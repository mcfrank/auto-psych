{"type":"tool_use","timestamp":1791358389918,"sessionID":"ses_eeab8ef93ffeNB11has6WTNJz3","part":{"type":"tool","tool":"read","callID":"HYkg93s11nCYue56","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/loop/gates.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/gates.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n2: \n3: A candidate directory must hold ``candidate.py`` (the model file) and\n4: ``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\n5: It is admitted only if, in order:\n6: \n7: 1. the code gate passes (`src.rsa.loop.code_gate`);\n8: 2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n9:    on the training displays AND on every shape of the novelty pool, so a model\n10:    that breaks on a 4 x 4 game is refused before any sampling;\n11: 3. it fits within the time limit, gives no observed choice probability zero,\n12:    and passes the convergence gate (one refit at target_accept 0.95 with a\n13:    fresh seed when the first fit fails it);\n14: 4. its ELPD-LOO is finite;\n15: 5. it is novel: its posterior-mean pool predictions are at least the\n16:    threshold (RMSE) from every admitted model's.\n17: \n18: Every refusal carries a reason written for the agent that will be asked to\n19: repair it. Infrastructure failures raise instead.\n20: \"\"\"\n21: \n22: from __future__ import annotations\n23: \n24: import math\n25: from dataclasses import dataclass, replace\n26: from pathlib import Path\n27: from typing import Dict, Mapping, Optional, Sequence\n28: \n29: import numpy as np\n30: \n31: from src.rsa.context import Context, group_by_shape\n32: from src.rsa.fit import FitSettings, RSAFit\n33: from src.rsa.loop.code_gate import code_problems\n34: from src.rsa.loop.fitting import ModelFailure, fit_cached\n35: from src.rsa.loop.novelty import closest, posterior_mean_class_probs\n36: from src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\n37: \n38: REFIT_TARGET_ACCEPT = 0.95\n39: \n40: \n41: @dataclass\n42: class Admission:\n43:     admitted: bool\n44:     reason: str\n45:     fit: Optional[RSAFit] = None\n46:     pool_preds: Optional[np.ndarray] = None\n47:     elpd_loo: Optional[float] = None\n48:     loo_reliable: Optional[bool] = None\n49: \n50: \n51: @dataclass(frozen=True)\n52: class GateConfig:\n53:     responses_path: Path\n54:     cache_dir: Path\n55:     settings: FitSettings\n56:     novelty_threshold: float\n57:     time_limit_sec: Optional[float]\n58: \n59: \n60: def _refuse(reason: str) -> Admission:\n61:     return Admission(admitted=False, reason=reason)\n62: \n63: \n64: def read_candidate(candidate_dir: Path) -> Optional[str]:\n65:     \"\"\"The reason a candidate directory is incomplete, or None.\"\"\"\n66:     for required in (\"candidate.py\", \"hypothesis.md\"):\n67:         f = Path(candidate_dir) / required\n68:         if not f.exists() or not f.read_text(encoding=\"utf-8\").strip():\n69:             return f\"{required} is missing or empty\"\n70:     return None\n71: \n72: \n73: def fit_with_refit(model_path: Path, name: str, cfg: GateConfig) -> RSAFit:\n74:     fitted = fit_cached(model_path, name, cfg.responses_path, cfg.settings, cfg.cache_dir,\n75:                         time_limit_sec=cfg.time_limit_sec)\n76:     if fitted.converged:\n77:         return fitted\n78:     retry = replace(cfg.settings, target_accept=max(cfg.settings.target_accept, REFIT_TARGET_ACCEPT),\n79:                     seed=cfg.settings.seed + 1)\n80:     return fit_cached(model_path, name, cfg.responses_path, retry, cfg.cache_dir,\n81:                       time_limit_sec=cfg.time_limit_sec)\n82: \n83: \n84: def admit(\n85:     candidate_dir: Path,\n86:     name: str,\n87:     *,\n88:     cfg: GateConfig,\n89:     training: Sequence[Context],\n90:     pool: Sequence[Context],\n91:     admitted_preds: Mapping[str, np.ndarray],\n92: ) -> Admission:\n93:     candidate_dir = Path(candidate_dir)\n94:     missing = read_candidate(candidate_dir)\n95:     if missing:\n96:         return _refuse(missing)\n97:     model_path = candidate_dir / \"candidate.py\"\n98:     source = model_path.read_text(encoding=\"utf-8\")\n99:     problems = code_problems(source)\n100:     if problems:\n101:         return _refuse(\n102:             \"the code gate refused candidate.py: \" + \", \".join(problems)\n103:             + \". Model files may import jax, memo, numpyro, numpy, a few stdlib modules \"\n104:             \"and src.rsa.memo_kit only, and may not read files or reach the interpreter.\"\n105:         )\n106:     try:\n107:         model = RSAModel(model_path, name=name)\n108:         check_contract(model, group_by_shape(training))\n109:         check_contract(model, group_by_shape(pool))\n110:     except ModelContractViolation as exc:\n111:         return _refuse(f\"contract: {exc}\")\n112:     except Exception as exc:  # memo compile errors, errors in the model's own code\n113:         from src.rsa.loop.fitting import is_model_failure\n114: \n115:         if is_model_failure(exc, model_path):\n116:             return _refuse(f\"the model failed to load or run: {type(exc).__name__}: {exc}\")\n117:         raise\n118:     try:\n119:         fitted = fit_with_refit(model_path, name, cfg)\n120:     except ModelFailure as exc:\n121:         return _refuse(f\"fitting failed: {exc}\")\n122:     if not fitted.converged:\n123:         return _refuse(\n124:             \"the fit did not converge even at target_accept 0.95: \"\n125:             + \"; \".join(fitted.convergence_problems)\n126:             + \". Reparameterise (e.g. sample on an unconstrained scale, tighten priors) \"\n127:             \"rather than relying on smaller steps.\"\n128:         )\n129:     loo = fitted.loo()\n130:     if not math.isfinite(loo.elpd_loo):\n131:         return _refuse(f\"ELPD-LOO is not finite ({loo.elpd_loo})\")\n132:     try:\n133:         preds = posterior_mean_class_probs(model, fitted, pool)\n134:     except ValueError as exc:\n135:         return _refuse(str(exc))\n136:     nearest, dist = closest(preds, admitted_preds)\n137:     if dist < cfg.novelty_threshold:\n138:         return Admission(\n139:             admitted=False,\n140:             reason=(\n141:                 f\"not novel: its predictions are within RMSE {dist:.4f} of {nearest}'s \"\n142:                 f\"(threshold {cfg.novelty_threshold}) over the loop's novelty pool of \"\n143:                 f\"{len(pool)} displays. A re-parameterisation of an existing mechanism is \"\n144:                 f\"not a new hypothesis; change what the listener or speaker computes.\"\n145:             ),\n146:             fit=fitted, pool_preds=preds, elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n147:         )\n148:     return Admission(\n149:         admitted=True, reason=\"admitted\", fit=fitted, pool_preds=preds,\n150:         elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n151:     )\n152: \n153: \n154: def pool_predictions_for(\n155:     models: Mapping[str, RSAModel], fits: Mapping[str, RSAFit], pool: Sequence[Context]\n156: ) -> Dict[str, np.ndarray]:\n157:     return {n: posterior_mean_class_probs(models[n], fits[n], pool) for n in models}\n\n(End of file - total 157 lines)\n</content>","metadata":{"preview":"\"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n\nA candidate directory must hold ``candidate.py`` (the model file) and\n``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\nIt is admitted only if, in order:\n\n1. the code gate passes (`src.rsa.loop.code_gate`);\n2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n   on the training displays AND on every shape of the novelty pool, so a model\n   that breaks on a 4 x 4 game is refused before any sampling;\n3. it fits within the time limit, gives no observed choice probability zero,\n   and passes the convergence gate (one refit at target_accept 0.95 with a\n   fresh seed when the first fit fails it);\n4. its ELPD-LOO is finite;\n5. it is novel: its posterior-mean pool predictions are at least the\n   threshold (RMSE) from every admitted model's.\n\nEvery refusal carries a reason written for the agent that will be asked to\nrepair it. Infrastructure failures raise instead.\n\"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/gates.py","text":"\"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n\nA candidate directory must hold ``candidate.py`` (the model file) and\n``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\nIt is admitted only if, in order:\n\n1. the code gate passes (`src.rsa.loop.code_gate`);\n2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n   on the training displays AND on every shape of the novelty pool, so a model\n   that breaks on a 4 x 4 game is refused before any sampling;\n3. it fits within the time limit, gives no observed choice probability zero,\n   and passes the convergence gate (one refit at target_accept 0.95 with a\n   fresh seed when the first fit fails it);\n4. its ELPD-LOO is finite;\n5. it is novel: its posterior-mean pool predictions are at least the\n   threshold (RMSE) from every admitted model's.\n\nEvery refusal carries a reason written for the agent that will be asked to\nrepair it. Infrastructure failures raise instead.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom dataclasses import dataclass, replace\nfrom pathlib import Path\nfrom typing import Dict, Mapping, Optional, Sequence\n\nimport numpy as np\n\nfrom src.rsa.context import Context, group_by_shape\nfrom src.rsa.fit import FitSettings, RSAFit\nfrom src.rsa.loop.code_gate import code_problems\nfrom src.rsa.loop.fitting import ModelFailure, fit_cached\nfrom src.rsa.loop.novelty import closest, posterior_mean_class_probs\nfrom src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\n\nREFIT_TARGET_ACCEPT = 0.95\n\n\n@dataclass\nclass Admission:\n    admitted: bool\n    reason: str\n    fit: Optional[RSAFit] = None\n    pool_preds: Optional[np.ndarray] = None\n    elpd_loo: Optional[float] = None\n    loo_reliable: Optional[bool] = None\n\n\n@dataclass(frozen=True)\nclass GateConfig:\n    responses_path: Path\n    cache_dir: Path\n    settings: FitSettings\n    novelty_threshold: float\n    time_limit_sec: Optional[float]\n\n\ndef _refuse(reason: str) -> Admission:\n    return Admission(admitted=False, reason=reason)\n\n\ndef read_candidate(candidate_dir: Path) -> Optional[str]:\n    \"\"\"The reason a candidate directory is incomplete, or None.\"\"\"\n    for required in (\"candidate.py\", \"hypothesis.md\"):\n        f = Path(candidate_dir) / required\n        if not f.exists() or not f.read_text(encoding=\"utf-8\").strip():\n            return f\"{required} is missing or empty\"\n    return None\n\n\ndef fit_with_refit(model_path: Path, name: str, cfg: GateConfig) -> RSAFit:\n    fitted = fit_cached(model_path, name, cfg.responses_path, cfg.settings, cfg.cache_dir,\n                        time_limit_sec=cfg.time_limit_sec)\n    if fitted.converged:\n        return fitted\n    retry = replace(cfg.settings, target_accept=max(cfg.settings.target_accept, REFIT_TARGET_ACCEPT),\n                    seed=cfg.settings.seed + 1)\n    return fit_cached(model_path, name, cfg.responses_path, retry, cfg.cache_dir,\n                      time_limit_sec=cfg.time_limit_sec)\n\n\ndef admit(\n    candidate_dir: Path,\n    name: str,\n    *,\n    cfg: GateConfig,\n    training: Sequence[Context],\n    pool: Sequence[Context],\n    admitted_preds: Mapping[str, np.ndarray],\n) -> Admission:\n    candidate_dir = Path(candidate_dir)\n    missing = read_candidate(candidate_dir)\n    if missing:\n        return _refuse(missing)\n    model_path = candidate_dir / \"candidate.py\"\n    source = model_path.read_text(encoding=\"utf-8\")\n    problems = code_problems(source)\n    if problems:\n        return _refuse(\n            \"the code gate refused candidate.py: \" + \", \".join(problems)\n            + \". Model files may import jax, memo, numpyro, numpy, a few stdlib modules \"\n            \"and src.rsa.memo_kit only, and may not read files or reach the interpreter.\"\n        )\n    try:\n        model = RSAModel(model_path, name=name)\n        check_contract(model, group_by_shape(training))\n        check_contract(model, group_by_shape(pool))\n    except ModelContractViolation as exc:\n        return _refuse(f\"contract: {exc}\")\n    except Exception as exc:  # memo compile errors, errors in the model's own code\n        from src.rsa.loop.fitting import is_model_failure\n\n        if is_model_failure(exc, model_path):\n            return _refuse(f\"the model failed to load or run: {type(exc).__name__}: {exc}\")\n        raise\n    try:\n        fitted = fit_with_refit(model_path, name, cfg)\n    except ModelFailure as exc:\n        return _refuse(f\"fitting failed: {exc}\")\n    if not fitted.converged:\n        return _refuse(\n            \"the fit did not converge even at target_accept 0.95: \"\n            + \"; \".join(fitted.convergence_problems)\n            + \". Reparameterise (e.g. sample on an unconstrained scale, tighten priors) \"\n            \"rather than relying on smaller steps.\"\n        )\n    loo = fitted.loo()\n    if not math.isfinite(loo.elpd_loo):\n        return _refuse(f\"ELPD-LOO is not finite ({loo.elpd_loo})\")\n    try:\n        preds = posterior_mean_class_probs(model, fitted, pool)\n    except ValueError as exc:\n        return _refuse(str(exc))\n    nearest, dist = closest(preds, admitted_preds)\n    if dist < cfg.novelty_threshold:\n        return Admission(\n            admitted=False,\n            reason=(\n                f\"not novel: its predictions are within RMSE {dist:.4f} of {nearest}'s \"\n                f\"(threshold {cfg.novelty_threshold}) over the loop's novelty pool of \"\n                f\"{len(pool)} displays. A re-parameterisation of an existing mechanism is \"\n                f\"not a new hypothesis; change what the listener or speaker computes.\"\n            ),\n            fit=fitted, pool_preds=preds, elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n        )\n    return Admission(\n        admitted=True, reason=\"admitted\", fit=fitted, pool_preds=preds,\n        elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n    )\n\n\ndef pool_predictions_for(\n    models: Mapping[str, RSAModel], fits: Mapping[str, RSAFit], pool: Sequence[Context]\n) -> Dict[str, np.ndarray]:\n    return {n: posterior_mean_class_probs(models[n], fits[n], pool) for n in models}","lineStart":1,"lineEnd":157,"totalLines":157,"truncated":false}},"title":"src/rsa/loop/gates.py","time":{"start":1791358389858,"end":1791358389878}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11547ce56001GO30F5l0MtQtBF","sessionID":"ses_eeab8ef93ffeNB11has6WTNJz3","messageID":"msg_11547c06c001zVnRkiNJ9Q8EOx"}}
