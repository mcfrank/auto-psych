{"type":"tool_use","timestamp":1791359141444,"sessionID":"ses_eeab8ef93ffeNB11has6WTNJz3","part":{"type":"tool","tool":"bash","callID":"4LBMTBRXsb1HPK3J","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport tempfile\nfrom pathlib import Path\nimport numpy as np\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.fit import FitSettings, fit\nfrom src.rsa.model_file import RSAModel\nfrom src.rsa.loop.novelty import novelty_pool, posterior_mean_class_probs, closest\nfrom src.rsa.loop.fitting import _read\n\ncode = '''\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \\\"alpha\\\": dist.LogNormal(0.0, 1.0),\n    \\\"w_features\\\": dist.Normal(0.0, 1.0),\n    \\\"w_familiar\\\": dist.Normal(0.0, 2.0),\n    \\\"beta_valence\\\": dist.Normal(0.0, 2.0),\n    \\\"lapse\\\": dist.Beta(1.0, 9.0),\n}\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\\\"w_features\\\"] * ctx.feature_count\n        + params[\\\"w_familiar\\\"] * ctx.familiarization\n        + params[\\\"beta_valence\\\"] * ctx.valence * ctx.feature_count\n    )\n    heard = L1(params[\\\"alpha\\\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\\\"lapse\\\"])\n'''\n\nwith tempfile.TemporaryDirectory() as td:\n    cand_path = Path(td) / 'candidate.py'\n    cand_path.write_text(code)\n    \n    ds = load_forced_choice(Path('data/rsa/loop_smoke2_repair/responses.csv'))\n    settings = FitSettings(num_warmup=500, num_samples=500, num_chains=2, target_accept=0.9, seed=0)\n    model = RSAModel(cand_path, name='cand')\n    fitted = fit(model, ds.contexts, ds.choices, settings)\n    print('Convergence problems:', fitted.convergence_problems)\n    print('ELPD-LOO:', fitted.loo().elpd_loo)\n    \n    pool = novelty_pool()\n    preds_cand = posterior_mean_class_probs(model, fitted, pool)\n    \n    cache_dir = Path('data/rsa/loop_smoke2_repair/.fit_cache')\n    models_dir = Path('data/rsa/loop_smoke2_repair/models')\n    names = ['literal_listener', 'rsa_l1', 'rsa_l2', 'rsa_l1_salience', 'rsa_l1_shared_prior', 'valence_evaluative_listener']\n    for name in names:\n        m = RSAModel(models_dir / f'{name}.py', name=name)\n        f = _read(cache_dir / f'{name}.nc', cache_dir / f'{name}.json')\n        p = posterior_mean_class_probs(m, f, pool)\n        rmse = np.sqrt(np.mean((preds_cand - p)**2))\n        print(f'cand vs {name:28s}: RMSE = {rmse:.4f}')\n\""},"output":"Convergence problems: []\nELPD-LOO: -4875.165371894836\ncand vs literal_listener            : RMSE = 0.1007\ncand vs rsa_l1                      : RMSE = 0.0589\ncand vs rsa_l2                      : RMSE = 0.0604\ncand vs rsa_l1_salience             : RMSE = 0.0400\ncand vs rsa_l1_shared_prior         : RMSE = 0.0416\ncand vs valence_evaluative_listener : RMSE = 0.0431\n","metadata":{"output":"Convergence problems: []\nELPD-LOO: -4875.165371894836\ncand vs literal_listener            : RMSE = 0.1007\ncand vs rsa_l1                      : RMSE = 0.0589\ncand vs rsa_l2                      : RMSE = 0.0604\ncand vs rsa_l1_salience             : RMSE = 0.0400\ncand vs rsa_l1_shared_prior         : RMSE = 0.0416\ncand vs valence_evaluative_listener : RMSE = 0.0431\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport tempfile\nfrom pathlib import Path\nimport numpy as np\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.fit import FitSettings, fit\nfrom src.rsa.model_file import RSAModel\nfrom src.rsa.loop.novelty import novelty_pool, posterior_mean_class_probs, closest\nfrom src.rsa.loop.fitting import _read\n\ncode = '''\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \\\"alpha\\\": dist.LogNormal(0.0, 1.0),\n    \\\"w_features\\\": dist.Normal(0.0, 1.0),\n    \\\"w_familiar\\\": dist.Normal(0.0, 2.0),\n    \\\"beta_valence\\\": dist.Normal(0.0, 2.0),\n    \\\"lapse\\\": dist.Beta(1.0, 9.0),\n}\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\\\"w_features\\\"] * ctx.feature_count\n        + params[\\\"w_familiar\\\"] * ctx.familiarization\n        + params[\\\"beta_valence\\\"] * ctx.valence * ctx.feature_count\n    )\n    heard = L1(params[\\\"alpha\\\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\\\"lapse\\\"])\n'''\n\nwith tempfile.TemporaryDirectory() as td:\n    cand_path = Path(td) / 'candidate.py'\n    cand_path.write_text(code)\n    \n    ds = load_forced_choice(Path('data/rsa/loop_smoke2_repair/responses.csv'))\n    settings = FitSettings(num_warmup=500, num_samples=500, num_chains=2, target_accept=0.9, seed=0)\n    model = RSAModel(cand_path, name='cand')\n    fitted = fit(model, ds.contexts, ds.choices, settings)\n    print('Convergence problems:', fitted.convergence_problems)\n    print('ELPD-LOO:', fitted.loo().elpd_loo)\n    \n    pool = novelty_pool()\n    preds_cand = posterior_mean_class_probs(model, fitted, pool)\n    \n    cache_dir = Path('data/rsa/loop_smoke2_repair/.fit_cache')\n    models_dir = Path('data/rsa/loop_smoke2_repair/models')\n    names = ['literal_listener', 'rsa_l1', 'rsa_l2', 'rsa_l1_salience', 'rsa_l1_shared_prior', 'valence_evaluative_listener']\n    for name in names:\n        m = RSAModel(models_dir / f'{name}.py', name=name)\n        f = _read(cache_dir / f'{name}.nc', cache_dir / f'{name}.json')\n        p = posterior_mean_class_probs(m, f, pool)\n        rmse = np.sqrt(np.mean((preds_cand - p)**2))\n        print(f'cand vs {name:28s}: RMSE = {rmse:.4f}')\n\"","time":{"start":1791358956744,"end":1791359141407}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1155074bf001P6ZwSUiP949EXD","sessionID":"ses_eeab8ef93ffeNB11has6WTNJz3","messageID":"msg_11550596c001ytoikrcK7ScGCz"}}
