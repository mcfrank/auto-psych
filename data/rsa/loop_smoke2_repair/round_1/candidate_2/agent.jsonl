pp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L1(params[\"alpha\"], ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":43,"totalLines":43,"truncated":false}},"title":"data/rsa/loop_smoke2_repair/models/rsa_l1.py","time":{"start":1791357293948,"end":1791357294128}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_115371572001ssYr26a2byXqU4","sessionID":"ses_eeac95a08ffePV4Q3pT4u1pnwg","messageID":"msg_115370d1f001Snz0bjVV2FTyLH"}}
