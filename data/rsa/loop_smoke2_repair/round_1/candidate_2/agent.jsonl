{"type":"tool_use","timestamp":1791357399309,"sessionID":"ses_eeac95a08ffePV4Q3pT4u1pnwg","part":{"type":"tool","tool":"read","callID":"h060cqKArbROgnWC","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/fit.py"},"output":"<path>/home/user/auto-psych/src/rsa/fit.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Fitting memo models with numpyro NUTS.\n2: \n3: The likelihood is the harness's, not the model's: each trial's choice is\n4: Categorical(choice_probs(params, ctx)). Trials are evaluated per shape group\n5: (`src.rsa.context.group_by_shape`), the groups' probabilities are padded with\n6: zeros to the widest context (a padded object is never chosen) and observed as\n7: one site, so the pointwise log-likelihood comes back in input trial order.\n8: \n9: A choice is observed as its *class* of identical objects\n10: (`src.rsa.context.Context.choice_classes`): no model can tell identical\n11: objects apart, and the pragmods data often cannot say which copy was chosen,\n12: so the class's summed probability is the likelihood.\n13: \n14: The result is an arviz ``InferenceData`` with a ``log_likelihood`` group, so\n15: the repo's PSIS-LOO reliability verdict (`src.models.loo_reliability`), the\n16: convergence gate (`src.models.pymc_inference.convergence_problems`) and\n17: ``az.compare`` apply unchanged.\n18: \"\"\"\n19: \n20: from __future__ import annotations\n21: \n22: from dataclasses import dataclass, field\n23: from typing import Any, Dict, List, Mapping, Sequence, Tuple\n24: \n25: import arviz as az\n26: import jax\n27: import jax.numpy as jnp\n28: import numpy as np\n29: import numpyro\n30: import numpyro.distributions as dist\n31: from numpyro.infer import MCMC, NUTS, log_likelihood\n32: \n33: from src.models.loo_reliability import LooDiagnostics, loo_diagnostics\n34: from src.models.pymc_inference import convergence_problems\n35: from src.rsa.context import Context, ShapeGroup, group_by_shape\n36: from src.rsa.model_file import RSAModel, check_contract\n37: \n38: OBSERVED_SITE = \"choice\"\n39: \n40: \n41: @dataclass(frozen=True)\n42: class FitSettings:\n43:     num_warmup: int = 1000\n44:     num_samples: int = 1000\n45:     num_chains: int = 4\n46:     target_accept: float = 0.9\n47:     seed: int = 0\n48: \n49: \n50: class ZeroProbabilityChoice(ValueError):\n51:     \"\"\"A model gives an observed choice probability zero at its prior draws.\"\"\"\n52: \n53: \n54: @dataclass\n55: class RSAFit:\n56:     model_name: str\n57:     idata: Any\n58:     param_names: List[str]\n59:     convergence_problems: List[str] = field(default_factory=list)\n60: \n61:     @property\n62:     def converged(self) -> bool:\n63:         return not self.convergence_problems\n64: \n65:     def loo(self) -> LooDiagnostics:\n66:         return loo_diagnostics(self.idata)\n67: \n68: \n69: def class_probs(probs, classes) -> jnp.ndarray:\n70:     \"\"\"Collapse (trials, N_OBJ) probabilities onto choice classes.\n71: \n72:     Each class's summed probability sits at its first object's index; the\n73:     other members of a class get zero.\n74:     \"\"\"\n75:     onehot = jax.nn.one_hot(jnp.asarray(classes), probs.shape[-1], dtype=probs.dtype)\n76:     return jnp.einsum(\"tr,trs->ts\", probs, onehot)\n77: \n78: \n79: def _padded_probs(\n80:     model: RSAModel, params: Mapping[str, Any], groups: Sequence[ShapeGroup], width: int\n81: ) -> jnp.ndarray:\n82:     blocks = []\n83:     for group in groups:\n84:         p = class_probs(model.group_probs(params, group), group.classes)\n85:         blocks.append(jnp.pad(p, ((0, 0), (0, width - p.shape[1]))))\n86:     return jnp.concatenate(blocks, axis=0)\n87: \n88: \n89: def _numpyro_model(model: RSAModel, groups: Sequence[ShapeGroup], width: int, choices=None):\n90:     params = {name: numpyro.sample(name, prior) for name, prior in model.params.items()}\n91:     probs = _padded_probs(model, params, groups, width)\n92:     numpyro.sample(OBSERVED_SITE, dist.Categorical(logits=_safe_logits(probs)), obs=choices)\n93: \n94: \n95: def _safe_logits(probs: jnp.ndarray) -> jnp.ndarray:\n96:     \"\"\"log(probs), -inf at zeros, with a finite gradient.\n97: \n98:     Zeros (padding, non-first members of a choice class) depend on the\n99:     parameters through the class sum; log(0)'s infinite derivative times a\n100:     zero cotangent would be NaN, so log is never evaluated at zero.\n101:     \"\"\"\n102:     positive = probs > 0\n103:     return jnp.where(positive, jnp.log(jnp.where(positive, probs, 1.0)), -jnp.inf)\n104: \n105: \n106: def prepare(\n107:     contexts: Sequence[Context], choices: Sequence[int]\n108: ) -> Tuple[List[ShapeGroup], np.ndarray, np.ndarray, int]:\n109:     \"\"\"Shape groups, choices in group order, the permutation back to input order, width.\"\"\"\n110:     if len(contexts) != len(choices):\n111:         raise ValueError(f\"{len(contexts)} contexts but {len(choices)} choices\")\n112:     choices = np.asarray(choices, dtype=np.int32)\n113:     for i, (ctx, c) in enumerate(zip(contexts, choices)):\n114:         if not 0 <= c < ctx.shape[0]:\n115:             raise ValueError(f\"trial {i}: choice {c} is not an object index of its context\")\n116:     choices = np.asarray(\n117:         [ctx.choice_classes()[c] for ctx, c in zip(contexts, choices)], dtype=np.int32\n118:     )\n119:     groups = list(group_by_shape(contexts).values())\n120:     order = np.concatenate([g.indices for g in groups])\n121:     inverse = np.empty_like(order)\n122:     inverse[order] = np.arange(len(order))\n123:     width = max(g.shape[0] for g in groups)\n124:     return groups, choices[order], inverse, width\n125: \n126: \n127: def _check_possible(model, groups, grouped_choices, width, n_draws: int = 4) -> None:\n128:     from src.rsa.model_file import prior_draws\n129: \n130:     for draw in prior_draws(model.params, n_draws, seed=1):\n131:         probs = np.asarray(_padded_probs(model, draw, groups, width))\n132:         p_chosen = probs[np.arange(len(grouped_choices)), grouped_choices]\n133:         if np.any(p_chosen <= 0):\n134:             raise ZeroProbabilityChoice(\n135:                 f\"{model.name} gives probability 0 to {(p_chosen <= 0).sum()} observed \"\n136:                 f\"choices at prior draw {draw}; a model must leave every object possible \"\n137:                 f\"(e.g. a lapse or noise process)\"\n138:             )\n139: \n140: \n141: def fit(\n142:     model: RSAModel,\n143:     contexts: Sequence[Context],\n144:     choices: Sequence[int],\n145:     settings: FitSettings = FitSettings(),\n146: ) -> RSAFit:\n147:     groups, grouped_choices, inverse, width = prepare(contexts, choices)\n148:     check_contract(model, {g.shape: g for g in groups})\n149:     _check_possible(model, groups, grouped_choices, width)\n150:     kernel = NUTS(_numpyro_model, target_accept_prob=settings.target_accept)\n151:     mcmc = MCMC(\n152:         kernel,\n153:         num_warmup=settings.num_warmup,\n154:         num_samples=settings.num_samples,\n155:         num_chains=settings.num_chains,\n156:         chain_method=\"vectorized\",\n157:         progress_bar=False,\n158:     )\n159:     obs = jnp.asarray(grouped_choices)\n160:     mcmc.run(\n161:         jax.random.PRNGKey(settings.seed), model, groups, width, obs,\n162:         extra_fields=(\"diverging\",),\n163:     )\n164:     samples = mcmc.get_samples(group_by_chain=True)\n165:     ll = log_likelihood(_numpyro_model, samples, model, groups, width, obs, batch_ndims=2)\n166:     pointwise = np.asarray(ll[OBSERVED_SITE])[..., inverse]\n167:     diverging = np.asarray(mcmc.get_extra_fields(group_by_chain=True)[\"diverging\"])\n168:     idata = az.from_dict(\n169:         posterior={k: np.asarray(v) for k, v in samples.items()},\n170:         log_likelihood={OBSERVED_SITE: pointwise},\n171:         sample_stats={\"diverging\": diverging},\n172:         observed_data={OBSERVED_SITE: grouped_choices[inverse]},\n173:     )\n174:     names = list(model.params)\n175:     return RSAFit(\n176:         model_name=model.name,\n177:         idata=idata,\n178:         param_names=names,\n179:         convergence_problems=convergence_problems(idata, names),\n180:     )\n181: \n182: \n183: def posterior_mean_probs(\n184:     model: RSAModel, fitted: RSAFit, contexts: Sequence[Context], max_draws: int = 200\n185: ) -> List[np.ndarray]:\n186:     \"\"\"Posterior-mean choice probabilities per context (ragged: one array per trial).\"\"\"\n187:     post = fitted.idata.posterior\n188:     flat = {k: np.asarray(post[k]).reshape(-1) for k in fitted.param_names}\n189:     n = len(next(iter(flat.values())))\n190:     take = np.linspace(0, n - 1, min(max_draws, n)).astype(int)\n191:     out: List[np.ndarray] = [None] * len(contexts)  # type: ignore[list-item]\n192:     for group in group_by_shape(contexts).values():\n193:         acc = 0.0\n194:         for i in take:\n195:             acc = acc + np.asarray(model.group_probs({k: v[i] for k, v in flat.items()}, group))\n196:         mean = acc / len(take)\n197:         for row, idx in enumerate(group.indices):\n198:             out[idx] = mean[row]\n199:     return out\n200: \n201: \n202: def compare(fits: Mapping[str, RSAFit]) -> Any:\n203:     \"\"\"``az.compare`` (PSIS-LOO) over fits keyed by model name.\"\"\"\n204:     return az.compare({name: f.idata for name, f in fits.items()}, ic=\"loo\")\n\n(End of file - total 204 lines)\n</content>","metadata":{"preview":"\"\"\"Fitting memo models with numpyro NUTS.\n\nThe likelihood is the harness's, not the model's: each trial's choice is\nCategorical(choice_probs(params, ctx)). Trials are evaluated per shape group\n(`src.rsa.context.group_by_shape`), the groups' probabilities are padded with\nzeros to the widest context (a padded object is never chosen) and observed as\none site, so the pointwise log-likelihood comes back in input trial order.\n\nA choice is observed as its *class* of identical objects\n(`src.rsa.context.Context.choice_classes`): no model can tell identical\nobjects apart, and the pragmods data often cannot say which copy was chosen,\nso the class's summed probability is the likelihood.\n\nThe result is an arviz ``InferenceData`` with a ``log_likelihood`` group, so\nthe repo's PSIS-LOO reliability verdict (`src.models.loo_reliability`), the\nconvergence gate (`src.models.pymc_inference.convergence_problems`) and\n``az.compare`` apply unchanged.\n\"\"\"\n\nfrom __future__ import annotations","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/fit.py","text":"\"\"\"Fitting memo models with numpyro NUTS.\n\nThe likelihood is the harness's, not the model's: each trial's choice is\nCategorical(choice_probs(params, ctx)). Trials are evaluated per shape group\n(`src.rsa.context.group_by_shape`), the groups' probabilities are padded with\nzeros to the widest context (a padded object is never chosen) and observed as\none site, so the pointwise log-likelihood comes back in input trial order.\n\nA choice is observed as its *class* of identical objects\n(`src.rsa.context.Context.choice_classes`): no model can tell identical\nobjects apart, and the pragmods data often cannot say which copy was chosen,\nso the class's summed probability is the likelihood.\n\nThe result is an arviz ``InferenceData`` with a ``log_likelihood`` group, so\nthe repo's PSIS-LOO reliability verdict (`src.models.loo_reliability`), the\nconvergence gate (`src.models.pymc_inference.convergence_problems`) and\n``az.compare`` apply unchanged.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import Any, Dict, List, Mapping, Sequence, Tuple\n\nimport arviz as az\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport numpyro\nimport numpyro.distributions as dist\nfrom numpyro.infer import MCMC, NUTS, log_likelihood\n\nfrom src.models.loo_reliability import LooDiagnostics, loo_diagnostics\nfrom src.models.pymc_inference import convergence_problems\nfrom src.rsa.context import Context, ShapeGroup, group_by_shape\nfrom src.rsa.model_file import RSAModel, check_contract\n\nOBSERVED_SITE = \"choice\"\n\n\n@dataclass(frozen=True)\nclass FitSettings:\n    num_warmup: int = 1000\n    num_samples: int = 1000\n    num_chains: int = 4\n    target_accept: float = 0.9\n    seed: int = 0\n\n\nclass ZeroProbabilityChoice(ValueError):\n    \"\"\"A model gives an observed choice probability zero at its prior draws.\"\"\"\n\n\n@dataclass\nclass RSAFit:\n    model_name: str\n    idata: Any\n    param_names: List[str]\n    convergence_problems: List[str] = field(default_factory=list)\n\n    @property\n    def converged(self) -> bool:\n        return not self.convergence_problems\n\n    def loo(self) -> LooDiagnostics:\n        return loo_diagnostics(self.idata)\n\n\ndef class_probs(probs, classes) -> jnp.ndarray:\n    \"\"\"Collapse (trials, N_OBJ) probabilities onto choice classes.\n\n    Each class's summed probability sits at its first object's index; the\n    other members of a class get zero.\n    \"\"\"\n    onehot = jax.nn.one_hot(jnp.asarray(classes), probs.shape[-1], dtype=probs.dtype)\n    return jnp.einsum(\"tr,trs->ts\", probs, onehot)\n\n\ndef _padded_probs(\n    model: RSAModel, params: Mapping[str, Any], groups: Sequence[ShapeGroup], width: int\n) -> jnp.ndarray:\n    blocks = []\n    for group in groups:\n        p = class_probs(model.group_probs(params, group), group.classes)\n        blocks.append(jnp.pad(p, ((0, 0), (0, width - p.shape[1]))))\n    return jnp.concatenate(blocks, axis=0)\n\n\ndef _numpyro_model(model: RSAModel, groups: Sequence[ShapeGroup], width: int, choices=None):\n    params = {name: numpyro.sample(name, prior) for name, prior in model.params.items()}\n    probs = _padded_probs(model, params, groups, width)\n    numpyro.sample(OBSERVED_SITE, dist.Categorical(logits=_safe_logits(probs)), obs=choices)\n\n\ndef _safe_logits(probs: jnp.ndarray) -> jnp.ndarray:\n    \"\"\"log(probs), -inf at zeros, with a finite gradient.\n\n    Zeros (padding, non-first members of a choice class) depend on the\n    parameters through the class sum; log(0)'s infinite derivative times a\n    zero cotangent would be NaN, so log is never evaluated at zero.\n    \"\"\"\n    positive = probs > 0\n    return jnp.where(positive, jnp.log(jnp.where(positive, probs, 1.0)), -jnp.inf)\n\n\ndef prepare(\n    contexts: Sequence[Context], choices: Sequence[int]\n) -> Tuple[List[ShapeGroup], np.ndarray, np.ndarray, int]:\n    \"\"\"Shape groups, choices in group order, the permutation back to input order, width.\"\"\"\n    if len(contexts) != len(choices):\n        raise ValueError(f\"{len(contexts)} contexts but {len(choices)} choices\")\n    choices = np.asarray(choices, dtype=np.int32)\n    for i, (ctx, c) in enumerate(zip(contexts, choices)):\n        if not 0 <= c < ctx.shape[0]:\n            raise ValueError(f\"trial {i}: choice {c} is not an object index of its context\")\n    choices = np.asarray(\n        [ctx.choice_classes()[c] for ctx, c in zip(contexts, choices)], dtype=np.int32\n    )\n    groups = list(group_by_shape(contexts).values())\n    order = np.concatenate([g.indices for g in groups])\n    inverse = np.empty_like(order)\n    inverse[order] = np.arange(len(order))\n    width = max(g.shape[0] for g in groups)\n    return groups, choices[order], inverse, width\n\n\ndef _check_possible(model, groups, grouped_choices, width, n_draws: int = 4) -> None:\n    from src.rsa.model_file import prior_draws\n\n    for draw in prior_draws(model.params, n_draws, seed=1):\n        probs = np.asarray(_padded_probs(model, draw, groups, width))\n        p_chosen = probs[np.arange(len(grouped_choices)), grouped_choices]\n        if np.any(p_chosen <= 0):\n            raise ZeroProbabilityChoice(\n                f\"{model.name} gives probability 0 to {(p_chosen <= 0).sum()} observed \"\n                f\"choices at prior draw {draw}; a model must leave every object possible \"\n                f\"(e.g. a lapse or noise process)\"\n            )\n\n\ndef fit(\n    model: RSAModel,\n    contexts: Sequence[Context],\n    choices: Sequence[int],\n    settings: FitSettings = FitSettings(),\n) -> RSAFit:\n    groups, grouped_choices, inverse, width = prepare(contexts, choices)\n    check_contract(model, {g.shape: g for g in groups})\n    _check_possible(model, groups, grouped_choices, width)\n    kernel = NUTS(_numpyro_model, target_accept_prob=settings.target_accept)\n    mcmc = MCMC(\n        kernel,\n        num_warmup=settings.num_warmup,\n        num_samples=settings.num_samples,\n        num_chains=settings.num_chains,\n        chain_method=\"vectorized\",\n        progress_bar=False,\n    )\n    obs = jnp.asarray(grouped_choices)\n    mcmc.run(\n        jax.random.PRNGKey(settings.seed), model, groups, width, obs,\n        extra_fields=(\"diverging\",),\n    )\n    samples = mcmc.get_samples(group_by_chain=True)\n    ll = log_likelihood(_numpyro_model, samples, model, groups, width, obs, batch_ndims=2)\n    pointwise = np.asarray(ll[OBSERVED_SITE])[..., inverse]\n    diverging = np.asarray(mcmc.get_extra_fields(group_by_chain=True)[\"diverging\"])\n    idata = az.from_dict(\n        posterior={k: np.asarray(v) for k, v in samples.items()},\n        log_likelihood={OBSERVED_SITE: pointwise},\n        sample_stats={\"diverging\": diverging},\n        observed_data={OBSERVED_SITE: grouped_choices[inverse]},\n    )\n    names = list(model.params)\n    return RSAFit(\n        model_name=model.name,\n        idata=idata,\n        param_names=names,\n        convergence_problems=convergence_problems(idata, names),\n    )\n\n\ndef posterior_mean_probs(\n    model: RSAModel, fitted: RSAFit, contexts: Sequence[Context], max_draws: int = 200\n) -> List[np.ndarray]:\n    \"\"\"Posterior-mean choice probabilities per context (ragged: one array per trial).\"\"\"\n    post = fitted.idata.posterior\n    flat = {k: np.asarray(post[k]).reshape(-1) for k in fitted.param_names}\n    n = len(next(iter(flat.values())))\n    take = np.linspace(0, n - 1, min(max_draws, n)).astype(int)\n    out: List[np.ndarray] = [None] * len(contexts)  # type: ignore[list-item]\n    for group in group_by_shape(contexts).values():\n        acc = 0.0\n        for i in take:\n            acc = acc + np.asarray(model.group_probs({k: v[i] for k, v in flat.items()}, group))\n        mean = acc / len(take)\n        for row, idx in enumerate(group.indices):\n            out[idx] = mean[row]\n    return out\n\n\ndef compare(fits: Mapping[str, RSAFit]) -> Any:\n    \"\"\"``az.compare`` (PSIS-LOO) over fits keyed by model name.\"\"\"\n    return az.compare({name: f.idata for name, f in fits.items()}, ic=\"loo\")","lineStart":1,"lineEnd":204,"totalLines":204,"truncated":false}},"title":"src/rsa/fit.py","time":{"start":1791357399255,"end":1791357399274}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11538b0cd0014z4BPSYgj7oE0S","sessionID":"ses_eeac95a08ffePV4Q3pT4u1pnwg","messageID":"msg_1153880f3001vIhIAAihLgV07V"}}
