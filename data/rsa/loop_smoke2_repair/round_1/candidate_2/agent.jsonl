eds)\nprint(f'Closest model: {nearest}, distance RMSE: {dist:.5f}')\nfor name, p in admitted_preds.items():\n    d = np.sqrt(np.mean((cand_preds - p)**2))\n    print(f'  vs {name}: {d:.5f}')\n\"","time":{"start":1791357787434,"end":1791357951167}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1153e9d16001ZAqianBO772yqT","sessionID":"ses_eeac95a08ffePV4Q3pT4u1pnwg","messageID":"msg_1153e77910014VcBSfmPUJNzJN"}}
