{"type":"tool_use","timestamp":1791357951229,"sessionID":"ses_eeac95a08ffePV4Q3pT4u1pnwg","part":{"type":"tool","tool":"bash","callID":"KZoY0qCsQefCGeTA","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport numpy as np\nfrom src.rsa.model_file import RSAModel\nfrom src.rsa.fit import RSAFit\nfrom src.rsa.loop.novelty import novelty_pool, posterior_mean_class_probs, closest\nimport arviz as az\nfrom pathlib import Path\n\npool = novelty_pool()\n\nfits = {}\nmodels = {}\nfor name in ['literal_listener', 'rsa_l1', 'rsa_l2', 'rsa_l1_salience', 'rsa_l1_shared_prior']:\n    nc_path = Path(f'data/rsa/loop_smoke2_repair/.fit_cache/{name}.nc')\n    idata = az.from_netcdf(nc_path)\n    models[name] = RSAModel(Path(f'data/rsa/loop_smoke2_repair/models/{name}.py'), name=name)\n    fits[name] = RSAFit(name, idata, list(models[name].params.keys()))\n\nadmitted_preds = {name: posterior_mean_class_probs(models[name], fits[name], pool, max_draws=50) for name in models}\n\n# Now for candidate_2: we can do a quick fit or use the cache/predictions if available, or fit quickly\ncand_model = RSAModel(Path('data/rsa/loop_smoke2_repair/round_1/candidate_2/candidate.py'), name='rsa_l2_salience')\n\n# Let's run a short fit to get cand_fit and compute pool predictions\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.fit import fit, FitSettings\nresponses = Path('data/rsa/loop_smoke2_repair/responses.csv')\ntrials = load_forced_choice(responses)\ncand_fit = fit(cand_model, trials.contexts, trials.choices, settings=FitSettings(num_warmup=100, num_samples=100, num_chains=2))\ncand_preds = posterior_mean_class_probs(cand_model, cand_fit, pool, max_draws=50)\n\nnearest, dist = closest(cand_preds, admitted_preds)\nprint(f'Closest model: {nearest}, distance RMSE: {dist:.5f}')\nfor name, p in admitted_preds.items():\n    d = np.sqrt(np.mean((cand_preds - p)**2))\n    print(f'  vs {name}: {d:.5f}')\n\""},"output":"Closest model: rsa_l1_sa