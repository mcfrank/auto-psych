{"type":"tool_use","timestamp":1791357368876,"sessionID":"ses_eeac95a08ffePV4Q3pT4u1pnwg","part":{"type":"tool","tool":"read","callID":"U4bnLICzbKxP4aAE","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/dataset.py"},"output":"<path>/home/user/auto-psych/src/rsa/dataset.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Forced-choice trials of the canonical pragmods table as contexts and choices.\n2: \n3: Reads `projects/rsa_reference/data/pragmods_trials.csv` (built by\n4: `src.rsa.pragmods_ingest`). Only included forced-choice rows with a recorded\n5: display are trials; the speakers' follow-up listener trials have no recorded\n6: matrix and are left out by name (`NO_DISPLAY`), never silently.\n7: \"\"\"\n8: \n9: from __future__ import annotations\n10: \n11: import json\n12: from dataclasses import dataclass\n13: from pathlib import Path\n14: from typing import List, Optional, Sequence\n15: \n16: import pandas as pd\n17: \n18: from src.rsa.context import Context\n19: from src.runtime.config import PROJECT_ASSETS_DIR\n20: \n21: DEFAULT_TRIALS_CSV = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"data\" / \"pragmods_trials.csv\"\n22: FAMILIARIZATION_IMAGES = 9\n23: \n24: # framing label -> valence of the speaker's attitude to the object he means.\n25: VALENCE_BY_FRAMING = {\n26:     \"my_favorite_X_has\": 1,\n27:     \"silent_favorite\": 1,\n28:     \"my_least_favorite_X_has\": -1,\n29:     \"silent_least_favorite\": -1,\n30:     \"one_word\": 0,\n31:     \"my_X_has\": 0,\n32:     \"the_X_has\": 0,\n33:     \"tricky_guy\": 0,\n34:     \"points_to_color_patch\": 0,\n35:     # The message is a picture of one feature (Mayn & Demberg's games).\n36:     \"message_icon\": 0,\n37: }\n38: \n39: NO_DISPLAY = \"[]\"\n40: \n41: \n42: @dataclass\n43: class Trials:\n44:     contexts: List[Context]\n45:     choices: List[int]\n46:     frame: pd.DataFrame  # the CSV rows, aligned with contexts\n47: \n48: \n49: def _json_or_none(value) -> Optional[list]:\n50:     if isinstance(value, float) and pd.isna(value):\n51:         return None\n52:     if value is None or value == \"\":\n53:         return None\n54:     return json.loads(value)\n55: \n56: \n57: def context_from_row(row: pd.Series) -> Context:\n58:     framing = row[\"framing\"]\n59:     if framing not in VALENCE_BY_FRAMING:\n60:         raise ValueError(f\"framing {framing!r} has no valence in VALENCE_BY_FRAMING\")\n61:     objects = json.loads(row[\"objects\"])\n62:     names = json.loads(row[\"feature_names\"])\n63:     names = tuple(n if n is not None else f\"feature{i}\" for i, n in enumerate(names))\n64:     if row[\"query\"] == \"utterance\":\n65:         utterance: Optional[int] = int(row[\"utterance\"])\n66:     elif row[\"query\"] == \"prior\":\n67:         utterance = None\n68:     else:\n69:         raise ValueError(f\"query {row['query']!r} is not a listener trial\")\n70:     fam = _json_or_none(row[\"familiarization\"])\n71:     if fam is not None:\n72:         if sum(fam) != FAMILIARIZATION_IMAGES:\n73:             raise ValueError(f\"familiarization counts {fam} do not sum to {FAMILIARIZATION_IMAGES}\")\n74:         fam = tuple(c / FAMILIARIZATION_IMAGES for c in fam)\n75:     gray = _json_or_none(row[\"grayscale\"])\n76:     # Optional column: the feature indices the speaker could name (a dataset\n77:     # whose every feature is a word, like pragmods, omits it).\n78:     messages = _json_or_none(row[\"messages\"]) if \"messages\" in row.index else None\n79:     return Context(\n80:         objects=tuple(tuple(r) for r in objects),\n81:         feature_names=names,\n82:         utterance=utterance,\n83:         item=str(row[\"item\"]),\n84:         familiarization=fam,\n85:         grayscale=None if gray is None else tuple(gray),\n86:         valence=VALENCE_BY_FRAMING[framing],\n87:         messages=None if messages is None else tuple(messages),\n88:     )\n89: \n90: \n91: def load_forced_choice(\n92:     path: Path = DEFAULT_TRIALS_CSV, experiments: Optional[Sequence[str]] = None\n93: ) -> Trials:\n94:     \"\"\"Included forced-choice listener trials, optionally from some experiments only.\"\"\"\n95:     df = pd.read_csv(path)\n96:     rows = df[(df[\"dv\"] == \"forced_choice\") & df[\"included\"].astype(bool)]\n97:     rows = rows[rows[\"objects\"] != NO_DISPLAY]\n98:     if experiments is not None:\n99:         unknown = sorted(set(experiments) - set(df[\"experiment\"]))\n100:         if unknown:\n101:             raise ValueError(f\"no experiments named {unknown} in {path}\")\n102:         rows = rows[rows[\"experiment\"].isin(experiments)]\n103:     rows = rows.reset_index(drop=True)\n104:     contexts = [context_from_row(r) for _, r in rows.iterrows()]\n105:     choices = [int(c) for c in rows[\"choice\"]]\n106:     return Trials(contexts=contexts, choices=choices, frame=rows)\n\n(End of file - total 106 lines)\n</content>","metadata":{"preview":"\"\"\"Forced-choice trials of the canonical pragmods table as contexts and choices.\n\nReads `projects/rsa_reference/data/pragmods_trials.csv` (built by\n`src.rsa.pragmods_ingest`). Only included forced-choice rows with a recorded\ndisplay are trials; the speakers' follow-up listener trials have no recorded\nmatrix and are left out by name (`NO_DISPLAY`), never silently.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import List, Optional, Sequence\n\nimport pandas as pd\n\nfrom src.rsa.context import Context\nfrom src.runtime.config import PROJECT_ASSETS_DIR\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/dataset.py","text":"\"\"\"Forced-choice trials of the canonical pragmods table as contexts and choices.\n\nReads `projects/rsa_reference/data/pragmods_trials.csv` (built by\n`src.rsa.pragmods_ingest`). Only included forced-choice rows with a recorded\ndisplay are trials; the speakers' follow-up listener trials have no recorded\nmatrix and are left out by name (`NO_DISPLAY`), never silently.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import List, Optional, Sequence\n\nimport pandas as pd\n\nfrom src.rsa.context import Context\nfrom src.runtime.config import PROJECT_ASSETS_DIR\n\nDEFAULT_TRIALS_CSV = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"data\" / \"pragmods_trials.csv\"\nFAMILIARIZATION_IMAGES = 9\n\n# framing label -> valence of the speaker's attitude to the object he means.\nVALENCE_BY_FRAMING = {\n    \"my_favorite_X_has\": 1,\n    \"silent_favorite\": 1,\n    \"my_least_favorite_X_has\": -1,\n    \"silent_least_favorite\": -1,\n    \"one_word\": 0,\n    \"my_X_has\": 0,\n    \"the_X_has\": 0,\n    \"tricky_guy\": 0,\n    \"points_to_color_patch\": 0,\n    # The message is a picture of one feature (Mayn & Demberg's games).\n    \"message_icon\": 0,\n}\n\nNO_DISPLAY = \"[]\"\n\n\n@dataclass\nclass Trials:\n    contexts: List[Context]\n    choices: List[int]\n    frame: pd.DataFrame  # the CSV rows, aligned with contexts\n\n\ndef _json_or_none(value) -> Optional[list]:\n    if isinstance(value, float) and pd.isna(value):\n        return None\n    if value is None or value == \"\":\n        return None\n    return json.loads(value)\n\n\ndef context_from_row(row: pd.Series) -> Context:\n    framing = row[\"framing\"]\n    if framing not in VALENCE_BY_FRAMING:\n        raise ValueError(f\"framing {framing!r} has no valence in VALENCE_BY_FRAMING\")\n    objects = json.loads(row[\"objects\"])\n    names = json.loads(row[\"feature_names\"])\n    names = tuple(n if n is not None else f\"feature{i}\" for i, n in enumerate(names))\n    if row[\"query\"] == \"utterance\":\n        utterance: Optional[int] = int(row[\"utterance\"])\n    elif row[\"query\"] == \"prior\":\n        utterance = None\n    else:\n        raise ValueError(f\"query {row['query']!r} is not a listener trial\")\n    fam = _json_or_none(row[\"familiarization\"])\n    if fam is not None:\n        if sum(fam) != FAMILIARIZATION_IMAGES:\n            raise ValueError(f\"familiarization counts {fam} do not sum to {FAMILIARIZATION_IMAGES}\")\n        fam = tuple(c / FAMILIARIZATION_IMAGES for c in fam)\n    gray = _json_or_none(row[\"grayscale\"])\n    # Optional column: the feature indices the speaker could name (a dataset\n    # whose every feature is a word, like pragmods, omits it).\n    messages = _json_or_none(row[\"messages\"]) if \"messages\" in row.index else None\n    return Context(\n        objects=tuple(tuple(r) for r in objects),\n        feature_names=names,\n        utterance=utterance,\n        item=str(row[\"item\"]),\n        familiarization=fam,\n        grayscale=None if gray is None else tuple(gray),\n        valence=VALENCE_BY_FRAMING[framing],\n        messages=None if messages is None else tuple(messages),\n    )\n\n\ndef load_forced_choice(\n    path: Path = DEFAULT_TRIALS_CSV, experiments: Optional[Sequence[str]] = None\n) -> Trials:\n    \"\"\"Included forced-choice listener trials, optionally from some experiments only.\"\"\"\n    df = pd.read_csv(path)\n    rows = df[(df[\"dv\"] == \"forced_choice\") & df[\"included\"].astype(bool)]\n    rows = rows[rows[\"objects\"] != NO_DISPLAY]\n    if experiments is not None:\n        unknown = sorted(set(experiments) - set(df[\"experiment\"]))\n        if unknown:\n            raise ValueError(f\"no experiments named {unknown} in {path}\")\n        rows = rows[rows[\"experiment\"].isin(experiments)]\n    rows = rows.reset_index(drop=True)\n    contexts = [context_from_row(r) for _, r in rows.iterrows()]\n    choices = [int(c) for c in rows[\"choice\"]]\n    return Trials(contexts=contexts, choices=choices, frame=rows)","lineStart":1,"lineEnd":106,"totalLines":106,"truncated":false}},"title":"src/rsa/dataset.py","time":{"start":1791357368767,"end":1791357368795}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1153839