9\nbest_beta, best_lapse = None, None\nfor beta in [0.0, 0.5, 1.0, 1.5, 2.0]:\n    for lapse in [0.05, 0.1, 0.15, 0.2]:\n        ll = 0.0\n        for ctx, choice in zip(trials.contexts, trials.choices):\n            n_obj = len(ctx.objects)\n            if ctx.utterance is None:\n                p = np.full(n_obj, 1.0 / n_obj)\n            else:\n                lex = ctx.lexicon()\n                u = ctx.present_features.index(ctx.utterance)\n                # match: lex[u, :]\n                fc = np.array([sum(obj) for obj in ctx.objects])\n                w = lex[u, :] * np.exp(-beta * fc)\n                if w.sum() == 0:\n                    p = np.full(n_obj, 1.0 / n_obj)\n                else:\n                    p = w / w.sum()\n            p_lapsed = (1 - lapse) * p + lapse / n_obj\n            ll += np.log(p_lapsed[choice])\n        if ll > best_ll:\n            best_ll = ll\n            best_beta, best_lapse = beta, lapse\n\nprint(f'Direct contrast best LL: {best_ll:.1f} at beta={best_beta}, lapse={best_lapse}')\n\"","time":{"start":1791357560401,"end":1791357565674}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1153b263f001Q2Ams0o0qs6Wbb","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_1153b0883001LlxPp0jGcYLYai"}}
