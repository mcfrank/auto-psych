{"type":"step_start","timestamp":1791357648982,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"id":"prt_1153c801a001xX3OON5tDKjbAy","messageID":"msg_1153c5d460013HNMvBrU3wsDju","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","type":"step-start"}}
{"type":"tool_use","timestamp":1791357656189,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"bash","callID":"UEqaiNZAEYYRW7OA","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport numpy as np\nfrom src.rsa.loop.novelty import novelty_pool\nfrom src.rsa.context import group_by_shape\n\npool = novelty_pool()\n# Check how many valence contexts are in the pool\nval_contexts = [c for c in pool if c.valence != 0]\nprint(f'Total pool: {len(pool)}, valence != 0: {len(val_contexts)}')\n\n# Let's see what rsa_l1 predicts vs what evaluative rsa predicts on pool\n# In rsa_l1, prior is uniform on all trials.\n# In evaluative rsa, prior is softmax(w_val * valence * fc).\n# Let's calculate the RMSE over the pool for w_val = 1.5, alpha = 1.5\ndiffs = []\nfor c in pool:\n    n_obj, n_utt = c.shape\n    fc = np.array([sum(obj) for obj in c.objects])\n    # rsa_l1 prior: uniform\n    prior_l1 = np.full(n_obj, 1.0 / n_obj)\n    # eval prior:\n    prior_logits = 1.5 * c.valence * fc\n    prior_eval = np.exp(prior_logits - np.max(prior_logits))\n    prior_eval = prior_eval / prior_eval.sum()\n    \n    if c.utterance is None:\n        p_l1 = prior_l1\n        p_eval = prior_eval\n    else:\n        lex = c.lexicon()\n        u = c.present_features.index(c.utterance)\n        l0 = lex / np.maximum(lex.sum(axis=1, keepdims=True), 1e-10)\n        s1_util = lex * np.exp(1.5 * np.log(l0 + 1e-10))\n        s1 = s1_util / np.maximum(s1_util.sum(axis=0, keepdims=True), 1e-10)\n        \n        p_l1 = s1[u, :] / np.maximum(s1[u, :].sum(), 1e-10)\n        p_eval = (s1[u, :] * prior_eval) / np.maximum((s1[u, :] * prior_eval).sum(), 1e-10)\n    \n    # compare class probs (identical objects summed)\n    classes = c.choice_classes()\n    p_l1_c = np.array([p_l1[classes == k].sum() for k in range(max(classes)+1)])\n    p_eval_c = np.array([p_eval[classes == k].sum() for k in range(max(classes)+1)])\n    diffs.extend((p_l1_c - p_eval_c)**2)\n\nrmse = np.sqrt(np.mean(diffs))\nprint(f'RMSE against rsa_l1 over pool: {rmse:.4f}')\n\""},"output":"Total pool: 1258, valence != 0: 116\nRMSE against rsa_l1 over pool: 0.0000\n","metadata":{"output":"Total pool: 1258, valence != 0: 116\nRMSE against rsa_l1 over pool: 0.0000\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport numpy as np\nfrom src.rsa.loop.novelty import novelty_pool\nfrom src.rsa.context import group_by_shape\n\npool = novelty_pool()\n# Check how many valence contexts are in the pool\nval_contexts = [c for c in pool if c.valence != 0]\nprint(f'Total pool: {len(pool)}, valence != 0: {len(val_contexts)}')\n\n# Let's see what rsa_l1 predicts vs what evaluative rsa predicts on pool\n# In rsa_l1, prior is uniform on all trials.\n# In evaluative rsa, prior is softmax(w_val * valence * fc).\n# Let's calculate the RMSE over the pool for w_val = 1.5, alpha = 1.5\ndiffs = []\nfor c in pool:\n    n_obj, n_utt = c.shape\n    fc = np.array([sum(obj) for obj in c.objects])\n    # rsa_l1 prior: uniform\n    prior_l1 = np.full(n_obj, 1.0 / n_obj)\n    # eval prior:\n    prior_logits = 1.5 * c.valence * fc\n    prior_eval = np.exp(prior_logits - np.max(prior_logits))\n    prior_eval = prior_eval / prior_eval.sum()\n    \n    if c.utterance is None:\n        p_l1 = prior_l1\n        p_eval = prior_eval\n    else:\n        lex = c.lexicon()\n        u = c.present_features.index(c.utterance)\n        l0 = lex / np.maximum(lex.sum(axis=1, keepdims=True), 1e-10)\n        s1_util = lex * np.exp(1.5 * np.log(l0 + 1e-10))\n        s1 = s1_util / np.maximum(s1_util.sum(axis=0, keepdims=True), 1e-10)\n        \n        p_l1 = s1[u, :] / np.maximum(s1[u, :].sum(), 1e-10)\n        p_eval = (s1[u, :] * prior_eval) / np.maximum((s1[u, :] * prior_eval).sum(), 1e-10)\n    \n    # compare class probs (identical objects summed)\n    classes = c.choice_classes()\n    p_l1_c = np.array([p_l1[classes == k].sum() for k in rang