{"type":"tool_use","timestamp":1791357464969,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"Rqpt9q0pOcsGgA3Z","state":{"status":"completed","input":{"offset":101,"limit":50,"filePath":"/home/user/auto-psych/tests/test_rsa_model_file.py"},"output":"<path>/home/user/auto-psych/tests/test_rsa_model_file.py</path>\n<type>file</type>\n<content>\n101:     return %s\n102: \"\"\"\n103: \n104: \n105: def write_model(tmp_path, body, name=\"m\"):\n106:     path = tmp_path / f\"{name}.py\"\n107:     path.write_text(textwrap.dedent(body))\n108:     return RSAModel(path)\n109: \n110: \n111: def groups():\n112:     return group_by_shape([Context(**SIMPLE, utterance=1)])\n113: \n114: \n115: def test_a_well_formed_model_passes(tmp_path):\n116:     check_contract(write_model(tmp_path, GOOD_BODY % 'with_lapse(p, params[\"lapse\"])'), groups())\n117: \n118: \n119: @pytest.mark.parametrize(\n120:     \"returned, message\",\n121:     [\n122:         (\"p[:2]\", \"shape\"),\n123:         (\"2.0 * p\", \"sum to 1\"),\n124:         (\"p + 0.6 * (jnp.arange(3) == 0) - 0.6 * (jnp.arange(3) == 2)\", \"negative\"),\n125:         (\"p * jnp.nan\", \"finite\"),\n126:         ('jnp.sqrt(params[\"lapse\"] - params[\"lapse\"]) + p', \"gradient\"),\n127:     ],\n128: )\n129: def test_contract_violations_raise(tmp_path, returned, message):\n130:     with pytest.raises(ModelContractViolation, match=message):\n131:         check_contract(write_model(tmp_path, GOOD_BODY % returned), groups())\n132: \n133: \n134: def test_a_model_may_not_define_the_injected_domains(tmp_path):\n135:     body = GOOD_BODY.replace(\"PARAMS =\", \"OBJ = jnp.arange(3)\\nPARAMS =\") % \"p\"\n136:     with pytest.raises(ModelContractViolation, match=\"OBJ\"):\n137:         write_model(tmp_path, body)\n138: \n139: \n140: def test_a_model_needs_params_and_choice_probs(tmp_path):\n141:     with pytest.raises(ModelContractViolation, match=\"PARAMS\"):\n142:         check_contract(\n143:             write_model(tmp_path, (GOOD_BODY % \"p\").replace(\"PARAMS =\", \"_P =\")), groups()\n144:         )\n145:     with pytest.raises(ModelContractViolation, match=\"choice_probs\"):\n146:         check_contract(\n147:             write_model(tmp_path, (GOOD_BODY % \"p\").replace(\"def choice_probs\", \"def other\")),\n148:             groups(),\n149:         )\n\n(End of file - total 149 lines)\n</content>","metadata":{"preview":"    return %s\n\"\"\"\n\n\ndef write_model(tmp_path, body, name=\"m\"):\n    path = tmp_path / f\"{name}.py\"\n    path.write_text(textwrap.dedent(body))\n    return RSAModel(path)\n\n\ndef groups():\n    return group_by_shape([Context(**SIMPLE, utterance=1)])\n\n\ndef test_a_well_formed_model_passes(tmp_path):\n    check_contract(write_model(tmp_path, GOOD_BODY % 'with_lapse(p, params[\"lapse\"])'), groups())\n\n\n@pytest.mark.parametrize(\n    \"returned, message\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/tests/test_rsa_model_file.py","text":"    return %s\n\"\"\"\n\n\ndef write_model(tmp_path, body, name=\"m\"):\n    path = tmp_path / f\"{name}.py\"\n    path.write_text(textwrap.dedent(body))\n    return RSAModel(path)\n\n\ndef groups():\n    return group_by_shape([Context(**SIMPLE, utterance=1)])\n\n\ndef test_a_well_formed_model_passes(tmp_path):\n    check_contract(write_model(tmp_path, GOOD_BODY % 'with_lapse(p, params[\"lapse\"])'), groups())\n\n\n@pytest.mark.parametrize(\n    \"returned, message\",\n    [\n        (\"p[:2]\", \"shape\"),\n        (\"2.0 * p\", \"sum to 1\"),\n        (\"p + 0.6 * (jnp.arange(3) == 0) - 0.6 * (jnp.arange(3) == 2)\", \"negative\"),\n        (\"p * jnp.nan\", \"finite\"),\n        ('jnp.sqrt(params[\"lapse\"] - params[\"lapse\"]) + p', \"gradient\"),\n    ],\n)\ndef test_contract_violations_raise(tmp_path, returned, message):\n    with pytest.raises(ModelContractViolation, match=message):\n        check_contract(write_model(tmp_path, GOOD_BODY % returned), groups())\n\n\ndef test_a_model_may_not_define_the_injected_domains(tmp_path):\n    body = GOOD_BODY.replace(\"PARAMS =\", \"OBJ = jnp.arange(3)\\nPARAMS =\") % \"p\"\n    with pytest.raises(ModelContractViolation, match=\"OBJ\"):\n        write_model(tmp_path, body)\n\n\ndef test_a_model_needs_params_and_choice_probs(tmp_path):\n    with pytest.raises(ModelContractViolation, match=\"PARAMS\"):\n        check_contract(\n            write_model(tmp_path, (GOOD_BODY % \"p\").replace(\"PARAMS =\", \"_P =\")), groups()\n        )\n    with pytest.raises(ModelContractViolation, match=\"choice_probs\"):\n        check_contract(\n            write_model(tmp_path, (GOOD_BODY % \"p\").replace(\"def choice_probs\", \"def other\")),\n            groups(),\n        )","lineStart":101,"lineEnd":149,"totalLines":149,"truncated":false}},"title":"tests/test_rsa_model_file.py","time":{"start":1791357464911,"end":1791357464933}},"metadata":{"google":{"thoughtSignature":"ErABCq0BAWkUfRMXKdPs66EOSlYXOUzWixcx9w6Ejw6Y6G7yZ9Q7BlsrjPUAvXF0moJ/hTaEtC58dnz456vrTy7bAE14HoyQAGVRUPjThIedtOSiLxGeaGbt7bNTDlobhE3FqmAaZhC8aIkgxllOaUd5yG/uos+QO+CRwXiLFvEKFgtLsKgL+3s5rYm8xpciV5oxUOjgh7cbphEE8/qHZe5rajZC/VbCPDxhlSt5BR+rUoM="}},"id":"prt_11539b143001CQdfRqys0qIzbH","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11539a531001ATC7040udEPxpr"}}
{"type":"step_finish","timestamp":1791357464970,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"id":"prt_11539b16b001hWm24SoswS7suF","reason":"tool-calls","messageID":"msg_11539a531001ATC7040udEPxpr","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","type":"step-finish","tokens":{"total":93363,"input":4904,"output":44,"reasoning":20,"cache":{"write":0,"read":88395}},"cost":0.010547625}}
{"type":"step_start","timestamp":1791357466960,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"id":"prt_11539b930001MM83fKaFzUqWzy","messageID":"msg_11539b17e001ZRz34a56KbsbJt","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","type":"step-start"}}
{"type":"tool_use","timestamp":1791357467106,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"jVrFSr6mcht9FH42","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/loop/brief.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/brief.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Candidate briefs and prompts for the RSA loop's agents.\n2: \n3: Every slot gets the same documents as the PyMC domain's loop (CONTEXT.md,\n4: CANDIDATE_BRIEF.md, existing_hypotheses.md, and attempted_hypotheses.md for\n5: an exploratory slot or refinement_menu.md for a refinement slot), written\n6: into its candidate directory and inlined into its prompt, plus the memo\n7: Handbook. Slot roles and the lens walk are the PyMC loop's\n8: (`src.pipelines.inner_loop.model_zoo.slot_roles`).\n9: \"\"\"\n10: \n11: from __future__ import annotations\n12: \n13: import sys\n14: from dataclasses import dataclass\n15: from pathlib import Path\n16: from typing import Dict, List, Mapping, Optional, Sequence\n17: \n18: from src.pipelines.inner_loop.hypothesis_ledger import HypothesisLedger\n19: from src.pipelines.inner_loop.model_zoo import (\n20:     SLOT_EXPLORE,\n21:     SLOT_REFINE_CHOSEN,\n22:     SLOT_REFINE_INCUMBENT,\n23: )\n24: \n25: PROMPTS = Path(__file__).with_name(\"prompts\")\n26: THEORY_PROMPT = PROMPTS / \"rsa_theory.md\"\n27: HANDBOOK = PROMPTS / \"memo_handbook.md\"\n28: \n29: # The exploration lenses, walked by exploratory slots (one per slot).\n30: DEFAULT_RSA_LENSES = [\n31:     \"Propose a mechanism from a genuinely different family than anything in \"\n32:     \"the current set: one the current models cannot express, not a variant.\",\n33:     \"Propose a single mechanism whose predictions would disagree most sharply \"\n34:     \"with the current best model on some display, and say in your hypothesis \"\n35:     \"which display and why.\",\n36:     \"Model the speaker's costs or alternatives: which words a speaker would \"\n37:     \"consider, how costly each is, or what a speaker who cannot name something \"\n38:     \"does, and let the listener reason about that speaker.\",\n39:     \"Model what the listener expects before hearing anything: a prior over \"\n40:     \"objects grounded in a psychological account (salience, typicality, what \"\n41:     \"the speaker is likely to talk about), used in a principled place.\",\n42:     \"Propose a resource-limited listener: a bounded reasoning depth, an \"\n43:     \"approximate or sampled inference, or limited attention to the display, \"\n44:     \"as the single mechanism.\",\n45:     \"Propose that the meaning of the words is uncertain or soft: lexical \"\n46:     \"uncertainty, graded or noisy truth values, or a listener who is unsure \"\n47:     \"which feature a word picks out.\",\n48:     \"Explain the framing manipulations: why describing a 'favorite' or 'least \"\n49:     \"favorite' object, or showing one object in colour, changes the choice, \"\n50:     \"with one mechanism that also covers the neutral trials.\",\n51:     \"Propose a non-Bayesian heuristic listener (e.g. pick the object with the \"\n52:     \"fewest features the word is true of, or the most distinctive one) that \"\n53:     \"is simple and could be wrong loudly.\",\n54:     \"Propose a mechanism at the level of the decision rule: how people turn \"\n55:     \"beliefs into a click (probability matching, a softmax over beliefs, a \"\n56:     \"structured lapse), with the inference itself kept simple.\",\n57:     \"Model the speaker's goal or question under discussion: the speaker is \"\n58:     \"informative about some aspect of the object rather than its identity, \"\n59:     \"and the listener reasons about that goal.\",\n60:     \"Propose that listeners differ: a mixture of a small number of listener \"\n61:     \"types (e.g. literal and pragmatic) as ONE hypothesis about population \"\n62:     \"structure, with the type proportions as parameters.\",\n63: ]\n64: \n65: # The harness's own interpreter, as in the PyMC loop: sandboxed agents have no\n66: # `uv` (it lives in ~/.local/bin, which the private home hides) and `uv run`\n67: # would sync the read-only venv; the 2026-10-07 smoke test found the `uv run`\n68: # form unrunnable in the sandbox.\n69: CHECK_COMMAND = sys.executable + \" -m src.rsa.loop.check_candidate {candidate_dir} --responses {responses}\"\n70: # The shell timeout agents must give the self-check: its fit may take up to\n71: # CHECK_TIME_LIMIT_SEC (10 min) after loading and the contract. opencode's\n72: # shell tool kills a command after 120 s by default, which in the 2026-10-06\n73: # smoke test killed every self-check before it printed anything.\n74: CHECK_SHELL_TIMEOUT_MS = 900_000\n75: \n76: \n77: @dataclass\n78: class ZooModel:\n79:     name: str\n80:     hypothesis: str\n81:     source: Path\n82:     standing: str  # e.g. \"best\" or \"12.3 ± 4.0 nats behind the best\"\n83: \n84: \n85: def context_md(*, candidate_dir: Path, responses_path: Path, round_index: int,\n86:                n_rounds: int, n_trials: int, experiments: Sequence[str]) -> str:\n87:     return f\"\"\"# Context\n88: \n89: - Candidate directory (write your three files here): `{candidate_dir}`\n90: - Responses (read-only): `{responses_path}`: {n_trials} forced-choice trials,\n91:   one row per click, from experiments {\", \".join(experiments)}. Columns\n92:   include `experiment`, `condition`, `objects` (JSON list of 0/1 feature\n93:   lists, one per object), `feature_names`, `query` (`utterance` or\n94:   `prior`), `utterance` (feature index heard), `familiarization`,\n95:   `grayscale`, `framing`, `choice` (object index clicked), `participant_id`\n96:   and `trial_index`. You may analyse it (e.g. with pandas, from the shell) to\n97:   find what the current models miss; your model file may not read it.\n98: - Inner-loop round {round_index + 1} of {n_rounds}.\n99: - Self-check: `{CHECK_COMMAND.format(candidate_dir=candidate_dir, responses=responses_path)}`\n100:   It takes 2-10 minutes (it compiles and fits your model). Give the shell\n101:   tool a timeout of {CHECK_SHELL_TIMEOUT_MS} milliseconds for it (the tool's\n102:   `timeout` parameter); with the default of 120 s the check is killed before it\n103:   prints anything. Run it once and read its result; do not re-run it unchanged.\n104: - Write and test your files **in your candidate directory only**: no drafts in\n105:   `/tmp`, the repository root or anywhere else. The loop reads only\n106:   `{candidate_dir}`; a candidate.py anywhere else counts as no candidate.\n107: \"\"\"\n108: \n109: \n110: def existing_md(models: Sequence[ZooModel]) -> str:\n111:     lines = [\"# Models in the set\", \"\"]\n112:     for m in models:\n113:         lines += [f\"## {m.name} ({m.standing})\", \"\", m.hypothesis.strip(), \"\", f\"Source: `{m.source}`\", \"\"]\n114:     return \"\\n\".join(lines)\n115: \n116: \n117: def menu_md(live: Sequence[ZooModel], pruned: Sequence[ZooModel], incumbent: str) -> str:\n118:     lines = [\n119:         \"# Refinement menu\",\n120:         \"\",\n121:         \"Choose ONE model to refine (not the incumbent). Your hypothesis must name it \"\n122:         \"and state the single change you make. Live models first, then models pruned \"\n123:         \"earlier (a pruned mechanism may come back with a substantive change).\",\n124:         \"\",\n125:     ]\n126:     for m in [x for x in live if x.name != incumbent] + list(pruned):\n127:         lines += [f\"## {m.name} ({m.standing})\", \"\", m.hypothesis.strip(), \"\", f\"Source: `{m.source}`\", \"\"]\n128:     return \"\\n\".join(lines)\n129: \n130: \n131: def brief_md(role: str, *, lens: Optional[str], incumbent: Optional[ZooModel]) -> str:\n132:     if role == SLOT_EXPLORE:\n133:         return (\n134:             \"# This slot: exploratory\\n\\n\"\n135:             \"Propose a NEW mechanism, not a refinement of a model in the set and not \"\n136:             \"anything in attempted_hypotheses.md.\\n\\n\"\n137:             f\"Lens for this slot: {lens}\\n\"\n138:         )\n139:     if role == SLOT_REFINE_INCUMBENT:\n140:         assert incumbent is not None\n141:         return (\n142:             \"# This slot: refine the incumbent\\n\\n\"\n143:             f\"Improve the current best model, **{incumbent.name}** ({incumbent.standing}), \"\n144:             \"with ONE stated change to its mechanism (a different functional form, prior, \"\n145:             \"depth, or one component taken from another model). Your hypothesis must say \"\n146:             \"what you changed and why it should fit better.\\n\\n\"\n147:             f\"Its hypothesis: {incumbent.hypothesis.strip()}\\n\\nIts source: `{incumbent.source}`\\n\"\n148:         )\n149:     if role == SLOT_REFINE_CHOSEN:\n150:         return (\n151:             \"# This slot: refine a model of your choice\\n\\n\"\n152:             \"Pick one model from refinement_menu.md (any but the incumbent\"\n153:             + (f\", {incumbent.name}\" if incumbent else \"\")\n154:             + \") and improve it with ONE stated change. Name the model you refine in your \"\n155:             \"hypothesis.\\n\"\n156:         )\n157:     raise ValueError(f\"unknown slot role {role!r}\")\n158: \n159: \n160: def write_docs(\n161:     candidate_dir: Path,\n162:     *,\n163:     role: str,\n164:     lens: Optional[str],\n165:     context: str,\n166:     live: Sequence[ZooModel],\n167:     pruned: Sequence[ZooModel],\n168:     incumbent: Optional[str],\n169:     ledger: HypothesisLedger,\n170:     attempt_note: Optional[str] = None,\n171: ) -> Dict[str, Optional[str]]:\n172:     candidate_dir.mkdir(parents=True, exist_ok=True)\n173:     inc = next((m for m in live if m.name == incumbent), None)\n174:     docs: Dict[str, Optional[str]] = {\n175:         \"context\": context,\n176:         \"brief\": brief_md(role, lens=lens, incumbent=inc),\n177:         \"existing_hypotheses\": existing_md(live),\n178:         \"attempted\": ledger.render_markdown([m.name for m in live]) if role == SLOT_EXPLORE else None,\n179:         \"menu\": menu_md(live, pruned, incumbent or \"\") if role == SLOT_REFINE_CHOSEN else None,\n180:         \"attempt_note\": attempt_note,\n181:     }\n182:     files = {\n183:         \"CONTEXT.md\": \"context\", \"CANDIDATE_BRIEF.md\": \"brief\",\n184:         \"existing_hypotheses.md\": \"existing_hypotheses\", \"attempted_hypotheses.md\": \"attempted\",\n185:         \"refinement_menu.md\": \"menu\",\n186:     }\n187:     for fname, key in files.items():\n188:         if docs[key]:\n189:             (candidate_dir / fname).write_text(docs[key], encoding=\"utf-8\")\n190:     (candidate_dir / \"memo_handbook.md\").write_text(HANDBOOK.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\n191:     return docs\n192: \n193: \n194: def build_prompt(candidate_dir: Path, docs: Mapping[str, Optional[str]]) -> str:\n195:     sections: List[str] = [\n196:         THEORY_PROMPT.read_text(encoding=\"utf-8\"),\n197:         \"---\",\n198:         f\"Your working directory for this candidate is `{candidate_dir}`.\\n\"\n199:         \"Write `hypothesis.md`, `model_name.txt` and `candidate.py` there. Your shell \"\n200:         \"runs from the repository root, NOT the candidate directory, so always write \"\n201:         \"to the absolute paths:\\n\"\n202:         f\"  {candidate_dir}/hypothesis.md\\n  {candidate_dir}/model_name.txt\\n\"\n203:         f\"  {candidate_dir}/candidate.py\\n\\n\"\n204:         \"Use the bash tool with a heredoc to create each file, e.g.\\n\"\n205:         f\"```bash\\ncat << 'EOF' > {candidate_dir}/hypothesis.md\\nYour hypothesis.\\nEOF\\n```\\n\"\n206:         \"Then run the self-check in CONTEXT.md and fix what it reports.\",\n207:     ]\n208:     if docs.get(\"attempt_note\"):\n209:         sections.append(str(docs[\"attempt_note\"]))\n210:     sections += [\n211:         f\"## CONTEXT.md\\n\\n{docs['context']}\",\n212:         f\"## CANDIDATE_BRIEF.md\\n\\n{docs['brief']}\",\n213:         f\"## existing_hypotheses.md\\n\\n{docs['existing_hypotheses']}\",\n214:     ]\n215:     if docs.get(\"attempted\"):\n216:         sections.append(f\"## attempted_hypotheses.md\\n\\n{docs['attempted']}\")\n217:     if docs.get(\"menu\"):\n218:         sections.append(f\"## refinement_menu.md\\n\\n{docs['menu']}\")\n219:     sections.append(f\"## memo_handbook.md\\n\\n{HANDBOOK.read_text(encoding='utf-8')}\")\n220:     return \"\\n\\n\".join(sections) + \"\\n\"\n221: \n222: \n223: def repair_note(reason: str) -> str:\n224:     return (\n225:         \"## REPAIR: your previous attempt was rejected\\n\\n\"\n226:         \"Your files from the previous attempt are in this directory. The pipeline \"\n227:         f\"rejected them for this reason:\\n\\n> {reason}\\n\\n\"\n228:         \"Fix exactly that (keep the hypothesis unless the reason shows it cannot work), \"\n229:         \"run the self-check, and write the corrected files. This is the final attempt.\"\n230:     )\n231: \n232: \n233: def retry_note() -> str:\n234:     return (\n235:         \"## RETRY: the previous attempt wrote no candidate.py\\n\\n\"\n236:         \"Write all three files to the absolute paths above this time.\"\n237:     )\n\n(End of file - total 237 lines)\n</content>","metadata":{"preview":"\"\"\"Candidate briefs and prompts for the RSA loop's agents.\n\nEvery slot gets the same documents as the PyMC domain's loop (CONTEXT.md,\nCANDIDATE_BRIEF.md, existing_hypotheses.md, and attempted_hypotheses.md for\nan exploratory slot or refinement_menu.md for a refinement slot), written\ninto its candidate directory and inlined into its prompt, plus the memo\nHandbook. Slot roles and the lens walk are the PyMC loop's\n(`src.pipelines.inner_loop.model_zoo.slot_roles`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Dict, List, Mapping, Optional, Sequence\n\nfrom src.pipelines.inner_loop.hypothesis_ledger import HypothesisLedger\nfrom src.pipelines.inner_loop.model_zoo import (\n    SLOT_EXPLORE,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/brief.py","text":"\"\"\"Candidate briefs and prompts for the RSA loop's agents.\n\nEvery slot gets the same documents as the PyMC domain's loop (CONTEXT.md,\nCANDIDATE_BRIEF.md, existing_hypotheses.md, and attempted_hypotheses.md for\nan exploratory slot or refinement_menu.md for a refinement slot), written\ninto its candidate directory and inlined into its prompt, plus the memo\nHandbook. Slot roles and the lens walk are the PyMC loop's\n(`src.pipelines.inner_loop.model_zoo.slot_roles`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Dict, List, Mapping, Optional, Sequence\n\nfrom src.pipelines.inner_loop.hypothesis_ledger import HypothesisLedger\nfrom src.pipelines.inner_loop.model_zoo import (\n    SLOT_EXPLORE,\n    SLOT_REFINE_CHOSEN,\n    SLOT_REFINE_INCUMBENT,\n)\n\nPROMPTS = Path(__file__).with_name(\"prompts\")\nTHEORY_PROMPT = PROMPTS / \"rsa_theory.md\"\nHANDBOOK = PROMPTS / \"memo_handbook.md\"\n\n# The exploration lenses, walked by exploratory slots (one per slot).\nDEFAULT_RSA_LENSES = [\n    \"Propose a mechanism from a genuinely different family than anything in \"\n    \"the current set: one the current models cannot express, not a variant.\",\n    \"Propose a single mechanism whose predictions would disagree most sharply \"\n    \"with the current best model on some display, and say in your hypothesis \"\n    \"which display and why.\",\n    \"Model the speaker's costs or alternatives: which words a speaker would \"\n    \"consider, how costly each is, or what a speaker who cannot name something \"\n    \"does, and let the listener reason about that speaker.\",\n    \"Model what the listener expects before hearing anything: a prior over \"\n    \"objects grounded in a psychological account (salience, typicality, what \"\n    \"the speaker is likely to talk about), used in a principled place.\",\n    \"Propose a resource-limited listener: a bounded reasoning depth, an \"\n    \"approximate or sampled inference, or limited attention to the display, \"\n    \"as the single mechanism.\",\n    \"Propose that the meaning of the words is uncertain or soft: lexical \"\n    \"uncertainty, graded or noisy truth values, or a listener who is unsure \"\n    \"which feature a word picks out.\",\n    \"Explain the framing manipulations: why describing a 'favorite' or 'least \"\n    \"favorite' object, or showing one object in colour, changes the choice, \"\n    \"with one mechanism that also covers the neutral trials.\",\n    \"Propose a non-Bayesian heuristic listener (e.g. pick the object with the \"\n    \"fewest features the word is true of, or the most distinctive one) that \"\n    \"is simple and could be wrong loudly.\",\n    \"Propose a mechanism at the level of the decision rule: how people turn \"\n    \"beliefs into a click (probability matching, a softmax over beliefs, a \"\n    \"structured lapse), with the inference itself kept simple.\",\n    \"Model the speaker's goal or question under discussion: the speaker is \"\n    \"informative about some aspect of the object rather than its identity, \"\n    \"and the listener reasons about that goal.\",\n    \"Propose that listeners differ: a mixture of a small number of listener \"\n    \"types (e.g. literal and pragmatic) as ONE hypothesis about population \"\n    \"structure, with the type proportions as parameters.\",\n]\n\n# The harness's own interpreter, as in the PyMC loop: sandboxed agents have no\n# `uv` (it lives in ~/.local/bin, which the private home hides) and `uv run`\n# would sync the read-only venv; the 2026-10-07 smoke test found the `uv run`\n# form unrunnable in the sandbox.\nCHECK_COMMAND = sys.executable + \" -m src.rsa.loop.check_candidate {candidate_dir} --responses {responses}\"\n# The shell timeout agents must give the self-check: its fit may take up to\n# CHECK_TIME_LIMIT_SEC (10 min) after loading and the contract. opencode's\n# shell tool kills a command after 120 s by default, which in the 2026-10-06\n# smoke test killed every self-check before it printed anything.\nCHECK_SHELL_TIMEOUT_MS = 900_000\n\n\n@dataclass\nclass ZooModel:\n    name: str\n    hypothesis: str\n    source: Path\n    standing: str  # e.g. \"best\" or \"12.3 ± 4.0 nats behind the best\"\n\n\ndef context_md(*, candidate_dir: Path, responses_path: Path, round_index: int,\n               n_rounds: int, n_trials: int, experiments: Sequence[str]) -> str:\n    return f\"\"\"# Context\n\n- Candidate directory (write your three files here): `{candidate_dir}`\n- Responses (read-only): `{responses_path}`: {n_trials} forced-choice trials,\n  one row per click, from experiments {\", \".join(experiments)}. Columns\n  include `experiment`, `condition`, `objects` (JSON list of 0/1 feature\n  lists, one per object), `feature_names`, `query` (`utterance` or\n  `prior`), `utterance` (feature index heard), `familiarization`,\n  `grayscale`, `framing`, `choice` (object index clicked), `participant_id`\n  and `trial_index`. You may analyse it (e.g. with pandas, from the shell) to\n  find what the current models miss; your model file may not read it.\n- Inner-loop round {round_index + 1} of {n_rounds}.\n- Self-check: `{CHECK_COMMAND.format(candidate_dir=candidate_dir, responses=responses_path)}`\n  It takes 2-10 minutes (it compiles and fits your model). Give the shell\n  tool a timeout of {CHECK_SHELL_TIMEOUT_MS} milliseconds for it (the tool's\n  `timeout` parameter); with the default of 120 s the check is killed before it\n  prints anything. Run it once and read its result; do not re-run it unchanged.\n- Write and test your files **in your candidate directory only**: no drafts in\n  `/tmp`, the repository root or anywhere else. The loop reads only\n  `{candidate_dir}`; a candidate.py anywhere else counts as no candidate.\n\"\"\"\n\n\ndef existing_md(models: Sequence[ZooModel]) -> str:\n    lines = [\"# Models in the set\", \"\"]\n    for m in models:\n        lines += [f\"## {m.name} ({m.standing})\", \"\", m.hypothesis.strip(), \"\", f\"Source: `{m.source}`\", \"\"]\n    return \"\\n\".join(lines)\n\n\ndef menu_md(live: Sequence[ZooModel], pruned: Sequence[ZooModel], incumbent: str) -> str:\n    lines = [\n        \"# Refinement menu\",\n        \"\",\n        \"Choose ONE model to refine (not the incumbent). Your hypothesis must name it \"\n        \"and state the single change you make. Live models first, then models pruned \"\n        \"earlier (a pruned mechanism may come back with a substantive change).\",\n        \"\",\n    ]\n    for m in [x for x in live if x.name != incumbent] + list(pruned):\n        lines += [f\"## {m.name} ({m.standing})\", \"\", m.hypothesis.strip(), \"\", f\"Source: `{m.source}`\", \"\"]\n    return \"\\n\".join(lines)\n\n\ndef brief_md(role: str, *, lens: Optional[str], incumbent: Optional[ZooModel]) -> str:\n    if role == SLOT_EXPLORE:\n        return (\n            \"# This slot: exploratory\\n\\n\"\n            \"Propose a NEW mechanism, not a refinement of a model in the set and not \"\n            \"anything in attempted_hypotheses.md.\\n\\n\"\n            f\"Lens for this slot: {lens}\\n\"\n        )\n    if role == SLOT_REFINE_INCUMBENT:\n        assert incumbent is not None\n        return (\n            \"# This slot: refine the incumbent\\n\\n\"\n            f\"Improve the current best model, **{incumbent.name}** ({incumbent.standing}), \"\n            \"with ONE stated change to its mechanism (a different functional form, prior, \"\n            \"depth, or one component taken from another model). Your hypothesis must say \"\n            \"what you changed and why it should fit better.\\n\\n\"\n            f\"Its hypothesis: {incumbent.hypothesis.strip()}\\n\\nIts source: `{incumbent.source}`\\n\"\n        )\n    if role == SLOT_REFINE_CHOSEN:\n        return (\n            \"# This slot: refine a model of your choice\\n\\n\"\n            \"Pick one model from refinement_menu.md (any but the incumbent\"\n            + (f\", {incumbent.name}\" if incumbent else \"\")\n            + \") and improve it with ONE stated change. Name the model you refine in your \"\n            \"hypothesis.\\n\"\n        )\n    raise ValueError(f\"unknown slot role {role!r}\")\n\n\ndef write_docs(\n    candidate_dir: Path,\n    *,\n    role: str,\n    lens: Optional[str],\n    context: str,\n    live: Sequence[ZooModel],\n    pruned: Sequence[ZooModel],\n    incumbent: Optional[str],\n    ledger: HypothesisLedger,\n    attempt_note: Optional[str] = None,\n) -> Dict[str, Optional[str]]:\n    candidate_dir.mkdir(parents=True, exist_ok=True)\n    inc = next((m for m in live if m.name == incumbent), None)\n    docs: Dict[str, Optional[str]] = {\n        \"context\": context,\n        \"brief\": brief_md(role, lens=lens, incumbent=inc),\n        \"existing_hypotheses\": existing_md(live),\n        \"attempted\": ledger.render_markdown([m.name for m in live]) if role == SLOT_EXPLORE else None,\n        \"menu\": menu_md(live, pruned, incumbent or \"\") if role == SLOT_REFINE_CHOSEN else None,\n        \"attempt_note\": attempt_note,\n    }\n    files = {\n        \"CONTEXT.md\": \"context\", \"CANDIDATE_BRIEF.md\": \"brief\",\n        \"existing_hypotheses.md\": \"existing_hypotheses\", \"attempted_hypotheses.md\": \"attempted\",\n        \"refinement_menu.md\": \"menu\",\n    }\n    for fname, key in files.items():\n        if docs[key]:\n            (candidate_dir / fname).write_text(docs[key], encoding=\"utf-8\")\n    (candidate_dir / \"memo_handbook.md\").write_text(HANDBOOK.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\n    return docs\n\n\ndef build_prompt(candidate_dir: Path, docs: Mapping[str, Optional[str]]) -> str:\n    sections: List[str] = [\n        THEORY_PROMPT.read_text(encoding=\"utf-8\"),\n        \"---\",\n        f\"Your working directory for this candidate is `{candidate_dir}`.\\n\"\n        \"Write `hypothesis.md`, `model_name.txt` and `candidate.py` there. Your shell \"\n        \"runs from the repository root, NOT the candidate directory, so always write \"\n        \"to the absolute paths:\\n\"\n        f\"  {candidate_dir}/hypothesis.md\\n  {candidate_dir}/model_name.txt\\n\"\n        f\"  {candidate_dir}/candidate.py\\n\\n\"\n        \"Use the bash tool with a heredoc to create each file, e.g.\\n\"\n        f\"```bash\\ncat << 'EOF' > {candidate_dir}/hypothesis.md\\nYour hypothesis.\\nEOF\\n```\\n\"\n        \"Then run the self-check in CONTEXT.md and fix what it reports.\",\n    ]\n    if docs.get(\"attempt_note\"):\n        sections.append(str(docs[\"attempt_note\"]))\n    sections += [\n        f\"## CONTEXT.md\\n\\n{docs['context']}\",\n        f\"## CANDIDATE_BRIEF.md\\n\\n{docs['brief']}\",\n        f\"## existing_hypotheses.md\\n\\n{docs['existing_hypotheses']}\",\n    ]\n    if docs.get(\"attempted\"):\n        sections.append(f\"## attempted_hypotheses.md\\n\\n{docs['attempted']}\")\n    if docs.get(\"menu\"):\n        sections.append(f\"## refinement_menu.md\\n\\n{docs['menu']}\")\n    sections.append(f\"## memo_handbook.md\\n\\n{HANDBOOK.read_text(encoding='utf-8')}\")\n    return \"\\n\\n\".join(sections) + \"\\n\"\n\n\ndef repair_note(reason: str) -> str:\n    return (\n        \"## REPAIR: your previous attempt was rejected\\n\\n\"\n        \"Your files from the previous attempt are in this directory. The pipeline \"\n        f\"rejected them for this reason:\\n\\n> {reason}\\n\\n\"\n        \"Fix exactly that (keep the hypothesis unless the reason shows it cannot work), \"\n        \"run the self-check, and write the corrected files. This is the final attempt.\"\n    )\n\n\ndef retry_note() -> str:\n    return (\n        \"## RETRY: the previous attempt wrote no candidate.py\\n\\n\"\n        \"Write all three files to the absolute paths above this time.\"\n    )","lineStart":1,"lineEnd":237,"totalLines":237,"truncated":false}},"title":"src/rsa/loop/brief.py","time":{"start":1791357466953,"end":1791357467071}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11539b935001tti0omX2vEtWXJ","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11539b17e001ZRz34a56KbsbJt"}}
