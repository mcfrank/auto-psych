{"type":"tool_use","timestamp":1791357611408,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"bash","callID":"uMpIYTI9q5FZYsMD","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport numpy as np\nfrom src.rsa.dataset import load_forced_choice\ntrials = load_forced_choice('data/rsa/loop_smoke2_repair/responses.csv')\n\n# rsa_l1_salience has w_features, w_familiar\n# Let's test w_features=0.5, w_familiar=1.0, alpha=1.5, lapse=0.1\nfor w_feat in [0.0, 0.4, 0.8]:\n    for w_fam in [0.0, 1.0, 2.0]:\n        ll = 0.0\n        alpha, lapse = 1.5, 0.1\n        for ctx, choice in zip(trials.contexts, trials.choices):\n            n_obj, n_utt = ctx.shape\n            fc = np.array([sum(obj) for obj in ctx.objects])\n            fam = np.zeros(n_obj) if ctx.familiarization is None else np.array(ctx.familiarization)\n            prior_logits = w_feat * fc + w_fam * fam\n            prior = np.exp(prior_logits - np.max(prior_logits))\n            prior = prior / prior.sum()\n            \n            if ctx.utterance is None:\n                p = prior\n            else:\n                lex = ctx.lexicon()\n                u = ctx.present_features.index(ctx.utterance)\n                l0 = lex / np.maximum(lex.sum(axis=1, keepdims=True), 1e-10)\n                s1_util = lex * np.exp(alpha * np.log(l0 + 1e-10))\n                s1 = s1_util / np.maximum(s1_util.sum(axis=0, keepdims=True), 1e-10)\n                l1 = (s1[u, :] * prior) / np.maximum((s1[u, :] * prior).sum(), 1e-10)\n                p = l1\n            p_lapsed = (1 - lapse) * p + lapse / n_obj\n            ll += np.log(p_lapsed[choice])\n        print(f'w_feat={w_feat}, w_fam={w_fam}: LL={ll:.1f}')\n\""},"output":"w_feat=0.0, w_fam=0.0: LL=-5200.6\nw_feat=0.0, w_fam=1.0: LL=-5173.6\nw_feat=0.0, w_fam=2.0: LL=-5168.6\nw_feat=0.4, w_fam=0.0: LL=-5234.4\nw_feat=0.4, w_fam=1.0: LL=-5215.5\nw_feat=0.4, w_fam=2.0: LL=-5219.4\nw_feat=0.8, w_fam