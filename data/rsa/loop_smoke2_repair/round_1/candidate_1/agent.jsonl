am}: LL={ll:.1f}')\n\"","time":{"start":1791357604845,"end":1791357611361}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1153bd3dd001OzYnvLaGL2l41s","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_1153b8bb50019QKuaur40ipxCL"}}
