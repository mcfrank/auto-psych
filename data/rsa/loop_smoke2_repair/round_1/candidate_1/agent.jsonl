{"type":"tool_use","timestamp":1791357278602,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"H3wlLA4GcSVPzSwQ","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/memo_kit.py"},"output":"<path>/home/user/auto-psych/src/rsa/memo_kit.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Helpers every memo model file may import.\n2: \n3: memo parses its own language: an array parameter (declared ``lex: ...``) can\n4: only be read through a function call, never subscripted (``lex[u, r]`` parses\n5: as a query about an agent). These JIT-compiled indexers are that call.\n6: \n7: ``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\n8: context shape being evaluated (`src.rsa.model_file`).\n9: \"\"\"\n10: \n11: from __future__ import annotations\n12: \n13: import jax\n14: import jax.numpy as jnp\n15: \n16: # Added inside log() so a zero probability gives a large finite penalty, not\n17: # -inf and a NaN gradient.\n18: EPS = 1e-10\n19: \n20: \n21: @jax.jit\n22: def at(matrix, i, j):\n23:     \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n24:     return matrix[i, j]\n25: \n26: \n27: @jax.jit\n28: def vec(vector, i):\n29:     \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n30:     return vector[i]\n31: \n32: \n33: def with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n34:     \"\"\"Mix a choice distribution with a uniform guess over the objects.\n35: \n36:     With probability ``lapse`` the participant picks an object at random.\n37:     Without some such noise a model that gives an object probability zero\n38:     (the literal semantics of RSA does, for any object the word is false of)\n39:     makes one participant's choice of it an impossible event.\n40:     \"\"\"\n41:     return (1.0 - lapse) * p + lapse / p.shape[-1]\n42: \n43: \n44: def softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n45:     \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n46:     return jax.nn.softmax(logits)\n\n(End of file - total 46 lines)\n</content>","metadata":{"preview":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/memo_kit.py","text":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n\n@jax.jit\ndef at(matrix, i, j):\n    \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n    return matrix[i, j]\n\n\n@jax.jit\ndef vec(vector, i):\n    \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n    return vector[i]\n\n\ndef with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n    \"\"\"Mix a choice distribution with a uniform guess over the objects.\n\n    With probability ``lapse`` the participant picks an object at random.\n    Without some such noise a model that gives an object probability zero\n    (the literal semantics of RSA does, for any object the word is false of)\n    makes one participant's choice of it an impossible event.\n    \"\"\"\n    return (1.0 - lapse) * p + lapse / p.shape[-1]\n\n\ndef softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n    \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n    return jax.nn.softmax(logits)","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"src/rsa/memo_kit.py","time":{"start":1791357278230,"end":1791357278578}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11536d808001z83wcSHQZWVyh0","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11536cf27001M1EL0WapyTt9mS"}}
{"type":"tool_use","timestamp":1791357278750,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"HJnl33CjHBQKNn2H","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1_salience.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1_salience.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n2: \n3: As vanilla RSA, but the pragmatic listener's prior over objects is a softmax\n4: of salience weights: w_features per feature an object has (pragmods prior\n5: measurements favour objects with more features) plus w_familiar times the\n6: base rate at which the object was seen in a familiarization phase. The prior\n7: enters only the listener's own inference, not the literal listener the\n8: speaker simulates (Frank & Goodman, 2012). With no informative word the\n9: choice is that prior itself, so prior-elicitation trials inform the salience\n10: weights. A lapse parameter mixes in uniform guessing.\n11: \"\"\"\n12: \n13: import jax.numpy as jnp\n14: import numpyro.distributions as dist\n15: from memo import memo\n16: \n17: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n18: \n19: PARAMS = {\n20:     \"alpha\": dist.LogNormal(0.0, 1.0),\n21:     \"w_features\": dist.Normal(0.0, 1.0),\n22:     \"w_familiar\": dist.Normal(0.0, 2.0),\n23:     \"lapse\": dist.Beta(1.0, 9.0),\n24: }\n25: \n26: \n27: @memo\n28: def L0[u: UTT, r: OBJ](lex: ...):\n29:     listener: knows(u)\n30:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n31:     return Pr[listener.r == r]\n32: \n33: \n34: @memo\n35: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n36:     listener: thinks[\n37:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n38:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n39:     ]\n40:     listener: observes [speaker.u] is u\n41:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n42:     return Pr[listener.r == r]\n43: \n44: \n45: def choice_probs(params, ctx):\n46:     prior = softmax_prior(\n47:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n48:     )\n49:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n50:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 50 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n\nAs vanilla RSA, but the pragmatic listener's prior over objects is a softmax\nof salience weights: w_features per feature an object has (pragmods prior\nmeasurements favour objects with more features) plus w_familiar times the\nbase rate at which the object was seen in a familiarization phase. The prior\nenters only the listener's own inference, not the literal listener the\nspeaker simulates (Frank & Goodman, 2012). With no informative word the\nchoice is that prior itself, so prior-elicitation trials inform the salience\nweights. A lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1_salience.py","text":"\"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n\nAs vanilla RSA, but the pragmatic listener's prior over objects is a softmax\nof salience weights: w_features per feature an object has (pragmods prior\nmeasurements favour objects with more features) plus w_familiar times the\nbase rate at which the object was seen in a familiarization phase. The prior\nenters only the listener's own inference, not the literal listener the\nspeaker simulates (Frank & Goodman, 2012). With no informative word the\nchoice is that prior itself, so prior-elicitation trials inform the salience\nweights. A lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":50,"totalLines":50,"truncated":false}},"title":"data/rsa/loop_smoke2_repair/models/rsa_l1_salience.py","time":{"start":1791357278491,"end":1791357278739}},"id":"prt_11536d9050010TlnLv3Co849wG","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11536cf27001M1EL0WapyTt9mS"}}
{"type":"tool_use","timestamp":1791357278916,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"A7RjsMdpKL5FyZhx","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1_shared_prior.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1_shared_prior.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n2: \n3: As the salience model, but the prior over objects is common knowledge: the\n4: literal listener the speaker simulates uses it too (the paper's \"mutual\n5: knowledge\" variant), so salience shapes which word a speaker would choose as\n6: well as the listener's inference. Salience is a softmax of w_features per\n7: feature an object has plus w_familiar times its familiarization base rate.\n8: With no informative word the choice is that prior. A lapse parameter mixes in\n9: uniform guessing.\n10: \"\"\"\n11: \n12: import jax.numpy as jnp\n13: import numpyro.distributions as dist\n14: from memo import memo\n15: \n16: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n17: \n18: PARAMS = {\n19:     \"alpha\": dist.LogNormal(0.0, 1.0),\n20:     \"w_features\": dist.Normal(0.0, 1.0),\n21:     \"w_familiar\": dist.Normal(0.0, 2.0),\n22:     \"lapse\": dist.Beta(1.0, 9.0),\n23: }\n24: \n25: \n26: @memo\n27: def L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n28:     listener: knows(u)\n29:     listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n30:     return Pr[listener.r == r]\n31: \n32: \n33: @memo\n34: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n35:     listener: thinks[\n36:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n37:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n38:     ]\n39:     listener: observes [speaker.u] is u\n40:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n41:     return Pr[listener.r == r]\n42: \n43: \n44: def choice_probs(params, ctx):\n45:     prior = softmax_prior(\n46:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n47:     )\n48:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n49:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 49 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1_shared_prior.py","text":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":49,"totalLines":49,"truncated":false}},"title":"data/rsa/loop_smoke2_repair/models/rsa_l1_shared_prior.py","time":{"start":1791357278710,"end":1791357278851}},"id":"prt_11536d9e00014gd09RSK8Twl1V","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11536cf27001M1EL0WapyTt9mS"}}
