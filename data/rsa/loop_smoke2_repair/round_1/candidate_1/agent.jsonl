{"type":"tool_use","timestamp":1791357461830,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"7pnZ0Rriepo81SZp","state":{"status":"completed","input":{"offset":1,"limit":100,"filePath":"/home/user/auto-psych/tests/test_rsa_model_file.py"},"output":"<path>/home/user/auto-psych/tests/test_rsa_model_file.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Loading memo model files per context shape, and the model contract.\"\"\"\n2: \n3: import textwrap\n4: \n5: import jax.numpy as jnp\n6: import numpy as np\n7: import pytest\n8: \n9: from src.rsa.context import Context, group_by_shape\n10: from src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\n11: from src.runtime.config import PROJECT_ASSETS_DIR\n12: \n13: SEEDS = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"seed_models\"\n14: SEED_NAMES = [\n15:     \"literal_listener\",\n16:     \"rsa_l1\",\n17:     \"rsa_l2\",\n18:     \"rsa_l1_salience\",\n19:     \"rsa_l1_shared_prior\",\n20: ]\n21: \n22: SIMPLE = dict(objects=((0, 0), (0, 1), (1, 1)), feature_names=(\"hat\", \"glasses\"))\n23: # The pragmods \"complex\" game: objects M, GM, HG over hat, glasses, mustache.\n24: COMPLEX = dict(\n25:     objects=((0, 0, 1), (0, 1, 1), (1, 1, 0)), feature_names=(\"hat\", \"glasses\", \"mustache\")\n26: )\n27: \n28: \n29: def probs(model, params, contexts):\n30:     groups = group_by_shape(contexts)\n31:     out = np.zeros((len(contexts), max(c.shape[0] for c in contexts)))\n32:     for group in groups.values():\n33:         p = np.asarray(model.group_probs(params, group))\n34:         out[group.indices, : p.shape[1]] = p\n35:     return out\n36: \n37: \n38: def test_literal_and_pragmatic_listeners_give_the_textbook_values():\n39:     glasses = Context(**SIMPLE, utterance=1)\n40:     l0 = RSAModel(SEEDS / \"literal_listener.py\")\n41:     np.testing.assert_allclose(probs(l0, {\"lapse\": 0.0}, [glasses])[0], [0, 0.5, 0.5], atol=1e-6)\n42:     l1 = RSAModel(SEEDS / \"rsa_l1.py\")\n43:     np.testing.assert_allclose(\n44:         probs(l1, {\"alpha\": 1.0, \"lapse\": 0.0}, [glasses])[0], [0, 0.75, 0.25], atol=1e-6\n45:     )\n46: \n47: \n48: def test_depth_two_favours_the_twice_implicated_object_more_than_depth_one():\n49:     glasses = Context(**COMPLEX, utterance=1)\n50:     params = {\"alpha\": 1.0, \"lapse\": 0.0}\n51:     p1 = probs(RSAModel(SEEDS / \"rsa_l1.py\"), params, [glasses])[0]\n52:     p2 = probs(RSAModel(SEEDS / \"rsa_l2.py\"), params, [glasses])[0]\n53:     assert p2[1] > p1[1] > 0.5\n54: \n55: \n56: def test_one_file_serves_contexts_of_different_shapes():\n57:     model = RSAModel(SEEDS / \"rsa_l1.py\")\n58:     contexts = [\n59:         Context(**SIMPLE, utterance=1),\n60:         Context(objects=((1, 0), (1, 1), (0, 1), (1, 0)), feature_names=(\"a\", \"b\"), utterance=0),\n61:     ]\n62:     p = probs(model, {\"alpha\": 2.0, \"lapse\": 0.1}, contexts)\n63:     np.testing.assert_allclose(p.sum(axis=1), 1.0, atol=1e-5)\n64:     assert len(model.compiled_shapes) == 2\n65: \n66: \n67: def test_prior_query_uses_the_salience_prior():\n68:     model = RSAModel(SEEDS / \"rsa_l1_salience.py\")\n69:     ctx = Context(**SIMPLE, utterance=None)\n70:     p = probs(model, {\"alpha\": 1.0, \"w_features\": 1.0, \"w_familiar\": 0.0, \"lapse\": 0.0}, [ctx])[0]\n71:     expected = np.exp([0.0, 1.0, 2.0]) / np.exp([0.0, 1.0, 2.0]).sum()\n72:     np.testing.assert_allclose(p, expected, atol=1e-5)\n73: \n74: \n75: @pytest.mark.parametrize(\"name\", SEED_NAMES)\n76: def test_every_seed_meets_the_contract(name):\n77:     contexts = [\n78:         Context(**SIMPLE, utterance=1),\n79:         Context(**SIMPLE, utterance=None, familiarization=(0.1, 0.1, 0.8)),\n80:         Context(**COMPLEX, utterance=2),\n81:     ]\n82:     check_contract(RSAModel(SEEDS / f\"{name}.py\"), group_by_shape(contexts))\n83: \n84: \n85: GOOD_BODY = \"\"\"\n86: import jax.numpy as jnp\n87: import numpyro.distributions as dist\n88: from memo import memo\n89: from src.rsa.memo_kit import at, with_lapse\n90: \n91: PARAMS = {\"lapse\": dist.Beta(1.0, 9.0)}\n92: \n93: @memo\n94: def L0[u: UTT, r: OBJ](lex: ...):\n95:     listener: knows(u)\n96:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n97:     return Pr[listener.r == r]\n98: \n99: def choice_probs(params, ctx):\n100:     p = L0(ctx.lex)[ctx.utterance]\n\n(Showing lines 1-100 of 149. Use offset=101 to continue.)\n</content>","metadata":{"preview":"\"\"\"Loading memo model files per context shape, and the model contract.\"\"\"\n\nimport textwrap\n\nimport jax.numpy as jnp\nimport numpy as np\nimport pytest\n\nfrom src.rsa.context import Context, group_by_shape\nfrom src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\nfrom src.runtime.config import PROJECT_ASSETS_DIR\n\nSEEDS = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"seed_models\"\nSEED_NAMES = [\n    \"literal_listener\",\n    \"rsa_l1\",\n    \"rsa_l2\",\n    \"rsa_l1_salience\",\n    \"rsa_l1_shared_prior\",\n]","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/tests/test_rsa_model_file.py","text":"\"\"\"Loading memo model files per context shape, and the model contract.\"\"\"\n\nimport textwrap\n\nimport jax.numpy as jnp\nimport numpy as np\nimport pytest\n\nfrom src.rsa.context import Context, group_by_shape\nfrom src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\nfrom src.runtime.config import PROJECT_ASSETS_DIR\n\nSEEDS = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"seed_models\"\nSEED_NAMES = [\n    \"literal_listener\",\n    \"rsa_l1\",\n    \"rsa_l2\",\n    \"rsa_l1_salience\",\n    \"rsa_l1_shared_prior\",\n]\n\nSIMPLE = dict(objects=((0, 0), (0, 1), (1, 1)), feature_names=(\"hat\", \"glasses\"))\n# The pragmods \"complex\" game: objects M, GM, HG over hat, glasses, mustache.\nCOMPLEX = dict(\n    objects=((0, 0, 1), (0, 1, 1), (1, 1, 0)), feature_names=(\"hat\", \"glasses\", \"mustache\")\n)\n\n\ndef probs(model, params, contexts):\n    groups = group_by_shape(contexts)\n    out = np.zeros((len(contexts), max(c.shape[0] for c in contexts)))\n    for group in groups.values():\n        p = np.asarray(model.group_probs(params, group))\n        out[group.indices, : p.shape[1]] = p\n    return out\n\n\ndef test_literal_and_pragmatic_listeners_give_the_textbook_values():\n    glasses = Context(**SIMPLE, utterance=1)\n    l0 = RSAModel(SEEDS / \"literal_listener.py\")\n    np.testing.assert_allclose(probs(l0, {\"lapse\": 0.0}, [glasses])[0], [0, 0.5, 0.5], atol=1e-6)\n    l1 = RSAModel(SEEDS / \"rsa_l1.py\")\n    np.testing.assert_allclose(\n        probs(l1, {\"alpha\": 1.0, \"lapse\": 0.0}, [glasses])[0], [0, 0.75, 0.25], atol=1e-6\n    )\n\n\ndef test_depth_two_favours_the_twice_implicated_object_more_than_depth_one():\n    glasses = Context(**COMPLEX, utterance=1)\n    params = {\"alpha\": 1.0, \"lapse\": 0.0}\n    p1 = probs(RSAModel(SEEDS / \"rsa_l1.py\"), params, [glasses])[0]\n    p2 = probs(RSAModel(SEEDS / \"rsa_l2.py\"), params, [glasses])[0]\n    assert p2[1] > p1[1] > 0.5\n\n\ndef test_one_file_serves_contexts_of_different_shapes():\n    model = RSAModel(SEEDS / \"rsa_l1.py\")\n    contexts = [\n        Context(**SIMPLE, utterance=1),\n        Context(objects=((1, 0), (1, 1), (0, 1), (1, 0)), feature_names=(\"a\", \"b\"), utterance=0),\n    ]\n    p = probs(model, {\"alpha\": 2.0, \"lapse\": 0.1}, contexts)\n    np.testing.assert_allclose(p.sum(axis=1), 1.0, atol=1e-5)\n    assert len(model.compiled_shapes) == 2\n\n\ndef test_prior_query_uses_the_salience_prior():\n    model = RSAModel(SEEDS / \"rsa_l1_salience.py\")\n    ctx = Context(**SIMPLE, utterance=None)\n    p = probs(model, {\"alpha\": 1.0, \"w_features\": 1.0, \"w_familiar\": 0.0, \"lapse\": 0.0}, [ctx])[0]\n    expected = np.exp([0.0, 1.0, 2.0]) / np.exp([0.0, 1.0, 2.0]).sum()\n    np.testing.assert_allclose(p, expected, atol=1e-5)\n\n\n@pytest.mark.parametrize(\"name\", SEED_NAMES)\ndef test_every_seed_meets_the_contract(name):\n    contexts = [\n        Context(**SIMPLE, utterance=1),\n        Context(**SIMPLE, utterance=None, familiarization=(0.1, 0.1, 0.8)),\n        Context(**COMPLEX, utterance=2),\n    ]\n    check_contract(RSAModel(SEEDS / f\"{name}.py\"), group_by_shape(contexts))\n\n\nGOOD_BODY = \"\"\"\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\"lapse\": dist.Beta(1.0, 9.0)}\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\ndef choice_probs(params, ctx):\n    p = L0(ctx.lex)[ctx.utterance]","lineStart":1,"lineEnd":100,"totalLines":149,"truncated":true}},"title":"tests/test_rsa_model_file.py","time":{"start":1791357461748,"end":1791357461766}},"metadata":{"google":{"thoughtSignature":"EtcBCtQBAWkUfRPnNHGIqaYSywUwG0AWv0xznTGxR9N9ovurJ6r5w+U5qgPGIrILDKTIZL9IChg9WjqF9gMWd6mbosZUtjqz9YBUEXfI90YABmHze+DtoxMoXWUfMP5tlAt+cyDtSJsoigvJHoM2/iFyRnOS6/PhsVLAPIGzlqi2mbfRJuzsY/9Y8DGH+8VeuP/doCfVuhlYhewpVWnKZgk5qOsdqwHeBpJQXpvy9aS37B33MXAFSXPmFBu5L09HtqCc88IU2T+xfVp3f2wEfGYm2gcFECskd/o="}},"id":"prt_11539a4ea001uUInvz6pnf6LLZ","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_1153999e40012vBlWsUYN1R2Rz"}}
