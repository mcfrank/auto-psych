{"type":"tool_use","timestamp":1791357586365,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"bash","callID":"pJCgvrZH5ADZQbLw","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport numpy as np\nfrom src.rsa.dataset import load_forced_choice\ntrials = load_forced_choice('data/rsa/loop_smoke2_repair/responses.csv')\n\n# Let's test rsa_l1\nfor alpha in [1.0, 1.5, 2.0, 2.5, 3.0]:\n    for lapse in [0.05, 0.1, 0.15]:\n        ll = 0.0\n        for ctx, choice in zip(trials.contexts, trials.choices):\n            n_obj, n_utt = ctx.shape\n            if ctx.utterance is None:\n                p = np.full(n_obj, 1.0 / n_obj)\n            else:\n                lex = ctx.lexicon()\n                u = ctx.present_features.index(ctx.utterance)\n                # L0: (n_utt, n_obj)\n                l0 = lex / np.maximum(lex.sum(axis=1, keepdims=True), 1e-10)\n                # S1: p(u | r) \\propto lex * exp(alpha * log(l0 + 1e-10))\n                s1_util = lex * np.exp(alpha * np.log(l0 + 1e-10))\n                s1 = s1_util / np.maximum(s1_util.sum(axis=0, keepdims=True), 1e-10)\n                # L1: p(r | u) \\propto s1[u, r] * prior(r)\n                l1 = s1[u, :] / np.maximum(s1[u, :].sum(), 1e-10)\n                p = l1\n            p_lapsed = (1 - lapse) * p + lapse / n_obj\n            ll += np.log(p_lapsed[choice])\n        print(f'RSA L1 alpha={alpha}, lapse={lapse}: LL={ll:.1f}')\n\""},"output":"RSA L1 alpha=1.0, lapse=0.05: LL=-5259.2\nRSA L1 alpha=1.0, lapse=0.1: LL=-5203.1\nRSA L1 alpha=1.0, lapse=0.15: LL=-5214.1\nRSA L1 alpha=1.5, lapse=0.05: LL=-5265.9\nRSA L1 alpha=1.5, lapse=0.1: LL=-5200.6\nRSA L1 alpha=1.5, lapse=0.15: LL=-5203.8\nRSA L1 alpha=2.0, lapse=0.05: LL=-5315.4\nRSA L1 alpha=2.0, lapse=0.1: LL=-5235.1\nRSA L1 alpha=2.0, lapse=0.15: LL=-5225.9\nRSA L1 alpha=2.5, lapse=0.05: LL=-5407.3\nRSA L1 alpha=2.5, lapse=0.1: LL=-5305.5\nRSA L1 alpha=2.5, lapse=0.15: LL=-5278