{"type":"tool_use","timestamp":1791357281260,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"5NMUbV52u1p0CbZY","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/literal_listener.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/literal_listener.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Literal listener (depth 0).\n2: \n3: The listener picks uniformly among the objects the heard word is literally\n4: true of; with no informative word, uniformly among all objects. A lapse\n5: parameter mixes in uniform guessing.\n6: \"\"\"\n7: \n8: import jax.numpy as jnp\n9: import numpyro.distributions as dist\n10: from memo import memo\n11: \n12: from src.rsa.memo_kit import at, with_lapse\n13: \n14: PARAMS = {\n15:     \"lapse\": dist.Beta(1.0, 9.0),\n16: }\n17: \n18: \n19: @memo\n20: def L0[u: UTT, r: OBJ](lex: ...):\n21:     listener: knows(u)\n22:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n23:     return Pr[listener.r == r]\n24: \n25: \n26: def choice_probs(params, ctx):\n27:     heard = L0(ctx.lex)[ctx.utterance]\n28:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n29:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 29 lines)\n</content>","metadata":{"preview":"\"\"\"Literal listener (depth 0).\n\nThe listener picks uniformly among the objects the heard word is literally\ntrue of; with no informative word, uniformly among all objects. A lapse\nparameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/literal_listener.py","text":"\"\"\"Literal listener (depth 0).\n\nThe listener picks uniformly among the objects the heard word is literally\ntrue of; with no informative word, uniformly among all objects. A lapse\nparameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L0(ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":29,"totalLines":29,"truncated":false}},"title":"data/rsa/loop_smoke2_repair/models/literal_listener.py","time":{"start":1791357281085,"end":1791357281254}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11536e333001k0eKMiljvaQYxu","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11536dab3001W25PMyK6KNjgHV"}}
{"type":"tool_use","timestamp":1791357281299,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"wZEXp94dcKC7FUPG","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Vanilla RSA pragmatic listener (depth 1), uniform prior over objects.\n2: \n3: The listener reasons about a speaker who chooses a true word with probability\n4: proportional to exp(alpha * log L0(object | word)), where L0 is the literal\n5: listener; the listener inverts that speaker with a uniform prior over objects\n6: (Frank & Goodman, 2012). With no informative word the choice is uniform. A\n7: lapse parameter mixes in uniform guessing.\n8: \"\"\"\n9: \n10: import jax.numpy as jnp\n11: import numpyro.distributions as dist\n12: from memo import memo\n13: \n14: from src.rsa.memo_kit import EPS, at, with_lapse\n15: \n16: PARAMS = {\n17:     \"alpha\": dist.LogNormal(0.0, 1.0),\n18:     \"lapse\": dist.Beta(1.0, 9.0),\n19: }\n20: \n21: \n22: @memo\n23: def L0[u: UTT, r: OBJ](lex: ...):\n24:     listener: knows(u)\n25:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n26:     return Pr[listener.r == r]\n27: \n28: \n29: @memo\n30: def L1[u: UTT, r: OBJ](alpha, lex: ...):\n31:     listener: thinks[\n32:         speaker: given(r in OBJ, wpp=1),\n33:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n34:     ]\n35:     listener: observes [speaker.u] is u\n36:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n37:     return Pr[listener.r == r]\n38: \n39: \n40: def choice_probs(params, ctx):\n41:     heard = L1(params[\"alpha\"], ctx.lex)[ctx.utterance]\n42:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n43:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 43 lines)\n</content>","metadata":{"preview":"\"\"\"Vanilla RSA pragmatic listener (depth 1), uniform prior over objects.\n\nThe listener reasons about a speaker who chooses a true word with probability\nproportional to exp(alpha * log L0(object | word)), where L0 is the literal\nlistener; the listener inverts that speaker with a uniform prior over objects\n(Frank & Goodman, 2012). With no informative word the choice is uniform. A\nlapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l1.py","text":"\"\"\"Vanilla RSA pragmatic listener (depth 1), uniform prior over objects.\n\nThe listener reasons about a speaker who chooses a true word with probability\nproportional to exp(alpha * log L0(object | word)), where L0 is the literal\nlistener; the listener inverts that speaker with a uniform prior over objects\n(Frank & Goodman, 2012). With no informative word the choice is uniform. A\nlapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L1(params[\"alpha\"], ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":43,"totalLines":43,"truncated":false}},"title":"data/rsa/loop_smoke2_repair/models/rsa_l1.py","time":{"start":1791357281198,"end":1791357281292}},"id":"prt_11536e3a5001bgEQwOss6sowZ7","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11536dab3001W25PMyK6KNjgHV"}}
{"type":"tool_use","timestamp":1791357281653,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"AXOAVrByqKwwod05","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l2.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l2.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n2: \n3: One more level of recursion than the vanilla model: a speaker S2 chooses words\n4: by how well the depth-1 pragmatic listener L1 would recover the object\n5: (exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\n6: what the pragmods \"complex\" game needs to single out the object described by\n7: the twice-implicated word. One rationality alpha at every level; uniform\n8: choice with no informative word; a lapse parameter mixes in uniform guessing.\n9: \"\"\"\n10: \n11: import jax.numpy as jnp\n12: import numpyro.distributions as dist\n13: from memo import memo\n14: \n15: from src.rsa.memo_kit import EPS, at, with_lapse\n16: \n17: PARAMS = {\n18:     \"alpha\": dist.LogNormal(0.0, 1.0),\n19:     \"lapse\": dist.Beta(1.0, 9.0),\n20: }\n21: \n22: \n23: @memo\n24: def L0[u: UTT, r: OBJ](lex: ...):\n25:     listener: knows(u)\n26:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n27:     return Pr[listener.r == r]\n28: \n29: \n30: @memo\n31: def L1[u: UTT, r: OBJ](alpha, lex: ...):\n32:     listener: thinks[\n33:         speaker: given(r in OBJ, wpp=1),\n34:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n35:     ]\n36:     listener: observes [speaker.u] is u\n37:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n38:     return Pr[listener.r == r]\n39: \n40: \n41: @memo\n42: def L2[u: UTT, r: OBJ](alpha, lex: ...):\n43:     listener: thinks[\n44:         speaker: given(r in OBJ, wpp=1),\n45:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n46:     ]\n47:     listener: observes [speaker.u] is u\n48:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n49:     return Pr[listener.r == r]\n50: \n51: \n52: def choice_probs(params, ctx):\n53:     heard = L2(params[\"alpha\"], ctx.lex)[ctx.utterance]\n54:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n55:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 55 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n\nOne more level of recursion than the vanilla model: a speaker S2 chooses words\nby how well the depth-1 pragmatic listener L1 would recover the object\n(exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\nwhat the pragmods \"complex\" game needs to single out the object described by\nthe twice-implicated word. One rationality alpha at every level; uniform\nchoice with no informative word; a lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/models/rsa_l2.py","text":"\"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n\nOne more level of recursion than the vanilla model: a speaker S2 chooses words\nby how well the depth-1 pragmatic listener L1 would recover the object\n(exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\nwhat the pragmods \"complex\" game needs to single out the object described by\nthe twice-implicated word. One rationality alpha at every level; uniform\nchoice with no informative word; a lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L2(params[\"alpha\"], ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":55,"totalLines":55,"truncated":false}},"title":"data/rsa/loop_smoke2_repair/models/rsa_l2.py","time":{"start":1791357281399,"end":1791357281597}},"id":"prt_11536e464001RbryAHQ6eDHOmm","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11536dab3001W25PMyK6KNjgHV"}}
