(r in OBJ, wpp=Pr[speaker.r == r])\n41:     return Pr[listener.r == r]\n42: \n43: \n44: def choice_probs(params, ctx):\n45:     eval_prior = softmax_prior(params[\"beta_valence\"] * ctx.valence * ctx.feature_count)\n46:     heard = L1(params[\"alpha\"], ctx.lex, eval_prior)[ctx.utterance]\n47:     return with_lapse(jnp.where(ctx.is_prior > 0, eval_prior, heard), params[\"lapse\"])\n\n(End of file - total 47 lines)\n</content>","metadata":{"preview":"\"\"\"Evaluative listener reasoning about an affective, value-conditioned speaker.\n\nThe listener models a speaker who communicates about a referent chosen\naccording to their evaluative attitude (valence): a speaker describing their\nfavorite object favors referents with more features, while a speaker\ndescribing their least favorite object favors referents with fewer features.\nOn neutral trials, referent preference is uniform. The listener inverts this\nvalue-conditioned speaker upon hearing an utterance, and chooses by the\nevaluative preference when no informative word is given. A lapse parameter\nmixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2_repair/round_1/candidate_1/candidate.py","text":"\"\"\"Evaluative listener reasoning about an affective, value-conditioned speaker.\n\nThe listener models a speaker who communicates about a referent chosen\naccording to their evaluative attitude (valence): a speaker describing their\nfavorite object favors referents with more features, while a speaker\ndescribing their least favorite object favors referents with fewer features.\nOn neutral trials, referent preference is uniform. The listener inverts this\nvalue-conditioned speaker upon hearing an utterance, and chooses by the\nevaluative preference when no informative word is given. A lapse parameter\nmixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"beta_valence\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., eval_prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(eval_prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    eval_prior = softmax_prior(params[\"beta_valence\"] * ctx.valence * ctx.feature_count)\n    heard = L1(params[\"alpha\"], ctx.lex, eval_prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, eval_prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":47,"totalLines":47,"truncated":false}},"title":"data/rsa/loop_smoke2_repair/round_1/candidate_1/candidate.py","time":{"start":1791357768053,"end":1791357768100}},"id":"prt_1153e516a001bJRrTWvYo7rdIA","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_1153e443b001O8Pz9vNENbGVLF"}}
