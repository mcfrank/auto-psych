{"type":"tool_use","timestamp":1791357695559,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"bash","callID":"kV9lQts37xBYNbIp","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport numpy as np\nfrom src.rsa.loop.novelty import novelty_pool\n\npool = novelty_pool()\n# rsa_l1_salience has w_features, w_familiar\n# Let's see what rsa_l1_salience predicts on the pool vs evaluative rsa\n# In rsa_l1_salience: prior is softmax(w_features * fc + w_familiar * fam).\n# Note that rsa_l1_salience has w_features * fc regardless of valence!\n# On valence contexts, c.valence is -1 or 1, but rsa_l1_salience ignores valence.\n# Evaluative rsa has w_val * c.valence * fc.\n# For valence=-1: rsa_l1_salience favors MORE features, but evaluative rsa favors FEWER features!\ndiffs = []\nfor c in pool:\n    n_obj, n_utt = c.shape\n    fc = np.array([sum(obj) for obj in c.objects])\n    fam = np.zeros(n_obj) if c.familiarization is None else np.array(c.familiarization)\n    \n    # Salience prior (approximate posterior mean from rsa_l1_salience)\n    # in rsa_l1_salience, w_feat ~ 0.4, w_fam ~ 1.5\n    s_logits = 0.4 * fc + 1.5 * fam\n    s_prior = np.exp(s_logits - np.max(s_logits))\n    s_prior = s_prior / s_prior.sum()\n    \n    # Eval prior:\n    e_logits = 1.5 * c.valence * fc\n    e_prior = np.exp(e_logits - np.max(e_logits))\n    e_prior = e_prior / e_prior.sum()\n    \n    if c.utterance is None:\n        p_sal = s_prior\n        p_eval = e_prior\n    else:\n        lex = c.lexicon()\n        u = c.present_features.index(c.utterance)\n        l0 = lex / np.maximum(lex.sum(axis=1, keepdims=True), 1e-10)\n        s1_util = lex * np.exp(1.5 * np.log(l0 + 1e-10))\n        s1 = s1_util / np.maximum(s1_util.sum(axis=0, keepdims=True), 1e-10)\n        \n        p_sal = (s1[u, :] * s_prior) / np.maximum((s1[u, :] * s_prior).sum(), 1e-10)\n        p_eval = (s1[u, :] * e_prior) / np.maximum((s1[u, :] * e_prior).sum(), 1e-10)\n    \n    classes = np.array(c.choice_classes())\n    cp_sal = np.array([p_sal[classes == k].sum() for k in range(len(np.unique(classes)))])\n    cp_eval = np.array([p_eval[classes == k].sum() for k in range(len(np.unique(classes)))])\n    diffs.extend((cp_sal - cp_eval)**2)\n\nrmse = np.sqrt(np.mean(diffs))\nprint(f'RMSE against rsa_l1_salience over pool: {rmse:.4f}')\n\""},"output":"RMSE against rsa_l1_salience over pool: 0.0902\n","metadata":{"output":"RMSE against rsa_l1_salience over pool: 0.0902\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport numpy as np\nfrom src.rsa.loop.novelty import novelty_pool\n\npool = novelty_pool()\n# rsa_l1_salience has w_features, w_familiar\n# Let's see what rsa_l1_salience predicts on the pool vs evaluative rsa\n# In rsa_l1_salience: prior is softmax(w_features * fc + w_familiar * fam).\n# Note that rsa_l1_salience has w_features * fc regardless of valence!\n# On valence contexts, c.valence is -1 or 1, but rsa_l1_salience ignores valence.\n# Evaluative rsa has w_val * c.valence * fc.\n# For valence=-1: rsa_l1_salience favors MORE features, but evaluative rsa favors FEWER features!\ndiffs = []\nfor c in pool:\n    n_obj, n_utt = c.shape\n    fc = np.array([sum(obj) for obj in c.objects])\n    fam = np.zeros(n_obj) if c.familiarization is None else np.array(c.familiarization)\n    \n    # Salience prior (approximate posterior mean from rsa_l1_salience)\n    # in rsa_l1_salience, w_feat ~ 0.4, w_fam ~ 1.5\n    s_logits = 0.4 * fc + 1.5 * fam\n    s_prior = np.exp(s_logits - np.max(s_logits))\n    s_prior = s_prior / s_prior.sum()\n    \n    # Eval prior:\n    e_logits = 1.5 * c.valence * fc\n    e_prior = np.exp(e_logits - np.max(e_logits))\n    e_prior = e_prior / e_prior.sum()\n    \n    if c.utterance is None:\n        p_sal = s_prior\n        p_eval = e_prior\n    else:\n        lex = c.lexicon()\n        u = c.present_features.index(c.utterance)\n        l0 = lex / np.maximum(lex.sum(axis=1, keepdims=True), 1e-10)\n        s1_util = lex * np.exp(1.5 * np.log(l0 + 1e-10))\n        s1 = s1_util / np.maximum(s1_util.sum(axis=0, keepdims=True), 1e-10)\n        \n        p_sal = (s1[u, :] * s_prior) / np.maximum((s1[u, :] * s_prior).sum(), 1e-10)\n        p_eval = (s1[u, :] * e_prior) / np.maximum((s1[u, :] * e_prior).sum(), 1e-10)\n    \n    classes = np.array(c.choice_classes())\n    cp_sal = np.array([p_sal[classes == k].sum() for k in range(len(np.unique(classes)))])\n    cp_eval = np.array([p_eval[classes == k].sum() for k in range(len(np.unique(classes)))])\n    diffs.extend((cp_sal - cp_eval)**2)\n\nrmse = np.sqrt(np.mean(diffs))\nprint(f'RMSE against rsa_l1_salience over pool: {rmse:.4f}')\n\"","time":{"start":1791357689821,"end":1791357695507}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1153d1fc9001VyCAFkTnUZ0arF","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_1153cedb6001BlGHgqK0vpHlYA"}}
