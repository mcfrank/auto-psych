{"type":"tool_use","timestamp":1791357288653,"sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","part":{"type":"tool","tool":"read","callID":"vAplQgdfuqNh0N26","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/context.py"},"output":"<path>/home/user/auto-psych/src/rsa/context.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Reference-game contexts and their encoding for memo models.\n2: \n3: A context is what one trial shows a listener: a few objects (referents), each\n4: a set of features, and either the one feature word a speaker said (an\n5: *utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\n6: will he pick next?\").\n7: \n8: Models never see padding. memo enumerates over fixed domains, and padding a\n9: small context out to a common size makes some distribution a 0/0 — harmless in\n10: memo's forward pass (it returns zeros) but NaN in its gradient, which stops\n11: NUTS. So trials are grouped by shape (`group_by_shape`) and each group is\n12: evaluated by a copy of the model compiled with exact-size domains `OBJ` and\n13: `UTT` (`src.rsa.model_file`).\n14: \n15: The utterances of a context are the features true of at least one object, in\n16: feature order, plus — when some object has none of them — a final **sink**\n17: utterance true of exactly those objects (\"no word applies\"). Without it a\n18: speaker who means a featureless object (the plain face of the pragmods simple\n19: game) has no true word, again a 0/0. The sink is never observed, and it adds\n20: no probability to any object a real word is true of, so L0/S1/L1 values on\n21: real words are the textbook ones.\n22: \"\"\"\n23: \n24: from __future__ import annotations\n25: \n26: from dataclasses import dataclass\n27: from typing import Dict, List, NamedTuple, Optional, Sequence, Tuple\n28: \n29: import jax.numpy as jnp\n30: import numpy as np\n31: \n32: SINK = \"<sink>\"\n33: \n34: \n35: class ContextArrays(NamedTuple):\n36:     \"\"\"One trial (or, stacked, a group of same-shape trials) as JAX arrays.\n37: \n38:     Shapes are for one trial; a group adds a leading trial axis.\n39:     \"\"\"\n40: \n41:     lex: jnp.ndarray  # (N_UTT, N_OBJ) 1.0 where utterance u is true of object r\n42:     is_sink: jnp.ndarray  # (N_UTT,) 1.0 for the sink utterance\n43:     feature_count: jnp.ndarray  # (N_OBJ,) number of context words true of each object\n44:     utterance: jnp.ndarray  # () int32 utterance index heard (0 for a prior query)\n45:     is_prior: jnp.ndarray  # () 1.0 for a prior query (no informative word)\n46:     familiarization: jnp.ndarray  # (N_OBJ,) base rate seen in familiarization, 0..1\n47:     has_familiarization: jnp.ndarray  # () 1.0 when there was a familiarization phase\n48:     grayscale: jnp.ndarray  # (N_OBJ,) 1.0 for an object shown in grayscale\n49:     valence: jnp.ndarray  # () +1 \"favorite\" framing, -1 \"least favorite\", 0 neutral\n50: \n51: \n52: @dataclass(frozen=True)\n53: class Context:\n54:     \"\"\"One trial's display. ``utterance`` indexes ``feature_names`` (None: prior query).\"\"\"\n55: \n56:     objects: Tuple[Tuple[int, ...], ...]\n57:     feature_names: Tuple[str, ...]\n58:     utterance: Optional[int]\n59:     item: str = \"\"\n60:     familiarization: Optional[Tuple[float, ...]] = None\n61:     grayscale: Optional[Tuple[int, ...]] = None\n62:     valence: int = 0\n63:     # Feature indices the speaker can name (the message set). None: every\n64:     # feature is a word (pragmods). In the Franke & Degen game some features\n65:     # (e.g. square, blue) have no word, which changes which inferences hold.\n66:     messages: Optional[Tuple[int, ...]] = None\n67: \n68:     def __post_init__(self) -> None:\n69:         objects = tuple(tuple(int(v) for v in row) for row in self.objects)\n70:         object.__setattr__(self, \"objects\", objects)\n71:         object.__setattr__(self, \"feature_names\", tuple(self.feature_names))\n72:         if not objects:\n73:             raise ValueError(\"a context needs at least one object\")\n74:         n_features = len(self.feature_names)\n75:         if any(len(row) != n_features for row in objects):\n76:             raise ValueError(\n77:                 f\"objects must be rectangular with one entry per feature \"\n78:                 f\"({n_features}): {objects}\"\n79:             )\n80:         if any(v not in (0, 1) for row in objects for v in row):\n81:             raise ValueError(f\"object features must be 0/1: {objects}\")\n82:         if self.messages is not None:\n83:             messages = tuple(int(m) for m in self.messages)\n84:             object.__setattr__(self, \"messages\", messages)\n85:             if not messages or len(set(messages)) != len(messages):\n86:                 raise ValueError(f\"messages must be distinct feature indices: {messages}\")\n87:             if any(not 0 <= m < n_features for m in messages):\n88:                 raise ValueError(f\"messages {messages} are not all feature indices (0..{n_features - 1})\")\n89:         if self.utterance is not None:\n90:             if self.messages is not None and self.utterance not in self.messages:\n91:                 raise ValueError(\n92:                     f\"utterance {self.feature_names[self.utterance]!r} is not in the message set\"\n93:                 )\n94:             if not 0 <= self.utterance < n_features:\n95:                 raise ValueError(\n96:                     f\"utterance {self.utterance} is not a feature index (0..{n_features - 1})\"\n97:                 )\n98:             if not any(row[self.utterance] for row in objects):\n99:                 raise ValueError(\n100:                     f\"utterance {self.feature_names[self.utterance]!r} is true of no object\"\n101:                 )\n102:         for name in (\"familiarization\", \"grayscale\"):\n103:             value = getattr(self, name)\n104:             if value is not None:\n105:                 value = tuple(value)\n106:                 object.__setattr__(self, name, value)\n107:                 if len(value) != len(objects):\n108:                     raise ValueError(f\"{name} needs one per object: {value}\")\n109:         if self.familiarization is not None and not all(\n110:             0.0 <= f <= 1.0 for f in self.familiarization\n111:         ):\n112:             raise ValueError(f\"familiarization rates must be in [0, 1]: {self.familiarization}\")\n113:         if self.grayscale is not None and any(g not in (0, 1) for g in self.grayscale):\n114:             raise ValueError(f\"grayscale must be 0/1 per object: {self.grayscale}\")\n115:         if self.valence not in (-1, 0, 1):\n116:             raise ValueError(f\"valence must be -1, 0 or 1: {self.valence}\")\n117: \n118:     @property\n119:     def nameable(self) -> Tuple[int, ...]:\n120:         \"\"\"Feature indices the speaker can name (every feature without a message set).\"\"\"\n121:         return tuple(range(len(self.feature_names))) if self.messages is None else tuple(sorted(self.messages))\n122: \n123:     @property\n124:     def present_features(self) -> Tuple[int, ...]:\n125:         \"\"\"Nameable feature indices true of at least one object: the context's words.\"\"\"\n126:         return tuple(f for f in self.nameable if any(row[f] for row in self.objects))\n127: \n128:     @property\n129:     def needs_sink(self) -> bool:\n130:         \"\"\"Whether some object has no word true of it (no nameable feature).\"\"\"\n131:         return any(not any(row[f] for f in self.nameable) for row in self.objects)\n132: \n133:     @property\n134:     def utterance_names(self) -> Tuple[str, ...]:\n135:         names = tuple(self.feature_names[f] for f in self.present_features)\n136:         return names + ((SINK,) if self.needs_sink else ())\n137: \n138:     @property\n139:     def shape(self) -> Tuple[int, int]:\n140:         \"\"\"(N_OBJ, N_UTT): the domain sizes a model is compiled for.\"\"\"\n141:         return (len(self.objects), len(self.utterance_names))\n142: \n143:     def lexicon(self) -> np.ndarray:\n144:         \"\"\"(N_UTT, N_OBJ) truth table of utterances over objects, sink last.\"\"\"\n145:         rows = [[row[f] for row in self.objects] for f in self.present_features]\n146:         if self.needs_sink:\n147:             rows.append([int(not any(row[f] for f in self.nameable)) for row in self.objects])\n148:         return np.asarray(rows, dtype=np.float32)\n149: \n150:     def choice_classes(self) -> Tuple[int, ...]:\n151:         \"\"\"Each object's choice class: the index of the first object identical to it.\n152: \n153:         Objects with the same features, familiarization rate and colour are\n154:         indistinguishable to every model (they get identical inputs) and, in\n155:         the pragmods data, often to the record of which was chosen. The fit\n156:         observes a choice as its class (`src.rsa.fit.class_probs`).\n157:         \"\"\"\n158:         keys = [\n159:             (\n160:                 row,\n161:                 None if self.familiarization is None else self.familiarization[i],\n162:                 None if self.grayscale is None else self.grayscale[i],\n163:             )\n164:             for i, row in enumerate(self.objects)\n165:         ]\n166:         return tuple(keys.index(k) for k in keys)\n167: \n168:     def arrays(self) -> ContextArrays:\n169:         n_obj, n_utt = self.shape\n170:         lex = self.lexicon()\n171:         is_sink = np.zeros(n_utt, dtype=np.float32)\n172:         if self.needs_sink:\n173:             is_sink[-1] = 1.0\n174:         if self.utterance is None:\n175:             utterance, is_prior = 0, 1.0\n176:         else:\n177:             utterance, is_prior = self.present_features.index(self.utterance), 0.0\n178:         familiarization = (\n179:             np.zeros(n_obj) if self.familiarization is None else np.asarray(self.familiarization)\n180:         )\n181:         grayscale = np.zeros(n_obj) if self.grayscale is None else np.asarray(self.grayscale)\n182:         return ContextArrays(\n183:             lex=jnp.asarray(lex),\n184:             is_sink=jnp.asarray(is_sink),\n185:             feature_count=jnp.asarray((lex * (1 - is_sink)[:, None]).sum(axis=0)),\n186:             utterance=jnp.asarray(utterance, dtype=jnp.int32),\n187:             is_prior=jnp.asarray(is_prior, dtype=jnp.float32),\n188:             familiarization=jnp.asarray(familiarization, dtype=jnp.float32),\n189:             has_familiarization=jnp.asarray(\n190:                 float(self.familiarization is not None), dtype=jnp.float32\n191:             ),\n192:             grayscale=jnp.asarray(grayscale, dtype=jnp.float32),\n193:             valence=jnp.asarray(float(self.valence), dtype=jnp.float32),\n194:         )\n195: \n196: \n197: @dataclass(frozen=True)\n198: class ShapeGroup:\n199:     \"\"\"Same-shape trials: their positions in the input and their stacked arrays.\"\"\"\n200: \n201:     shape: Tuple[int, int]\n202:     indices: np.ndarray\n203:     arrays: ContextArrays\n204:     classes: np.ndarray  # (trials, N_OBJ) choice class of each object (`Context.choice_classes`)\n205: \n206: \n207: def stack(arrays: Sequence[ContextArrays]) -> ContextArrays:\n208:     return ContextArrays(*(jnp.stack(field) for field in zip(*arrays)))\n209: \n210: \n211: def group_by_shape(contexts: Sequence[Context]) -> Dict[Tuple[int, int], ShapeGroup]:\n212:     \"\"\"Group contexts by (N_OBJ, N_UTT), keeping input order within a group.\"\"\"\n213:     by_shape: Dict[Tuple[int, int], List[int]] = {}\n214:     for i, ctx in enumerate(contexts):\n215:         by_shape.setdefault(ctx.shape, []).append(i)\n216:     return {\n217:         shape: ShapeGroup(\n218:             shape=shape,\n219:             indices=np.asarray(idx),\n220:             arrays=stack([contexts[i].arrays() for i in idx]),\n221:             classes=np.asarray([contexts[i].choice_classes() for i in idx], dtype=np.int32),\n222:         )\n223:         for shape, idx in sorted(by_shape.items())\n224:     }\n\n(End of file - total 224 lines)\n</content>","metadata":{"preview":"\"\"\"Reference-game contexts and their encoding for memo models.\n\nA context is what one trial shows a listener: a few objects (referents), each\na set of features, and either the one feature word a speaker said (an\n*utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\nwill he pick next?\").\n\nModels never see padding. memo enumerates over fixed domains, and padding a\nsmall context out to a common size makes some distribution a 0/0 — harmless in\nmemo's forward pass (it returns zeros) but NaN in its gradient, which stops\nNUTS. So trials are grouped by shape (`group_by_shape`) and each group is\nevaluated by a copy of the model compiled with exact-size domains `OBJ` and\n`UTT` (`src.rsa.model_file`).\n\nThe utterances of a context are the features true of at least one object, in\nfeature order, plus — when some object has none of them — a final **sink**\nutterance true of exactly those objects (\"no word applies\"). Without it a\nspeaker who means a featureless object (the plain face of the pragmods simple\ngame) has no true word, again a 0/0. The sink is never observed, and it adds\nno probability to any object a real word is true of, so L0/S1/L1 values on","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/context.py","text":"\"\"\"Reference-game contexts and their encoding for memo models.\n\nA context is what one trial shows a listener: a few objects (referents), each\na set of features, and either the one feature word a speaker said (an\n*utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\nwill he pick next?\").\n\nModels never see padding. memo enumerates over fixed domains, and padding a\nsmall context out to a common size makes some distribution a 0/0 — harmless in\nmemo's forward pass (it returns zeros) but NaN in its gradient, which stops\nNUTS. So trials are grouped by shape (`group_by_shape`) and each group is\nevaluated by a copy of the model compiled with exact-size domains `OBJ` and\n`UTT` (`src.rsa.model_file`).\n\nThe utterances of a context are the features true of at least one object, in\nfeature order, plus — when some object has none of them — a final **sink**\nutterance true of exactly those objects (\"no word applies\"). Without it a\nspeaker who means a featureless object (the plain face of the pragmods simple\ngame) has no true word, again a 0/0. The sink is never observed, and it adds\nno probability to any object a real word is true of, so L0/S1/L1 values on\nreal words are the textbook ones.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Dict, List, NamedTuple, Optional, Sequence, Tuple\n\nimport jax.numpy as jnp\nimport numpy as np\n\nSINK = \"<sink>\"\n\n\nclass ContextArrays(NamedTuple):\n    \"\"\"One trial (or, stacked, a group of same-shape trials) as JAX arrays.\n\n    Shapes are for one trial; a group adds a leading trial axis.\n    \"\"\"\n\n    lex: jnp.ndarray  # (N_UTT, N_OBJ) 1.0 where utterance u is true of object r\n    is_sink: jnp.ndarray  # (N_UTT,) 1.0 for the sink utterance\n    feature_count: jnp.ndarray  # (N_OBJ,) number of context words true of each object\n    utterance: jnp.ndarray  # () int32 utterance index heard (0 for a prior query)\n    is_prior: jnp.ndarray  # () 1.0 for a prior query (no informative word)\n    familiarization: jnp.ndarray  # (N_OBJ,) base rate seen in familiarization, 0..1\n    has_familiarization: jnp.ndarray  # () 1.0 when there was a familiarization phase\n    grayscale: jnp.ndarray  # (N_OBJ,) 1.0 for an object shown in grayscale\n    valence: jnp.ndarray  # () +1 \"favorite\" framing, -1 \"least favorite\", 0 neutral\n\n\n@dataclass(frozen=True)\nclass Context:\n    \"\"\"One trial's display. ``utterance`` indexes ``feature_names`` (None: prior query).\"\"\"\n\n    objects: Tuple[Tuple[int, ...], ...]\n    feature_names: Tuple[str, ...]\n    utterance: Optional[int]\n    item: str = \"\"\n    familiarization: Optional[Tuple[float, ...]] = None\n    grayscale: Optional[Tuple[int, ...]] = None\n    valence: int = 0\n    # Feature indices the speaker can name (the message set). None: every\n    # feature is a word (pragmods). In the Franke & Degen game some features\n    # (e.g. square, blue) have no word, which changes which inferences hold.\n    messages: Optional[Tuple[int, ...]] = None\n\n    def __post_init__(self) -> None:\n        objects = tuple(tuple(int(v) for v in row) for row in self.objects)\n        object.__setattr__(self, \"objects\", objects)\n        object.__setattr__(self, \"feature_names\", tuple(self.feature_names))\n        if not objects:\n            raise ValueError(\"a context needs at least one object\")\n        n_features = len(self.feature_names)\n        if any(len(row) != n_features for row in objects):\n            raise ValueError(\n                f\"objects must be rectangular with one entry per feature \"\n                f\"({n_features}): {objects}\"\n            )\n        if any(v not in (0, 1) for row in objects for v in row):\n            raise ValueError(f\"object features must be 0/1: {objects}\")\n        if self.messages is not None:\n            messages = tuple(int(m) for m in self.messages)\n            object.__setattr__(self, \"messages\", messages)\n            if not messages or len(set(messages)) != len(messages):\n                raise ValueError(f\"messages must be distinct feature indices: {messages}\")\n            if any(not 0 <= m < n_features for m in messages):\n                raise ValueError(f\"messages {messages} are not all feature indices (0..{n_features - 1})\")\n        if self.utterance is not None:\n            if self.messages is not None and self.utterance not in self.messages:\n                raise ValueError(\n                    f\"utterance {self.feature_names[self.utterance]!r} is not in the message set\"\n                )\n            if not 0 <= self.utterance < n_features:\n                raise ValueError(\n                    f\"utterance {self.utterance} is not a feature index (0..{n_features - 1})\"\n                )\n            if not any(row[self.utterance] for row in objects):\n                raise ValueError(\n                    f\"utterance {self.feature_names[self.utterance]!r} is true of no object\"\n                )\n        for name in (\"familiarization\", \"grayscale\"):\n            value = getattr(self, name)\n            if value is not None:\n                value = tuple(value)\n                object.__setattr__(self, name, value)\n                if len(value) != len(objects):\n                    raise ValueError(f\"{name} needs one per object: {value}\")\n        if self.familiarization is not None and not all(\n            0.0 <= f <= 1.0 for f in self.familiarization\n        ):\n            raise ValueError(f\"familiarization rates must be in [0, 1]: {self.familiarization}\")\n        if self.grayscale is not None and any(g not in (0, 1) for g in self.grayscale):\n            raise ValueError(f\"grayscale must be 0/1 per object: {self.grayscale}\")\n        if self.valence not in (-1, 0, 1):\n            raise ValueError(f\"valence must be -1, 0 or 1: {self.valence}\")\n\n    @property\n    def nameable(self) -> Tuple[int, ...]:\n        \"\"\"Feature indices the speaker can name (every feature without a message set).\"\"\"\n        return tuple(range(len(self.feature_names))) if self.messages is None else tuple(sorted(self.messages))\n\n    @property\n    def present_features(self) -> Tuple[int, ...]:\n        \"\"\"Nameable feature indices true of at least one object: the context's words.\"\"\"\n        return tuple(f for f in self.nameable if any(row[f] for row in self.objects))\n\n    @property\n    def needs_sink(self) -> bool:\n        \"\"\"Whether some object has no word true of it (no nameable feature).\"\"\"\n        return any(not any(row[f] for f in self.nameable) for row in self.objects)\n\n    @property\n    def utterance_names(self) -> Tuple[str, ...]:\n        names = tuple(self.feature_names[f] for f in self.present_features)\n        return names + ((SINK,) if self.needs_sink else ())\n\n    @property\n    def shape(self) -> Tuple[int, int]:\n        \"\"\"(N_OBJ, N_UTT): the domain sizes a model is compiled for.\"\"\"\n        return (len(self.objects), len(self.utterance_names))\n\n    def lexicon(self) -> np.ndarray:\n        \"\"\"(N_UTT, N_OBJ) truth table of utterances over objects, sink last.\"\"\"\n        rows = [[row[f] for row in self.objects] for f in self.present_features]\n        if self.needs_sink:\n            rows.append([int(not any(row[f] for f in self.nameable)) for row in self.objects])\n        return np.asarray(rows, dtype=np.float32)\n\n    def choice_classes(self) -> Tuple[int, ...]:\n        \"\"\"Each object's choice class: the index of the first object identical to it.\n\n        Objects with the same features, familiarization rate and colour are\n        indistinguishable to every model (they get identical inputs) and, in\n        the pragmods data, often to the record of which was chosen. The fit\n        observes a choice as its class (`src.rsa.fit.class_probs`).\n        \"\"\"\n        keys = [\n            (\n                row,\n                None if self.familiarization is None else self.familiarization[i],\n                None if self.grayscale is None else self.grayscale[i],\n            )\n            for i, row in enumerate(self.objects)\n        ]\n        return tuple(keys.index(k) for k in keys)\n\n    def arrays(self) -> ContextArrays:\n        n_obj, n_utt = self.shape\n        lex = self.lexicon()\n        is_sink = np.zeros(n_utt, dtype=np.float32)\n        if self.needs_sink:\n            is_sink[-1] = 1.0\n        if self.utterance is None:\n            utterance, is_prior = 0, 1.0\n        else:\n            utterance, is_prior = self.present_features.index(self.utterance), 0.0\n        familiarization = (\n            np.zeros(n_obj) if self.familiarization is None else np.asarray(self.familiarization)\n        )\n        grayscale = np.zeros(n_obj) if self.grayscale is None else np.asarray(self.grayscale)\n        return ContextArrays(\n            lex=jnp.asarray(lex),\n            is_sink=jnp.asarray(is_sink),\n            feature_count=jnp.asarray((lex * (1 - is_sink)[:, None]).sum(axis=0)),\n            utterance=jnp.asarray(utterance, dtype=jnp.int32),\n            is_prior=jnp.asarray(is_prior, dtype=jnp.float32),\n            familiarization=jnp.asarray(familiarization, dtype=jnp.float32),\n            has_familiarization=jnp.asarray(\n                float(self.familiarization is not None), dtype=jnp.float32\n            ),\n            grayscale=jnp.asarray(grayscale, dtype=jnp.float32),\n            valence=jnp.asarray(float(self.valence), dtype=jnp.float32),\n        )\n\n\n@dataclass(frozen=True)\nclass ShapeGroup:\n    \"\"\"Same-shape trials: their positions in the input and their stacked arrays.\"\"\"\n\n    shape: Tuple[int, int]\n    indices: np.ndarray\n    arrays: ContextArrays\n    classes: np.ndarray  # (trials, N_OBJ) choice class of each object (`Context.choice_classes`)\n\n\ndef stack(arrays: Sequence[ContextArrays]) -> ContextArrays:\n    return ContextArrays(*(jnp.stack(field) for field in zip(*arrays)))\n\n\ndef group_by_shape(contexts: Sequence[Context]) -> Dict[Tuple[int, int], ShapeGroup]:\n    \"\"\"Group contexts by (N_OBJ, N_UTT), keeping input order within a group.\"\"\"\n    by_shape: Dict[Tuple[int, int], List[int]] = {}\n    for i, ctx in enumerate(contexts):\n        by_shape.setdefault(ctx.shape, []).append(i)\n    return {\n        shape: ShapeGroup(\n            shape=shape,\n            indices=np.asarray(idx),\n            arrays=stack([contexts[i].arrays() for i in idx]),\n            classes=np.asarray([contexts[i].choice_classes() for i in idx], dtype=np.int32),\n        )\n        for shape, idx in sorted(by_shape.items())\n    }","lineStart":1,"lineEnd":224,"totalLines":224,"truncated":false}},"title":"src/rsa/context.py","time":{"start":1791357288580,"end":1791357288596}},"metadata":{"google":{"thoughtSignature":"Er0BCroBAWkUfRNB4EmHNHOnvZ/ZEIPVLOuAxoHSQq/1aFN/tNfIvMnq8T3HQ9DXqeW64BvibX4q23hr4R0Io4N5pkjl/GX4FyNUY5hXt+Pi9EcpWQV9pzB7Cq/7lxcJmbFHAtT0cA61c38YQFjmOmI0EalwPvhQKjnJWlvszmC+rQcvtHt9IS41mGH7i/bohTTx7aP+enmLJvsi00ZF7kuQApuG1wrf92otvxXKqB8hr/KQiVLXoKGxnk3upPnJ"}},"id":"prt_11537007b001mKNbg30QYJCOl0","sessionID":"ses_eeac95740ffejVNLcFbklV5Ztd","messageID":"msg_11536f681001WpkvBwADwerIYi"}}
