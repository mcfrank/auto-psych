.elpd_loo})\")\n132:     try:\n133:         preds = posterior_mean_class_probs(model, fitted, pool)\n134:     except ValueError as exc:\n135:         return _refuse(str(exc))\n136:     nearest, dist = closest(preds, admitted_preds)\n137:     if dist < cfg.novelty_threshold:\n138:         return Admission(\n139:             admitted=False,\n140:             reason=(\n141:                 f\"not novel: its predictions are within RMSE {dist:.4f} of {nearest}'s \"\n142:                 f\"(threshold {cfg.novelty_threshold}) over the loop's novelty pool of \"\n143:                 f\"{len(pool)} displays. A re-parameterisation of an existing mechanism is \"\n144:                 f\"not a new hypothesis; change what the listener or speaker computes.\"\n145:             ),\n146:             fit=fitted, pool_preds=preds, elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n147:         )\n148:     return Admission(\n149:         admitted=True, reason=\"admitted\", fit=fitted, pool_preds=preds,\n150:         elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n151:     )\n152: \n153: \n154: def pool_predictions_for(\n155:     models: Mapping[str, RSAModel], fits: Mapping[str, RSAFit], pool: Sequence[Context]\n156: ) -> Dict[str, np.ndarray]:\n157:     return {n: posterior_mean_class_probs(models[n], fits[n], pool) for n in models}\n\n(End of file - total 157 lines)\n</content>","metadata":{"preview":"        return _refuse(\n            \"the code gate refused candidate.py: \" + \", \".join(problems)\n            + \". Model files may import jax, memo, numpyro, numpy, a few stdlib modules \"\n            \"and src.rsa.memo_kit only, and may not read files or reach the interpreter.\"\n        )\n    try:\n        model = RSAModel(model_path, name=name)\n        check_contract(model, group_by_shape(training))\n        check_contract(model, group_by_shape(pool))\n    except ModelContractViolation as exc:\n        return _refuse(f\"contract: {exc}\")\n    except Exception as exc:  # memo compile errors, errors in the model's own code\n        from src.rsa.loop.fitting import is_model_failure\n\n        if is_model_failure(exc, model_path):\n            return _refuse(f\"the model failed to load or run: {type(exc).__name__}: {exc}\")\n        raise\n    try:\n        fitted = fit_with_refit(model_path, name, cfg)\n    except ModelFailure as exc:","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/gates.py","text":"        return _refuse(\n            \"the code gate refused candidate.py: \" + \", \".join(problems)\n            + \". Model files may import jax, memo, numpyro, numpy, a few stdlib modules \"\n            \"and src.rsa.memo_kit only, and may not read files or reach the interpreter.\"\n        )\n    try:\n        model = RSAModel(model_path, name=name)\n        check_contract(model, group_by_shape(training))\n        check_contract(model, group_by_shape(pool))\n    except ModelContractViolation as exc:\n        return _refuse(f\"contract: {exc}\")\n    except Exception as exc:  # memo compile errors, errors in the model's own code\n        from src.rsa.loop.fitting import is_model_failure\n\n        if is_model_failure(exc, model_path):\n            return _refuse(f\"the model failed to load or run: {type(exc).__name__}: {exc}\")\n        raise\n    try:\n        fitted = fit_with_refit(model_path, name, cfg)\n    except ModelFailure as exc:\n        return _refuse(f\"fitting failed: {exc}\")\n    if not fitted.converged:\n        return _refuse(\n            \"the fit did not converge even at target_accept 0.95: \"\n            + \"; \".join(fitted.convergence_problems)\n            + \". Reparameterise (e.g. sample on an unconstrained scale, tighten priors) \"\n            \"rather than relying on smaller steps.\"\n        )\n    loo = fitted.loo()\n    if not math.isfinite(loo.elpd_loo):\n        return _refuse(f\"ELPD-LOO is not finite ({loo.elpd_loo})\")\n    try:\n        preds = posterior_mean_class_probs(model, fitted, pool)\n    except ValueError as exc:\n        return _refuse(str(exc))\n    nearest, dist = closest(preds, admitted_preds)\n    if dist < cfg.novelty_threshold:\n        return Admission(\n            admitted=False,\n            reason=(\n                f\"not novel: its predictions are within RMSE {dist:.4f} of {nearest}'s \"\n                f\"(threshold {cfg.novelty_threshold}) over the loop's novelty pool of \"\n                f\"{len(pool)} displays. A re-parameterisation of an existing mechanism is \"\n                f\"not a new hypothesis; change what the listener or speaker computes.\"\n            ),\n            fit=fitted, pool_preds=preds, elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n        )\n    return Admission(\n        admitted=True, reason=\"admitted\", fit=fitted, pool_preds=preds,\n        elpd_loo=loo.elpd_loo, loo_reliable=not loo.unreliable,\n    )\n\n\ndef pool_predictions_for(\n    models: Mapping[str, RSAModel], fits: Mapping[str, RSAFit], pool: Sequence[Context]\n) -> Dict[str, np.ndarray]:\n    return {n: posterior_mean_class_probs(models[n], fits[n], pool) for n in models}","lineStart":101,"lineEnd":157,"totalLines":157,"truncated":false}},"title":"src/rsa/loop/gates.py","time":{"start":1791346143952,"end":1791346143986}},"metadata":{"google":{"thoughtSignature":"EsABCr0BAWkUfRMOel4CnAYD3VRgLQAjfsZ6+kXCl2NHZCJzwXqZPJdecZluYQq9vkOH767i3+WGesxxEf2NFaEjrQXB7CBw0mGeZv7wwj/BZa9sGFxPyVUtUepbzZScmfjtV3Mfh9bpVPgZpSH/vjJfDRTgcHlioFRJ9QXp+yWoFukf+/DX+srnQz9Y+9wdS82vUuZ1FDkbS7sGrCvCgIOi8c6ICoE4glgtpe43L6igeiymo4Fg1Vl8pHoRF0sDAeYf"}},"id":"prt_1148cf2b9001wl6KFEHfB1aat3","sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","messageID":"msg_1148ceac3001QQg4Tv2pJJiudG"}}
