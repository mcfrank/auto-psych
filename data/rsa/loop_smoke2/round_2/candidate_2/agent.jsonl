{"type":"step_start","timestamp":1791346223348,"sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","part":{"id":"prt_1148e28e2001Rdd7DwuwHFBjIp","messageID":"msg_1148e188e001BrGdLoqyqhMr3E","sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","type":"step-start"}}
{"type":"tool_use","timestamp":1791346234805,"sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","part":{"type":"tool","tool":"bash","callID":"8uVZ9fLi8mAs1dir","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\nfrom src.rsa.loop.novelty import novelty_pool, closest\nfrom src.rsa.context import group_by_shape\nfrom src.rsa.fit import class_probs\nimport numpy as np\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\ndef choice_probs_l1(params, ctx):\n    feat_weight = params['w_features'] + params['w_valence'] * ctx.valence\n    prior = softmax_prior(\n        feat_weight * ctx.feature_count + params['w_familiar'] * ctx.familiarization\n    )\n    heard = L1(params['alpha'], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params['lapse'])\n\ndef choice_probs_l2(params, ctx):\n    feat_weight = params['w_features'] + params['w_valence'] * ctx.valence\n    prior = softmax_prior(\n        feat_weight * ctx.feature_count + params['w_familiar'] * ctx.familiarization\n    )\n    heard = L2(params['alpha'], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params['lapse'])\n\npool = novelty_pool()\n# test on a subset or full pool\nparams = {'alpha': 0.6, 'w_features': -0.1, 'w_valence': 1.0, 'w_familiar': 1.5, 'lapse': 0.04}\n\n# Let's compute RMSE between L1 and L2 on the pool\np_l1_list, p_l2_list = [], []\nfor c in pool[:100]:\n    p_l1 = np.asarray(choice_probs_l1(params, c.as_jax_context()))\n    p_l2 = np.asarray(choice_probs_l2(params, c.as_jax_context()))\n    p_l1_list.append(p_l1)\n    p_l2_list.append(p_l2)\n\np_l1_all = np.concatenate(p_l1_list)\np_l2_all = np.concatenate(p_l2_list)\nrmse = np.sqrt(np.mean((p_l1_all - p_l2_all)**2))\nprint('RMSE on first 100 pool items:', rmse)\n\""},"output":"memo.core.MemoError: Python couldn't find your memo source code\n\n  hint: You cannot define a new @memo in the Python interactive REPL.\n        Try writing your memo code to a file and running via `python\n        filename.py`. If you really want an interactive experience,\n        memo also works inside Jupyter notebooks.\n\n  info: You are using memo 1.3.0, JAX 0.7.0, Python 3.12.3 on Linux.\n","metadata":{"output":"memo.core.MemoError: Python couldn't find your memo source code\n\n  hint: You cannot define a new @memo in the Python interactive REPL.\n        Try writing your memo code to a file and running via `python\n        filename.py`. If you really want an interactive experience,\n        memo also works inside Jupyter notebooks.\n\n  info: You are using memo 1.3.0, JAX 0.7.0, Python 3.12.3 on Linux.\n","exit":1,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\nfrom src.rsa.memo_kit import EPS, at, softmax