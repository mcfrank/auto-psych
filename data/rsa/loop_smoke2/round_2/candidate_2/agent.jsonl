{'alpha': 0.6, 'w_features': -0.1, 'w_valence': 1.0, 'w_familiar': 1.5, 'lapse': 0.04}\n\n# Let's compute RMSE between L1 and L2 on the pool\np_l1_list, p_l2_list = [], []\nfor c in pool[:100]:\n    p_l1 = np.asarray(choice_probs_l1(params, c.as_jax_context()))\n    p_l2 = np.asarray(choice_probs_l2(params, c.as_jax_context()))\n    p_l1_list.append(p_l1)\n    p_l2_list.append(p_l2)\n\np_l1_all = np.concatenate(p_l1_list)\np_l2_all = np.concatenate(p_l2_list)\nrmse = np.sqrt(np.mean((p_l1_all - p_l2_all)**2))\nprint('RMSE on first 100 pool items:', rmse)\n\"","time":{"start":1791346229880,"end":1791346234774}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148e426a0011xlwi7ucmh87ws","sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","messageID":"msg_1148e188e001BrGdLoqyqhMr3E"}}
