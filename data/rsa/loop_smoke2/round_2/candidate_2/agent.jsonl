{"type":"tool_use","timestamp":1791346141900,"sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","part":{"type":"tool","tool":"read","callID":"AGkVVWbWQHFHZkbn","state":{"status":"completed","input":{"offset":1,"filePath":"/home/user/auto-psych/src/rsa/loop/gates.py","limit":100},"output":"<path>/home/user/auto-psych/src/rsa/loop/gates.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n2: \n3: A candidate directory must hold ``candidate.py`` (the model file) and\n4: ``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\n5: It is admitted only if, in order:\n6: \n7: 1. the code gate passes (`src.rsa.loop.code_gate`);\n8: 2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n9:    on the training displays AND on every shape of the novelty pool, so a model\n10:    that breaks on a 4 x 4 game is refused before any sampling;\n11: 3. it fits within the time limit, gives no observed choice probability zero,\n12:    and passes the convergence gate (one refit at target_accept 0.95 with a\n13:    fresh seed when the first fit fails it);\n14: 4. its ELPD-LOO is finite;\n15: 5. it is novel: its posterior-mean pool predictions are at least the\n16:    threshold (RMSE) from every admitted model's.\n17: \n18: Every refusal carries a reason written for the agent that will be asked to\n19: repair it. Infrastructure failures raise instead.\n20: \"\"\"\n21: \n22: from __future__ import annotations\n23: \n24: import math\n25: from dataclasses import dataclass, replace\n26: from pathlib import Path\n27: from typing import Dict, Mapping, Optional, Sequence\n28: \n29: import numpy as np\n30: \n31: from src.rsa.context import Context, group_by_shape\n32: from src.rsa.fit import FitSettings, RSAFit\n33: from src.rsa.loop.code_gate import code_problems\n34: from src.rsa.loop.fitting import ModelFailure, fit_cached\n35: from src.rsa.loop.novelty import closest, posterior_mean_class_probs\n36: from src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\n37: \n38: REFIT_TARGET_ACCEPT = 0.95\n39: \n40: \n41: @dataclass\n42: class Admission:\n43:     admitted: bool\n44:     reason: str\n45:     fit: Optional[RSAFit] = None\n46:     pool_preds: Optional[np.ndarray] = None\n47:     elpd_loo: Optional[float] = None\n48:     loo_reliable: Optional[bool] = None\n49: \n50: \n51: @dataclass(frozen=True)\n52: class GateConfig:\n53:     responses_path: Path\n54:     cache_dir: Path\n55:     settings: FitSettings\n56:     novelty_threshold: float\n57:     time_limit_sec: Optional[float]\n58: \n59: \n60: def _refuse(reason: str) -> Admission:\n61:     return Admission(admitted=False, reason=reason)\n62: \n63: \n64: def read_candidate(candidate_dir: Path) -> Optional[str]:\n65:     \"\"\"The reason a candidate directory is incomplete, or None.\"\"\"\n66:     for required in (\"candidate.py\", \"hypothesis.md\"):\n67:         f = Path(candidate_dir) / required\n68:         if not f.exists() or not f.read_text(encoding=\"utf-8\").strip():\n69:             return f\"{required} is missing or empty\"\n70:     return None\n71: \n72: \n73: def fit_with_refit(model_path: Path, name: str, cfg: GateConfig) -> RSAFit:\n74:     fitted = fit_cached(model_path, name, cfg.responses_path, cfg.settings, cfg.cache_dir,\n75:                         time_limit_sec=cfg.time_limit_sec)\n76:     if fitted.converged:\n77:         return fitted\n78:     retry = replace(cfg.settings, target_accept=max(cfg.settings.target_accept, REFIT_TARGET_ACCEPT),\n79:                     seed=cfg.settings.seed + 1)\n80:     return fit_cached(model_path, name, cfg.responses_path, retry, cfg.cache_dir,\n81:                       time_limit_sec=cfg.time_limit_sec)\n82: \n83: \n84: def admit(\n85:     candidate_dir: Path,\n86:     name: str,\n87:     *,\n88:     cfg: GateConfig,\n89:     training: Sequence[Context],\n90:     pool: Sequence[Context],\n91:     admitted_preds: Mapping[str, np.ndarray],\n92: ) -> Admission:\n93:     candidate_dir = Path(candidate_dir)\n94:     missing = read_candidate(candidate_dir)\n95:     if missing:\n96:         return _refuse(missing)\n97:     model_path = candidate_dir / \"candidate.py\"\n98:     source = model_path.read_text(encoding=\"utf-8\")\n99:     problems = code_problems(source)\n100:     if problems:\n\n(Showing lines 1-100 of 157. Use offset=101 to continue.)\n</content>","metadata":{"preview":"\"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n\nA candidate directory must hold ``candidate.py`` (the model file) and\n``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\nIt is admitted only if, in order:\n\n1. the code gate passes (`src.rsa.loop.code_gate`);\n2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n   on the training displays AND on every shape of the novelty pool, so a model\n   that breaks on a 4 x 4 game is refused before any sampling;\n3. it fits within the time limit, gives no observed choice probability zero,\n   and passes the convergence gate (one refit at target_accept 0.95 with a\n   fresh seed when the first fit fails it);\n4. its ELPD-LOO is finite;\n5. it is novel: its posterior-mean pool predictions are at least the\n   threshold (RMSE) from every admitted model's.\n\nEvery refusal carries a reason written for the agent that will be asked to\nrepair it. Infrastructure failures raise instead.\n\"\"\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/gates.py","text":"\"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n\nA candidate directory must hold ``candidate.py`` (the model file) and\n``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\nIt is admitted only if, in order:\n\n1. the code gate passes (`src.rsa.loop.code_gate`);\n2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n   on the training displays AND on every shape of the novelty pool, so a model\n   that breaks on a 4 x 4 game is refused before any sampling;\n3. it fits within the time limit, gives no observed choice probability zero,\n   and passes the convergence gate (one refit at target_accept 0.95 with a\n   fresh seed when the first fit fails it);\n4. its ELPD-LOO is finite;\n5. it is novel: its posterior-mean pool predictions are at least the\n   threshold (RMSE) from every admitted model's.\n\nEvery refusal carries a reason written for the agent that will be asked to\nrepair it. Infrastructure failures raise instead.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom dataclasses import dataclass, replace\nfrom pathlib import Path\nfrom typing import Dict, Mapping, Optional, Sequence\n\nimport numpy as np\n\nfrom src.rsa.context import Context, group_by_shape\nfrom src.rsa.fit import FitSettings, RSAFit\nfrom src.rsa.loop.code_gate import code_problems\nfrom src.rsa.loop.fitting import ModelFailure, fit_cached\nfrom src.rsa.loop.novelty import closest, posterior_mean_class_probs\nfrom src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\n\nREFIT_TARGET_ACCEPT = 0.95\n\n\n@dataclass\nclass Admission:\n    admitted: bool\n    reason: str\n    fit: Optional[RSAFit] = None\n    pool_preds: Optional[np.ndarray] = None\n    elpd_loo: Optional[float] = None\n    loo_reliable: Optional[bool] = None\n\n\n@dataclass(frozen=True)\nclass GateConfig:\n    responses_path: Path\n    cache_dir: Path\n    settings: FitSettings\n    novelty_threshold: float\n    time_limit_sec: Optional[float]\n\n\ndef _refuse(reason: str) -> Admission:\n    return Admission(admitted=False, reason=reason)\n\n\ndef read_candidate(candidate_dir: Path) -> Optional[str]:\n    \"\"\"The reason a candidate directory is incomplete, or None.\"\"\"\n    for required in (\"candidate.py\", \"hypothesis.md\"):\n        f = Path(candidate_dir) / required\n        if not f.exists() or not f.read_text(encoding=\"utf-8\").strip():\n            return f\"{required} is missing or empty\"\n    return None\n\n\ndef fit_with_refit(model_path: Path, name: str, cfg: GateConfig) -> RSAFit:\n    fitted = fit_cached(model_path, name, cfg.responses_path, cfg.settings, cfg.cache_dir,\n                        time_limit_sec=cfg.time_limit_sec)\n    if fitted.converged:\n        return fitted\n    retry = replace(cfg.settings, target_accept=max(cfg.settings.target_accept, REFIT_TARGET_ACCEPT),\n                    seed=cfg.settings.seed + 1)\n    return fit_cached(model_path, name, cfg.responses_path, retry, cfg.cache_dir,\n                      time_limit_sec=cfg.time_limit_sec)\n\n\ndef admit(\n    candidate_dir: Path,\n    name: str,\n    *,\n    cfg: GateConfig,\n    training: Sequence[Context],\n    pool: Sequence[Context],\n    admitted_preds: Mapping[str, np.ndarray],\n) -> Admission:\n    candidate_dir = Path(candidate_dir)\n    missing = read_candidate(candidate_dir)\n    if missing:\n        return _refuse(missing)\n    model_path = candidate_dir / \"candidate.py\"\n    source = model_path.read_text(encoding=\"utf-8\")\n    problems = code_problems(source)\n    if problems:","lineStart":1,"lineEnd":100,"totalLines":157,"truncated":true}},"title":"src/rsa/loop/gates.py","time":{"start":1791346141811,"end":1791346141868}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148cea6b0014W2tmWWPNjaaLn","sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","messageID":"msg_1148cdeb2001IbYbkJmDxUIvWa"}}
