{"type":"tool_use","timestamp":1791346199309,"sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","part":{"type":"tool","tool":"read","callID":"9Ld5gRhJMdcFIyOm","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/loop/fitting.py","limit":60,"offset":1},"output":"<path>/home/user/auto-psych/src/rsa/loop/fitting.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n2: \n3: A fit is content-addressed by (model file sha, responses file sha, sampler\n4: settings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n5: ``.json`` (parameter names, convergence problems). A cached fit is reused,\n6: never recomputed; files are written under a temporary name and\n7: ``os.replace``d into place.\n8: \n9: A fit can run in a spawned child process with a time limit (agent-written\n10: candidates: a pathological model must not stall the loop). Failures are\n11: classified as in the PyMC domain: a failure of the model itself (its own\n12: code raised, memo refused to compile it, it broke the contract, it gives an\n13: observed choice probability zero) is a `ModelFailure` the caller turns into a\n14: rejection; anything else (a killed worker, an unreadable file, OSError,\n15: MemoryError) is infrastructure and raises.\n16: \"\"\"\n17: \n18: from __future__ import annotations\n19: \n20: import hashlib\n21: import json\n22: import multiprocessing as mp\n23: import os\n24: import traceback\n25: from dataclasses import asdict, dataclass\n26: from pathlib import Path\n27: from typing import Any, List, Optional\n28: \n29: from src.rsa.fit import FitSettings, RSAFit, ZeroProbabilityChoice\n30: \n31: FIT_TIME_LIMIT_SEC = 30 * 60  # as the PyMC domain's CANDIDATE_FIT_TIME_LIMIT_SEC\n32: \n33: \n34: class ModelFailure(RuntimeError):\n35:     \"\"\"The model failed (a rejection), as opposed to the infrastructure.\"\"\"\n36: \n37: \n38: class FitTimeLimitExceeded(ModelFailure):\n39:     \"\"\"The fit did not finish within the time limit (the model is too slow).\"\"\"\n40: \n41: \n42: def _sha_file(path: Path) -> str:\n43:     return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n44: \n45: \n46: def fingerprint(model_path: Path, responses_path: Path, settings: FitSettings) -> str:\n47:     h = hashlib.sha256()\n48:     h.update(_sha_file(model_path).encode())\n49:     h.update(_sha_file(responses_path).encode())\n50:     h.update(json.dumps(asdict(settings), sort_keys=True).encode())\n51:     return h.hexdigest()[:20]\n52: \n53: \n54: def cache_paths(cache_dir: Path, name: str, fp: str) -> tuple[Path, Path]:\n55:     base = Path(cache_dir) / f\"{name}.{fp}\"\n56:     return base.with_suffix(\".nc\"), base.with_suffix(\".json\")\n57: \n58: \n59: def _model_failure_types() -> tuple:\n60:     from memo.core import MemoError\n\n(Showing lines 1-60 of 192. Use offset=61 to continue.)\n</content>","metadata":{"preview":"\"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n\nA fit is content-addressed by (model file sha, responses file sha, sampler\nsettings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n``.json`` (parameter names, convergence problems). A cached fit is reused,\nnever recomputed; files are written under a temporary name and\n``os.replace``d into place.\n\nA fit can run in a spawned child process with a time limit (agent-written\ncandidates: a pathological model must not stall the loop). Failures are\nclassified as in the PyMC domain: a failure of the model itself (its own\ncode raised, memo refused to compile it, it broke the contract, it gives an\nobserved choice probability zero) is a `ModelFailure` the caller turns into a\nrejection; anything else (a killed worker, an unreadable file, OSError,\nMemoryError) is infrastructure and raises.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/fitting.py","text":"\"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n\nA fit is content-addressed by (model file sha, responses file sha, sampler\nsettings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n``.json`` (parameter names, convergence problems). A cached fit is reused,\nnever recomputed; files are written under a temporary name and\n``os.replace``d into place.\n\nA fit can run in a spawned child process with a time limit (agent-written\ncandidates: a pathological model must not stall the loop). Failures are\nclassified as in the PyMC domain: a failure of the model itself (its own\ncode raised, memo refused to compile it, it broke the contract, it gives an\nobserved choice probability zero) is a `ModelFailure` the caller turns into a\nrejection; anything else (a killed worker, an unreadable file, OSError,\nMemoryError) is infrastructure and raises.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport multiprocessing as mp\nimport os\nimport traceback\nfrom dataclasses import asdict, dataclass\nfrom pathlib import Path\nfrom typing import Any, List, Optional\n\nfrom src.rsa.fit import FitSettings, RSAFit, ZeroProbabilityChoice\n\nFIT_TIME_LIMIT_SEC = 30 * 60  # as the PyMC domain's CANDIDATE_FIT_TIME_LIMIT_SEC\n\n\nclass ModelFailure(RuntimeError):\n    \"\"\"The model failed (a rejection), as opposed to the infrastructure.\"\"\"\n\n\nclass FitTimeLimitExceeded(ModelFailure):\n    \"\"\"The fit did not finish within the time limit (the model is too slow).\"\"\"\n\n\ndef _sha_file(path: Path) -> str:\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef fingerprint(model_path: Path, responses_path: Path, settings: FitSettings) -> str:\n    h = hashlib.sha256()\n    h.update(_sha_file(model_path).encode())\n    h.update(_sha_file(responses_path).encode())\n    h.update(json.dumps(asdict(settings), sort_keys=True).encode())\n    return h.hexdigest()[:20]\n\n\ndef cache_paths(cache_dir: Path, name: str, fp: str) -> tuple[Path, Path]:\n    base = Path(cache_dir) / f\"{name}.{fp}\"\n    return base.with_suffix(\".nc\"), base.with_suffix(\".json\")\n\n\ndef _model_failure_types() -> tuple:\n    from memo.core import MemoError","lineStart":1,"lineEnd":60,"totalLines":192,"truncated":true}},"title":"src/rsa/loop/fitting.py","time":{"start":1791346199240,"end":1791346199262}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148dcabc001qnopMu1qQ2OdNH","sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","messageID":"msg_1148dc027001F4olcqiNPgxIIS"}}
