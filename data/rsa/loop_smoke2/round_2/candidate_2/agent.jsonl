{"type":"tool_use","timestamp":1791346201634,"sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","part":{"type":"tool","tool":"read","callID":"0X9sPNiTDzLPMh7T","state":{"status":"completed","input":{"limit":80,"offset":1,"filePath":"/home/user/auto-psych/src/rsa/loop/orchestrator.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/orchestrator.py</path>\n<type>file</type>\n<content>\n1: \"\"\"The RSA inner loop: agents propose memo models; the data decide.\n2: \n3: A parallel of the PyMC domain's `src.pipelines.inner_loop.pymc_orchestrator`\n4: that reuses its domain-neutral parts unchanged (slot roles and the lens walk,\n5: the hypothesis ledger, the agent launcher, the LOO reliability verdict and\n6: convergence gate, the clustered SE of an ELPD difference) and has its own\n7: memo admission (`src.rsa.loop.gates`), fitting and novelty pool.\n8: \n9: Layout under ``results_dir``::\n10: \n11:     responses.csv               the trials the loop fits (copied in once)\n12:     models/                     the live set: <name>.py + models_manifest.yaml\n13:     models/pruned/              models pruned or retired at the end\n14:     attempted_hypotheses.jsonl  the ledger (every slot, admitted or not)\n15:     novelty_pool.json           the novelty gate's displays\n16:     .fit_cache/                 content-addressed fits\n17:     round_<k>/candidate_<i>[_retry_1|_repair_1]/   agent working directories\n18:     steps/step_<n>/             comparison.csv, params.csv, cells.csv, summary.json\n19:     history.json                one entry per scoring step\n20:     report.html                 the latest report page (src.rsa.report)\n21:     best_model.py, export.json  the exported winner\n22: \n23: Each round: spawn every slot's agent concurrently; re-spawn once a slot that\n24: wrote no candidate.py; admit sequentially; re-spawn once, with the reason, a\n25: candidate that was refused; admit the repairs; score. At the end: prune\n26: models distinguishable from the best trusted model, cap the live set, export.\n27: \"\"\"\n28: \n29: from __future__ import annotations\n30: \n31: import json\n32: import re\n33: import shutil\n34: from concurrent.futures import ThreadPoolExecutor\n35: from dataclasses import dataclass, field\n36: from pathlib import Path\n37: from typing import Callable, Dict, List, Optional\n38: \n39: import numpy as np\n40: import pandas as pd\n41: import yaml\n42: \n43: from src.models.clustered_se import cluster_dse\n44: from src.models.model_manifest import read_manifest_entries\n45: from src.pipelines.inner_loop.hypothesis_ledger import (\n46:     LEDGER_FILENAME,\n47:     HypothesisLedger,\n48:     LedgerEntry,\n49:     collapse_whitespace,\n50: )\n51: from src.pipelines.inner_loop.model_zoo import (\n52:     SLOT_EXPLORE,\n53:     _lens_index,\n54:     exploratory_slots_per_round,\n55:     slot_roles,\n56: )\n57: from src.rsa.dataset import load_forced_choice\n58: from src.rsa.fit import FitSettings, RSAFit, compare\n59: from src.rsa.loop import brief as briefs\n60: from src.rsa.loop.fitting import FIT_TIME_LIMIT_SEC, ModelFailure\n61: from src.rsa.loop.gates import GateConfig, admit, fit_with_refit\n62: from src.rsa.loop.novelty import (\n63:     DEFAULT_NOVELTY_RMSE_THRESHOLD,\n64:     novelty_pool,\n65:     pool_digest,\n66:     pool_record,\n67:     posterior_mean_class_probs,\n68: )\n69: from src.rsa.model_file import RSAModel\n70: \n71: DEFAULT_PRUNE_DSE_MULTIPLIER = 2.0\n72: MAX_LIVE_MODELS = 8\n73: NAME_RE = re.compile(r\"^[a-z][a-z0-9_]{2,39}$\")\n74: DISPLAY_COLUMNS = (\"objects\", \"query\", \"utterance\", \"familiarization\", \"grayscale\", \"framing\")\n75: # The unit the end-of-run prune treats as one observation (clustered SE of an\n76: # ELPD difference): a display within an experimental condition. Clustering by\n77: # display alone (PI decision 2026-10-07 to change it) made the pragmods\n78: # simple display, shared by many experiments, one cluster of thousands of\n79: # trials whose sum dominated the variance: nothing was pruned, not even the\n80: # literal listener 554 nats behind (SE 324). By experiment x condition x\n\n(Showing lines 1-80 of 415. Use offset=81 to continue.)\n</content>","metadata":{"preview":"\"\"\"The RSA inner loop: agents propose memo models; the data decide.\n\nA parallel of the PyMC domain's `src.pipelines.inner_loop.pymc_orchestrator`\nthat reuses its domain-neutral parts unchanged (slot roles and the lens walk,\nthe hypothesis ledger, the agent launcher, the LOO reliability verdict and\nconvergence gate, the clustered SE of an ELPD difference) and has its own\nmemo admission (`src.rsa.loop.gates`), fitting and novelty pool.\n\nLayout under ``results_dir``::\n\n    responses.csv               the trials the loop fits (copied in once)\n    models/                     the live set: <name>.py + models_manifest.yaml\n    models/pruned/              models pruned or retired at the end\n    attempted_hypotheses.jsonl  the ledger (every slot, admitted or not)\n    novelty_pool.json           the novelty gate's displays\n    .fit_cache/                 content-addressed fits\n    round_<k>/candidate_<i>[_retry_1|_repair_1]/   agent working directories\n    steps/step_<n>/             comparison.csv, params.csv, cells.csv, summary.json\n    history.json                one entry per scoring step\n    report.html                 the latest report page (src.rsa.report)","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/orchestrator.py","text":"\"\"\"The RSA inner loop: agents propose memo models; the data decide.\n\nA parallel of the PyMC domain's `src.pipelines.inner_loop.pymc_orchestrator`\nthat reuses its domain-neutral parts unchanged (slot roles and the lens walk,\nthe hypothesis ledger, the agent launcher, the LOO reliability verdict and\nconvergence gate, the clustered SE of an ELPD difference) and has its own\nmemo admission (`src.rsa.loop.gates`), fitting and novelty pool.\n\nLayout under ``results_dir``::\n\n    responses.csv               the trials the loop fits (copied in once)\n    models/                     the live set: <name>.py + models_manifest.yaml\n    models/pruned/              models pruned or retired at the end\n    attempted_hypotheses.jsonl  the ledger (every slot, admitted or not)\n    novelty_pool.json           the novelty gate's displays\n    .fit_cache/                 content-addressed fits\n    round_<k>/candidate_<i>[_retry_1|_repair_1]/   agent working directories\n    steps/step_<n>/             comparison.csv, params.csv, cells.csv, summary.json\n    history.json                one entry per scoring step\n    report.html                 the latest report page (src.rsa.report)\n    best_model.py, export.json  the exported winner\n\nEach round: spawn every slot's agent concurrently; re-spawn once a slot that\nwrote no candidate.py; admit sequentially; re-spawn once, with the reason, a\ncandidate that was refused; admit the repairs; score. At the end: prune\nmodels distinguishable from the best trusted model, cap the live set, export.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nimport shutil\nfrom concurrent.futures import ThreadPoolExecutor\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Callable, Dict, List, Optional\n\nimport numpy as np\nimport pandas as pd\nimport yaml\n\nfrom src.models.clustered_se import cluster_dse\nfrom src.models.model_manifest import read_manifest_entries\nfrom src.pipelines.inner_loop.hypothesis_ledger import (\n    LEDGER_FILENAME,\n    HypothesisLedger,\n    LedgerEntry,\n    collapse_whitespace,\n)\nfrom src.pipelines.inner_loop.model_zoo import (\n    SLOT_EXPLORE,\n    _lens_index,\n    exploratory_slots_per_round,\n    slot_roles,\n)\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.fit import FitSettings, RSAFit, compare\nfrom src.rsa.loop import brief as briefs\nfrom src.rsa.loop.fitting import FIT_TIME_LIMIT_SEC, ModelFailure\nfrom src.rsa.loop.gates import GateConfig, admit, fit_with_refit\nfrom src.rsa.loop.novelty import (\n    DEFAULT_NOVELTY_RMSE_THRESHOLD,\n    novelty_pool,\n    pool_digest,\n    pool_record,\n    posterior_mean_class_probs,\n)\nfrom src.rsa.model_file import RSAModel\n\nDEFAULT_PRUNE_DSE_MULTIPLIER = 2.0\nMAX_LIVE_MODELS = 8\nNAME_RE = re.compile(r\"^[a-z][a-z0-9_]{2,39}$\")\nDISPLAY_COLUMNS = (\"objects\", \"query\", \"utterance\", \"familiarization\", \"grayscale\", \"framing\")\n# The unit the end-of-run prune treats as one observation (clustered SE of an\n# ELPD difference): a display within an experimental condition. Clustering by\n# display alone (PI decision 2026-10-07 to change it) made the pragmods\n# simple display, shared by many experiments, one cluster of thousands of\n# trials whose sum dominated the variance: nothing was pruned, not even the\n# literal listener 554 nats behind (SE 324). By experiment x condition x","lineStart":1,"lineEnd":80,"totalLines":415,"truncated":true}},"title":"src/rsa/loop/orchestrator.py","time":{"start":1791346201567,"end":1791346201590}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148dd3d3001nJR17oHf9xbHWc","sessionID":"ses_eeb753660ffeoSxUa5mxs618zH","messageID":"msg_1148dcb00001xJFHdF5S440kx6"}}
