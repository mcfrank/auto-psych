{"type":"tool_use","timestamp":1791346610401,"sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","part":{"type":"tool","tool":"bash","callID":"ZMoppxWJNKLhBvcr","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport jax\nimport jax.numpy as jnp\n\ndef compute_contrast(lex, is_sink):\n    real_lex = lex * (1.0 - is_sink)[:, None]\n    diff = jnp.abs(real_lex[:, :, None] - real_lex[:, None, :])\n    contrast = diff.sum(axis=0).sum(axis=1) / jnp.maximum(real_lex.shape[1] - 1, 1)\n    return contrast\n\njit_contrast = jax.jit(compute_contrast)\nvmap_contrast = jax.vmap(compute_contrast)\n\n# Test 1 trial\nlex = jnp.ones((3, 2))\nis_sink = jnp.zeros(3)\nc = jit_contrast(lex, is_sink)\nprint('1 trial contrast:', c.shape, c)\n\n# Test batch of 5 trials\nb_lex = jnp.ones((5, 3, 2))\nb_sink = jnp.zeros((5, 3))\nbc = vmap_contrast(b_lex, b_sink)\nprint('Batch contrast:', bc.shape)\n\""},"output":"1 trial contrast: (2,) [0. 0.]\nBatch contrast: (5, 2)\n","metadata":{"output":"1 trial contrast: (2,) [0. 0.]\nBatch contrast: (5, 2)\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport jax\nimport jax.numpy as jnp\n\ndef compute_contrast(lex, is_sink):\n    real_lex = lex * (1.0 - is_sink)[:, None]\n    diff = jnp.abs(real_lex[:, :, None] - real_lex[:, None, :])\n    contrast = diff.sum(axis=0).sum(axis=1) / jnp.maximum(real_lex.shape[1] - 1, 1)\n    return contrast\n\njit_contrast = jax.jit(compute_contrast)\nvmap_contrast = jax.vmap(compute_contrast)\n\n# Test 1 trial\nlex = jnp.ones((3, 2))\nis_sink = jnp.zeros(3)\nc = jit_contrast(lex, is_sink)\nprint('1 trial contrast:', c.shape, c)\n\n# Test batch of 5 trials\nb_lex = jnp.ones((5, 3, 2))\nb_sink = jnp.zeros((5, 3))\nbc = vmap_contrast(b_lex, b_sink)\nprint('Batch contrast:', bc.shape)\n\"","time":{"start":1791346608567,"end":1791346610346}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_114940997001HRWPhRif0kJ30q","sessionID":"ses_eeb