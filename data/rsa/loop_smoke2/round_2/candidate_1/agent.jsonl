{"type":"tool_use","timestamp":1791346824150,"sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","part":{"type":"tool","tool":"write","callID":"ieelNEGhaMlvMRwx","state":{"status":"completed","input":{"content":"\"\"\"RSA pragmatic listener with a contextual feature contrast salience prior.\n\nListeners expect speakers to refer to the most distinctive object in a scene,\nweighting referents by their contextual feature contrast (average dissimilarity\nto all other objects in the display). This contrast prior is shared as common\nknowledge between the listener and the simulated speaker, guiding both prior\nchoices and pragmatic disambiguation of informative utterances.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_contrast\": dist.Normal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    real_lex = ctx.lex * (1.0 - ctx.is_sink)[:, None]\n    diff = jnp.abs(real_lex[:, :, None] - real_lex[:, None, :])\n    contrast = diff.sum(axis=0).sum(axis=1) / jnp.maximum(real_lex.shape[1] - 1, 1)\n    prior = softmax_prior(params[\"w_contrast\"] * contrast)\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n","filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/round_2/candidate_1/candidate.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/auto-psych/data/rsa/loop_smoke2/round_2/candidate_1/candidate.py","exists":false,"truncated":false},"title":"data/rsa/loop_smoke2/round_2/candidate_1/candidate.py","time":{"start":1791346824079,"end":1791346824092}},"metadata":{"google":{"thoughtSignature":"EokBCoYBAWkUfROl0r7yOKR5JLYFiW1igml2NxfgAYqp09wui4EA5q2C1nl/FES9TQUGqpe2XjZXJJdVeE5m0L3HPlSs+dPdbWMl6TYmkI+2jrkGNiHTiAgsXgAG1P/aXTRjfISmJGSXaG8KcnrRvgSFL4XftSKbnyCojHqYADoDP/llUT06EQBDgfE="}},"id":"prt_11497538300154lfN3V6Twq0gH","sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","messageID":"msg_114973eca001YBOrCt6vKXMdbw"}}
