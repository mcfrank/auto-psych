{"type":"tool_use","timestamp":1791346424607,"sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","part":{"type":"tool","tool":"bash","callID":"SL8C5k44Uoa5py33","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport pandas as pd\nimport numpy as np\nimport json\n\ndf = pd.read_csv('data/rsa/loop_smoke2/responses.csv', low_memory=False)\npriors = df[df['query'] == 'prior']\nprint('Number of prior trials:', len(priors))\n\n# Let's check accuracy on prior trials where objects differ\ncorr_fc = 0\ncorr_m1 = 0\ncorr_m2 = 0\ntotal = 0\n\nfor _, row in priors.iterrows():\n    objs = json.loads(row['objects'])\n    c = int(row['choice'])\n    n_obj = len(objs)\n    # compute features\n    mat = np.array(objs) # (n_obj, n_feat)\n    \n    # fc\n    fc = mat.sum(axis=1)\n    \n    # m1: pairwise distance\n    # mat shape (n_obj, n_feat)\n    diff = np.abs(mat[:, None, :] - mat[None, :, :]).sum(axis=-1) # (n_obj, n_obj)\n    m1 = diff.sum(axis=1) / max(n_obj - 1, 1)\n    \n    # m2: rarity\n    n_per_feat = np.maximum(mat.sum(axis=0, keepdims=True), 1.0)\n    m2 = (mat / n_per_feat).sum(axis=1)\n    \n    if len(set(fc)) > 1:\n        corr_fc += (fc[c] == np.max(fc))\n        corr_m1 += (m1[c] == np.max(m1))\n        corr_m2 += (m2[c] == np.max(m2))\n        total += 1\n\nprint('Total non-trivial prior trials:', total)\nprint('FC top pick matches choice:', corr_fc / total)\nprint('M1 (pairwise contrast) matches choice:', corr_m1 / total)\nprint('M2 (rarity) matches choice:', corr_m2 / total)\n\""},"output":"Number of prior trials: 4570\nTotal non-trivial prior trials: 1700\nFC top pick matches choice: 0.49529411764705883\nM1 (pairwise contrast) matches choice: 0.6982352941176471\nM2 (rarity) matches choice: 0.47\n","metadata":{"output":"Number of prior trials: 4570\nTotal non-trivial prior trials: 1700\nFC top pick matches choice: 0.49529411764705883\nM1 (pairwise contrast) matches choice: 0.6982352941176471\nM2 (rarity) matches choice: 0.47\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport pandas as pd\nimport numpy as np\nimport json\n\ndf = pd.read_csv('data/rsa/loop_smoke2/responses.csv', low_memory=False)\npriors = df[df['query'] == 'prior']\nprint('Number of prior trials:', len(priors))\n\n# Let's check accuracy on prior trials where objects differ\ncorr_fc = 0\ncorr_m1 = 0\ncorr_m2 = 0\ntotal = 0\n\nfor _, row in priors.iterrows():\n    objs = json.loads(row['objects'])\n    c = int(row['choice'])\n    n_obj = len(objs)\n    # compute features\n    mat = np.array(objs) # (n_obj, n_feat)\n    \n    # fc\n    fc = mat.sum(axis=1)\n    \n    # m1: pairwise distance\n    # mat shape (n_obj, n_feat)\n    diff = np.abs(mat[:, None, :] - mat[None, :, :]).sum(axis=-1) # (n_obj, n_obj)\n    m1 = diff.sum(axis=1) / max(n_obj - 1, 1)\n    \n    # m2: rarity\n    n_per_feat = np.maximum(mat.sum(axis=0, keepdims=True), 1.0)\n    m2 = (mat / n_per_feat).sum(axis=1)\n    \n    if len(set(fc)) > 1:\n        corr_fc += (fc[c] == np.max(fc))\n        corr_m1 += (m1[c] == np.max(m1))\n        corr_m2 += (m2[c] == np.max(m2))\n        total += 1\n\nprint('Total non-trivial prior trials:', total)\nprint('FC top pick matches choice:', corr_fc / total)\nprint('M1 (pairwise contrast) matches choice:', corr_m1 / total)\nprint('M2 (rarity) matches choice:', corr_m2 / total)\n\"","time":{"start":1791346422914,"end":1791346424553}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_114913479001P3lAW2trbcfNqa","sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","messageID":"msg_11491175b001n2zS9ePAi5SiQB"}}
