{"type":"tool_use","timestamp":1791346793608,"sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","part":{"type":"tool","tool":"bash","callID":"FtRaPnhjLfa6f5wu","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport tempfile\nfrom pathlib import Path\nfrom src.rsa.model_file import RSAModel, check_contract\nfrom src.rsa.loop.code_gate import code_problems\nfrom src.rsa.context import group_by_shape\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.loop.novelty import novelty_pool\n\ncode = '''\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \\\"alpha\\\": dist.LogNormal(0.0, 1.0),\n    \\\"w_contrast\\\": dist.Normal(0.0, 1.0),\n    \\\"lapse\\\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    real_lex = ctx.lex * (1.0 - ctx.is_sink)[:, None]\n    diff = jnp.abs(real_lex[:, :, None] - real_lex[:, None, :])\n    contrast = diff.sum(axis=0).sum(axis=1) / jnp.maximum(real_lex.shape[1] - 1, 1)\n    prior = softmax_prior(params[\\\"w_contrast\\\"] * contrast)\n    heard = L1(params[\\\"alpha\\\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\\\"lapse\\\"])\n'''\n\nproblems = code_problems(code)\nprint('Code problems:', problems)\n\nwith tempfile.TemporaryDirectory() as tmpdir:\n    p = Path(tmpdir) / 'candidate.py'\n    p.write_text(code)\n    m = RSAModel(p, name='contrast_salience_listener')\n    print('Loaded model params:', m.params.keys())\n    \n    # Check contract on novelty pool\n    pool = novelty_pool()\n    pool_groups = group_by_shape(pool)\n    check_contract(m, pool_groups)\n    print('Contract on pool PASSED!')\n    \n    # Check contract on training data\n    training = load_forced_choice('data/rsa/loop_smoke2/responses.csv').contexts\n    training_groups = group_by_shape(training)\n    check_contract(m, training_groups)\n    print('Contract on training PASSED!')\n\""},"output":"Warning: Columns (7,18,19) have mixed types. Specify dtype option on import or set low_memory=False.\nCode problems: []\nLoaded model params: dict_keys(['alpha', 'w_contrast', 'lapse'])\nContract on pool PASSED!\nContract on training PASSED!\n","metadata":{"output":"Warning: Columns (7,18,19) have mixed types. Specify dtype option on import or set low_memory=False.\nCode problems: []\nLoaded model params: dict_keys(['alpha', 'w_contrast', 'lapse'])\nContract on pool PASSED!\nContract on training PASSED!\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport tempfile\nfrom pathlib import Path\nfrom src.rsa.model_file import RSAModel, check_contract\nfrom src.rsa.loop.code_gate import code_problems\nfrom src.rsa.context import group_by_shape\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.loop.novelty import novelty_pool\n\ncode = '''\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \\\"alpha\\\": dist.LogNormal(0.0, 1.0),\n    \\\"w_contrast\\\": dist.Normal(0.0, 1.0),\n    \\\"lapse\\\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    real_lex = ctx.lex * (1.0 - ctx.is_sink)[:, None]\n    diff = jnp.abs(real_lex[:, :, None] - real_lex[:, None, :])\n    contrast = diff.sum(axis=0).sum(axis=1) / jnp.maximum(real_lex.shape[1] - 1, 1)\n    prior = softmax_prior(params[\\\"w_contrast\\\"] * contrast)\n    heard = L1(params[\\\"alpha\\\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\\\"lapse\\\"])\n'''\n\nproblems = code_problems(code)\nprint('Code problems:', problems)\n\nwith tempfile.TemporaryDirectory() as tmpdir:\n    p = Path(tmpdir) / 'candidate.py'\n    p.write_text(code)\n    m = RSAModel(p, name='contrast_salience_listener')\n    print('Loaded model params:', m.params.keys())\n    \n    # Check contract on novelty pool\n    pool = novelty_pool()\n    pool_groups = group_by_shape(pool)\n    check_contract(m, pool_groups)\n    print('Contract on pool PASSED!')\n    \n    # Check contract on training data\n    training = load_forced_choice('data/rsa/loop_smoke2/responses.csv').contexts\n    training_groups = group_by_shape(training)\n    check_contract(m, training_groups)\n    print('Contract on training PASSED!')\n\"","time":{"start":1791346620769,"end":1791346793531}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_114943951001BHQ34o6z4E2jfB","sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","messageID":"msg_1149410d10016fclQposRnjkqr"}}
