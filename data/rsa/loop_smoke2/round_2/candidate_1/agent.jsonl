{"type":"step_start","timestamp":1791346456511,"sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","part":{"id":"prt_11491b7ae001fgx6zudRY08WyT","messageID":"msg_11491ab5b001RZ9gtR7fR8Z4iD","sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","type":"step-start"}}
{"type":"tool_use","timestamp":1791346591093,"sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","part":{"type":"tool","tool":"bash","callID":"MWFLwSGqaMKsAZMA","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport jax.numpy as jnp\nimport numpy as np\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.context import group_by_shape\n\nds = load_forced_choice('data/rsa/loop_smoke2/responses.csv')\ngroups = group_by_shape(ds.contexts)\n\n# Test on first 100 trials of each group:\nll_m1 = 0.0\nll_m2 = 0.0\nll_fc = 0.0\ncount = 0\n\nfor (n_obj, n_utt), group in groups.items():\n    arrays = group.arrays\n    real_lex = arrays.lex * (1.0 - arrays.is_sink)[:, :, None]\n    \n    # M1: pairwise distance\n    diff = np.abs(real_lex[:, :, :, None] - real_lex[:, :, None, :])\n    pairwise = diff.sum(axis=1)\n    m1 = pairwise.sum(axis=-1) / max(n_obj - 1, 1)\n    \n    # M2: feature distinctiveness (1/n)\n    n_per_feat = np.maximum(real_lex.sum(axis=-1, keepdims=True), 1.0)\n    m2 = (real_lex / n_per_feat).sum(axis=1)\n    \n    # FC: feature count\n    fc = real_lex.sum(axis=1)\n    \n    # Compare prior log-likelihood on prior trials\n    is_prior = arrays.is_prior > 0\n    if np.any(is_prior):\n        prior_idx = np.where(is_prior)[0]\n        for idx in prior_idx:\n            c = ds.contexts[group.indices[idx]]\n            choice = ds.choices[group.indices[idx]]\n            if choice < 0 or choice >= n_obj: continue\n            \n            p_m1 = np.exp(0.5 * m1[idx]) / np.sum(np.exp(0.5 * m1[idx]))\n            p_m2 = np.exp(0.5 * m2[idx]) / np.sum(np.exp(0.5 * m2[idx]))\n            p_fc = np.exp(0.5 * fc[idx]) / np.sum(np.exp(0.5 * fc[idx]))\n            \n            ll_m1 += np.log(p_m1[choice] + 1e-10)\n            ll_m2 += np.log(p_m2[choice] + 1e-10)\n            ll_fc += np.log(p_fc[choice] + 1e-10)\n            count += 1\n\nprint('Evaluated on', count, 'prior trials:')\nprint('LL M1 (Pairwise Hamming):', ll_m1)\nprint('LL M2 (Feature Rarity 1/n):', ll_m2)\nprint('LL FC (Feature Count):', ll_fc)\n\""},"output":"/home/user/auto-psych/src/rsa/dataset.py:95: DtypeWarning: Columns (7,18,19) have mixed types. Specify dtype option on import or set low_memory=False.\n  df = pd.read_csv(path)\nEvaluated on 3514 prior trials:\nLL M1 (Pairwise Hamming): -3698.9983\nLL M2 (Feature Rarity 1/n): -3728.9905\nLL FC (Feature Count): -3828.686\n","metadata":{"output":"/home/user/auto-psych/src/rsa/dataset.py:95: DtypeWarning: Columns (7,18,19) have mixed types. Specify dtype option on import or set low_memory=False.\n  df = pd.read_csv(path)\nEvaluated on 3514 prior trials:\nLL M1 (Pairwise Hamming): -3698.9983\nLL M2 (Feature Rarity 1/n): -3728.9905\nLL FC (Feature Count): -3828.686\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport jax.numpy as jnp\nimport numpy as np\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.context import group_by_shape\n\nds = load_forced_choice('data/rsa/loop_smoke2/responses.csv')\ngroups = group_by_shape(ds.contexts)\n\n# Test on first 100 trials of each group:\nll_m1 = 0.0\nll_m2 = 0.0\nll_fc = 0.0\ncount = 0\n\nfor (n_obj, n_utt), group in groups.items():\n    arrays = group.arrays\n    real_lex = arrays.lex * (1.0 - arrays.is_sink)[:, :, None]\n    \n    # M1: pairwise distance\n    diff = np.abs(real_lex[:, :, :, None] - real_lex[:, :, None, :])\n    pairwise = diff.sum(axis=1)\n    m1 = pairwise.sum(axis=-1) / max(n_obj - 1, 1)\n    \n    # M2: feature distinctiveness (1/n)\n    n_per_feat = np.maximum(real_lex.sum(axis=-1, keepdims=True), 1.0)\n    m2 = (real_lex / n_per_feat).sum(axis=1)\n    \n    # FC: feature count\n    fc = real_lex.sum(axis=1)\n    \n    # Compare prior log-likelihood on prior trials\n    is_prior = arrays.is_prior > 0\n    if np.any(is_prior):\n        prior_idx = np.where(is_prior)[0]\n        for idx in prior_idx:\n            c = ds.contexts[group.indices[idx]]\n            choice = ds.choices[group.indices[idx]]\n            if choice < 0 or choice >= n_obj: continue\n            \n            p_m1 = np.exp(0.5 * m1[idx]) / np.sum(np.exp(0.5 * m1[idx]))\n            p_m2 = np.exp(0.5 * m2[idx]) / np.sum(np.exp(0.5 * m2[idx]))\n            p_fc = np.exp(0.5 * fc[idx]) / np.sum(np.exp(0.5 * fc[idx]))\n            \n            ll_m1 += np.log(p_m1[choice] + 1e-10)\n            ll_m2 += np.log(p_m2[choice] + 1e-10)\n            ll_fc += np.log(p_fc[choice] + 1e-10)\n            count += 1\n\nprint('Evaluated on', count, 'prior trials:')\nprint('LL M1 (Pairwise Hamming):', ll_m1)\nprint('LL M2 (Feature Rarity 1/n):', ll_m2)\nprint('LL FC (Feature Count):', ll_fc)\n\"","time":{"start":1791346474518,"end":1791346591013}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11491fe09001R74t536uTnEYRZ","sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","messageID":"msg_11491ab5b001RZ9gtR7fR8Z4iD"}}
