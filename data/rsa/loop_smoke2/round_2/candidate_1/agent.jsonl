ams[\"w_valence\"] * ctx.valence * ctx.feature_count)\n46:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n47:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 47 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with valence-modulated referent prior.\n\nListeners interpret evaluative framing (favorite vs. least favorite) as\nsignaling the speaker's expectation over referent complexity: positive valence\nbiases prior probability toward feature-rich objects, whereas negative valence\nbiases prior probability toward simple, feature-poor objects. With neutral\nframing, the prior over referents is uniform. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_valence\": dist.Normal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/valence_salience_listener.py","text":"\"\"\"RSA pragmatic listener (depth 1) with valence-modulated referent prior.\n\nListeners interpret evaluative framing (favorite vs. least favorite) as\nsignaling the speaker's expectation over referent complexity: positive valence\nbiases prior probability toward feature-rich objects, whereas negative valence\nbiases prior probability toward simple, feature-poor objects. With neutral\nframing, the prior over referents is uniform. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_valence\": dist.Normal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(params[\"w_valence\"] * ctx.valence * ctx.feature_count)\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":47,"totalLines":47,"truncated":false}},"title":"data/rsa/loop_smoke2/models/valence_salience_listener.py","time":{"start":1791346036886,"end":1791346036902}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148b508c001XbFz0Pmzse3blX","sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","messageID":"msg_1148b46d0001Qq1MGvM9GwUU4q"}}
