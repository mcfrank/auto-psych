one] - real_lex[:, None, :]) # (N_UTT, N_OBJ, N_OBJ)\ndist_matrix = diff.sum(axis=0) # (N_OBJ, N_OBJ)\navg_dist = dist_matrix.sum(axis=1) / jnp.maximum(dist_matrix.shape[0] - 1, 1)\nprint('Avg pairwise Hamming distance:', avg_dist)\n\n# Method 2: Feature distinctiveness (sum of 1 / feature count)\nfeat_counts = jnp.maximum(real_lex.sum(axis=1, keepdims=True), 1.0)\ninv_freq = real_lex / feat_counts\nfeat_dist = inv_freq.sum(axis=0)\nprint('Feature distinctiveness (sum of 1/n):', feat_dist)\n\"","time":{"start":1791346362118,"end":1791346363744}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1149046f8001VPu2q2WXdXFkyE","sessionID":"ses_eeb7537e0ffe7TnNRtM3LzuDXr","messageID":"msg_1148f780c0014LoB9xP1LW1eqD"}}
