{"type":"tool_use","timestamp":1791346314487,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"read","callID":"pJXD5XONf6PWUCTs","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/round_2/candidate_2/candidate.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/round_2/candidate_2/candidate.py</path>\n<type>file</type>\n<content>\n1: import jax.numpy as jnp\n2: import numpyro.distributions as dist\n3: from memo import memo\n4: \n5: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n6: \n7: PARAMS = {\n8:     \"alpha\": dist.LogNormal(0.0, 1.0),\n9:     \"w_features\": dist.Normal(0.0, 1.0),\n10:     \"w_valence\": dist.Normal(0.0, 2.0),\n11:     \"w_familiar\": dist.Normal(0.0, 2.0),\n12:     \"lapse\": dist.Beta(1.0, 9.0),\n13: }\n14: \n15: \n16: @memo\n17: def L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n18:     listener: knows(u)\n19:     listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n20:     return Pr[listener.r == r]\n21: \n22: \n23: @memo\n24: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n25:     listener: thinks[\n26:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n27:         speaker: chooses(\n28:             u in UTT,\n29:             wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n30:         ),\n31:     ]\n32:     listener: observes [speaker.u] is u\n33:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n34:     return Pr[listener.r == r]\n35: \n36: \n37: @memo\n38: def L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n39:     listener: thinks[\n40:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n41:         speaker: chooses(\n42:             u in UTT,\n43:             wpp=at(lex, u, r)\n44:             * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n45:         ),\n46:     ]\n47:     listener: observes [speaker.u] is u\n48:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n49:     return Pr[listener.r == r]\n50: \n51: \n52: def choice_probs(params, ctx):\n53:     feat_weight = params[\"w_features\"] + params[\"w_valence\"] * ctx.valence\n54:     prior = softmax_prior(\n55:         feat_weight * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n56:     )\n57:     heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n58:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 58 lines)\n</content>","metadata":{"preview":"import jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_valence\": dist.Normal(0.0, 2.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/round_2/candidate_2/candidate.py","text":"import jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_valence\": dist.Normal(0.0, 2.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r)\n            * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    feat_weight = params[\"w_features\"] + params[\"w_valence\"] * ctx.valence\n    prior = softmax_prior(\n        feat_weight * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":58,"totalLines":58,"truncated":false}},"title":"data/rsa/loop_smoke2/round_2/candidate_2/candidate.py","time":{"start":1791346314461,"end":1791346314482}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148f8cd3001p01LRwODfAsvAo","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148f84fd001Yn2w966Y8wtRNZ"}}
