{EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\npool = novelty_pool()\ngroups = group_by_shape(pool)\n\np_shared_list = []\np_sal_list = []\n\nfor shape, group in groups.items():\n    arrays = group.arrays\n    # evaluate for each context in group\n    for i in range(len(group.indices)):\n        c_lex = arrays.lex[i]\n        c_utt = int(arrays.utterance[i])\n        c_prior_flag = float(arrays.is_prior[i])\n        c_feat = arrays.feature_count[i]\n        c_fam = arrays.familiarization[i]\n        c_val = float(arrays.valence[i])\n        \n        feat_w = params['w_features'] + params['w_valence'] * c_val\n        prior = softmax_prior(feat_w * c_feat + params['w_familiar'] * c_fam)\n        \n        # Shared\n        h_shared = L1_shared(params['alpha'], c_lex, prior)[c_utt]\n        p_shared = with_lapse(jnp.where(c_prior_flag > 0, prior, h_shared), params['lapse'])\n        p_shared_class = class_probs(p_shared[None, :], group.classes[i:i+1])[0]\n        p_shared_list.append(np.array(p_shared_class))\n        \n        # Salience\n        h_sal = L1_sal(params['alpha'], c_lex, prior)[c_utt]\n        p_sal = with_lapse(jnp.where(c_prior_flag > 0, prior, h_sal), params['lapse'])\n        p_sal_class = class_probs(p_sal[None, :], group.classes[i:i+1])[0]\n        p_sal_list.append(np.array(p_sal_class))\n\np1 = np.concatenate(p_shared_list)\np2 = np.concatenate(p_sal_list)\nrmse = np.sqrt(np.mean((p1 - p2) ** 2))\nprint('RMSE between shared and asymmetric salience with valence:', rmse)\n\"","time":{"start":1791346455112,"end":1791346459636}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11491b23a001oRiqeXDqa23pe0","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_11491455c001OEPWCKv2rvQpWL"}}
