       pool.append(Context(objects=matrix, feature_names=names, utterance=word, valence=valence))\n                for favoured in range(3):\n                    fam = tuple(7 / 9 if i == favoured else 1 / 9 for i in range(3))\n                    pool.append(Context(objects=matrix, feature_names=names, utterance=word, familiarization=fam))\n                for gray in range(3):\n                    mask = tuple(int(i != gray) for i in range(3))  # one object in colour\n                    pool.append(Context(objects=matrix, feature_names=names, utterance=word, grayscale=mask))\n    return pool\n\n\ndef pool_digest(pool: Sequence[Context]) -> str:\n    blob = json.dumps([pool_record(c) for c in pool], sort_keys=True).encode()\n    return hashlib.sha256(blob).hexdigest()[:16]\n\n\ndef pool_record(ctx: Context) -> dict:\n    return dict(\n        objects=ctx.objects, utterance=ctx.utterance, valence=ctx.valence,\n        familiarization=ctx.familiarization, grayscale=ctx.grayscale,\n    )\n\n\ndef posterior_mean_class_probs(\n    model: RSAModel, fitted: RSAFit, pool: Sequence[Context], max_draws: int = MAX_DRAWS\n) -> np.ndarray:\n    \"\"\"Posterior-mean choice-class probabilities over the pool, flattened.\n\n    Raises ValueError when the model's probabilities are not finite on some\n    pool context (a model failure: the caller rejects with the reason).","lineStart":30,"lineEnd":69,"totalLines":99,"truncated":true}},"title":"src/rsa/loop/novelty.py","time":{"start":1791346277527,"end":1791346277541}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148efc8e001c3n6HgTCaMTaN3","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148eed81001GUruqvsZo03Etx"}}
