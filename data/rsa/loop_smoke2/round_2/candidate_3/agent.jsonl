prior = softmax_prior(params[\"w_valence\"] * ctx.valence * ctx.feature_count)\n    heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n","filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/round_2/candidate_3/candidate.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/auto-psych/data/rsa/loop_smoke2/round_2/candidate_3/candidate.py","exists":false,"truncated":false},"title":"data/rsa/loop_smoke2/round_2/candidate_3/candidate.py","time":{"start":1791346630170,"end":1791346630185}},"metadata":{"google":{"thoughtSignature":"EpQBCpEBAWkUfRNgRXiZ5bTmdb9k1EDL4JP7TKIK5mZkVtgiEENOweoBoH9HyTb5GjT1neVeL2l0skW0WT0IfDcNT3xkgZg7zUjaqthSFR/HuGf07YV0hth03JZ4EmsC8hF+FuVkS86IRScKkerhA9kGJl8CAQFIfk67EjrAYNY5e/SBZNYYqDcfUER/qKXFUYmLh2p1HA=="}},"id":"prt_114945e0a0014mLRyMx3Cvxud7","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1149447be001pOH64XFR8Ed5dV"}}
