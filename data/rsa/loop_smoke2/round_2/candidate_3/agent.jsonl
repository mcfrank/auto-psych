{"type":"step_start","timestamp":1791346431617,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"id":"prt_114915677001b7a9byUWiWHmvp","messageID":"msg_11491455c001OEPWCKv2rvQpWL","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","type":"step-start"}}
{"type":"tool_use","timestamp":1791346459692,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"bash","callID":"1qMWy604B64XbsdG","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport jax\nimport jax.numpy as jnp\nfrom memo import memo\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\nfrom src.rsa.loop.novelty import novelty_pool\nfrom src.rsa.context import group_by_shape\nfrom src.rsa.fit import class_probs\nimport numpy as np\n\n# Load parameters from rsa_l2_shared_prior_2 fit\nparams = {\n    'alpha': jnp.array(0.747),\n    'w_features': jnp.array(-0.115),\n    'w_valence': jnp.array(1.046),\n    'w_familiar': jnp.array(1.513),\n    'lapse': jnp.array(0.042),\n}\n\n# Model 1: shared prior (rsa_l2_shared_prior_2)\n@memo\ndef L0_shared[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n@memo\ndef L1_shared[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0_shared[u, r](lex, prior) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n# Model 2: asymmetric salience (L0 literal, S1 has prior)\n@memo\ndef L0_sal[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n@memo\ndef L1_sal[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0_sal[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\npool = novelty_pool()\ngroups = group_by_shape(pool)\n\np_shared_list = []\np_sal_list = []\n\nfor shape, group in groups.items():\n    arrays = group.arrays\n    # evaluate for each context in group\n    for i in range(len(group.indices)):\n        c_lex = arrays.lex[i]\n        c_utt = int(arrays.utterance[i])\n        c_prior_flag = float(arrays.is_prior[i])\n        c_feat = arrays.feature_count[i]\n        c_fam = arrays.familiarization[i]\n        c_val = float(arrays.valence[i])\n        \n        feat_w = params['w_features'] + params['w_valence'] * c_val\n        prior = softmax_prior(feat_w * c_feat + params['w_familiar'] * c_fam)\n        \n        # Shared\n        h_shared = L1_shared(params['alpha'], c_lex, prior)[c_utt]\n        p_shared = with_lapse(jnp.where(c_prior_flag > 0, prior, h_shared), params['lapse'])\n        p_shared_class = class_probs(p_shared[None, :], group.classes[i:i+1])[0]\n        p_shared_list.append(np.array(p_shared_class))\n        \n        # Salience\n        h_sal = L1_sal(params['alpha'], c_lex, prior)[c_utt]\n        p_sal = with_lapse(jnp.where(c_prior_flag > 0, prior, h_sal), params['lapse'])\n        p_sal_class = class_probs(p_sal[None, :], group.classes[i:i+1])[0]\n        p_sal_list.append(np.array(p_sal_class))\n\np1 = np.concatenate(p_shared_list)\np2 = np.concatenate(p_sal_list)\nrmse = np.sqrt(np.mean((p1 - p2) ** 2))\nprint('RMSE between shared and asymmetric salience with valence:', rmse)\n\""},"output":"memo.core.MemoError: Python couldn't find your memo source code\n\n  hint: You cannot define a new @memo in the Python interactive REPL.\n        Try writing your memo code to a file and running via `python\n        filename.py`. If you really want an interactive experience,\n        memo also works inside Jupyter notebooks.\n\n  info: You are using memo 1.3.0, JAX 0.7.0, Python 3.12.3 on Linux.\n","metadata":{"output":"memo.core.MemoError: Python couldn't find your memo source code\n\n  hint: You cannot de