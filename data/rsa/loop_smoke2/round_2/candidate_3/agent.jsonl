ener (depth 0).\n\nThe listener picks uniformly among the objects the heard word is literally\ntrue of; with no informative word, uniformly among all objects. A lapse\nparameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L0(ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":29,"totalLines":29,"truncated":false}},"title":"data/rsa/loop_smoke2/models/literal_listener.py","time":{"start":1791346023155,"end":1791346023324}},"id":"prt_1148b1ae9001s3vfW1CaUdmK31","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148b12fa001HiQQISk68wcGtJ"}}
