{"type":"tool_use","timestamp":1791346364592,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"bash","callID":"xjQuP1bqAsGUnLQc","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nfrom src.rsa.loop.novelty import novelty_pool, posterior_mean_class_probs\nfrom src.rsa.model_file import RSAModel\nfrom src.rsa.loop.fitting import _read\nimport numpy as np\nfrom pathlib import Path\n\npool = novelty_pool()\ncache_dir = Path('data/rsa/loop_smoke2/.fit_cache')\n\nm1 = RSAModel(Path('data/rsa/loop_smoke2/models/rsa_l1_salience.py'), 'rsa_l1_salience')\nf1 = _read(cache_dir / 'rsa_l1_salience.nc', cache_dir / 'rsa_l1_salience.json')\np1 = posterior_mean_class_probs(m1, f1, pool)\n\nm2 = RSAModel(Path('data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py'), 'rsa_l1_shared_prior')\nf2 = _read(cache_dir / 'rsa_l1_shared_prior.nc', cache_dir / 'rsa_l1_shared_prior.json')\np2 = posterior_mean_class_probs(m2, f2, pool)\n\nrmse = np.sqrt(np.mean((p1 - p2) ** 2))\nprint('RMSE between rsa_l1_salience and rsa_l1_shared_prior:', rmse)\n\""},"output":"RMSE between rsa_l1_salience and rsa_l1_shared_prior: 0.007594613\n","metadata":{"output":"RMSE between rsa_l1_salience and rsa_l1_shared_prior: 0.007594613\n","exit":0,"truncated":false},"title":"/home/user/auto-psych/.venv/bin/python3 -c \"\nfrom src.rsa.loop.novelty import novelty_pool, posterior_mean_class_probs\nfrom src.rsa.model_file import RSAModel\nfrom src.rsa.loop.fitting import _read\nimport numpy as np\nfrom pathlib import Path\n\npool = novelty_pool()\ncache_dir = Path('data/rsa/loop_smoke2/.fit_cache')\n\nm1 = RSAModel(Path('data/rsa/loop_smoke2/models/rsa_l1_salience.py'), 'rsa_l1_salience')\nf1 = _read(cache_dir / 'rsa_l1_salience.nc', cache_dir / 'rsa_l1_salience.json')\np1 = posterior_mean_class_probs(m1, f1, pool)\n\nm2 = RSAModel(Path('data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py'), 'rsa_l1_shared_prior')\nf2 = _read(cache_dir / 'rsa_l1_shared_prior.nc', cache_dir / 'rsa_l1_shared_prior.json')\np2 = posterior_mean_class_probs(m2, f2, pool)\n\nrmse = np.sqrt(np.mean((p1 - p2) ** 2))\nprint('RMSE between rsa_l1_salience and rsa_l1_shared_prior:', rmse)\n\"","time":{"start":1791346342690,"end":1791346364560}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148ffb15001J6gI3MsCk3ymRB","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148fbba9001ZtpFdQuNAK6x7h"}}
