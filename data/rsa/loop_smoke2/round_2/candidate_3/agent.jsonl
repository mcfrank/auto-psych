max_prior(params[\\\"w_valence\\\"] * ctx.valence * ctx.feature_count)\n    heard = L2(params[\\\"alpha\\\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\\\"lapse\\\"])\n'''\n\nwith tempfile.TemporaryDirectory() as td:\n    p = Path(td) / 'candidate.py'\n    p.write_text(code)\n    m = RSAModel(p, 'valence_salience_l2')\n    \n    # We can evaluate predictions using posterior mean of valence_salience_listener parameters\n    # alpha ~ 0.8, w_valence ~ 1.0, lapse ~ 0.04\n    pool = novelty_pool()\n    cache_dir = Path('data/rsa/loop_smoke2/.fit_cache')\n    \n    admitted_preds = {}\n    for name in ['literal_listener', 'rsa_l1', 'rsa_l2', 'rsa_l1_salience', 'rsa_l1_shared_prior', 'valence_salience_listener', 'rsa_l2_shared_prior', 'rsa_l2_shared_prior_2']:\n        mod = RSAModel(Path(f'data/rsa/loop_smoke2/models/{name}.py'), name)\n        fit = _read(cache_dir / f'{name}.nc', cache_dir / f'{name}.json')\n        admitted_preds[name] = posterior_mean_class_probs(mod, fit, pool)\n    \n    # Also candidate 2's model if we can\n    # Let's mock a fit for m using valence_salience_listener's idata\n    f_val = _read(cache_dir / 'valence_salience_listener.nc', cache_dir / 'valence_salience_listener.json')\n    preds_m = posterior_mean_class_probs(m, f_val, pool)\n    \n    nearest, dist = closest(preds_m, admitted_preds)\n    print(f'Closest model: {nearest}, RMSE distance: {dist:.5f}')\n    for name, p in admitted_preds.items():\n        d = np.sqrt(np.mean((preds_m - p) ** 2))\n        print(f'  vs {name}: RMSE = {d:.5f}')\n\"","time":{"start":1791346529870,"end":1791346601989}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_11492d63a001zk7vqq0zpJdDln","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_11491fcea0015C7i8L0lhUEVg9"}}
