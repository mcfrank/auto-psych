er.u] is u\n41:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n42:     return Pr[listener.r == r]\n43: \n44: \n45: def choice_probs(params, ctx):\n46:     prior = softmax_prior(\n47:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n48:     )\n49:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n50:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 50 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n\nAs vanilla RSA, but the pragmatic listener's prior over objects is a softmax\nof salience weights: w_features per feature an object has (pragmods prior\nmeasurements favour objects with more features) plus w_familiar times the\nbase rate at which the object was seen in a familiarization phase. The prior\nenters only the listener's own inference, not the literal listener the\nspeaker simulates (Frank & Goodman, 2012). With no informative word the\nchoice is that prior itself, so prior-elicitation trials inform the salience\nweights. A lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_salience.py","text":"\"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n\nAs vanilla RSA, but the pragmatic listener's prior over objects is a softmax\nof salience weights: w_features per feature an object has (pragmods prior\nmeasurements favour objects with more features) plus w_familiar times the\nbase rate at which the object was seen in a familiarization phase. The prior\nenters only the listener's own inference, not the literal listener the\nspeaker simulates (Frank & Goodman, 2012). With no informative word the\nchoice is that prior itself, so prior-elicitation trials inform the salience\nweights. A lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":50,"totalLines":50,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l1_salience.py","time":{"start":1791346021052,"end":1791346021084}},"id":"prt_1148b12ac001snjPA9UhmIq2OA","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148b0511001MagPn63RAJFiLt"}}
