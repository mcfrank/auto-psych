{"type":"tool_use","timestamp":1791346427238,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"read","callID":"x1aTzwhSUiqLVsJh","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke/models/rsa_l2_salience.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke/models/rsa_l2_salience.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener at depth 2 with a learned salience prior.\n2: \n3: Refines rsa_l2 by adding a salience prior (over feature count and familiarization base rate) \n4: to the top-level listener (L2). The simulated speaker (S2) and lower-level listener (L1) \n5: and literal listener (L0) all continue to use a uniform prior over objects.\n6: \"\"\"\n7: \n8: import jax.numpy as jnp\n9: import numpyro.distributions as dist\n10: from memo import memo\n11: \n12: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n13: \n14: PARAMS = {\n15:     \"alpha\": dist.LogNormal(0.0, 1.0),\n16:     \"w_features\": dist.Normal(0.0, 1.0),\n17:     \"w_familiar\": dist.Normal(0.0, 2.0),\n18:     \"lapse\": dist.Beta(1.0, 9.0),\n19: }\n20: \n21: \n22: @memo\n23: def L0[u: UTT, r: OBJ](lex: ...):\n24:     listener: knows(u)\n25:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n26:     return Pr[listener.r == r]\n27: \n28: \n29: @memo\n30: def L1[u: UTT, r: OBJ](alpha, lex: ...):\n31:     listener: thinks[\n32:         speaker: given(r in OBJ, wpp=1),\n33:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n34:     ]\n35:     listener: observes [speaker.u] is u\n36:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n37:     return Pr[listener.r == r]\n38: \n39: \n40: @memo\n41: def L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n42:     listener: thinks[\n43:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n44:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n45:     ]\n46:     listener: observes [speaker.u] is u\n47:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n48:     return Pr[listener.r == r]\n49: \n50: \n51: def choice_probs(params, ctx):\n52:     prior = softmax_prior(\n53:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n54:     )\n55:     heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n56:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 56 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener at depth 2 with a learned salience prior.\n\nRefines rsa_l2 by adding a salience prior (over feature count and familiarization base rate) \nto the top-level listener (L2). The simulated speaker (S2) and lower-level listener (L1) \nand literal listener (L0) all continue to use a uniform prior over objects.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke/models/rsa_l2_salience.py","text":"\"\"\"RSA pragmatic listener at depth 2 with a learned salience prior.\n\nRefines rsa_l2 by adding a salience prior (over feature count and familiarization base rate) \nto the top-level listener (L2). The simulated speaker (S2) and lower-level listener (L1) \nand literal listener (L0) all continue to use a uniform prior over objects.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":56,"totalLines":56,"truncated":false}},"title":"data/rsa/loop_smoke/models/rsa_l2_salience.py","time":{"start":1791346427078,"end":1791346427193}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1149144b0001dKvQVoHq4rJjEo","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_114913b060019My1NS0B0OrDtk"}}
