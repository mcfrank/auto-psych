return Pr[listener.r == r]\\n29: \\n30: \\n31: @memo\\n32: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\\n33:     listener: thinks[\\n34:         speaker: given(r in OBJ, wpp=vec(prior, r)),\\n35:         speaker: chooses(\\n36:             u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))\\n37:         ),\\n38:     ]\\n39:     listener: observes [speaker.u] is u\\n40:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\\n41:     return Pr[listener.r == r]\\n42: \\n43: \\n44: def choice_probs(params, ctx):\\n45:     prior = softmax_prior(par... (line truncated to 2000 chars)\n{\"type\":\"step_finish\",\"timestamp\":1791346020133,\"sessionID\":\"ses_eeb753660ffeoSxUa5mxs618zH\",\"part\":{\"id\":\"prt_1148b0ef7001327v73EUGqKwHW\",\"reason\":\"tool-calls\",\"messageID\":\"msg_1148b00d4001YiLa6LFjDRSW87\",\"sessionID\":\"ses_eeb753660ffeoSxUa5mxs618zH\",\"type\":\"step-finish\",\"tokens\":{\"total\":34068,\"input\":5140,\"output\":41,\"reasoning\":170,\"cache\":{\"write\":0,\"read\":28717}},\"cost\":0.006800025}}\n{\"type\":\"step_start\",\"timestamp\":1791346022672,\"sessionID\":\"ses_eeb753660ffeoSxUa5mxs618zH\",\"part\":{\"id\":\"prt_1148b18e4001v2WqbgHI5TYd7c\",\"messageID\":\"msg_1148b0f10001KQYRfszXZYH71F\",\"sessionID\":\"ses_eeb753660ffeoSxUa5mxs618zH\",\"type\":\"step-start\"}}\n{\"type\":\"tool_use\",\"timestamp\":1791346023563,\"sessionID\":\"ses_eeb753660ffeoSxUa5mxs618zH\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"8D7jAN1RoX58rPVJ\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py\"},\"output\":\"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"RSA pragmatic listener (depth 1) with a salience prior at every level.\\n2: \\n3: As the salience model, but the prior over objects is common knowledge: the\\n4: literal listener the speaker simulate