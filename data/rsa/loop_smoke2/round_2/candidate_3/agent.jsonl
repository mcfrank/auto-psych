{"type":"tool_use","timestamp":1791346015011,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"read","callID":"zJDpCy84ZMJWp01g","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/memo_kit.py"},"output":"<path>/home/user/auto-psych/src/rsa/memo_kit.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Helpers every memo model file may import.\n2: \n3: memo parses its own language: an array parameter (declared ``lex: ...``) can\n4: only be read through a function call, never subscripted (``lex[u, r]`` parses\n5: as a query about an agent). These JIT-compiled indexers are that call.\n6: \n7: ``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\n8: context shape being evaluated (`src.rsa.model_file`).\n9: \"\"\"\n10: \n11: from __future__ import annotations\n12: \n13: import jax\n14: import jax.numpy as jnp\n15: \n16: # Added inside log() so a zero probability gives a large finite penalty, not\n17: # -inf and a NaN gradient.\n18: EPS = 1e-10\n19: \n20: \n21: @jax.jit\n22: def at(matrix, i, j):\n23:     \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n24:     return matrix[i, j]\n25: \n26: \n27: @jax.jit\n28: def vec(vector, i):\n29:     \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n30:     return vector[i]\n31: \n32: \n33: def with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n34:     \"\"\"Mix a choice distribution with a uniform guess over the objects.\n35: \n36:     With probability ``lapse`` the participant picks an object at random.\n37:     Without some such noise a model that gives an object probability zero\n38:     (the literal semantics of RSA does, for any object the word is false of)\n39:     makes one participant's choice of it an impossible event.\n40:     \"\"\"\n41:     return (1.0 - lapse) * p + lapse / p.shape[-1]\n42: \n43: \n44: def softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n45:     \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n46:     return jax.nn.softmax(logits)\n\n(End of file - total 46 lines)\n</content>","metadata":{"preview":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/memo_kit.py","text":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n\n@jax.jit\ndef at(matrix, i, j):\n    \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n    return matrix[i, j]\n\n\n@jax.jit\ndef vec(vector, i):\n    \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n    return vector[i]\n\n\ndef with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n    \"\"\"Mix a choice distribution with a uniform guess over the objects.\n\n    With probability ``lapse`` the participant picks an object at random.\n    Without some such noise a model that gives an object probability zero\n    (the literal semantics of RSA does, for any object the word is false of)\n    makes one participant's choice of it an impossible event.\n    \"\"\"\n    return (1.0 - lapse) * p + lapse / p.shape[-1]\n\n\ndef softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n    \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n    return jax.nn.softmax(logits)","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"src/rsa/memo_kit.py","time":{"start":1791346014976,"end":1791346015002}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148afaeb001GAllhrrex73yA4","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148af0c3001TjkoRMObk5LOYC"}}
{"type":"tool_use","timestamp":1791346015286,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"read","callID":"B6JfsMx3pKpTubmi","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/valence_salience_listener.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/valence_salience_listener.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener (depth 1) with valence-modulated referent prior.\n2: \n3: Listeners interpret evaluative framing (favorite vs. least favorite) as\n4: signaling the speaker's expectation over referent complexity: positive valence\n5: biases prior probability toward feature-rich objects, whereas negative valence\n6: biases prior probability toward simple, feature-poor objects. With neutral\n7: framing, the prior over referents is uniform. A lapse parameter mixes in\n8: uniform guessing.\n9: \"\"\"\n10: \n11: import jax.numpy as jnp\n12: import numpyro.distributions as dist\n13: from memo import memo\n14: \n15: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n16: \n17: PARAMS = {\n18:     \"alpha\": dist.LogNormal(0.0, 1.0),\n19:     \"w_valence\": dist.Normal(0.0, 1.0),\n20:     \"lapse\": dist.Beta(1.0, 9.0),\n21: }\n22: \n23: \n24: @memo\n25: def L0[u: UTT, r: OBJ](lex: ...):\n26:     listener: knows(u)\n27:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n28:     return Pr[listener.r == r]\n29: \n30: \n31: @memo\n32: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n33:     listener: thinks[\n34:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n35:         speaker: chooses(\n36:             u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))\n37:         ),\n38:     ]\n39:     listener: observes [speaker.u] is u\n40:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n41:     return Pr[listener.r == r]\n42: \n43: \n44: def choice_probs(params, ctx):\n45:     prior = softmax_prior(params[\"w_valence\"] * ctx.valence * ctx.feature_count)\n46:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n47:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 47 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with valence-modulated referent prior.\n\nListeners interpret evaluative framing (favorite vs. least favorite) as\nsignaling the speaker's expectation over referent complexity: positive valence\nbiases prior probability toward feature-rich objects, whereas negative valence\nbiases prior probability toward simple, feature-poor objects. With neutral\nframing, the prior over referents is uniform. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_valence\": dist.Normal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/valence_salience_listener.py","text":"\"\"\"RSA pragmatic listener (depth 1) with valence-modulated referent prior.\n\nListeners interpret evaluative framing (favorite vs. least favorite) as\nsignaling the speaker's expectation over referent complexity: positive valence\nbiases prior probability toward feature-rich objects, whereas negative valence\nbiases prior probability toward simple, feature-poor objects. With neutral\nframing, the prior over referents is uniform. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_valence\": dist.Normal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(params[\"w_valence\"] * ctx.valence * ctx.feature_count)\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":47,"totalLines":47,"truncated":false}},"title":"data/rsa/loop_smoke2/models/valence_salience_listener.py","time":{"start":1791346015125,"end":1791346015227}},"id":"prt_1148afb85001CV4WfhdsIcA40M","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148af0c3001TjkoRMObk5LOYC"}}
