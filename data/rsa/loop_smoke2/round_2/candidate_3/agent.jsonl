{"type":"tool_use","timestamp":1791346023211,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"read","callID":"TzYqXT2q2YlD9KA4","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n2: \n3: One more level of recursion than the vanilla model: a speaker S2 chooses words\n4: by how well the depth-1 pragmatic listener L1 would recover the object\n5: (exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\n6: what the pragmods \"complex\" game needs to single out the object described by\n7: the twice-implicated word. One rationality alpha at every level; uniform\n8: choice with no informative word; a lapse parameter mixes in uniform guessing.\n9: \"\"\"\n10: \n11: import jax.numpy as jnp\n12: import numpyro.distributions as dist\n13: from memo import memo\n14: \n15: from src.rsa.memo_kit import EPS, at, with_lapse\n16: \n17: PARAMS = {\n18:     \"alpha\": dist.LogNormal(0.0, 1.0),\n19:     \"lapse\": dist.Beta(1.0, 9.0),\n20: }\n21: \n22: \n23: @memo\n24: def L0[u: UTT, r: OBJ](lex: ...):\n25:     listener: knows(u)\n26:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n27:     return Pr[listener.r == r]\n28: \n29: \n30: @memo\n31: def L1[u: UTT, r: OBJ](alpha, lex: ...):\n32:     listener: thinks[\n33:         speaker: given(r in OBJ, wpp=1),\n34:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n35:     ]\n36:     listener: observes [speaker.u] is u\n37:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n38:     return Pr[listener.r == r]\n39: \n40: \n41: @memo\n42: def L2[u: UTT, r: OBJ](alpha, lex: ...):\n43:     listener: thinks[\n44:         speaker: given(r in OBJ, wpp=1),\n45:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n46:     ]\n47:     listener: observes [speaker.u] is u\n48:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n49:     return Pr[listener.r == r]\n50: \n51: \n52: def choice_probs(params, ctx):\n53:     heard = L2(params[\"alpha\"], ctx.lex)[ctx.utterance]\n54:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n55:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 55 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n\nOne more level of recursion than the vanilla model: a speaker S2 chooses words\nby how well the depth-1 pragmatic listener L1 would recover the object\n(exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\nwhat the pragmods \"complex\" game needs to single out the object described by\nthe twice-implicated word. One rationality alpha at every level; uniform\nchoice with no informative word; a lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2.py","text":"\"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n\nOne more level of recursion than the vanilla model: a speaker S2 chooses words\nby how well the depth-1 pragmatic listener L1 would recover the object\n(exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\nwhat the pragmods \"complex\" game needs to single out the object described by\nthe twice-implicated word. One rationality alpha at every level; uniform\nchoice with no informative word; a lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L2(params[\"alpha\"], ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":55,"totalLines":55,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l2.py","time":{"start":1791346023000,"end":1791346023201}},"metadata":{"google":{"thoughtSignature":"EsIBCr8BAWkUfRNxfjYQQKUkGiis9nuqW/kIHYRnHaDqq045A5qmXrspRtPoxoZKmbZdFLjgUFzHg0i5KVlxr8rBpKJLXSoY+28OwP6hdADg7b4bxcPs+ULjWgq45O456Zk9tleK0UYVytetOjygM1Ox2ZwD5bklVDSzGZPCbUQj4TpR1I3f3LOr2yXKnMYol6ZyhfQW3n9w6uQSGvQ6Vc0muKJzHcQE1sV4XIrqclWvQJb9rQtsaszmIi4Y4Fwmvg6FFhk="}},"id":"prt_1148b1a4e0013C7ay07tCGFrf5","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148b12fa001HiQQISk68wcGtJ"}}
