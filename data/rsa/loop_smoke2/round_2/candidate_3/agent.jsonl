{"type":"tool_use","timestamp":1791346017472,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"read","callID":"25dwJRH8KB0ypDBd","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2_shared_prior.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2_shared_prior.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener at depth 2 with a shared salience prior.\n2: \n3: Refines the depth-2 model (rsa_l2) by replacing the uniform object prior with a\n4: salience prior that is common knowledge at every level of recursive reasoning\n5: (as in rsa_l1_shared_prior). The prior is a softmax over object feature count\n6: (w_features) and familiarization base rate (w_familiar). Literal listener L0,\n7: pragmatic speaker S1, listener L1, speaker S2, and depth-2 listener L2 all share\n8: this prior. On prior-elicitation trials (no informative word), participants\n9: choose according to the salience prior directly. A lapse parameter mixes in\n10: uniform guessing.\n11: \"\"\"\n12: \n13: import jax.numpy as jnp\n14: import numpyro.distributions as dist\n15: from memo import memo\n16: \n17: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n18: \n19: PARAMS = {\n20:     \"alpha\": dist.LogNormal(0.0, 1.0),\n21:     \"w_features\": dist.Normal(0.0, 1.0),\n22:     \"w_familiar\": dist.Normal(0.0, 2.0),\n23:     \"lapse\": dist.Beta(1.0, 9.0),\n24: }\n25: \n26: \n27: @memo\n28: def L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n29:     listener: knows(u)\n30:     listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n31:     return Pr[listener.r == r]\n32: \n33: \n34: @memo\n35: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n36:     listener: thinks[\n37:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n38:         speaker: chooses(\n39:             u in UTT,\n40:             wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n41:         ),\n42:     ]\n43:     listener: observes [speaker.u] is u\n44:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n45:     return Pr[listener.r == r]\n46: \n47: \n48: @memo\n49: def L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n50:     listener: thinks[\n51:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n52:         speaker: chooses(\n53:             u in UTT,\n54:             wpp=at(lex, u, r)\n55:             * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n56:         ),\n57:     ]\n58:     listener: observes [speaker.u] is u\n59:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n60:     return Pr[listener.r == r]\n61: \n62: \n63: def choice_probs(params, ctx):\n64:     prior = softmax_prior(\n65:         params[\"w_features\"] * ctx.feature_count\n66:         + params[\"w_familiar\"] * ctx.familiarization\n67:     )\n68:     heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n69:     return with_lapse(\n70:         jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"]\n71:     )\n\n(End of file - total 71 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener at depth 2 with a shared salience prior.\n\nRefines the depth-2 model (rsa_l2) by replacing the uniform object prior with a\nsalience prior that is common knowledge at every level of recursive reasoning\n(as in rsa_l1_shared_prior). The prior is a softmax over object feature count\n(w_features) and familiarization base rate (w_familiar). Literal listener L0,\npragmatic speaker S1, listener L1, speaker S2, and depth-2 listener L2 all share\nthis prior. On prior-elicitation trials (no informative word), participants\nchoose according to the salience prior directly. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2_shared_prior.py","text":"\"\"\"RSA pragmatic listener at depth 2 with a shared salience prior.\n\nRefines the depth-2 model (rsa_l2) by replacing the uniform object prior with a\nsalience prior that is common knowledge at every level of recursive reasoning\n(as in rsa_l1_shared_prior). The prior is a softmax over object feature count\n(w_features) and familiarization base rate (w_familiar). Literal listener L0,\npragmatic speaker S1, listener L1, speaker S2, and depth-2 listener L2 all share\nthis prior. On prior-elicitation trials (no informative word), participants\nchoose according to the salience prior directly. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r)\n            * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count\n        + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(\n        jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"]\n    )","lineStart":1,"lineEnd":71,"totalLines":71,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l2_shared_prior.py","time":{"start":1791346017278,"end":1791346017466}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148b03ef001N6dgjAPyGm5Xiz","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148afc150016ga7pcAbjtfseU"}}
