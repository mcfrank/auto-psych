{"type":"tool_use","timestamp":1791346602031,"sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","part":{"type":"tool","tool":"bash","callID":"DCLXH0H8WaC26dug","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c \"\nimport tempfile\nfrom pathlib import Path\nfrom src.rsa.model_file import RSAModel\nfrom src.rsa.loop.novelty import novelty_pool, posterior_mean_class_probs, closest\nfrom src.rsa.loop.fitting import _read\nimport numpy as np\n\n# Let's write Variant 1 to a temp file\ncode = '''\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \\\"alpha\\\": dist.LogNormal(0.0, 1.0),\n    \\\"w_valence\\\": dist.Normal(0.0, 1.0),\n    \\\"lapse\\\": dist.Beta(1.0, 9.0),\n}\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r)\n            * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(params[\\\"w_valence\\\"] * ctx.valence * ctx.feature_count)\n    heard = L2(params[\\\"alpha\\\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\\\"lapse\\\"])\n'''\n\nwith tempfile.TemporaryDirectory() as td:\n    p = Path(td) / 'candidate.py'\n    p.write_text(code)\n    m = RSAModel(p, 'valence_salience_l2')\n    \n    # We can evaluate predictions using posterior mean of valence_salience_listener parameters\n    # alpha ~ 0.8, w_valence ~ 1.0, lapse ~ 0.04\n    pool = novelty_pool()\n    cache_dir = Path('data/rsa/loop_smoke2/.fit_cache')\n    \n    admitted_preds = {}\n    for name in ['literal_listener', 'rsa_l1', 'rsa_l2', 'rsa_l1_salience', 'rsa_l1_shared_prior', 'valence_salience_listener', 'rsa_l2_shared_prior', 'rsa_l2_shared_prior_2']:\n        mod = RSAModel(Path(f'data/rsa/loop_smoke2/models/{name}.py'), name)\n        fit = _read(cache_dir / f'{name}.nc', cache_dir / f'{name}.json')\n        admitted_preds[name] = posterior_mean_class_probs(mod, fit, pool)\n    \n    # Also candidate 2's model if we can\n    # Let's mock a fit for m using valence_salience_listener's idata\n    f_val = _read(cache_dir / 'valence_salience_listener.nc', cache_dir / 'valence_salience_listener.json')\n    preds_m = posterior_mean_class_probs(m, f_val, pool)\n    \n    nearest, dist = closest(preds_m, admitted_preds)\n    print(f'Closest model: {nearest}, RMSE distance: {dist:.5f}')\n    for name, p in admitted_preds.items():\n        d = np.sqrt(np.mean((preds_m - p) ** 2))\n        print(f'  vs {name}: RMSE = {d:.5f}')\n\""},"output":"Closest model: valence_salience_listener, RMSE distance: 0.02330\n  vs literal_listener: RMSE = 0.10886\n  vs rsa_l1: RMSE = 0.04629\n  vs rsa_l2: RMSE = 0.04517\n  vs rsa_l1_salience: RMSE = 0.06612\n  vs rsa_l1_shared_prior: RMSE = 0.06587\n  vs valence_salience_listener: RMSE = 0.02330\n  vs rsa_l2_shared_prior: RMSE = 0.06363\n  vs rsa_l2_shared_prior_2: RMSE = 0.05200\n","metadata":{"output":"Closest model: valence_salience_listener, RMSE distance: 0.02330\n  vs literal_listener: RMSE