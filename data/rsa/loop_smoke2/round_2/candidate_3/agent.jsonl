\n41:     return Pr[listener.r == r]\n42: \n43: \n44: def choice_probs(params, ctx):\n45:     prior = softmax_prior(\n46:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n47:     )\n48:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n49:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 49 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py","text":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":49,"totalLines":49,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py","time":{"start":1791346020852,"end":1791346020907}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1148b11e9001Whp5k36JF4NLUs","sessionID":"ses_eeb753877ffeEZ5M2IaWa5Y4aK","messageID":"msg_1148b0511001MagPn63RAJFiLt"}}
