{"type":"tool_use","timestamp":1791339922648,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"read","callID":"Geldt1ptApUTWCaG","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/loop/gates.py","limit":120},"output":"<path>/home/user/auto-psych/src/rsa/loop/gates.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n2: \n3: A candidate directory must hold ``candidate.py`` (the model file) and\n4: ``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\n5: It is admitted only if, in order:\n6: \n7: 1. the code gate passes (`src.rsa.loop.code_gate`);\n8: 2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n9:    on the training displays AND on every shape of the novelty pool, so a model\n10:    that breaks on a 4 x 4 game is refused before any sampling;\n11: 3. it fits within the time limit, gives no observed choice probability zero,\n12:    and passes the convergence gate (one refit at target_accept 0.95 with a\n13:    fresh seed when the first fit fails it);\n14: 4. its ELPD-LOO is finite;\n15: 5. it is novel: its posterior-mean pool predictions are at least the\n16:    threshold (RMSE) from every admitted model's.\n17: \n18: Every refusal carries a reason written for the agent that will be asked to\n19: repair it. Infrastructure failures raise instead.\n20: \"\"\"\n21: \n22: from __future__ import annotations\n23: \n24: import math\n25: from dataclasses import dataclass, replace\n26: from pathlib import Path\n27: from typing import Dict, Mapping, Optional, Sequence\n28: \n29: import numpy as np\n30: \n31: from src.rsa.context import Context, group_by_shape\n32: from src.rsa.fit import FitSettings, RSAFit\n33: from src.rsa.loop.code_gate import code_problems\n34: from src.rsa.loop.fitting import ModelFailure, fit_cached\n35: from src.rsa.loop.novelty import closest, posterior_mean_class_probs\n36: from src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\n37: \n38: REFIT_TARGET_ACCEPT = 0.95\n39: \n40: \n41: @dataclass\n42: class Admission:\n43:     admitted: bool\n44:     reason: str\n45:     fit: Optional[RSAFit] = None\n46:     pool_preds: Optional[np.ndarray] = None\n47:     elpd_loo: Optional[float] = None\n48:     loo_reliable: Optional[bool] = None\n49: \n50: \n51: @dataclass(frozen=True)\n52: class GateConfig:\n53:     responses_path: Path\n54:     cache_dir: Path\n55:     settings: FitSettings\n56:     novelty_threshold: float\n57:     time_limit_sec: Optional[float]\n58: \n59: \n60: def _refuse(reason: str) -> Admission:\n61:     return Admission(admitted=False, reason=reason)\n62: \n63: \n64: def read_candidate(candidate_dir: Path) -> Optional[str]:\n65:     \"\"\"The reason a candidate directory is incomplete, or None.\"\"\"\n66:     for required in (\"candidate.py\", \"hypothesis.md\"):\n67:         f = Path(candidate_dir) / required\n68:         if not f.exists() or not f.read_text(encoding=\"utf-8\").strip():\n69:             return f\"{required} is missing or empty\"\n70:     return None\n71: \n72: \n73: def fit_with_refit(model_path: Path, name: str, cfg: GateConfig) -> RSAFit:\n74:     fitted = fit_cached(model_path, name, cfg.responses_path, cfg.settings, cfg.cache_dir,\n75:                         time_limit_sec=cfg.time_limit_sec)\n76:     if fitted.converged:\n77:         return fitted\n78:     retry = replace(cfg.settings, target_accept=max(cfg.settings.target_accept, REFIT_TARGET_ACCEPT),\n79:                     seed=cfg.settings.seed + 1)\n80:     return fit_cached(model_path, name, cfg.responses_path, retry, cfg.cache_dir,\n81:                       time_limit_sec=cfg.time_limit_sec)\n82: \n83: \n84: def admit(\n85:     candidate_dir: Path,\n86:     name: str,\n87:     *,\n88:     cfg: GateConfig,\n89:     training: Sequence[Context],\n90:     pool: Sequence[Context],\n91:     admitted_preds: Mapping[str, np.ndarray],\n92: ) -> Admission:\n93:     candidate_dir = Path(candidate_dir)\n94:     missing = read_candidate(candidate_dir)\n95:     if missing:\n96:         return _refuse(missing)\n97:     model_path = candidate_dir / \"candidate.py\"\n98:     source = model_path.read_text(encoding=\"utf-8\")\n99:     problems = code_problems(source)\n100:     if problems:\n101:         return _refuse(\n102:             \"the code gate refused candidate.py: \" + \", \".join(problems)\n103:             + \". Model files may import jax, memo, numpyro, numpy, a few stdlib modules \"\n104:             \"and src.rsa.memo_kit only, and may not read files or reach the interpreter.\"\n105:         )\n106:     try:\n107:         model = RSAModel(model_path, name=name)\n108:         check_contract(model, group_by_shape(training))\n109:         check_contract(model, group_by_shape(pool))\n110:     except ModelContractViolation as exc:\n111:         return _refuse(f\"contract: {exc}\")\n112:     except Exception as exc:  # memo compile errors, errors in the model's own code\n113:         from src.rsa.loop.fitting import is_model_failure\n114: \n115:         if is_model_failure(exc, model_path):\n116:             return _refuse(f\"the model failed to load or run: {type(exc).__name__}: {exc}\")\n117:         raise\n118:     try:\n119:         fitted = fit_with_refit(model_path, name, cfg)\n120:     except ModelFailure as exc:\n\n(Showing lines 1-120 of 157. Use offset=121 to continue.)\n</content>","metadata":{"preview":"\"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n\nA candidate directory must hold ``candidate.py`` (the model file) and\n``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\nIt is admitted only if, in order:\n\n1. the code gate passes (`src.rsa.loop.code_gate`);\n2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n   on the training displays AND on every shape of the novelty pool, so a model\n   that breaks on a 4 x 4 game is refused before any sampling;\n3. it fits within the time limit, gives no observed choice probability zero,\n   and passes the convergence gate (one refit at target_accept 0.95 with a\n   fresh seed when the first fit fails it);\n4. its ELPD-LOO is finite;\n5. it is novel: its posterior-mean pool predictions are at least the\n   threshold (RMSE) from every admitted model's.\n\nEvery refusal carries a reason written for the agent that will be asked to\nrepair it. Infrastructure failures raise instead.\n\"\"\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/gates.py","text":"\"\"\"Admission of an agent-written memo candidate to the RSA loop's zoo.\n\nA candidate directory must hold ``candidate.py`` (the model file) and\n``hypothesis.md`` (its mechanism in prose); ``model_name.txt`` is optional.\nIt is admitted only if, in order:\n\n1. the code gate passes (`src.rsa.loop.code_gate`);\n2. it loads and meets the model contract (`src.rsa.model_file.check_contract`)\n   on the training displays AND on every shape of the novelty pool, so a model\n   that breaks on a 4 x 4 game is refused before any sampling;\n3. it fits within the time limit, gives no observed choice probability zero,\n   and passes the convergence gate (one refit at target_accept 0.95 with a\n   fresh seed when the first fit fails it);\n4. its ELPD-LOO is finite;\n5. it is novel: its posterior-mean pool predictions are at least the\n   threshold (RMSE) from every admitted model's.\n\nEvery refusal carries a reason written for the agent that will be asked to\nrepair it. Infrastructure failures raise instead.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom dataclasses import dataclass, replace\nfrom pathlib import Path\nfrom typing import Dict, Mapping, Optional, Sequence\n\nimport numpy as np\n\nfrom src.rsa.context import Context, group_by_shape\nfrom src.rsa.fit import FitSettings, RSAFit\nfrom src.rsa.loop.code_gate import code_problems\nfrom src.rsa.loop.fitting import ModelFailure, fit_cached\nfrom src.rsa.loop.novelty import closest, posterior_mean_class_probs\nfrom src.rsa.model_file import ModelContractViolation, RSAModel, check_contract\n\nREFIT_TARGET_ACCEPT = 0.95\n\n\n@dataclass\nclass Admission:\n    admitted: bool\n    reason: str\n    fit: Optional[RSAFit] = None\n    pool_preds: Optional[np.ndarray] = None\n    elpd_loo: Optional[float] = None\n    loo_reliable: Optional[bool] = None\n\n\n@dataclass(frozen=True)\nclass GateConfig:\n    responses_path: Path\n    cache_dir: Path\n    settings: FitSettings\n    novelty_threshold: float\n    time_limit_sec: Optional[float]\n\n\ndef _refuse(reason: str) -> Admission:\n    return Admission(admitted=False, reason=reason)\n\n\ndef read_candidate(candidate_dir: Path) -> Optional[str]:\n    \"\"\"The reason a candidate directory is incomplete, or None.\"\"\"\n    for required in (\"candidate.py\", \"hypothesis.md\"):\n        f = Path(candidate_dir) / required\n        if not f.exists() or not f.read_text(encoding=\"utf-8\").strip():\n            return f\"{required} is missing or empty\"\n    return None\n\n\ndef fit_with_refit(model_path: Path, name: str, cfg: GateConfig) -> RSAFit:\n    fitted = fit_cached(model_path, name, cfg.responses_path, cfg.settings, cfg.cache_dir,\n                        time_limit_sec=cfg.time_limit_sec)\n    if fitted.converged:\n        return fitted\n    retry = replace(cfg.settings, target_accept=max(cfg.settings.target_accept, REFIT_TARGET_ACCEPT),\n                    seed=cfg.settings.seed + 1)\n    return fit_cached(model_path, name, cfg.responses_path, retry, cfg.cache_dir,\n                      time_limit_sec=cfg.time_limit_sec)\n\n\ndef admit(\n    candidate_dir: Path,\n    name: str,\n    *,\n    cfg: GateConfig,\n    training: Sequence[Context],\n    pool: Sequence[Context],\n    admitted_preds: Mapping[str, np.ndarray],\n) -> Admission:\n    candidate_dir = Path(candidate_dir)\n    missing = read_candidate(candidate_dir)\n    if missing:\n        return _refuse(missing)\n    model_path = candidate_dir / \"candidate.py\"\n    source = model_path.read_text(encoding=\"utf-8\")\n    problems = code_problems(source)\n    if problems:\n        return _refuse(\n            \"the code gate refused candidate.py: \" + \", \".join(problems)\n            + \". Model files may import jax, memo, numpyro, numpy, a few stdlib modules \"\n            \"and src.rsa.memo_kit only, and may not read files or reach the interpreter.\"\n        )\n    try:\n        model = RSAModel(model_path, name=name)\n        check_contract(model, group_by_shape(training))\n        check_contract(model, group_by_shape(pool))\n    except ModelContractViolation as exc:\n        return _refuse(f\"contract: {exc}\")\n    except Exception as exc:  # memo compile errors, errors in the model's own code\n        from src.rsa.loop.fitting import is_model_failure\n\n        if is_model_failure(exc, model_path):\n            return _refuse(f\"the model failed to load or run: {type(exc).__name__}: {exc}\")\n        raise\n    try:\n        fitted = fit_with_refit(model_path, name, cfg)\n    except ModelFailure as exc:","lineStart":1,"lineEnd":120,"totalLines":157,"truncated":true}},"title":"src/rsa/loop/gates.py","time":{"start":1791339922546,"end":1791339922580}},"metadata":{"google":{"thoughtSignature":"Es4BCssBAWkUfRMfKIIiKI6G9wNwMjQpNx9GvFQSWdEOXt2/mcDOw52vZ18a2rxFmDMusrYJC5rtxusStv0wKaC5JQ5ugtC+BoedT31GSwqNPCuDSPfkKKphvgcuotS4sop9I31M2l1waF0EjN+GFMt55esbP7D2mgM7YTf1whzEq6l/XQDjogv1sS5D9pHjQFE8ggPZoApScsiZ5BLtNMeBnKZ5xLPPHN9NYKbIDq1IWGXYjxFMLeqDUhFcVKERk1yxj+G7+K7TS2qyE3cXktM="}},"id":"prt_1142e0461001LIzaDNxG2Knv9q","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_1142df2ba001sh9pLFoFwewNbU"}}
{"type":"step_finish","timestamp":1791339922648,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"id":"prt_1142e04a0001y4RN4L84ZD1nD5","reason":"tool-calls","messageID":"msg_1142df2ba001sh9pLFoFwewNbU","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","type":"step-finish","tokens":{"total":37260,"input":4380,"output":37,"reasoning":26,"cache":{"write":0,"read":32817}},"cost":0.005982525}}
{"type":"step_start","timestamp":1791339925217,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"id":"prt_1142e0ec5001Vg2AnNnnrqb5gw","messageID":"msg_1142e04bf001EuOwkTzdzNArUK","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","type":"step-start"}}
{"type":"tool_use","timestamp":1791339925261,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"read","callID":"SaWG8MSnBg7Dva3d","state":{"status":"completed","input":{"limit":100,"filePath":"/home/user/auto-psych/src/rsa/context.py"},"output":"<path>/home/user/auto-psych/src/rsa/context.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Reference-game contexts and their encoding for memo models.\n2: \n3: A context is what one trial shows a listener: a few objects (referents), each\n4: a set of features, and either the one feature word a speaker said (an\n5: *utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\n6: will he pick next?\").\n7: \n8: Models never see padding. memo enumerates over fixed domains, and padding a\n9: small context out to a common size makes some distribution a 0/0 — harmless in\n10: memo's forward pass (it returns zeros) but NaN in its gradient, which stops\n11: NUTS. So trials are grouped by shape (`group_by_shape`) and each group is\n12: evaluated by a copy of the model compiled with exact-size domains `OBJ` and\n13: `UTT` (`src.rsa.model_file`).\n14: \n15: The utterances of a context are the features true of at least one object, in\n16: feature order, plus — when some object has none of them — a final **sink**\n17: utterance true of exactly those objects (\"no word applies\"). Without it a\n18: speaker who means a featureless object (the plain face of the pragmods simple\n19: game) has no true word, again a 0/0. The sink is never observed, and it adds\n20: no probability to any object a real word is true of, so L0/S1/L1 values on\n21: real words are the textbook ones.\n22: \"\"\"\n23: \n24: from __future__ import annotations\n25: \n26: from dataclasses import dataclass\n27: from typing import Dict, List, NamedTuple, Optional, Sequence, Tuple\n28: \n29: import jax.numpy as jnp\n30: import numpy as np\n31: \n32: SINK = \"<sink>\"\n33: \n34: \n35: class ContextArrays(NamedTuple):\n36:     \"\"\"One trial (or, stacked, a group of same-shape trials) as JAX arrays.\n37: \n38:     Shapes are for one trial; a group adds a leading trial axis.\n39:     \"\"\"\n40: \n41:     lex: jnp.ndarray  # (N_UTT, N_OBJ) 1.0 where utterance u is true of object r\n42:     is_sink: jnp.ndarray  # (N_UTT,) 1.0 for the sink utterance\n43:     feature_count: jnp.ndarray  # (N_OBJ,) number of context words true of each object\n44:     utterance: jnp.ndarray  # () int32 utterance index heard (0 for a prior query)\n45:     is_prior: jnp.ndarray  # () 1.0 for a prior query (no informative word)\n46:     familiarization: jnp.ndarray  # (N_OBJ,) base rate seen in familiarization, 0..1\n47:     has_familiarization: jnp.ndarray  # () 1.0 when there was a familiarization phase\n48:     grayscale: jnp.ndarray  # (N_OBJ,) 1.0 for an object shown in grayscale\n49:     valence: jnp.ndarray  # () +1 \"favorite\" framing, -1 \"least favorite\", 0 neutral\n50: \n51: \n52: @dataclass(frozen=True)\n53: class Context:\n54:     \"\"\"One trial's display. ``utterance`` indexes ``feature_names`` (None: prior query).\"\"\"\n55: \n56:     objects: Tuple[Tuple[int, ...], ...]\n57:     feature_names: Tuple[str, ...]\n58:     utterance: Optional[int]\n59:     item: str = \"\"\n60:     familiarization: Optional[Tuple[float, ...]] = None\n61:     grayscale: Optional[Tuple[int, ...]] = None\n62:     valence: int = 0\n63:     # Feature indices the speaker can name (the message set). None: every\n64:     # feature is a word (pragmods). In the Franke & Degen game some features\n65:     # (e.g. square, blue) have no word, which changes which inferences hold.\n66:     messages: Optional[Tuple[int, ...]] = None\n67: \n68:     def __post_init__(self) -> None:\n69:         objects = tuple(tuple(int(v) for v in row) for row in self.objects)\n70:         object.__setattr__(self, \"objects\", objects)\n71:         object.__setattr__(self, \"feature_names\", tuple(self.feature_names))\n72:         if not objects:\n73:             raise ValueError(\"a context needs at least one object\")\n74:         n_features = len(self.feature_names)\n75:         if any(len(row) != n_features for row in objects):\n76:             raise ValueError(\n77:                 f\"objects must be rectangular with one entry per feature \"\n78:                 f\"({n_features}): {objects}\"\n79:             )\n80:         if any(v not in (0, 1) for row in objects for v in row):\n81:             raise ValueError(f\"object features must be 0/1: {objects}\")\n82:         if self.messages is not None:\n83:             messages = tuple(int(m) for m in self.messages)\n84:             object.__setattr__(self, \"messages\", messages)\n85:             if not messages or len(set(messages)) != len(messages):\n86:                 raise ValueError(f\"messages must be distinct feature indices: {messages}\")\n87:             if any(not 0 <= m < n_features for m in messages):\n88:                 raise ValueError(f\"messages {messages} are not all feature indices (0..{n_features - 1})\")\n89:         if self.utterance is not None:\n90:             if self.messages is not None and self.utterance not in self.messages:\n91:                 raise ValueError(\n92:                     f\"utterance {self.feature_names[self.utterance]!r} is not in the message set\"\n93:                 )\n94:             if not 0 <= self.utterance < n_features:\n95:                 raise ValueError(\n96:                     f\"utterance {self.utterance} is not a feature index (0..{n_features - 1})\"\n97:                 )\n98:             if not any(row[self.utterance] for row in objects):\n99:                 raise ValueError(\n100:                     f\"utterance {self.feature_names[self.utterance]!r} is true of no object\"\n\n(Showing lines 1-100 of 224. Use offset=101 to continue.)\n</content>","metadata":{"preview":"\"\"\"Reference-game contexts and their encoding for memo models.\n\nA context is what one trial shows a listener: a few objects (referents), each\na set of features, and either the one feature word a speaker said (an\n*utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\nwill he pick next?\").\n\nModels never see padding. memo enumerates over fixed domains, and padding a\nsmall context out to a common size makes some distribution a 0/0 — harmless in\nmemo's forward pass (it returns zeros) but NaN in its gradient, which stops\nNUTS. So trials are grouped by shape (`group_by_shape`) and each group is\nevaluated by a copy of the model compiled with exact-size domains `OBJ` and\n`UTT` (`src.rsa.model_file`).\n\nThe utterances of a context are the features true of at least one object, in\nfeature order, plus — when some object has none of them — a final **sink**\nutterance true of exactly those objects (\"no word applies\"). Without it a\nspeaker who means a featureless object (the plain face of the pragmods simple\ngame) has no true word, again a 0/0. The sink is never observed, and it adds\nno probability to any object a real word is true of, so L0/S1/L1 values on","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/context.py","text":"\"\"\"Reference-game contexts and their encoding for memo models.\n\nA context is what one trial shows a listener: a few objects (referents), each\na set of features, and either the one feature word a speaker said (an\n*utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\nwill he pick next?\").\n\nModels never see padding. memo enumerates over fixed domains, and padding a\nsmall context out to a common size makes some distribution a 0/0 — harmless in\nmemo's forward pass (it returns zeros) but NaN in its gradient, which stops\nNUTS. So trials are grouped by shape (`group_by_shape`) and each group is\nevaluated by a copy of the model compiled with exact-size domains `OBJ` and\n`UTT` (`src.rsa.model_file`).\n\nThe utterances of a context are the features true of at least one object, in\nfeature order, plus — when some object has none of them — a final **sink**\nutterance true of exactly those objects (\"no word applies\"). Without it a\nspeaker who means a featureless object (the plain face of the pragmods simple\ngame) has no true word, again a 0/0. The sink is never observed, and it adds\nno probability to any object a real word is true of, so L0/S1/L1 values on\nreal words are the textbook ones.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Dict, List, NamedTuple, Optional, Sequence, Tuple\n\nimport jax.numpy as jnp\nimport numpy as np\n\nSINK = \"<sink>\"\n\n\nclass ContextArrays(NamedTuple):\n    \"\"\"One trial (or, stacked, a group of same-shape trials) as JAX arrays.\n\n    Shapes are for one trial; a group adds a leading trial axis.\n    \"\"\"\n\n    lex: jnp.ndarray  # (N_UTT, N_OBJ) 1.0 where utterance u is true of object r\n    is_sink: jnp.ndarray  # (N_UTT,) 1.0 for the sink utterance\n    feature_count: jnp.ndarray  # (N_OBJ,) number of context words true of each object\n    utterance: jnp.ndarray  # () int32 utterance index heard (0 for a prior query)\n    is_prior: jnp.ndarray  # () 1.0 for a prior query (no informative word)\n    familiarization: jnp.ndarray  # (N_OBJ,) base rate seen in familiarization, 0..1\n    has_familiarization: jnp.ndarray  # () 1.0 when there was a familiarization phase\n    grayscale: jnp.ndarray  # (N_OBJ,) 1.0 for an object shown in grayscale\n    valence: jnp.ndarray  # () +1 \"favorite\" framing, -1 \"least favorite\", 0 neutral\n\n\n@dataclass(frozen=True)\nclass Context:\n    \"\"\"One trial's display. ``utterance`` indexes ``feature_names`` (None: prior query).\"\"\"\n\n    objects: Tuple[Tuple[int, ...], ...]\n    feature_names: Tuple[str, ...]\n    utterance: Optional[int]\n    item: str = \"\"\n    familiarization: Optional[Tuple[float, ...]] = None\n    grayscale: Optional[Tuple[int, ...]] = None\n    valence: int = 0\n    # Feature indices the speaker can name (the message set). None: every\n    # feature is a word (pragmods). In the Franke & Degen game some features\n    # (e.g. square, blue) have no word, which changes which inferences hold.\n    messages: Optional[Tuple[int, ...]] = None\n\n    def __post_init__(self) -> None:\n        objects = tuple(tuple(int(v) for v in row) for row in self.objects)\n        object.__setattr__(self, \"objects\", objects)\n        object.__setattr__(self, \"feature_names\", tuple(self.feature_names))\n        if not objects:\n            raise ValueError(\"a context needs at least one object\")\n        n_features = len(self.feature_names)\n        if any(len(row) != n_features for row in objects):\n            raise ValueError(\n                f\"objects must be rectangular with one entry per feature \"\n                f\"({n_features}): {objects}\"\n            )\n        if any(v not in (0, 1) for row in objects for v in row):\n            raise ValueError(f\"object features must be 0/1: {objects}\")\n        if self.messages is not None:\n            messages = tuple(int(m) for m in self.messages)\n            object.__setattr__(self, \"messages\", messages)\n            if not messages or len(set(messages)) != len(messages):\n                raise ValueError(f\"messages must be distinct feature indices: {messages}\")\n            if any(not 0 <= m < n_features for m in messages):\n                raise ValueError(f\"messages {messages} are not all feature indices (0..{n_features - 1})\")\n        if self.utterance is not None:\n            if self.messages is not None and self.utterance not in self.messages:\n                raise ValueError(\n                    f\"utterance {self.feature_names[self.utterance]!r} is not in the message set\"\n                )\n            if not 0 <= self.utterance < n_features:\n                raise ValueError(\n                    f\"utterance {self.utterance} is not a feature index (0..{n_features - 1})\"\n                )\n            if not any(row[self.utterance] for row in objects):\n                raise ValueError(\n                    f\"utterance {self.feature_names[self.utterance]!r} is true of no object\"","lineStart":1,"lineEnd":100,"totalLines":224,"truncated":true}},"title":"src/rsa/context.py","time":{"start":1791339925208,"end":1791339925222}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142e0ece001Iwv2qf84KIemzC","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_1142e04bf001EuOwkTzdzNArUK"}}
