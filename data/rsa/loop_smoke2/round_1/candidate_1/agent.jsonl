{"type":"tool_use","timestamp":1791340042244,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"read","callID":"l3lngx9vkFirBmTo","state":{"status":"completed","input":{"limit":100,"filePath":"/home/user/auto-psych/src/rsa/loop/fitting.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/fitting.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n2: \n3: A fit is content-addressed by (model file sha, responses file sha, sampler\n4: settings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n5: ``.json`` (parameter names, convergence problems). A cached fit is reused,\n6: never recomputed; files are written under a temporary name and\n7: ``os.replace``d into place.\n8: \n9: A fit can run in a spawned child process with a time limit (agent-written\n10: candidates: a pathological model must not stall the loop). Failures are\n11: classified as in the PyMC domain: a failure of the model itself (its own\n12: code raised, memo refused to compile it, it broke the contract, it gives an\n13: observed choice probability zero) is a `ModelFailure` the caller turns into a\n14: rejection; anything else (a killed worker, an unreadable file, OSError,\n15: MemoryError) is infrastructure and raises.\n16: \"\"\"\n17: \n18: from __future__ import annotations\n19: \n20: import hashlib\n21: import json\n22: import multiprocessing as mp\n23: import os\n24: import traceback\n25: from dataclasses import asdict, dataclass\n26: from pathlib import Path\n27: from typing import Any, List, Optional\n28: \n29: from src.rsa.fit import FitSettings, RSAFit, ZeroProbabilityChoice\n30: \n31: FIT_TIME_LIMIT_SEC = 30 * 60  # as the PyMC domain's CANDIDATE_FIT_TIME_LIMIT_SEC\n32: \n33: \n34: class ModelFailure(RuntimeError):\n35:     \"\"\"The model failed (a rejection), as opposed to the infrastructure.\"\"\"\n36: \n37: \n38: class FitTimeLimitExceeded(ModelFailure):\n39:     \"\"\"The fit did not finish within the time limit (the model is too slow).\"\"\"\n40: \n41: \n42: def _sha_file(path: Path) -> str:\n43:     return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n44: \n45: \n46: def fingerprint(model_path: Path, responses_path: Path, settings: FitSettings) -> str:\n47:     h = hashlib.sha256()\n48:     h.update(_sha_file(model_path).encode())\n49:     h.update(_sha_file(responses_path).encode())\n50:     h.update(json.dumps(asdict(settings), sort_keys=True).encode())\n51:     return h.hexdigest()[:20]\n52: \n53: \n54: def cache_paths(cache_dir: Path, name: str, fp: str) -> tuple[Path, Path]:\n55:     base = Path(cache_dir) / f\"{name}.{fp}\"\n56:     return base.with_suffix(\".nc\"), base.with_suffix(\".json\")\n57: \n58: \n59: def _model_failure_types() -> tuple:\n60:     from memo.core import MemoError\n61: \n62:     from src.rsa.model_file import ModelContractViolation\n63: \n64:     return (ModelContractViolation, ZeroProbabilityChoice, MemoError, SyntaxError)\n65: \n66: \n67: def is_model_failure(exc: BaseException, model_path: Path) -> bool:\n68:     \"\"\"A failure of the model: a known model-failure type, or raised in its file.\"\"\"\n69:     if isinstance(exc, (OSError, MemoryError)):\n70:         return False\n71:     if isinstance(exc, _model_failure_types()):\n72:         return True\n73:     model_path = str(Path(model_path).resolve())\n74:     frames = traceback.extract_tb(exc.__traceback__)\n75:     return bool(frames) and any(str(Path(f.filename).resolve()) == model_path for f in frames)\n76: \n77: \n78: def _write(fitted: RSAFit, nc_path: Path, meta_path: Path) -> None:\n79:     nc_path.parent.mkdir(parents=True, exist_ok=True)\n80:     tmp = nc_path.with_suffix(f\".tmp{os.getpid()}.nc\")\n81:     fitted.idata.to_netcdf(str(tmp))\n82:     os.replace(tmp, nc_path)\n83:     meta = dict(\n84:         model_name=fitted.model_name,\n85:         param_names=fitted.param_names,\n86:         convergence_problems=fitted.convergence_problems,\n87:     )\n88:     tmp_meta = meta_path.with_suffix(f\".tmp{os.getpid()}.json\")\n89:     tmp_meta.write_text(json.dumps(meta))\n90:     os.replace(tmp_meta, meta_path)\n91: \n92: \n93: def _read(nc_path: Path, meta_path: Path) -> RSAFit:\n94:     import arviz as az\n95: \n96:     meta = json.loads(meta_path.read_text())\n97:     idata = az.from_netcdf(str(nc_path))\n98:     idata.load()\n99:     return RSAFit(\n100:         model_name=meta[\"model_name\"],\n\n(Showing lines 1-100 of 192. Use offset=101 to continue.)\n</content>","metadata":{"preview":"\"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n\nA fit is content-addressed by (model file sha, responses file sha, sampler\nsettings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n``.json`` (parameter names, convergence problems). A cached fit is reused,\nnever recomputed; files are written under a temporary name and\n``os.replace``d into place.\n\nA fit can run in a spawned child process with a time limit (agent-written\ncandidates: a pathological model must not stall the loop). Failures are\nclassified as in the PyMC domain: a failure of the model itself (its own\ncode raised, memo refused to compile it, it broke the contract, it gives an\nobserved choice probability zero) is a `ModelFailure` the caller turns into a\nrejection; anything else (a killed worker, an unreadable file, OSError,\nMemoryError) is infrastructure and raises.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/fitting.py","text":"\"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n\nA fit is content-addressed by (model file sha, responses file sha, sampler\nsettings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n``.json`` (parameter names, convergence problems). A cached fit is reused,\nnever recomputed; files are written under a temporary name and\n``os.replace``d into place.\n\nA fit can run in a spawned child process with a time limit (agent-written\ncandidates: a pathological model must not stall the loop). Failures are\nclassified as in the PyMC domain: a failure of the model itself (its own\ncode raised, memo refused to compile it, it broke the contract, it gives an\nobserved choice probability zero) is a `ModelFailure` the caller turns into a\nrejection; anything else (a killed worker, an unreadable file, OSError,\nMemoryError) is infrastructure and raises.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport multiprocessing as mp\nimport os\nimport traceback\nfrom dataclasses import asdict, dataclass\nfrom pathlib import Path\nfrom typing import Any, List, Optional\n\nfrom src.rsa.fit import FitSettings, RSAFit, ZeroProbabilityChoice\n\nFIT_TIME_LIMIT_SEC = 30 * 60  # as the PyMC domain's CANDIDATE_FIT_TIME_LIMIT_SEC\n\n\nclass ModelFailure(RuntimeError):\n    \"\"\"The model failed (a rejection), as opposed to the infrastructure.\"\"\"\n\n\nclass FitTimeLimitExceeded(ModelFailure):\n    \"\"\"The fit did not finish within the time limit (the model is too slow).\"\"\"\n\n\ndef _sha_file(path: Path) -> str:\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef fingerprint(model_path: Path, responses_path: Path, settings: FitSettings) -> str:\n    h = hashlib.sha256()\n    h.update(_sha_file(model_path).encode())\n    h.update(_sha_file(responses_path).encode())\n    h.update(json.dumps(asdict(settings), sort_keys=True).encode())\n    return h.hexdigest()[:20]\n\n\ndef cache_paths(cache_dir: Path, name: str, fp: str) -> tuple[Path, Path]:\n    base = Path(cache_dir) / f\"{name}.{fp}\"\n    return base.with_suffix(\".nc\"), base.with_suffix(\".json\")\n\n\ndef _model_failure_types() -> tuple:\n    from memo.core import MemoError\n\n    from src.rsa.model_file import ModelContractViolation\n\n    return (ModelContractViolation, ZeroProbabilityChoice, MemoError, SyntaxError)\n\n\ndef is_model_failure(exc: BaseException, model_path: Path) -> bool:\n    \"\"\"A failure of the model: a known model-failure type, or raised in its file.\"\"\"\n    if isinstance(exc, (OSError, MemoryError)):\n        return False\n    if isinstance(exc, _model_failure_types()):\n        return True\n    model_path = str(Path(model_path).resolve())\n    frames = traceback.extract_tb(exc.__traceback__)\n    return bool(frames) and any(str(Path(f.filename).resolve()) == model_path for f in frames)\n\n\ndef _write(fitted: RSAFit, nc_path: Path, meta_path: Path) -> None:\n    nc_path.parent.mkdir(parents=True, exist_ok=True)\n    tmp = nc_path.with_suffix(f\".tmp{os.getpid()}.nc\")\n    fitted.idata.to_netcdf(str(tmp))\n    os.replace(tmp, nc_path)\n    meta = dict(\n        model_name=fitted.model_name,\n        param_names=fitted.param_names,\n        convergence_problems=fitted.convergence_problems,\n    )\n    tmp_meta = meta_path.with_suffix(f\".tmp{os.getpid()}.json\")\n    tmp_meta.write_text(json.dumps(meta))\n    os.replace(tmp_meta, meta_path)\n\n\ndef _read(nc_path: Path, meta_path: Path) -> RSAFit:\n    import arviz as az\n\n    meta = json.loads(meta_path.read_text())\n    idata = az.from_netcdf(str(nc_path))\n    idata.load()\n    return RSAFit(\n        model_name=meta[\"model_name\"],","lineStart":1,"lineEnd":100,"totalLines":192,"truncated":true}},"title":"src/rsa/loop/fitting.py","time":{"start":1791340042188,"end":1791340042207}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142fd7c3001ac3S7Ijw0VZL2W","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_1142fce030010F02t0I4Kzg0X3"}}
