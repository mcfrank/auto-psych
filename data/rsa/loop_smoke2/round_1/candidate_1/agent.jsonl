{"type":"tool_use","timestamp":1791339958684,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"read","callID":"ZGgkoASTlswPn3MM","state":{"status":"completed","input":{"limit":100,"filePath":"/home/user/auto-psych/src/rsa/loop/novelty.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/novelty.py</path>\n<type>file</type>\n<content>\n1: \"\"\"The novelty gate's context pool and prediction distance for memo models.\n2: \n3: A candidate is novel when its posterior-mean choice probabilities differ from\n4: every admitted model's by at least a threshold (RMSE over the pool). The pool\n5: is generated by the loop, deliberately not the training displays (the PyMC\n6: domain learned that models distinct in mechanism can agree on the training\n7: stimuli): every game up to 4 objects x 4 features with each word and a prior\n8: query, plus copies of the 3-object games under each manipulation the data\n9: contain (valence, a familiarization base rate favouring one object, one\n10: object in grayscale), so a model that reads a manipulation can differ there.\n11: \n12: Probabilities are compared per choice class (identical objects summed), the\n13: unit the likelihood observes.\n14: \"\"\"\n15: \n16: from __future__ import annotations\n17: \n18: import hashlib\n19: import json\n20: from typing import Dict, List, Mapping, Sequence\n21: \n22: import numpy as np\n23: \n24: from src.rsa.context import Context, group_by_shape\n25: from src.rsa.design_space import context_pool, games\n26: from src.rsa.fit import RSAFit, class_probs\n27: from src.rsa.model_file import RSAModel\n28: \n29: DEFAULT_NOVELTY_RMSE_THRESHOLD = 0.002\n30: POOL_SIZES = ((2, 2), (3, 2), (3, 3), (3, 4), (4, 2), (4, 3), (4, 4))\n31: MAX_DRAWS = 100\n32: \n33: \n34: def novelty_pool() -> List[Context]:\n35:     pool = context_pool(POOL_SIZES, include_prior_queries=True)\n36:     for n_feat in (2, 3):\n37:         names = tuple(f\"f{i}\" for i in range(n_feat))\n38:         for matrix in games(3, n_feat):\n39:             for word in [None, *range(n_feat)]:\n40:                 for valence in (-1, 1):\n41:                     pool.append(Context(objects=matrix, feature_names=names, utterance=word, valence=valence))\n42:                 for favoured in range(3):\n43:                     fam = tuple(7 / 9 if i == favoured else 1 / 9 for i in range(3))\n44:                     pool.append(Context(objects=matrix, feature_names=names, utterance=word, familiarization=fam))\n45:                 for gray in range(3):\n46:                     mask = tuple(int(i != gray) for i in range(3))  # one object in colour\n47:                     pool.append(Context(objects=matrix, feature_names=names, utterance=word, grayscale=mask))\n48:     return pool\n49: \n50: \n51: def pool_digest(pool: Sequence[Context]) -> str:\n52:     blob = json.dumps([pool_record(c) for c in pool], sort_keys=True).encode()\n53:     return hashlib.sha256(blob).hexdigest()[:16]\n54: \n55: \n56: def pool_record(ctx: Context) -> dict:\n57:     return dict(\n58:         objects=ctx.objects, utterance=ctx.utterance, valence=ctx.valence,\n59:         familiarization=ctx.familiarization, grayscale=ctx.grayscale,\n60:     )\n61: \n62: \n63: def posterior_mean_class_probs(\n64:     model: RSAModel, fitted: RSAFit, pool: Sequence[Context], max_draws: int = MAX_DRAWS\n65: ) -> np.ndarray:\n66:     \"\"\"Posterior-mean choice-class probabilities over the pool, flattened.\n67: \n68:     Raises ValueError when the model's probabilities are not finite on some\n69:     pool context (a model failure: the caller rejects with the reason).\n70:     \"\"\"\n71:     post = fitted.idata.posterior\n72:     flat = {k: np.asarray(post[k]).reshape(-1) for k in fitted.param_names}\n73:     n = len(next(iter(flat.values())))\n74:     take = np.linspace(0, n - 1, min(max_draws, n)).astype(int)\n75:     out: Dict[int, np.ndarray] = {}\n76:     for group in group_by_shape(pool).values():\n77:         acc = 0.0\n78:         for i in take:\n79:             p = model.group_probs({k: v[i] for k, v in flat.items()}, group)\n80:             acc = acc + np.asarray(class_probs(p, group.classes))\n81:         mean = acc / len(take)\n82:         if not np.all(np.isfinite(mean)):\n83:             bad = [pool[group.indices[r]] for r in np.where(~np.isfinite(mean).all(axis=1))[0][:3]]\n84:             raise ValueError(\n85:                 f\"{model.name}'s choice probabilities are not finite on pool contexts such as \"\n86:                 + \"; \".join(json.dumps(pool_record(c)) for c in bad)\n87:             )\n88:         for row, idx in enumerate(group.indices):\n89:             out[int(idx)] = mean[row]\n90:     return np.concatenate([out[i] for i in range(len(pool))])\n91: \n92: \n93: def closest(candidate: np.ndarray, admitted: Mapping[str, np.ndarray]) -> tuple[str, float]:\n94:     \"\"\"The admitted model whose pool predictions are nearest (RMSE), and the distance.\"\"\"\n95:     if not admitted:\n96:         return \"\", float(\"inf\")\n97:     dists = {name: float(np.sqrt(np.mean((candidate - v) ** 2))) for name, v in admitted.items()}\n98:     name = min(dists, key=dists.get)\n99:     return name, dists[name]\n\n(End of file - total 99 lines)\n</content>","metadata":{"preview":"\"\"\"The novelty gate's context pool and prediction distance for memo models.\n\nA candidate is novel when its posterior-mean choice probabilities differ from\nevery admitted model's by at least a threshold (RMSE over the pool). The pool\nis generated by the loop, deliberately not the training displays (the PyMC\ndomain learned that models distinct in mechanism can agree on the training\nstimuli): every game up to 4 objects x 4 features with each word and a prior\nquery, plus copies of the 3-object games under each manipulation the data\ncontain (valence, a familiarization base rate favouring one object, one\nobject in grayscale), so a model that reads a manipulation can differ there.\n\nProbabilities are compared per choice class (identical objects summed), the\nunit the likelihood observes.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom typing import Dict, List, Mapping, Sequence","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/novelty.py","text":"\"\"\"The novelty gate's context pool and prediction distance for memo models.\n\nA candidate is novel when its posterior-mean choice probabilities differ from\nevery admitted model's by at least a threshold (RMSE over the pool). The pool\nis generated by the loop, deliberately not the training displays (the PyMC\ndomain learned that models distinct in mechanism can agree on the training\nstimuli): every game up to 4 objects x 4 features with each word and a prior\nquery, plus copies of the 3-object games under each manipulation the data\ncontain (valence, a familiarization base rate favouring one object, one\nobject in grayscale), so a model that reads a manipulation can differ there.\n\nProbabilities are compared per choice class (identical objects summed), the\nunit the likelihood observes.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom typing import Dict, List, Mapping, Sequence\n\nimport numpy as np\n\nfrom src.rsa.context import Context, group_by_shape\nfrom src.rsa.design_space import context_pool, games\nfrom src.rsa.fit import RSAFit, class_probs\nfrom src.rsa.model_file import RSAModel\n\nDEFAULT_NOVELTY_RMSE_THRESHOLD = 0.002\nPOOL_SIZES = ((2, 2), (3, 2), (3, 3), (3, 4), (4, 2), (4, 3), (4, 4))\nMAX_DRAWS = 100\n\n\ndef novelty_pool() -> List[Context]:\n    pool = context_pool(POOL_SIZES, include_prior_queries=True)\n    for n_feat in (2, 3):\n        names = tuple(f\"f{i}\" for i in range(n_feat))\n        for matrix in games(3, n_feat):\n            for word in [None, *range(n_feat)]:\n                for valence in (-1, 1):\n                    pool.append(Context(objects=matrix, feature_names=names, utterance=word, valence=valence))\n                for favoured in range(3):\n                    fam = tuple(7 / 9 if i == favoured else 1 / 9 for i in range(3))\n                    pool.append(Context(objects=matrix, feature_names=names, utterance=word, familiarization=fam))\n                for gray in range(3):\n                    mask = tuple(int(i != gray) for i in range(3))  # one object in colour\n                    pool.append(Context(objects=matrix, feature_names=names, utterance=word, grayscale=mask))\n    return pool\n\n\ndef pool_digest(pool: Sequence[Context]) -> str:\n    blob = json.dumps([pool_record(c) for c in pool], sort_keys=True).encode()\n    return hashlib.sha256(blob).hexdigest()[:16]\n\n\ndef pool_record(ctx: Context) -> dict:\n    return dict(\n        objects=ctx.objects, utterance=ctx.utterance, valence=ctx.valence,\n        familiarization=ctx.familiarization, grayscale=ctx.grayscale,\n    )\n\n\ndef posterior_mean_class_probs(\n    model: RSAModel, fitted: RSAFit, pool: Sequence[Context], max_draws: int = MAX_DRAWS\n) -> np.ndarray:\n    \"\"\"Posterior-mean choice-class probabilities over the pool, flattened.\n\n    Raises ValueError when the model's probabilities are not finite on some\n    pool context (a model failure: the caller rejects with the reason).\n    \"\"\"\n    post = fitted.idata.posterior\n    flat = {k: np.asarray(post[k]).reshape(-1) for k in fitted.param_names}\n    n = len(next(iter(flat.values())))\n    take = np.linspace(0, n - 1, min(max_draws, n)).astype(int)\n    out: Dict[int, np.ndarray] = {}\n    for group in group_by_shape(pool).values():\n        acc = 0.0\n        for i in take:\n            p = model.group_probs({k: v[i] for k, v in flat.items()}, group)\n            acc = acc + np.asarray(class_probs(p, group.classes))\n        mean = acc / len(take)\n        if not np.all(np.isfinite(mean)):\n            bad = [pool[group.indices[r]] for r in np.where(~np.isfinite(mean).all(axis=1))[0][:3]]\n            raise ValueError(\n                f\"{model.name}'s choice probabilities are not finite on pool contexts such as \"\n                + \"; \".join(json.dumps(pool_record(c)) for c in bad)\n            )\n        for row, idx in enumerate(group.indices):\n            out[int(idx)] = mean[row]\n    return np.concatenate([out[i] for i in range(len(pool))])\n\n\ndef closest(candidate: np.ndarray, admitted: Mapping[str, np.ndarray]) -> tuple[str, float]:\n    \"\"\"The admitted model whose pool predictions are nearest (RMSE), and the distance.\"\"\"\n    if not admitted:\n        return \"\", float(\"inf\")\n    dists = {name: float(np.sqrt(np.mean((candidate - v) ** 2))) for name, v in admitted.items()}\n    name = min(dists, key=dists.get)\n    return name, dists[name]","lineStart":1,"lineEnd":99,"totalLines":99,"truncated":false}},"title":"src/rsa/loop/novelty.py","time":{"start":1791339958627,"end":1791339958650}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142e9158001Gfns7ZpRB6l9Z0","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_1142e74c0001tB01HmOXHdXj7D"}}
