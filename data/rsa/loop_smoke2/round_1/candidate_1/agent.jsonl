{"type":"tool_use","timestamp":1791340044818,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"read","callID":"2ivoNFr2zaAw7BZM","state":{"status":"completed","input":{"limit":100,"filePath":"/home/user/auto-psych/src/rsa/fit.py"},"output":"<path>/home/user/auto-psych/src/rsa/fit.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Fitting memo models with numpyro NUTS.\n2: \n3: The likelihood is the harness's, not the model's: each trial's choice is\n4: Categorical(choice_probs(params, ctx)). Trials are evaluated per shape group\n5: (`src.rsa.context.group_by_shape`), the groups' probabilities are padded with\n6: zeros to the widest context (a padded object is never chosen) and observed as\n7: one site, so the pointwise log-likelihood comes back in input trial order.\n8: \n9: A choice is observed as its *class* of identical objects\n10: (`src.rsa.context.Context.choice_classes`): no model can tell identical\n11: objects apart, and the pragmods data often cannot say which copy was chosen,\n12: so the class's summed probability is the likelihood.\n13: \n14: The result is an arviz ``InferenceData`` with a ``log_likelihood`` group, so\n15: the repo's PSIS-LOO reliability verdict (`src.models.loo_reliability`), the\n16: convergence gate (`src.models.pymc_inference.convergence_problems`) and\n17: ``az.compare`` apply unchanged.\n18: \"\"\"\n19: \n20: from __future__ import annotations\n21: \n22: from dataclasses import dataclass, field\n23: from typing import Any, Dict, List, Mapping, Sequence, Tuple\n24: \n25: import arviz as az\n26: import jax\n27: import jax.numpy as jnp\n28: import numpy as np\n29: import numpyro\n30: import numpyro.distributions as dist\n31: from numpyro.infer import MCMC, NUTS, log_likelihood\n32: \n33: from src.models.loo_reliability import LooDiagnostics, loo_diagnostics\n34: from src.models.pymc_inference import convergence_problems\n35: from src.rsa.context import Context, ShapeGroup, group_by_shape\n36: from src.rsa.model_file import RSAModel, check_contract\n37: \n38: OBSERVED_SITE = \"choice\"\n39: \n40: \n41: @dataclass(frozen=True)\n42: class FitSettings:\n43:     num_warmup: int = 1000\n44:     num_samples: int = 1000\n45:     num_chains: int = 4\n46:     target_accept: float = 0.9\n47:     seed: int = 0\n48: \n49: \n50: class ZeroProbabilityChoice(ValueError):\n51:     \"\"\"A model gives an observed choice probability zero at its prior draws.\"\"\"\n52: \n53: \n54: @dataclass\n55: class RSAFit:\n56:     model_name: str\n57:     idata: Any\n58:     param_names: List[str]\n59:     convergence_problems: List[str] = field(default_factory=list)\n60: \n61:     @property\n62:     def converged(self) -> bool:\n63:         return not self.convergence_problems\n64: \n65:     def loo(self) -> LooDiagnostics:\n66:         return loo_diagnostics(self.idata)\n67: \n68: \n69: def class_probs(probs, classes) -> jnp.ndarray:\n70:     \"\"\"Collapse (trials, N_OBJ) probabilities onto choice classes.\n71: \n72:     Each class's summed probability sits at its first object's index; the\n73:     other members of a class get zero.\n74:     \"\"\"\n75:     onehot = jax.nn.one_hot(jnp.asarray(classes), probs.shape[-1], dtype=probs.dtype)\n76:     return jnp.einsum(\"tr,trs->ts\", probs, onehot)\n77: \n78: \n79: def _padded_probs(\n80:     model: RSAModel, params: Mapping[str, Any], groups: Sequence[ShapeGroup], width: int\n81: ) -> jnp.ndarray:\n82:     blocks = []\n83:     for group in groups:\n84:         p = class_probs(model.group_probs(params, group), group.classes)\n85:         blocks.append(jnp.pad(p, ((0, 0), (0, width - p.shape[1]))))\n86:     return jnp.concatenate(blocks, axis=0)\n87: \n88: \n89: def _numpyro_model(model: RSAModel, groups: Sequence[ShapeGroup], width: int, choices=None):\n90:     params = {name: numpyro.sample(name, prior) for name, prior in model.params.items()}\n91:     probs = _padded_probs(model, params, groups, width)\n92:     numpyro.sample(OBSERVED_SITE, dist.Categorical(logits=_safe_logits(probs)), obs=choices)\n93: \n94: \n95: def _safe_logits(probs: jnp.ndarray) -> jnp.ndarray:\n96:     \"\"\"log(probs), -inf at zeros, with a finite gradient.\n97: \n98:     Zeros (padding, non-first members of a choice class) depend on the\n99:     parameters through the class sum; log(0)'s infinite derivative times a\n100:     zero cotangent would be NaN, so log is never evaluated at zero.\n\n(Showing lines 1-100 of 204. Use offset=101 to continue.)\n</content>","metadata":{"preview":"\"\"\"Fitting memo models with numpyro NUTS.\n\nThe likelihood is the harness's, not the model's: each trial's choice is\nCategorical(choice_probs(params, ctx)). Trials are evaluated per shape group\n(`src.rsa.context.group_by_shape`), the groups' probabilities are padded with\nzeros to the widest context (a padded object is never chosen) and observed as\none site, so the pointwise log-likelihood comes back in input trial order.\n\nA choice is observed as its *class* of identical objects\n(`src.rsa.context.Context.choice_classes`): no model can tell identical\nobjects apart, and the pragmods data often cannot say which copy was chosen,\nso the class's summed probability is the likelihood.\n\nThe result is an arviz ``InferenceData`` with a ``log_likelihood`` group, so\nthe repo's PSIS-LOO reliability verdict (`src.models.loo_reliability`), the\nconvergence gate (`src.models.pymc_inference.convergence_problems`) and\n``az.compare`` apply unchanged.\n\"\"\"\n\nfrom __future__ import annotations","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/fit.py","text":"\"\"\"Fitting memo models with numpyro NUTS.\n\nThe likelihood is the harness's, not the model's: each trial's choice is\nCategorical(choice_probs(params, ctx)). Trials are evaluated per shape group\n(`src.rsa.context.group_by_shape`), the groups' probabilities are padded with\nzeros to the widest context (a padded object is never chosen) and observed as\none site, so the pointwise log-likelihood comes back in input trial order.\n\nA choice is observed as its *class* of identical objects\n(`src.rsa.context.Context.choice_classes`): no model can tell identical\nobjects apart, and the pragmods data often cannot say which copy was chosen,\nso the class's summed probability is the likelihood.\n\nThe result is an arviz ``InferenceData`` with a ``log_likelihood`` group, so\nthe repo's PSIS-LOO reliability verdict (`src.models.loo_reliability`), the\nconvergence gate (`src.models.pymc_inference.convergence_problems`) and\n``az.compare`` apply unchanged.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import Any, Dict, List, Mapping, Sequence, Tuple\n\nimport arviz as az\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport numpyro\nimport numpyro.distributions as dist\nfrom numpyro.infer import MCMC, NUTS, log_likelihood\n\nfrom src.models.loo_reliability import LooDiagnostics, loo_diagnostics\nfrom src.models.pymc_inference import convergence_problems\nfrom src.rsa.context import Context, ShapeGroup, group_by_shape\nfrom src.rsa.model_file import RSAModel, check_contract\n\nOBSERVED_SITE = \"choice\"\n\n\n@dataclass(frozen=True)\nclass FitSettings:\n    num_warmup: int = 1000\n    num_samples: int = 1000\n    num_chains: int = 4\n    target_accept: float = 0.9\n    seed: int = 0\n\n\nclass ZeroProbabilityChoice(ValueError):\n    \"\"\"A model gives an observed choice probability zero at its prior draws.\"\"\"\n\n\n@dataclass\nclass RSAFit:\n    model_name: str\n    idata: Any\n    param_names: List[str]\n    convergence_problems: List[str] = field(default_factory=list)\n\n    @property\n    def converged(self) -> bool:\n        return not self.convergence_problems\n\n    def loo(self) -> LooDiagnostics:\n        return loo_diagnostics(self.idata)\n\n\ndef class_probs(probs, classes) -> jnp.ndarray:\n    \"\"\"Collapse (trials, N_OBJ) probabilities onto choice classes.\n\n    Each class's summed probability sits at its first object's index; the\n    other members of a class get zero.\n    \"\"\"\n    onehot = jax.nn.one_hot(jnp.asarray(classes), probs.shape[-1], dtype=probs.dtype)\n    return jnp.einsum(\"tr,trs->ts\", probs, onehot)\n\n\ndef _padded_probs(\n    model: RSAModel, params: Mapping[str, Any], groups: Sequence[ShapeGroup], width: int\n) -> jnp.ndarray:\n    blocks = []\n    for group in groups:\n        p = class_probs(model.group_probs(params, group), group.classes)\n        blocks.append(jnp.pad(p, ((0, 0), (0, width - p.shape[1]))))\n    return jnp.concatenate(blocks, axis=0)\n\n\ndef _numpyro_model(model: RSAModel, groups: Sequence[ShapeGroup], width: int, choices=None):\n    params = {name: numpyro.sample(name, prior) for name, prior in model.params.items()}\n    probs = _padded_probs(model, params, groups, width)\n    numpyro.sample(OBSERVED_SITE, dist.Categorical(logits=_safe_logits(probs)), obs=choices)\n\n\ndef _safe_logits(probs: jnp.ndarray) -> jnp.ndarray:\n    \"\"\"log(probs), -inf at zeros, with a finite gradient.\n\n    Zeros (padding, non-first members of a choice class) depend on the\n    parameters through the class sum; log(0)'s infinite derivative times a\n    zero cotangent would be NaN, so log is never evaluated at zero.","lineStart":1,"lineEnd":100,"totalLines":204,"truncated":true}},"title":"src/rsa/fit.py","time":{"start":1791340044777,"end":1791340044792}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142fe1de0017iiMVFjMxmye5t","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_1142fd7f90016x2ACSOT6Hmh7h"}}
