{"type":"tool_use","timestamp":1791340316125,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"write","callID":"IcqYHG15QY5LSXgU","state":{"status":"completed","input":{"content":"\"\"\"RSA pragmatic listener (depth 1) with valence-modulated referent prior.\n\nListeners interpret evaluative framing (favorite vs. least favorite) as\nsignaling the speaker's expectation over referent complexity: positive valence\nbiases prior probability toward feature-rich objects, whereas negative valence\nbiases prior probability toward simple, feature-poor objects. With neutral\nframing, the prior over referents is uniform. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_valence\": dist.Normal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(params[\"w_valence\"] * ctx.valence * ctx.feature_count)\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n","filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/round_1/candidate_1/candidate.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/auto-psych/data/rsa/loop_smoke2/round_1/candidate_1/candidate.py","exists":false,"truncated":false},"title":"data/rsa/loop_smoke2/round_1/candidate_1/candidate.py","time":{"start":1791340316075,"end":1791340316086}},"metadata":{"google":{"thoughtSignature":"EpoBCpcBAWkUfROq/2sgOl5QPEIDvRAcyh5DRyzekNaWMF0xfwUZTR3FWw48aLAZFMCOTdYaTxhCdiodaH49fZDG7nxBfJb+3/UyKYjGDHKEYRJveFFq+/8fbP6ePQRj5h4uj6aFNW8pBVvK6pCHIS4bhUVDpvv1B1UCt2mb1Qcp4NkPrRs+cyHIbUu0vbrmSSTpbh3SpI2i8uDacg=="}},"id":"prt_1143405a2001XBsZb8Cr8DsDiL","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_11433f32f001ZtvU6NFPtSPxMy"}}
