{"type":"tool_use","timestamp":1791340093866,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"read","callID":"MacQuEB649pKZ7sH","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/tests/test_rsa_loop_gates.py","limit":100},"output":"<path>/home/user/auto-psych/tests/test_rsa_loop_gates.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Admission of memo candidates to the RSA loop.\"\"\"\n2: \n3: import numpy as np\n4: import pandas as pd\n5: import pytest\n6: \n7: from src.rsa.dataset import DEFAULT_TRIALS_CSV, load_forced_choice\n8: from src.rsa.fit import FitSettings\n9: from src.rsa.loop.gates import GateConfig, admit\n10: from src.rsa.loop.novelty import novelty_pool\n11: from src.runtime.config import PROJECT_ASSETS_DIR\n12: \n13: pytestmark = pytest.mark.slow  # runs NUTS\n14: \n15: SEEDS = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"seed_models\"\n16: QUICK = FitSettings(num_warmup=300, num_samples=300, num_chains=2)\n17: \n18: \n19: @pytest.fixture(scope=\"module\")\n20: def setup(tmp_path_factory):\n21:     tmp = tmp_path_factory.mktemp(\"gates\")\n22:     df = pd.read_csv(DEFAULT_TRIALS_CSV)\n23:     responses = tmp / \"responses.csv\"\n24:     df[df.experiment.isin([\"E8_levels\", \"E9_twins\"])].to_csv(responses, index=False)\n25:     cfg = GateConfig(responses_path=responses, cache_dir=tmp / \"cache\", settings=QUICK,\n26:                      novelty_threshold=0.002, time_limit_sec=None)\n27:     training = load_forced_choice(responses).contexts\n28:     pool = novelty_pool()\n29:     return tmp, cfg, training, pool\n30: \n31: \n32: def candidate(tmp, name, source, hypothesis=\"A hypothesis.\"):\n33:     d = tmp / name\n34:     d.mkdir()\n35:     (d / \"candidate.py\").write_text(source)\n36:     (d / \"hypothesis.md\").write_text(hypothesis)\n37:     return d\n38: \n39: \n40: def test_a_seed_is_admitted_then_its_copy_is_not_novel(setup):\n41:     tmp, cfg, training, pool = setup\n42:     src = (SEEDS / \"rsa_l1.py\").read_text()\n43:     first = admit(candidate(tmp, \"a\", src), \"rsa_l1\", cfg=cfg, training=training, pool=pool, admitted_preds={})\n44:     assert first.admitted, first.reason\n45:     assert first.pool_preds.shape[0] > len(pool)\n46:     again = admit(candidate(tmp, \"b\", src.replace(\"Vanilla\", \"Plain\")), \"rsa_l1_copy\", cfg=cfg,\n47:                   training=training, pool=pool, admitted_preds={\"rsa_l1\": first.pool_preds})\n48:     assert not again.admitted\n49:     assert \"not novel\" in again.reason and \"rsa_l1\" in again.reason\n50: \n51: \n52: def test_a_different_mechanism_is_novel(setup):\n53:     tmp, cfg, training, pool = setup\n54:     l1 = admit(candidate(tmp, \"c\", (SEEDS / \"rsa_l1.py\").read_text()), \"rsa_l1\", cfg=cfg,\n55:                training=training, pool=pool, admitted_preds={})\n56:     lit = admit(candidate(tmp, \"d\", (SEEDS / \"literal_listener.py\").read_text()), \"literal\", cfg=cfg,\n57:                 training=training, pool=pool, admitted_preds={\"rsa_l1\": l1.pool_preds})\n58:     assert lit.admitted, lit.reason\n59: \n60: \n61: @pytest.mark.parametrize(\n62:     \"mutate, reason\",\n63:     [\n64:         (lambda s: \"import os\\n\" + s, \"code gate\"),\n65:         (lambda s: s.replace(\"{EPS}\", \"EPS\"), \"failed to load or run\"),\n66:         (lambda s: s.replace('return with_lapse(', 'return 2.0 * with_lapse('), \"sum to 1\"),\n67:         (lambda s: s.replace('with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])',\n68:                              'jnp.where(ctx.is_prior > 0, uniform, heard) + 0.0 * params[\"lapse\"]'),\n69:          \"probability 0\"),\n70:     ],\n71: )\n72: def test_broken_candidates_are_refused_with_a_reason(setup, mutate, reason):\n73:     tmp, cfg, training, pool = setup\n74:     src = mutate((SEEDS / \"rsa_l1.py\").read_text())\n75:     out = admit(candidate(tmp, f\"bad_{abs(hash(reason))}\", src), \"bad\", cfg=cfg,\n76:                 training=training, pool=pool, admitted_preds={})\n77:     assert not out.admitted\n78:     assert reason in out.reason\n79: \n80: \n81: def test_a_candidate_without_a_hypothesis_is_refused(setup):\n82:     tmp, cfg, training, pool = setup\n83:     d = candidate(tmp, \"nohyp\", (SEEDS / \"rsa_l1.py\").read_text(), hypothesis=\"  \")\n84:     out = admit(d, \"x\", cfg=cfg, training=training, pool=pool, admitted_preds={})\n85:     assert not out.admitted and \"hypothesis.md\" in out.reason\n\n(End of file - total 85 lines)\n</content>","metadata":{"preview":"\"\"\"Admission of memo candidates to the RSA loop.\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom src.rsa.dataset import DEFAULT_TRIALS_CSV, load_forced_choice\nfrom src.rsa.fit import FitSettings\nfrom src.rsa.loop.gates import GateConfig, admit\nfrom src.rsa.loop.novelty import novelty_pool\nfrom src.runtime.config import PROJECT_ASSETS_DIR\n\npytestmark = pytest.mark.slow  # runs NUTS\n\nSEEDS = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"seed_models\"\nQUICK = FitSettings(num_warmup=300, num_samples=300, num_chains=2)\n\n\n@pytest.fixture(scope=\"module\")\ndef setup(tmp_path_factory):","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/tests/test_rsa_loop_gates.py","text":"\"\"\"Admission of memo candidates to the RSA loop.\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom src.rsa.dataset import DEFAULT_TRIALS_CSV, load_forced_choice\nfrom src.rsa.fit import FitSettings\nfrom src.rsa.loop.gates import GateConfig, admit\nfrom src.rsa.loop.novelty import novelty_pool\nfrom src.runtime.config import PROJECT_ASSETS_DIR\n\npytestmark = pytest.mark.slow  # runs NUTS\n\nSEEDS = PROJECT_ASSETS_DIR / \"rsa_reference\" / \"seed_models\"\nQUICK = FitSettings(num_warmup=300, num_samples=300, num_chains=2)\n\n\n@pytest.fixture(scope=\"module\")\ndef setup(tmp_path_factory):\n    tmp = tmp_path_factory.mktemp(\"gates\")\n    df = pd.read_csv(DEFAULT_TRIALS_CSV)\n    responses = tmp / \"responses.csv\"\n    df[df.experiment.isin([\"E8_levels\", \"E9_twins\"])].to_csv(responses, index=False)\n    cfg = GateConfig(responses_path=responses, cache_dir=tmp / \"cache\", settings=QUICK,\n                     novelty_threshold=0.002, time_limit_sec=None)\n    training = load_forced_choice(responses).contexts\n    pool = novelty_pool()\n    return tmp, cfg, training, pool\n\n\ndef candidate(tmp, name, source, hypothesis=\"A hypothesis.\"):\n    d = tmp / name\n    d.mkdir()\n    (d / \"candidate.py\").write_text(source)\n    (d / \"hypothesis.md\").write_text(hypothesis)\n    return d\n\n\ndef test_a_seed_is_admitted_then_its_copy_is_not_novel(setup):\n    tmp, cfg, training, pool = setup\n    src = (SEEDS / \"rsa_l1.py\").read_text()\n    first = admit(candidate(tmp, \"a\", src), \"rsa_l1\", cfg=cfg, training=training, pool=pool, admitted_preds={})\n    assert first.admitted, first.reason\n    assert first.pool_preds.shape[0] > len(pool)\n    again = admit(candidate(tmp, \"b\", src.replace(\"Vanilla\", \"Plain\")), \"rsa_l1_copy\", cfg=cfg,\n                  training=training, pool=pool, admitted_preds={\"rsa_l1\": first.pool_preds})\n    assert not again.admitted\n    assert \"not novel\" in again.reason and \"rsa_l1\" in again.reason\n\n\ndef test_a_different_mechanism_is_novel(setup):\n    tmp, cfg, training, pool = setup\n    l1 = admit(candidate(tmp, \"c\", (SEEDS / \"rsa_l1.py\").read_text()), \"rsa_l1\", cfg=cfg,\n               training=training, pool=pool, admitted_preds={})\n    lit = admit(candidate(tmp, \"d\", (SEEDS / \"literal_listener.py\").read_text()), \"literal\", cfg=cfg,\n                training=training, pool=pool, admitted_preds={\"rsa_l1\": l1.pool_preds})\n    assert lit.admitted, lit.reason\n\n\n@pytest.mark.parametrize(\n    \"mutate, reason\",\n    [\n        (lambda s: \"import os\\n\" + s, \"code gate\"),\n        (lambda s: s.replace(\"{EPS}\", \"EPS\"), \"failed to load or run\"),\n        (lambda s: s.replace('return with_lapse(', 'return 2.0 * with_lapse('), \"sum to 1\"),\n        (lambda s: s.replace('with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])',\n                             'jnp.where(ctx.is_prior > 0, uniform, heard) + 0.0 * params[\"lapse\"]'),\n         \"probability 0\"),\n    ],\n)\ndef test_broken_candidates_are_refused_with_a_reason(setup, mutate, reason):\n    tmp, cfg, training, pool = setup\n    src = mutate((SEEDS / \"rsa_l1.py\").read_text())\n    out = admit(candidate(tmp, f\"bad_{abs(hash(reason))}\", src), \"bad\", cfg=cfg,\n                training=training, pool=pool, admitted_preds={})\n    assert not out.admitted\n    assert reason in out.reason\n\n\ndef test_a_candidate_without_a_hypothesis_is_refused(setup):\n    tmp, cfg, training, pool = setup\n    d = candidate(tmp, \"nohyp\", (SEEDS / \"rsa_l1.py\").read_text(), hypothesis=\"  \")\n    out = admit(d, \"x\", cfg=cfg, training=training, pool=pool, admitted_preds={})\n    assert not out.admitted and \"hypothesis.md\" in out.reason","lineStart":1,"lineEnd":85,"totalLines":85,"truncated":false}},"title":"tests/test_rsa_loop_gates.py","time":{"start":1791340093827,"end":1791340093839}},"metadata":{"google":{"thoughtSignature":"EtoBCtcBAWkUfRMyxIDW7b9KG/IDkcGx9E27yluJg4Go0ceNprIGqcwH20WxeaCVP0qtQ8DkXkmFsxhK9sBGusl1MvJzAlsgoDUZPnkcpSjex4OYlSJzNmre1f9r4g+iQ7RLLLBqQm1vAPVX1d6lPEKOnVRPbHF3e29qFNtx3onNViT5yHFhbGz/419jaVWb0ylsXan4Zy573An/0UsLKD4SvWbahbsQJmvL5fb0ESZRCXDFXPAAEhAxkdo/K8t6dGU5P7CnaDl/O8cKy40fnUDEo8ToqDgqAc6SSCE="}},"id":"prt_11430a17b001pX3blOfvIwKr1F","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_114309975001U7oXRn4KbSgTEd"}}
