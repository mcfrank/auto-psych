{"type":"tool_use","timestamp":1791339915701,"sessionID":"ses_eebd2826affeACkZSg43c3MZBb","part":{"type":"tool","tool":"read","callID":"B8sdpjzC7p24kqdu","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/literal_listener.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/literal_listener.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Literal listener (depth 0).\n2: \n3: The listener picks uniformly among the objects the heard word is literally\n4: true of; with no informative word, uniformly among all objects. A lapse\n5: parameter mixes in uniform guessing.\n6: \"\"\"\n7: \n8: import jax.numpy as jnp\n9: import numpyro.distributions as dist\n10: from memo import memo\n11: \n12: from src.rsa.memo_kit import at, with_lapse\n13: \n14: PARAMS = {\n15:     \"lapse\": dist.Beta(1.0, 9.0),\n16: }\n17: \n18: \n19: @memo\n20: def L0[u: UTT, r: OBJ](lex: ...):\n21:     listener: knows(u)\n22:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n23:     return Pr[listener.r == r]\n24: \n25: \n26: def choice_probs(params, ctx):\n27:     heard = L0(ctx.lex)[ctx.utterance]\n28:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n29:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 29 lines)\n</content>","metadata":{"preview":"\"\"\"Literal listener (depth 0).\n\nThe listener picks uniformly among the objects the heard word is literally\ntrue of; with no informative word, uniformly among all objects. A lapse\nparameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/literal_listener.py","text":"\"\"\"Literal listener (depth 0).\n\nThe listener picks uniformly among the objects the heard word is literally\ntrue of; with no informative word, uniformly among all objects. A lapse\nparameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L0(ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":29,"totalLines":29,"truncated":false}},"title":"data/rsa/loop_smoke2/models/literal_listener.py","time":{"start":1791339915435,"end":1791339915588}},"metadata":{"google":{"thoughtSignature":"EtkBCtYBAWkUfRMOQ/Lmn7QYAXil83fxfjTOwG9OJwHW46i/b430L9fNygnCEEzxmV8WsYt+iYY3mIRinbYSCJ8GWCKTpcNSdPfcLLn1GoBYP1mXN5o7tvuFz2ylMPDK8MsGWFDqHJ1+T22H/vPtGatlguB/tB7KH914H2oM2yNX4JFiDNZ8DOuPAXqjCLlwPzRULY8iQnMirVrsXg1/hB3Jq3eCLFKGjwm7ls0DRm7xM7r3uo/MbTs+r75fPEP3qn+8kG9feCZil+yZ0ZmnHs5Gmx+ZLDP9eHNLXA=="}},"id":"prt_1142de89a001bbnMAfPd711C6y","sessionID":"ses_eebd2826affeACkZSg43c3MZBb","messageID":"msg_1142dc89e001Xm55ApVnexRSyq"}}
