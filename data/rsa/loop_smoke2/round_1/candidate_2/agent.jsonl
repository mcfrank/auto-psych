{"type":"tool_use","timestamp":1791341661413,"sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","part":{"type":"tool","tool":"read","callID":"M93IHSTp88P6N9ZU","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/loop/fitting.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/fitting.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n2: \n3: A fit is content-addressed by (model file sha, responses file sha, sampler\n4: settings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n5: ``.json`` (parameter names, convergence problems). A cached fit is reused,\n6: never recomputed; files are written under a temporary name and\n7: ``os.replace``d into place.\n8: \n9: A fit can run in a spawned child process with a time limit (agent-written\n10: candidates: a pathological model must not stall the loop). Failures are\n11: classified as in the PyMC domain: a failure of the model itself (its own\n12: code raised, memo refused to compile it, it broke the contract, it gives an\n13: observed choice probability zero) is a `ModelFailure` the caller turns into a\n14: rejection; anything else (a killed worker, an unreadable file, OSError,\n15: MemoryError) is infrastructure and raises.\n16: \"\"\"\n17: \n18: from __future__ import annotations\n19: \n20: import hashlib\n21: import json\n22: import multiprocessing as mp\n23: import os\n24: import traceback\n25: from dataclasses import asdict, dataclass\n26: from pathlib import Path\n27: from typing import Any, List, Optional\n28: \n29: from src.rsa.fit import FitSettings, RSAFit, ZeroProbabilityChoice\n30: \n31: FIT_TIME_LIMIT_SEC = 30 * 60  # as the PyMC domain's CANDIDATE_FIT_TIME_LIMIT_SEC\n32: \n33: \n34: class ModelFailure(RuntimeError):\n35:     \"\"\"The model failed (a rejection), as opposed to the infrastructure.\"\"\"\n36: \n37: \n38: class FitTimeLimitExceeded(ModelFailure):\n39:     \"\"\"The fit did not finish within the time limit (the model is too slow).\"\"\"\n40: \n41: \n42: def _sha_file(path: Path) -> str:\n43:     return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n44: \n45: \n46: def fingerprint(model_path: Path, responses_path: Path, settings: FitSettings) -> str:\n47:     h = hashlib.sha256()\n48:     h.update(_sha_file(model_path).encode())\n49:     h.update(_sha_file(responses_path).encode())\n50:     h.update(json.dumps(asdict(settings), sort_keys=True).encode())\n51:     return h.hexdigest()[:20]\n52: \n53: \n54: def cache_paths(cache_dir: Path, name: str, fp: str) -> tuple[Path, Path]:\n55:     base = Path(cache_dir) / f\"{name}.{fp}\"\n56:     return base.with_suffix(\".nc\"), base.with_suffix(\".json\")\n57: \n58: \n59: def _model_failure_types() -> tuple:\n60:     from memo.core import MemoError\n61: \n62:     from src.rsa.model_file import ModelContractViolation\n63: \n64:     return (ModelContractViolation, ZeroProbabilityChoice, MemoError, SyntaxError)\n65: \n66: \n67: def is_model_failure(exc: BaseException, model_path: Path) -> bool:\n68:     \"\"\"A failure of the model: a known model-failure type, or raised in its file.\"\"\"\n69:     if isinstance(exc, (OSError, MemoryError)):\n70:         return False\n71:     if isinstance(exc, _model_failure_types()):\n72:         return True\n73:     model_path = str(Path(model_path).resolve())\n74:     frames = traceback.extract_tb(exc.__traceback__)\n75:     return bool(frames) and any(str(Path(f.filename).resolve()) == model_path for f in frames)\n76: \n77: \n78: def _write(fitted: RSAFit, nc_path: Path, meta_path: Path) -> None:\n79:     nc_path.parent.mkdir(parents=True, exist_ok=True)\n80:     tmp = nc_path.with_suffix(f\".tmp{os.getpid()}.nc\")\n81:     fitted.idata.to_netcdf(str(tmp))\n82:     os.replace(tmp, nc_path)\n83:     meta = dict(\n84:         model_name=fitted.model_name,\n85:         param_names=fitted.param_names,\n86:         convergence_problems=fitted.convergence_problems,\n87:     )\n88:     tmp_meta = meta_path.with_suffix(f\".tmp{os.getpid()}.json\")\n89:     tmp_meta.write_text(json.dumps(meta))\n90:     os.replace(tmp_meta, meta_path)\n91: \n92: \n93: def _read(nc_path: Path, meta_path: Path) -> RSAFit:\n94:     import arviz as az\n95: \n96:     meta = json.loads(meta_path.read_text())\n97:     idata = az.from_netcdf(str(nc_path))\n98:     idata.load()\n99:     return RSAFit(\n100:         model_name=meta[\"model_name\"],\n101:         idata=idata,\n102:         param_names=meta[\"param_names\"],\n103:         convergence_problems=meta[\"convergence_problems\"],\n104:     )\n105: \n106: \n107: def _fit_now(model_path: Path, name: str, responses_path: Path, settings: FitSettings) -> RSAFit:\n108:     from src.rsa.dataset import load_forced_choice\n109:     from src.rsa.fit import fit\n110:     from src.rsa.model_file import RSAModel\n111: \n112:     trials = load_forced_choice(responses_path)\n113:     return fit(RSAModel(model_path, name=name), trials.contexts, trials.choices, settings)\n114: \n115: \n116: def _child(model_path, name, responses_path, settings, nc_path, meta_path, queue) -> None:\n117:     try:\n118:         fitted = _fit_now(Path(model_path), name, Path(responses_path), settings)\n119:         _write(fitted, Path(nc_path), Path(meta_path))\n120:         queue.put((\"ok\", None, None))\n121:     except BaseException as exc:  # reported to the parent, which classifies it\n122:         queue.put(\n123:             (\n124:                 \"model\" if is_model_failure(exc, Path(model_path)) else \"infrastructure\",\n125:                 f\"{type(exc).__name__}: {exc}\",\n126:                 \"\".join(traceback.format_exception(exc))[-4000:],\n127:             )\n128:         )\n129: \n130: \n131: def fit_cached(\n132:     model_path: Path,\n133:     name: str,\n134:     responses_path: Path,\n135:     settings: FitSettings,\n136:     cache_dir: Path,\n137:     *,\n138:     time_limit_sec: Optional[float] = None,\n139: ) -> RSAFit:\n140:     \"\"\"The model's fit to the responses, from the cache or fitted now.\n141: \n142:     With ``time_limit_sec`` the fit runs in a spawned child process that is\n143:     killed at the limit (`FitTimeLimitExceeded`). Raises `ModelFailure` for a\n144:     failure of the model, and RuntimeError for any other failure.\n145:     \"\"\"\n146:     fp = fingerprint(model_path, responses_path, settings)\n147:     nc_path, meta_path = cache_paths(cache_dir, name, fp)\n148:     if nc_path.exists() and meta_path.exists():\n149:         return _read(nc_path, meta_path)\n150:     if time_limit_sec is None:\n151:         try:\n152:             fitted = _fit_now(model_path, name, responses_path, settings)\n153:         except Exception as exc:\n154:             if is_model_failure(exc, model_path):\n155:                 raise ModelFailure(f\"{type(exc).__name__}: {exc}\") from exc\n156:             raise\n157:         _write(fitted, nc_path, meta_path)\n158:         return fitted\n159: \n160:     ctx = mp.get_context(\"spawn\")\n161:     queue = ctx.Queue()\n162:     proc = ctx.Process(\n163:         target=_child,\n164:         args=(str(model_path), name, str(responses_path), settings, str(nc_path), str(meta_path), queue),\n165:     )\n166:     proc.start()\n167:     proc.join(time_limit_sec)\n168:     if proc.is_alive():\n169:         proc.kill()\n170:         proc.join()\n171:         raise FitTimeLimitExceeded(\n172:             f\"{name}: the fit did not finish within {time_limit_sec / 60:.0f} minutes\"\n173:         )\n174:     if queue.empty():\n175:         raise RuntimeError(\n176:             f\"{name}: the fit process exited with code {proc.exitcode} without reporting \"\n177:             f\"(killed? out of memory?) — an infrastructure failure, not the model's\"\n178:         )\n179:     kind, message, tb = queue.get()\n180:     if kind == \"ok\":\n181:         return _read(nc_path, meta_path)\n182:     if kind == \"model\":\n183:         raise ModelFailure(message)\n184:     raise RuntimeError(f\"{name}: infrastructure failure while fitting: {message}\\n{tb}\")\n185: \n186: \n187: def cached_fits(cache_dir: Path) -> List[Path]:\n188:     return sorted(Path(cache_dir).glob(\"*.nc\"))\n189: \n190: \n191: def describe(fitted: RSAFit) -> dict[str, Any]:\n192:     return dict(name=fitted.model_name, converged=fitted.converged, problems=fitted.convergence_problems)\n\n(End of file - total 192 lines)\n</content>","metadata":{"preview":"\"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n\nA fit is content-addressed by (model file sha, responses file sha, sampler\nsettings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n``.json`` (parameter names, convergence problems). A cached fit is reused,\nnever recomputed; files are written under a temporary name and\n``os.replace``d into place.\n\nA fit can run in a spawned child process with a time limit (agent-written\ncandidates: a pathological model must not stall the loop). Failures are\nclassified as in the PyMC domain: a failure of the model itself (its own\ncode raised, memo refused to compile it, it broke the contract, it gives an\nobserved choice probability zero) is a `ModelFailure` the caller turns into a\nrejection; anything else (a killed worker, an unreadable file, OSError,\nMemoryError) is infrastructure and raises.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/fitting.py","text":"\"\"\"Cached, time-limited fits of memo model files for the RSA loop.\n\nA fit is content-addressed by (model file sha, responses file sha, sampler\nsettings) and stored as ``<cache>/<name>.<fingerprint>.nc`` with a sidecar\n``.json`` (parameter names, convergence problems). A cached fit is reused,\nnever recomputed; files are written under a temporary name and\n``os.replace``d into place.\n\nA fit can run in a spawned child process with a time limit (agent-written\ncandidates: a pathological model must not stall the loop). Failures are\nclassified as in the PyMC domain: a failure of the model itself (its own\ncode raised, memo refused to compile it, it broke the contract, it gives an\nobserved choice probability zero) is a `ModelFailure` the caller turns into a\nrejection; anything else (a killed worker, an unreadable file, OSError,\nMemoryError) is infrastructure and raises.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport multiprocessing as mp\nimport os\nimport traceback\nfrom dataclasses import asdict, dataclass\nfrom pathlib import Path\nfrom typing import Any, List, Optional\n\nfrom src.rsa.fit import FitSettings, RSAFit, ZeroProbabilityChoice\n\nFIT_TIME_LIMIT_SEC = 30 * 60  # as the PyMC domain's CANDIDATE_FIT_TIME_LIMIT_SEC\n\n\nclass ModelFailure(RuntimeError):\n    \"\"\"The model failed (a rejection), as opposed to the infrastructure.\"\"\"\n\n\nclass FitTimeLimitExceeded(ModelFailure):\n    \"\"\"The fit did not finish within the time limit (the model is too slow).\"\"\"\n\n\ndef _sha_file(path: Path) -> str:\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef fingerprint(model_path: Path, responses_path: Path, settings: FitSettings) -> str:\n    h = hashlib.sha256()\n    h.update(_sha_file(model_path).encode())\n    h.update(_sha_file(responses_path).encode())\n    h.update(json.dumps(asdict(settings), sort_keys=True).encode())\n    return h.hexdigest()[:20]\n\n\ndef cache_paths(cache_dir: Path, name: str, fp: str) -> tuple[Path, Path]:\n    base = Path(cache_dir) / f\"{name}.{fp}\"\n    return base.with_suffix(\".nc\"), base.with_suffix(\".json\")\n\n\ndef _model_failure_types() -> tuple:\n    from memo.core import MemoError\n\n    from src.rsa.model_file import ModelContractViolation\n\n    return (ModelContractViolation, ZeroProbabilityChoice, MemoError, SyntaxError)\n\n\ndef is_model_failure(exc: BaseException, model_path: Path) -> bool:\n    \"\"\"A failure of the model: a known model-failure type, or raised in its file.\"\"\"\n    if isinstance(exc, (OSError, MemoryError)):\n        return False\n    if isinstance(exc, _model_failure_types()):\n        return True\n    model_path = str(Path(model_path).resolve())\n    frames = traceback.extract_tb(exc.__traceback__)\n    return bool(frames) and any(str(Path(f.filename).resolve()) == model_path for f in frames)\n\n\ndef _write(fitted: RSAFit, nc_path: Path, meta_path: Path) -> None:\n    nc_path.parent.mkdir(parents=True, exist_ok=True)\n    tmp = nc_path.with_suffix(f\".tmp{os.getpid()}.nc\")\n    fitted.idata.to_netcdf(str(tmp))\n    os.replace(tmp, nc_path)\n    meta = dict(\n        model_name=fitted.model_name,\n        param_names=fitted.param_names,\n        convergence_problems=fitted.convergence_problems,\n    )\n    tmp_meta = meta_path.with_suffix(f\".tmp{os.getpid()}.json\")\n    tmp_meta.write_text(json.dumps(meta))\n    os.replace(tmp_meta, meta_path)\n\n\ndef _read(nc_path: Path, meta_path: Path) -> RSAFit:\n    import arviz as az\n\n    meta = json.loads(meta_path.read_text())\n    idata = az.from_netcdf(str(nc_path))\n    idata.load()\n    return RSAFit(\n        model_name=meta[\"model_name\"],\n        idata=idata,\n        param_names=meta[\"param_names\"],\n        convergence_problems=meta[\"convergence_problems\"],\n    )\n\n\ndef _fit_now(model_path: Path, name: str, responses_path: Path, settings: FitSettings) -> RSAFit:\n    from src.rsa.dataset import load_forced_choice\n    from src.rsa.fit import fit\n    from src.rsa.model_file import RSAModel\n\n    trials = load_forced_choice(responses_path)\n    return fit(RSAModel(model_path, name=name), trials.contexts, trials.choices, settings)\n\n\ndef _child(model_path, name, responses_path, settings, nc_path, meta_path, queue) -> None:\n    try:\n        fitted = _fit_now(Path(model_path), name, Path(responses_path), settings)\n        _write(fitted, Path(nc_path), Path(meta_path))\n        queue.put((\"ok\", None, None))\n    except BaseException as exc:  # reported to the parent, which classifies it\n        queue.put(\n            (\n                \"model\" if is_model_failure(exc, Path(model_path)) else \"infrastructure\",\n                f\"{type(exc).__name__}: {exc}\",\n                \"\".join(traceback.format_exception(exc))[-4000:],\n            )\n        )\n\n\ndef fit_cached(\n    model_path: Path,\n    name: str,\n    responses_path: Path,\n    settings: FitSettings,\n    cache_dir: Path,\n    *,\n    time_limit_sec: Optional[float] = None,\n) -> RSAFit:\n    \"\"\"The model's fit to the responses, from the cache or fitted now.\n\n    With ``time_limit_sec`` the fit runs in a spawned child process that is\n    killed at the limit (`FitTimeLimitExceeded`). Raises `ModelFailure` for a\n    failure of the model, and RuntimeError for any other failure.\n    \"\"\"\n    fp = fingerprint(model_path, responses_path, settings)\n    nc_path, meta_path = cache_paths(cache_dir, name, fp)\n    if nc_path.exists() and meta_path.exists():\n        return _read(nc_path, meta_path)\n    if time_limit_sec is None:\n        try:\n            fitted = _fit_now(model_path, name, responses_path, settings)\n        except Exception as exc:\n            if is_model_failure(exc, model_path):\n                raise ModelFailure(f\"{type(exc).__name__}: {exc}\") from exc\n            raise\n        _write(fitted, nc_path, meta_path)\n        return fitted\n\n    ctx = mp.get_context(\"spawn\")\n    queue = ctx.Queue()\n    proc = ctx.Process(\n        target=_child,\n        args=(str(model_path), name, str(responses_path), settings, str(nc_path), str(meta_path), queue),\n    )\n    proc.start()\n    proc.join(time_limit_sec)\n    if proc.is_alive():\n        proc.kill()\n        proc.join()\n        raise FitTimeLimitExceeded(\n            f\"{name}: the fit did not finish within {time_limit_sec / 60:.0f} minutes\"\n        )\n    if queue.empty():\n        raise RuntimeError(\n            f\"{name}: the fit process exited with code {proc.exitcode} without reporting \"\n            f\"(killed? out of memory?) — an infrastructure failure, not the model's\"\n        )\n    kind, message, tb = queue.get()\n    if kind == \"ok\":\n        return _read(nc_path, meta_path)\n    if kind == \"model\":\n        raise ModelFailure(message)\n    raise RuntimeError(f\"{name}: infrastructure failure while fitting: {message}\\n{tb}\")\n\n\ndef cached_fits(cache_dir: Path) -> List[Path]:\n    return sorted(Path(cache_dir).glob(\"*.nc\"))\n\n\ndef describe(fitted: RSAFit) -> dict[str, Any]:\n    return dict(name=fitted.model_name, converged=fitted.converged, problems=fitted.convergence_problems)","lineStart":1,"lineEnd":192,"totalLines":192,"truncated":false}},"title":"src/rsa/loop/fitting.py","time":{"start":1791341661360,"end":1791341661381}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_114488ca30014CafCG1PZf7ElM","sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","messageID":"msg_1144875d1001sqgFt6YRuYV7e2"}}
