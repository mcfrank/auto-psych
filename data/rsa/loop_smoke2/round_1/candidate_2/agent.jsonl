{"type":"tool_use","timestamp":1791340126234,"sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","part":{"type":"tool","tool":"read","callID":"QQ1f3dK6ankeAkTD","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/pipelines/inner_loop/import_gate.py"},"output":"<path>/home/user/auto-psych/src/pipelines/inner_loop/import_gate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Static AST check: reject agent-written code that imports outside an allowlist.\n2: \n3: Every candidate model and critique test statistic must be self-contained. The\n4: allowlist covers the numeric/modelling stack the agents need (numpy, pymc,\n5: pytensor, arviz, scipy) plus selected stdlib modules. Anything else — especially\n6: the project's feature library — is rejected at admission before the code is ever\n7: executed, and the rejection is recorded in the hypothesis ledger.\n8: \"\"\"\n9: \n10: from __future__ import annotations\n11: \n12: import ast\n13: import string\n14: from pathlib import Path\n15: from typing import AbstractSet, List\n16: \n17: CANDIDATE_IMPORT_ALLOWLIST = frozenset(\n18:     {\n19:         \"numpy\",\n20:         \"pymc\",\n21:         \"pytensor\",\n22:         \"arviz\",\n23:         \"scipy\",\n24:         \"math\",\n25:         \"itertools\",\n26:         \"functools\",\n27:         \"collections\",\n28:         \"re\",\n29:         \"typing\",\n30:         \"dataclasses\",\n31:         \"statistics\",\n32:         \"operator\",\n33:     }\n34: )\n35: \n36: \n37: # Names and attributes agent code may not use. The code runs inside the harness\n38: # process, which can see the ground truth's files and its own command line; the\n39: # import allowlist alone let file reads (open, np.load), dynamic imports and\n40: # interpreter escapes through, and a model needs none of them.\n41: #\n42: # Allowed modules re-export forbidden ones as attributes (``typing.sys``,\n43: # ``dataclasses.builtins``, ``numpy.lib.npyio``), and pandas — injected into\n44: # critique statistics — reads files (``pd.read_csv``), so the attribute list\n45: # covers the module names, the file readers and writers of the allowed\n46: # libraries, and the introspection routes (frames, tracebacks, ``getattr``,\n47: # attribute paths inside ``str.format`` fields) that reach the rest. It is a\n48: # denylist over the known routes, not a proof: the harness also forgets its\n49: # command line once parsed (scripts/subjective_randomness/holdout_recovery.py).\n50: FORBIDDEN_NAMES = frozenset(\n51:     {\n52:         \"open\",\n53:         \"__import__\",\n54:         \"exec\",\n55:         \"eval\",\n56:         \"compile\",\n57:         \"globals\",\n58:         \"vars\",\n59:         \"locals\",\n60:         \"breakpoint\",\n61:         \"input\",\n62:         \"__builtins__\",\n63:         \"getattr\",\n64:         \"setattr\",\n65:         \"delattr\",\n66:         \"__loader__\",\n67:         \"__spec__\",\n68:     }\n69: )\n70: FORBIDDEN_ATTRIBUTES = frozenset(\n71:     {\n72:         # modules reachable as attributes of allowed ones\n73:         \"sys\",\n74:         \"os\",\n75:         \"builtins\",\n76:         \"io\",\n77:         \"subprocess\",\n78:         \"pathlib\",\n79:         \"shutil\",\n80:         \"importlib\",\n81:         \"ctypes\",\n82:         \"ctypeslib\",\n83:         \"socket\",\n84:         \"pickle\",\n85:         \"marshal\",\n86:         \"npyio\",\n87:         \"_datasource\",\n88:         \"modules\",\n89:         # file readers and writers\n90:         \"open\",\n91:         \"read\",\n92:         \"write\",\n93:         \"load\",\n94:         \"loadtxt\",\n95:         \"genfromtxt\",\n96:         \"fromfile\",\n97:         \"fromregex\",\n98:         \"memmap\",\n99:         \"open_memmap\",\n100:         \"DataSource\",\n101:         \"loadmat\",\n102:         \"savemat\",\n103:         \"from_netcdf\",\n104:         \"from_json\",\n105:         \"from_zarr\",\n106:         \"load_arviz_data\",\n107:         \"save\",\n108:         \"savez\",\n109:         \"savez_compressed\",\n110:         \"savetxt\",\n111:         \"tofile\",\n112:         \"to_netcdf\",\n113:         \"to_csv\",\n114:         \"to_pickle\",\n115:         \"to_parquet\",\n116:         \"to_hdf\",\n117:         \"to_sql\",\n118:         \"to_excel\",\n119:         \"to_feather\",\n120:         \"to_stata\",\n121:         # getattr by another name\n122:         \"attrgetter\",\n123:         \"methodcaller\",\n124:         # introspection escapes\n125:         \"__globals__\",\n126:         \"__builtins__\",\n127:         \"__subclasses__\",\n128:         \"__code__\",\n129:         \"__getattribute__\",\n130:         \"__dict__\",\n131:         \"__bases__\",\n132:         \"__base__\",\n133:         \"__mro__\",\n134:         \"__traceback__\",\n135:         \"__loader__\",\n136:         \"__spec__\",\n137:         \"__closure__\",\n138:         \"__self__\",\n139:         \"__func__\",\n140:         \"__reduce__\",\n141:         \"__reduce_ex__\",\n142:         \"tb_frame\",\n143:         \"tb_next\",\n144:         \"f_back\",\n145:         \"f_globals\",\n146:         \"f_locals\",\n147:         \"f_builtins\",\n148:         \"f_code\",\n149:         \"gi_frame\",\n150:         \"cr_frame\",\n151:         \"ag_frame\",\n152:     }\n153: )\n154: # Attribute prefixes: pandas' file readers (read_csv, read_json, read_pickle, ...).\n155: FORBIDDEN_ATTRIBUTE_PREFIXES = (\"read_\",)\n156: \n157: \n158: def _forbidden_attribute(attr: str) -> bool:\n159:     return attr in FORBIDDEN_ATTRIBUTES or attr.startswith(FORBIDDEN_ATTRIBUTE_PREFIXES)\n160: \n161: \n162: def _format_reaches_attributes(node: ast.Call) -> bool:\n163:     \"\"\"A ``str.format``/``format_map`` call that can look up attributes.\n164: \n165:     A replacement field such as ``\"{0.sys.argv}\"`` makes ``format`` perform\n166:     the attribute lookup at run time, where the AST check cannot see it. Only\n167:     a call on a string literal whose fields index nothing is allowed.\n168:     \"\"\"\n169:     func = node.func\n170:     if not (isinstance(func, ast.Attribute) and func.attr in (\"format\", \"format_map\")):\n171:         return False\n172:     if not (isinstance(func.value, ast.Constant) and isinstance(func.value.value, str)):\n173:         return True\n174:     try:\n175:         fields = [\n176:             field for _, field, _, _ in string.Formatter().parse(func.value.value)\n177:         ]\n178:     except ValueError:\n179:         return True\n180:     return any(field and (\".\" in field or \"[\" in field) for field in fields)\n181: \n182: \n183: def check_forbidden_imports(\n184:     source: str,\n185:     *,\n186:     allowlist: AbstractSet[str] = CANDIDATE_IMPORT_ALLOWLIST,\n187:     exact_modules: AbstractSet[str] = frozenset(),\n188: ) -> List[str]:\n189:     \"\"\"Return why ``source`` may not run: forbidden imports and forbidden uses.\n190: \n191:     Imports outside the allowlist are reported by module name; uses of\n192:     ``FORBIDDEN_NAMES`` (a bare ``open``, ``eval``, ``getattr``, ...) and of\n193:     ``FORBIDDEN_ATTRIBUTES`` (``np.load``, ``typing.sys``, ``pd.read_csv``,\n194:     ``__subclasses__``, ...) — as an attribute or as a name imported with\n195:     ``from … import`` — as \"use of X\"; a ``str.format`` that can look up\n196:     attributes as \"use of .format with an attribute field\". Walks the full AST\n197:     (including nested function bodies) so an import hidden inside\n198:     ``def compute_features`` is still caught. Relative imports\n199:     (``from . import ...``) are always forbidden — agent code has no package\n200:     context.\n201: \n202:     ``allowlist`` names the allowed top-level packages (default: the PyMC\n203:     stack's); ``exact_modules`` allows single modules by full dotted name\n204:     without opening their package (the RSA domain allows\n205:     ``src.rsa.memo_kit``, never ``src``).\n206:     \"\"\"\n207:     try:\n208:         tree = ast.parse(source)\n209:     except SyntaxError:\n210:         return [\"<unparseable source>\"]\n211:     forbidden: list[str] = []\n212:     for node in ast.walk(tree):\n213:         if isinstance(node, ast.Import):\n214:             for alias in node.names:\n215:                 parts = alias.name.split(\".\")\n216:                 if alias.name in exact_modules:\n217:                     continue\n218:                 if parts[0] not in allowlist:\n219:                     forbidden.append(alias.name)\n220:                 elif any(_forbidden_attribute(part) for part in parts[1:]):\n221:                     forbidden.append(alias.name)\n222:         elif isinstance(node, ast.ImportFrom):\n223:             if node.level:\n224:                 forbidden.append(f\"relative import (level {node.level})\")\n225:                 continue\n226:             if node.module and node.module not in exact_modules:\n227:                 parts = node.module.split(\".\")\n228:                 if parts[0] not in allowlist or any(\n229:                     _forbidden_attribute(part) for part in parts[1:]\n230:                 ):\n231:                     forbidden.append(node.module)\n232:                     continue\n233:             for alias in node.names:\n234:                 if alias.name in FORBIDDEN_NAMES or _forbidden_attribute(alias.name):\n235:                     forbidden.append(f\"use of {alias.name}\")\n236:         elif isinstance(node, ast.Name) and node.id in FORBIDDEN_NAMES:\n237:             forbidden.append(f\"use of {node.id}\")\n238:         elif isinstance(node, ast.Attribute) and _forbidden_attribute(node.attr):\n239:             forbidden.append(f\"use of .{node.attr}\")\n240:         elif isinstance(node, ast.Call) and _format_reaches_attributes(node):\n241:             forbidden.append(f\"use of .{node.func.attr} with an attribute field\")\n242:     return sorted(set(forbidden))\n\n(End of file - total 242 lines)\n</content>","metadata":{"preview":"\"\"\"Static AST check: reject agent-written code that imports outside an allowlist.\n\nEvery candidate model and critique test statistic must be self-contained. The\nallowlist covers the numeric/modelling stack the agents need (numpy, pymc,\npytensor, arviz, scipy) plus selected stdlib modules. Anything else — especially\nthe project's feature library — is rejected at admission before the code is ever\nexecuted, and the rejection is recorded in the hypothesis ledger.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport string\nfrom pathlib import Path\nfrom typing import AbstractSet, List\n\nCANDIDATE_IMPORT_ALLOWLIST = frozenset(\n    {\n        \"numpy\",\n        \"pymc\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/pipelines/inner_loop/import_gate.py","text":"\"\"\"Static AST check: reject agent-written code that imports outside an allowlist.\n\nEvery candidate model and critique test statistic must be self-contained. The\nallowlist covers the numeric/modelling stack the agents need (numpy, pymc,\npytensor, arviz, scipy) plus selected stdlib modules. Anything else — especially\nthe project's feature library — is rejected at admission before the code is ever\nexecuted, and the rejection is recorded in the hypothesis ledger.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport string\nfrom pathlib import Path\nfrom typing import AbstractSet, List\n\nCANDIDATE_IMPORT_ALLOWLIST = frozenset(\n    {\n        \"numpy\",\n        \"pymc\",\n        \"pytensor\",\n        \"arviz\",\n        \"scipy\",\n        \"math\",\n        \"itertools\",\n        \"functools\",\n        \"collections\",\n        \"re\",\n        \"typing\",\n        \"dataclasses\",\n        \"statistics\",\n        \"operator\",\n    }\n)\n\n\n# Names and attributes agent code may not use. The code runs inside the harness\n# process, which can see the ground truth's files and its own command line; the\n# import allowlist alone let file reads (open, np.load), dynamic imports and\n# interpreter escapes through, and a model needs none of them.\n#\n# Allowed modules re-export forbidden ones as attributes (``typing.sys``,\n# ``dataclasses.builtins``, ``numpy.lib.npyio``), and pandas — injected into\n# critique statistics — reads files (``pd.read_csv``), so the attribute list\n# covers the module names, the file readers and writers of the allowed\n# libraries, and the introspection routes (frames, tracebacks, ``getattr``,\n# attribute paths inside ``str.format`` fields) that reach the rest. It is a\n# denylist over the known routes, not a proof: the harness also forgets its\n# command line once parsed (scripts/subjective_randomness/holdout_recovery.py).\nFORBIDDEN_NAMES = frozenset(\n    {\n        \"open\",\n        \"__import__\",\n        \"exec\",\n        \"eval\",\n        \"compile\",\n        \"globals\",\n        \"vars\",\n        \"locals\",\n        \"breakpoint\",\n        \"input\",\n        \"__builtins__\",\n        \"getattr\",\n        \"setattr\",\n        \"delattr\",\n        \"__loader__\",\n        \"__spec__\",\n    }\n)\nFORBIDDEN_ATTRIBUTES = frozenset(\n    {\n        # modules reachable as attributes of allowed ones\n        \"sys\",\n        \"os\",\n        \"builtins\",\n        \"io\",\n        \"subprocess\",\n        \"pathlib\",\n        \"shutil\",\n        \"importlib\",\n        \"ctypes\",\n        \"ctypeslib\",\n        \"socket\",\n        \"pickle\",\n        \"marshal\",\n        \"npyio\",\n        \"_datasource\",\n        \"modules\",\n        # file readers and writers\n        \"open\",\n        \"read\",\n        \"write\",\n        \"load\",\n        \"loadtxt\",\n        \"genfromtxt\",\n        \"fromfile\",\n        \"fromregex\",\n        \"memmap\",\n        \"open_memmap\",\n        \"DataSource\",\n        \"loadmat\",\n        \"savemat\",\n        \"from_netcdf\",\n        \"from_json\",\n        \"from_zarr\",\n        \"load_arviz_data\",\n        \"save\",\n        \"savez\",\n        \"savez_compressed\",\n        \"savetxt\",\n        \"tofile\",\n        \"to_netcdf\",\n        \"to_csv\",\n        \"to_pickle\",\n        \"to_parquet\",\n        \"to_hdf\",\n        \"to_sql\",\n        \"to_excel\",\n        \"to_feather\",\n        \"to_stata\",\n        # getattr by another name\n        \"attrgetter\",\n        \"methodcaller\",\n        # introspection escapes\n        \"__globals__\",\n        \"__builtins__\",\n        \"__subclasses__\",\n        \"__code__\",\n        \"__getattribute__\",\n        \"__dict__\",\n        \"__bases__\",\n        \"__base__\",\n        \"__mro__\",\n        \"__traceback__\",\n        \"__loader__\",\n        \"__spec__\",\n        \"__closure__\",\n        \"__self__\",\n        \"__func__\",\n        \"__reduce__\",\n        \"__reduce_ex__\",\n        \"tb_frame\",\n        \"tb_next\",\n        \"f_back\",\n        \"f_globals\",\n        \"f_locals\",\n        \"f_builtins\",\n        \"f_code\",\n        \"gi_frame\",\n        \"cr_frame\",\n        \"ag_frame\",\n    }\n)\n# Attribute prefixes: pandas' file readers (read_csv, read_json, read_pickle, ...).\nFORBIDDEN_ATTRIBUTE_PREFIXES = (\"read_\",)\n\n\ndef _forbidden_attribute(attr: str) -> bool:\n    return attr in FORBIDDEN_ATTRIBUTES or attr.startswith(FORBIDDEN_ATTRIBUTE_PREFIXES)\n\n\ndef _format_reaches_attributes(node: ast.Call) -> bool:\n    \"\"\"A ``str.format``/``format_map`` call that can look up attributes.\n\n    A replacement field such as ``\"{0.sys.argv}\"`` makes ``format`` perform\n    the attribute lookup at run time, where the AST check cannot see it. Only\n    a call on a string literal whose fields index nothing is allowed.\n    \"\"\"\n    func = node.func\n    if not (isinstance(func, ast.Attribute) and func.attr in (\"format\", \"format_map\")):\n        return False\n    if not (isinstance(func.value, ast.Constant) and isinstance(func.value.value, str)):\n        return True\n    try:\n        fields = [\n            field for _, field, _, _ in string.Formatter().parse(func.value.value)\n        ]\n    except ValueError:\n        return True\n    return any(field and (\".\" in field or \"[\" in field) for field in fields)\n\n\ndef check_forbidden_imports(\n    source: str,\n    *,\n    allowlist: AbstractSet[str] = CANDIDATE_IMPORT_ALLOWLIST,\n    exact_modules: AbstractSet[str] = frozenset(),\n) -> List[str]:\n    \"\"\"Return why ``source`` may not run: forbidden imports and forbidden uses.\n\n    Imports outside the allowlist are reported by module name; uses of\n    ``FORBIDDEN_NAMES`` (a bare ``open``, ``eval``, ``getattr``, ...) and of\n    ``FORBIDDEN_ATTRIBUTES`` (``np.load``, ``typing.sys``, ``pd.read_csv``,\n    ``__subclasses__``, ...) — as an attribute or as a name imported with\n    ``from … import`` — as \"use of X\"; a ``str.format`` that can look up\n    attributes as \"use of .format with an attribute field\". Walks the full AST\n    (including nested function bodies) so an import hidden inside\n    ``def compute_features`` is still caught. Relative imports\n    (``from . import ...``) are always forbidden — agent code has no package\n    context.\n\n    ``allowlist`` names the allowed top-level packages (default: the PyMC\n    stack's); ``exact_modules`` allows single modules by full dotted name\n    without opening their package (the RSA domain allows\n    ``src.rsa.memo_kit``, never ``src``).\n    \"\"\"\n    try:\n        tree = ast.parse(source)\n    except SyntaxError:\n        return [\"<unparseable source>\"]\n    forbidden: list[str] = []\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Import):\n            for alias in node.names:\n                parts = alias.name.split(\".\")\n                if alias.name in exact_modules:\n                    continue\n                if parts[0] not in allowlist:\n                    forbidden.append(alias.name)\n                elif any(_forbidden_attribute(part) for part in parts[1:]):\n                    forbidden.append(alias.name)\n        elif isinstance(node, ast.ImportFrom):\n            if node.level:\n                forbidden.append(f\"relative import (level {node.level})\")\n                continue\n            if node.module and node.module not in exact_modules:\n                parts = node.module.split(\".\")\n                if parts[0] not in allowlist or any(\n                    _forbidden_attribute(part) for part in parts[1:]\n                ):\n                    forbidden.append(node.module)\n                    continue\n            for alias in node.names:\n                if alias.name in FORBIDDEN_NAMES or _forbidden_attribute(alias.name):\n                    forbidden.append(f\"use of {alias.name}\")\n        elif isinstance(node, ast.Name) and node.id in FORBIDDEN_NAMES:\n            forbidden.append(f\"use of {node.id}\")\n        elif isinstance(node, ast.Attribute) and _forbidden_attribute(node.attr):\n            forbidden.append(f\"use of .{node.attr}\")\n        elif isinstance(node, ast.Call) and _format_reaches_attributes(node):\n            forbidden.append(f\"use of .{node.func.attr} with an attribute field\")\n    return sorted(set(forbidden))","lineStart":1,"lineEnd":242,"totalLines":242,"truncated":false}},"title":"src/pipelines/inner_loop/import_gate.py","time":{"start":1791340126175,"end":1791340126197}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_114311fd5001M0lMcNhlndhzJl","sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","messageID":"msg_114311699001x1aLGp8RVgFu6e"}}
