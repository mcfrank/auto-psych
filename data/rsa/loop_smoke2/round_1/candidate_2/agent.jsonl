{"type":"tool_use","timestamp":1791339915717,"sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","part":{"type":"tool","tool":"read","callID":"E1xTNsUNqmP6VOwV","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/memo_kit.py"},"output":"<path>/home/user/auto-psych/src/rsa/memo_kit.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Helpers every memo model file may import.\n2: \n3: memo parses its own language: an array parameter (declared ``lex: ...``) can\n4: only be read through a function call, never subscripted (``lex[u, r]`` parses\n5: as a query about an agent). These JIT-compiled indexers are that call.\n6: \n7: ``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\n8: context shape being evaluated (`src.rsa.model_file`).\n9: \"\"\"\n10: \n11: from __future__ import annotations\n12: \n13: import jax\n14: import jax.numpy as jnp\n15: \n16: # Added inside log() so a zero probability gives a large finite penalty, not\n17: # -inf and a NaN gradient.\n18: EPS = 1e-10\n19: \n20: \n21: @jax.jit\n22: def at(matrix, i, j):\n23:     \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n24:     return matrix[i, j]\n25: \n26: \n27: @jax.jit\n28: def vec(vector, i):\n29:     \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n30:     return vector[i]\n31: \n32: \n33: def with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n34:     \"\"\"Mix a choice distribution with a uniform guess over the objects.\n35: \n36:     With probability ``lapse`` the participant picks an object at random.\n37:     Without some such noise a model that gives an object probability zero\n38:     (the literal semantics of RSA does, for any object the word is false of)\n39:     makes one participant's choice of it an impossible event.\n40:     \"\"\"\n41:     return (1.0 - lapse) * p + lapse / p.shape[-1]\n42: \n43: \n44: def softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n45:     \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n46:     return jax.nn.softmax(logits)\n\n(End of file - total 46 lines)\n</content>","metadata":{"preview":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/memo_kit.py","text":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n\n@jax.jit\ndef at(matrix, i, j):\n    \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n    return matrix[i, j]\n\n\n@jax.jit\ndef vec(vector, i):\n    \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n    return vector[i]\n\n\ndef with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n    \"\"\"Mix a choice distribution with a uniform guess over the objects.\n\n    With probability ``lapse`` the participant picks an object at random.\n    Without some such noise a model that gives an object probability zero\n    (the literal semantics of RSA does, for any object the word is false of)\n    makes one participant's choice of it an impossible event.\n    \"\"\"\n    return (1.0 - lapse) * p + lapse / p.shape[-1]\n\n\ndef softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n    \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n    return jax.nn.softmax(logits)","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"src/rsa/memo_kit.py","time":{"start":1791339915541,"end":1791339915669}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142de8e6001h2b8ks1XCKju9g","sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","messageID":"msg_1142dcafc001laMJBcgHpm4V0h"}}
