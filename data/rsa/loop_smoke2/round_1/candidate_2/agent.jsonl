{"type":"tool_use","timestamp":1791341347957,"sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","part":{"type":"tool","tool":"bash","callID":"feLvZutpXSDgfpNU","state":{"status":"completed","input":{"command":"/home/user/auto-psych/.venv/bin/python3 -c '\nimport time\nfrom pathlib import Path\nimport jax\nimport jax.numpy as jnp\nfrom src.rsa.model_file import RSAModel\nfrom src.rsa.dataset import load_forced_choice\nfrom src.rsa.context import group_by_shape\nfrom src.rsa.fit import prepare, _numpyro_model\nimport numpyro\n\ntraining = load_forced_choice(Path(\"data/rsa/loop_smoke2/responses.csv\"))\ncontexts = training.contexts\nchoices = training.choices\n\nfor name in [\"rsa_l2\", \"rsa_l1_shared_prior\"]:\n    model = RSAModel(Path(f\"data/rsa/loop_smoke2/models/{name}.py\"))\n    groups, grouped_choices, inverse, width = prepare(contexts, choices)\n    obs = jnp.asarray(grouped_choices)\n    \n    # Trace log_density\n    from numpyro.infer.util import log_density\n    init_params = {k: dist.sample(jax.random.PRNGKey(0), ()) for k, dist in model.params.items()}\n    \n    t0 = time.time()\n    ld, grad = jax.value_and_grad(lambda p: log_density(_numpyro_model, (model, groups, width, obs), {}, p)[0])(init_params)\n    t_compile = time.time() - t0\n    \n    t0 = time.time()\n    for _ in range(10):\n        ld, grad = jax.value_and_grad(lambda p: log_density(_numpyro_model, (model, groups, width, obs), {}, p)[0])(init_params)\n        jax.tree_util.tree_map(lambda x: x.block_until_ready(), grad)\n    t_run = (time.time() - t0) / 10\n    print(f\"{name}: compile {t_compile:.2f}s, run {t_run*1000:.2f}ms per eval\")\n'"},"output":"/home/user/auto-psych/src/rsa/dataset.py:95: DtypeWarning: Columns (7,18,19) have mixed types. Specify dtype option on import or set low_memory=False.\n  df = pd.read_csv(path)\nrsa_l2: compile 17.54s, run 157.85ms per eval\nrsa_l1_shared_prior: compile 14.30s, run 240.15ms per eval\n","metadata":{"output":"/home/user/auto-psych/src/rsa/datase