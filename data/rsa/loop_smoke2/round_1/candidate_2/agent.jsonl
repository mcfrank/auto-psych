{"type":"tool_use","timestamp":1791339907928,"sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","part":{"type":"tool","tool":"read","callID":"v8795HJ7HeaRoAd9","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n2: \n3: As the salience model, but the prior over objects is common knowledge: the\n4: literal listener the speaker simulates uses it too (the paper's \"mutual\n5: knowledge\" variant), so salience shapes which word a speaker would choose as\n6: well as the listener's inference. Salience is a softmax of w_features per\n7: feature an object has plus w_familiar times its familiarization base rate.\n8: With no informative word the choice is that prior. A lapse parameter mixes in\n9: uniform guessing.\n10: \"\"\"\n11: \n12: import jax.numpy as jnp\n13: import numpyro.distributions as dist\n14: from memo import memo\n15: \n16: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n17: \n18: PARAMS = {\n19:     \"alpha\": dist.LogNormal(0.0, 1.0),\n20:     \"w_features\": dist.Normal(0.0, 1.0),\n21:     \"w_familiar\": dist.Normal(0.0, 2.0),\n22:     \"lapse\": dist.Beta(1.0, 9.0),\n23: }\n24: \n25: \n26: @memo\n27: def L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n28:     listener: knows(u)\n29:     listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n30:     return Pr[listener.r == r]\n31: \n32: \n33: @memo\n34: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n35:     listener: thinks[\n36:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n37:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n38:     ]\n39:     listener: observes [speaker.u] is u\n40:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n41:     return Pr[listener.r == r]\n42: \n43: \n44: def choice_probs(params, ctx):\n45:     prior = softmax_prior(\n46:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n47:     )\n48:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n49:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 49 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py","text":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":49,"totalLines":49,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py","time":{"start":1791339907500,"end":1791339907775}},"metadata":{"google":{"thoughtSignature":"EtEBCs4BAWkUfROCEW0VrJ8tiZuK4b3lt8jOwEWcF4aEW7XU3UnZdOJYA8UsYQU5ALbChiID35TqOHXq+lkDPeQeUXCulQ+rpcpM44pOIqZkP7TYr5EgtaxY2h9+y7KRlFCD3mSCxlFSUw8+KhwaTHHuub8P1WL81BpZHwngIsVtzbRAxsrjBAoBZLe8CobMreOOexR8b0d77KIyXldWVvss7ru+U1YhTds5GOIfM+4AUsE4juBU7DQ/dPEQzgbVgTgPIgamPxQHjoJ9F6CG0++ji1k="}},"id":"prt_1142dc99e001Uh5JMrT3OqbxFX","sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","messageID":"msg_1142dbe38001z2CyEUZSZ3Qmnv"}}
