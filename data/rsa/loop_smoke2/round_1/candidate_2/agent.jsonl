{"type":"tool_use","timestamp":1791340154875,"sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","part":{"type":"tool","tool":"bash","callID":"gHXQjCINKbO9n8Tw","state":{"status":"completed","input":{"command":"cat << 'EOF' > data/rsa/loop_smoke2/round_1/candidate_2/candidate.py\n\"\"\"RSA pragmatic listener at depth 2 with a shared salience prior.\n\nRefines the depth-2 model (rsa_l2) by replacing the uniform object prior with a\nsalience prior that is common knowledge at every level of recursive reasoning\n(as in rsa_l1_shared_prior). The prior is a softmax over object feature count\n(w_features) and familiarization base rate (w_familiar). Literal listener L0,\npragmatic speaker S1, listener L1, speaker S2, and depth-2 listener L2 all share\nthis prior. On prior-elicitation trials (no informative word), participants\nchoose according to the salience prior directly. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r)\n            * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count\n        + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(\n        jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"]\n    )\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"cat << 'EOF' > data/rsa/loop_smoke2/round_1/candidate_2/candidate.py\n\"\"\"RSA pragmatic listener at depth 2 with a shared salience prior.\n\nRefines the depth-2 model (rsa_l2) by replacing the uniform object prior with a\nsalience prior that is common knowledge at every level of recursive reasoning\n(as in rsa_l1_shared_prior). The prior is a softmax over object feature count\n(w_features) and familiarization base rate (w_familiar). Literal listener L0,\npragmatic speaker S1, listener L1, speaker S2, and depth-2 listener L2 all share\nthis prior. On prior-elicitation trials (no informative word), participants\nchoose according to the salience prior directly. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(\n            u in UTT,\n            wpp=at(lex, u, r)\n            * exp(alpha * log(L1[u, r](alpha, lex, prior) + {EPS})),\n        ),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count\n        + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L2(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(\n        jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"]\n    )\nEOF","time":{"start":1791340154769,"end":1791340154812}},"metadata":{"google":{"thoughtSignature":"EpoBCpcBAWkUfRP0DzPAXCVOMoegCWLAPW1/614gwGASfHvt+APQCnhQ6PE95+Zleq6f6q3BjwK6Zg4tEtFQ4KZEqqjhWEJcK+vmF94SzJw+P91jW0nH4VvRGaxwSklPYE+j6GMw93KC90J6ifhWy+cBxJX9ZukLv88HoE8pNEb/vjzgakUkkPf/DqA5lCNT4HLKYIh5owlbeqwnOA=="}},"id":"prt_114318f81001CqoNyyKzJiB3NL","sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","messageID":"msg_1143172e7001b4UnL7dMyQoac8"}}
