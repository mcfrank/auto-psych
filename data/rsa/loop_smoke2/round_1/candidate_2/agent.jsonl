{"type":"tool_use","timestamp":1791339943637,"sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","part":{"type":"tool","tool":"read","callID":"SaaeeXWgk22skFGg","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/loop/check_candidate.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/check_candidate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Self-check for an agent's memo candidate: the admission gates with a short fit.\n2: \n3:     <the harness python> -m src.rsa.loop.check_candidate <candidate_dir> --responses <responses.csv>\n4: \n5: Runs the code gate, loading, the contract on the training displays and on\n6: the novelty pool's shapes, a short NUTS fit (zero-probability choices, finite\n7: ELPD) and the pool predictions. It does not run the novelty comparison\n8: (that needs the loop's model set) and reports non-convergence of the short\n9: fit as a warning, since the loop's fit is longer. Exit code 0 when nothing\n10: fails.\n11: \"\"\"\n12: \n13: from __future__ import annotations\n14: \n15: import sys\n16: import tempfile\n17: from dataclasses import dataclass\n18: from pathlib import Path\n19: \n20: import tyro\n21: \n22: from src.rsa.dataset import DEFAULT_TRIALS_CSV, load_forced_choice\n23: from src.rsa.fit import FitSettings\n24: from src.rsa.loop.gates import GateConfig, admit\n25: from src.rsa.loop.novelty import novelty_pool\n26: \n27: CHECK_SETTINGS = FitSettings(num_warmup=300, num_samples=300, num_chains=2)\n28: CHECK_TIME_LIMIT_SEC = 10 * 60\n29: \n30: \n31: @dataclass\n32: class Args:\n33:     candidate_dir: tyro.conf.Positional[Path]\n34:     \"\"\"The candidate directory (positional: the command the agents are given passes it bare).\"\"\"\n35:     responses: Path = DEFAULT_TRIALS_CSV\n36: \n37: \n38: def check(candidate_dir: Path, responses: Path) -> tuple[bool, str]:\n39:     with tempfile.TemporaryDirectory() as cache:\n40:         cfg = GateConfig(\n41:             responses_path=responses, cache_dir=Path(cache), settings=CHECK_SETTINGS,\n42:             novelty_threshold=0.0, time_limit_sec=CHECK_TIME_LIMIT_SEC,\n43:         )\n44:         out = admit(\n45:             candidate_dir, \"candidate\", cfg=cfg,\n46:             training=load_forced_choice(responses).contexts, pool=novelty_pool(), admitted_preds={},\n47:         )\n48:     if out.admitted:\n49:         return True, (\n50:             f\"PASS: the candidate meets every gate the self-check runs \"\n51:             f\"(short-fit ELPD-LOO {out.elpd_loo:.1f}). The loop also checks novelty \"\n52:             f\"against the models in the set.\"\n53:         )\n54:     if out.reason.startswith(\"the fit did not converge\"):\n55:         return True, (\n56:             \"WARNING (not a failure of the self-check): the short fit did not converge \"\n57:             f\"({out.reason}). The loop fits longer; if your model has parameters the \"\n58:             \"data cannot pin down, reparameterise.\"\n59:         )\n60:     return False, f\"FAIL: {out.reason}\"\n61: \n62: \n63: def main(args: Args) -> int:\n64:     ok, message = check(args.candidate_dir, args.responses)\n65:     print(message)\n66:     return 0 if ok else 1\n67: \n68: \n69: if __name__ == \"__main__\":\n70:     sys.exit(main(tyro.cli(Args)))\n\n(End of file - total 70 lines)\n</content>","metadata":{"preview":"\"\"\"Self-check for an agent's memo candidate: the admission gates with a short fit.\n\n    <the harness python> -m src.rsa.loop.check_candidate <candidate_dir> --responses <responses.csv>\n\nRuns the code gate, loading, the contract on the training displays and on\nthe novelty pool's shapes, a short NUTS fit (zero-probability choices, finite\nELPD) and the pool predictions. It does not run the novelty comparison\n(that needs the loop's model set) and reports non-convergence of the short\nfit as a warning, since the loop's fit is longer. Exit code 0 when nothing\nfails.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nimport tempfile\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nimport tyro","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/check_candidate.py","text":"\"\"\"Self-check for an agent's memo candidate: the admission gates with a short fit.\n\n    <the harness python> -m src.rsa.loop.check_candidate <candidate_dir> --responses <responses.csv>\n\nRuns the code gate, loading, the contract on the training displays and on\nthe novelty pool's shapes, a short NUTS fit (zero-probability choices, finite\nELPD) and the pool predictions. It does not run the novelty comparison\n(that needs the loop's model set) and reports non-convergence of the short\nfit as a warning, since the loop's fit is longer. Exit code 0 when nothing\nfails.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nimport tempfile\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nimport tyro\n\nfrom src.rsa.dataset import DEFAULT_TRIALS_CSV, load_forced_choice\nfrom src.rsa.fit import FitSettings\nfrom src.rsa.loop.gates import GateConfig, admit\nfrom src.rsa.loop.novelty import novelty_pool\n\nCHECK_SETTINGS = FitSettings(num_warmup=300, num_samples=300, num_chains=2)\nCHECK_TIME_LIMIT_SEC = 10 * 60\n\n\n@dataclass\nclass Args:\n    candidate_dir: tyro.conf.Positional[Path]\n    \"\"\"The candidate directory (positional: the command the agents are given passes it bare).\"\"\"\n    responses: Path = DEFAULT_TRIALS_CSV\n\n\ndef check(candidate_dir: Path, responses: Path) -> tuple[bool, str]:\n    with tempfile.TemporaryDirectory() as cache:\n        cfg = GateConfig(\n            responses_path=responses, cache_dir=Path(cache), settings=CHECK_SETTINGS,\n            novelty_threshold=0.0, time_limit_sec=CHECK_TIME_LIMIT_SEC,\n        )\n        out = admit(\n            candidate_dir, \"candidate\", cfg=cfg,\n            training=load_forced_choice(responses).contexts, pool=novelty_pool(), admitted_preds={},\n        )\n    if out.admitted:\n        return True, (\n            f\"PASS: the candidate meets every gate the self-check runs \"\n            f\"(short-fit ELPD-LOO {out.elpd_loo:.1f}). The loop also checks novelty \"\n            f\"against the models in the set.\"\n        )\n    if out.reason.startswith(\"the fit did not converge\"):\n        return True, (\n            \"WARNING (not a failure of the self-check): the short fit did not converge \"\n            f\"({out.reason}). The loop fits longer; if your model has parameters the \"\n            \"data cannot pin down, reparameterise.\"\n        )\n    return False, f\"FAIL: {out.reason}\"\n\n\ndef main(args: Args) -> int:\n    ok, message = check(args.candidate_dir, args.responses)\n    print(message)\n    return 0 if ok else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(tyro.cli(Args)))","lineStart":1,"lineEnd":70,"totalLines":70,"truncated":false}},"title":"src/rsa/loop/check_candidate.py","time":{"start":1791339943524,"end":1791339943605}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142e565b001AJILGE2zIhDdoM","sessionID":"ses_eebd28287ffe4uKSFxrZYOYb26","messageID":"msg_1142e4a5d0013CWBXKDdoZ5Jzr"}}
