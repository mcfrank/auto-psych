{"type":"step_start","timestamp":1791339922476,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"id":"prt_1142e040f001p0ztqnm2kIlhOx","messageID":"msg_1142df494001i9Bf4tFANNOJ1u","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","type":"step-start"}}
{"type":"tool_use","timestamp":1791339922525,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"V1O4JZOOHUVZL8FT","state":{"status":"completed","input":{"limit":100,"filePath":"/home/user/auto-psych/src/rsa/context.py"},"output":"<path>/home/user/auto-psych/src/rsa/context.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Reference-game contexts and their encoding for memo models.\n2: \n3: A context is what one trial shows a listener: a few objects (referents), each\n4: a set of features, and either the one feature word a speaker said (an\n5: *utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\n6: will he pick next?\").\n7: \n8: Models never see padding. memo enumerates over fixed domains, and padding a\n9: small context out to a common size makes some distribution a 0/0 — harmless in\n10: memo's forward pass (it returns zeros) but NaN in its gradient, which stops\n11: NUTS. So trials are grouped by shape (`group_by_shape`) and each group is\n12: evaluated by a copy of the model compiled with exact-size domains `OBJ` and\n13: `UTT` (`src.rsa.model_file`).\n14: \n15: The utterances of a context are the features true of at least one object, in\n16: feature order, plus — when some object has none of them — a final **sink**\n17: utterance true of exactly those objects (\"no word applies\"). Without it a\n18: speaker who means a featureless object (the plain face of the pragmods simple\n19: game) has no true word, again a 0/0. The sink is never observed, and it adds\n20: no probability to any object a real word is true of, so L0/S1/L1 values on\n21: real words are the textbook ones.\n22: \"\"\"\n23: \n24: from __future__ import annotations\n25: \n26: from dataclasses import dataclass\n27: from typing import Dict, List, NamedTuple, Optional, Sequence, Tuple\n28: \n29: import jax.numpy as jnp\n30: import numpy as np\n31: \n32: SINK = \"<sink>\"\n33: \n34: \n35: class ContextArrays(NamedTuple):\n36:     \"\"\"One trial (or, stacked, a group of same-shape trials) as JAX arrays.\n37: \n38:     Shapes are for one trial; a group adds a leading trial axis.\n39:     \"\"\"\n40: \n41:     lex: jnp.ndarray  # (N_UTT, N_OBJ) 1.0 where utterance u is true of object r\n42:     is_sink: jnp.ndarray  # (N_UTT,) 1.0 for the sink utterance\n43:     feature_count: jnp.ndarray  # (N_OBJ,) number of context words true of each object\n44:     utterance: jnp.ndarray  # () int32 utterance index heard (0 for a prior query)\n45:     is_prior: jnp.ndarray  # () 1.0 for a prior query (no informative word)\n46:     familiarization: jnp.ndarray  # (N_OBJ,) base rate seen in familiarization, 0..1\n47:     has_familiarization: jnp.ndarray  # () 1.0 when there was a familiarization phase\n48:     grayscale: jnp.ndarray  # (N_OBJ,) 1.0 for an object shown in grayscale\n49:     valence: jnp.ndarray  # () +1 \"favorite\" framing, -1 \"least favorite\", 0 neutral\n50: \n51: \n52: @dataclass(frozen=True)\n53: class Context:\n54:     \"\"\"One trial's display. ``utterance`` indexes ``feature_names`` (None: prior query).\"\"\"\n55: \n56:     objects: Tuple[Tuple[int, ...], ...]\n57:     feature_names: Tuple[str, ...]\n58:     utterance: Optional[int]\n59:     item: str = \"\"\n60:     familiarization: Optional[Tuple[float, ...]] = None\n61:     grayscale: Optional[Tuple[int, ...]] = None\n62:     valence: int = 0\n63:     # Feature indices the speaker can name (the message set). None: every\n64:     # feature is a word (pragmods). In the Franke & Degen game some features\n65:     # (e.g. square, blue) have no word, which changes which inferences hold.\n66:     messages: Optional[Tuple[int, ...]] = None\n67: \n68:     def __post_init__(self) -> None:\n69:         objects = tuple(tuple(int(v) for v in row) for row in self.objects)\n70:         object.__setattr__(self, \"objects\", objects)\n71:         object.__setattr__(self, \"feature_names\", tuple(self.feature_names))\n72:         if not objects:\n73:             raise ValueError(\"a context needs at least one object\")\n74:         n_features = len(self.feature_names)\n75:         if any(len(row) != n_features for row in objects):\n76:             raise ValueError(\n77:                 f\"objects must be rectangular with one entry per feature \"\n78:                 f\"({n_features}): {objects}\"\n79:             )\n80:         if any(v not in (0, 1) for row in objects for v in row):\n81:             raise ValueError(f\"object features must be 0/1: {objects}\")\n82:         if self.messages is not None:\n83:             messages = tuple(int(m) for m in self.messages)\n84:             object.__setattr__(self, \"messages\", messages)\n85:             if not messages or len(set(messages)) != len(messages):\n86:                 raise ValueError(f\"messages must be distinct feature indices: {messages}\")\n87:             if any(not 0 <= m < n_features for m in messages):\n88:                 raise ValueError(f\"messages {messages} are not all feature indices (0..{n_features - 1})\")\n89:         if self.utterance is not None:\n90:             if self.messages is not None and self.utterance not in self.messages:\n91:                 raise ValueError(\n92:                     f\"utterance {self.feature_names[self.utterance]!r} is not in the message set\"\n93:                 )\n94:             if not 0 <= self.utterance < n_features:\n95:                 raise ValueError(\n96:                     f\"utterance {self.utterance} is not a feature index (0..{n_features - 1})\"\n97:                 )\n98:             if not any(row[self.utterance] for row in objects):\n99:                 raise ValueError(\n100:                     f\"utterance {self.feature_names[self.utterance]!r} is true of no object\"\n\n(Showing lines 1-100 of 224. Use offset=101 to continue.)\n</content>","metadata":{"preview":"\"\"\"Reference-game contexts and their encoding for memo models.\n\nA context is what one trial shows a listener: a few objects (referents), each\na set of features, and either the one feature word a speaker said (an\n*utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\nwill he pick next?\").\n\nModels never see padding. memo enumerates over fixed domains, and padding a\nsmall context out to a common size makes some distribution a 0/0 — harmless in\nmemo's forward pass (it returns zeros) but NaN in its gradient, which stops\nNUTS. So trials are grouped by shape (`group_by_shape`) and each group is\nevaluated by a copy of the model compiled with exact-size domains `OBJ` and\n`UTT` (`src.rsa.model_file`).\n\nThe utterances of a context are the features true of at least one object, in\nfeature order, plus — when some object has none of them — a final **sink**\nutterance true of exactly those objects (\"no word applies\"). Without it a\nspeaker who means a featureless object (the plain face of the pragmods simple\ngame) has no true word, again a 0/0. The sink is never observed, and it adds\nno probability to any object a real word is true of, so L0/S1/L1 values on","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/context.py","text":"\"\"\"Reference-game contexts and their encoding for memo models.\n\nA context is what one trial shows a listener: a few objects (referents), each\na set of features, and either the one feature word a speaker said (an\n*utterance* query) or no informative word (a *prior* query: \"mumble\", \"which\nwill he pick next?\").\n\nModels never see padding. memo enumerates over fixed domains, and padding a\nsmall context out to a common size makes some distribution a 0/0 — harmless in\nmemo's forward pass (it returns zeros) but NaN in its gradient, which stops\nNUTS. So trials are grouped by shape (`group_by_shape`) and each group is\nevaluated by a copy of the model compiled with exact-size domains `OBJ` and\n`UTT` (`src.rsa.model_file`).\n\nThe utterances of a context are the features true of at least one object, in\nfeature order, plus — when some object has none of them — a final **sink**\nutterance true of exactly those objects (\"no word applies\"). Without it a\nspeaker who means a featureless object (the plain face of the pragmods simple\ngame) has no true word, again a 0/0. The sink is never observed, and it adds\nno probability to any object a real word is true of, so L0/S1/L1 values on\nreal words are the textbook ones.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Dict, List, NamedTuple, Optional, Sequence, Tuple\n\nimport jax.numpy as jnp\nimport numpy as np\n\nSINK = \"<sink>\"\n\n\nclass ContextArrays(NamedTuple):\n    \"\"\"One trial (or, stacked, a group of same-shape trials) as JAX arrays.\n\n    Shapes are for one trial; a group adds a leading trial axis.\n    \"\"\"\n\n    lex: jnp.ndarray  # (N_UTT, N_OBJ) 1.0 where utterance u is true of object r\n    is_sink: jnp.ndarray  # (N_UTT,) 1.0 for the sink utterance\n    feature_count: jnp.ndarray  # (N_OBJ,) number of context words true of each object\n    utterance: jnp.ndarray  # () int32 utterance index heard (0 for a prior query)\n    is_prior: jnp.ndarray  # () 1.0 for a prior query (no informative word)\n    familiarization: jnp.ndarray  # (N_OBJ,) base rate seen in familiarization, 0..1\n    has_familiarization: jnp.ndarray  # () 1.0 when there was a familiarization phase\n    grayscale: jnp.ndarray  # (N_OBJ,) 1.0 for an object shown in grayscale\n    valence: jnp.ndarray  # () +1 \"favorite\" framing, -1 \"least favorite\", 0 neutral\n\n\n@dataclass(frozen=True)\nclass Context:\n    \"\"\"One trial's display. ``utterance`` indexes ``feature_names`` (None: prior query).\"\"\"\n\n    objects: Tuple[Tuple[int, ...], ...]\n    feature_names: Tuple[str, ...]\n    utterance: Optional[int]\n    item: str = \"\"\n    familiarization: Optional[Tuple[float, ...]] = None\n    grayscale: Optional[Tuple[int, ...]] = None\n    valence: int = 0\n    # Feature indices the speaker can name (the message set). None: every\n    # feature is a word (pragmods). In the Franke & Degen game some features\n    # (e.g. square, blue) have no word, which changes which inferences hold.\n    messages: Optional[Tuple[int, ...]] = None\n\n    def __post_init__(self) -> None:\n        objects = tuple(tuple(int(v) for v in row) for row in self.objects)\n        object.__setattr__(self, \"objects\", objects)\n        object.__setattr__(self, \"feature_names\", tuple(self.feature_names))\n        if not objects:\n            raise ValueError(\"a context needs at least one object\")\n        n_features = len(self.feature_names)\n        if any(len(row) != n_features for row in objects):\n            raise ValueError(\n                f\"objects must be rectangular with one entry per feature \"\n                f\"({n_features}): {objects}\"\n            )\n        if any(v not in (0, 1) for row in objects for v in row):\n            raise ValueError(f\"object features must be 0/1: {objects}\")\n        if self.messages is not None:\n            messages = tuple(int(m) for m in self.messages)\n            object.__setattr__(self, \"messages\", messages)\n            if not messages or len(set(messages)) != len(messages):\n                raise ValueError(f\"messages must be distinct feature indices: {messages}\")\n            if any(not 0 <= m < n_features for m in messages):\n                raise ValueError(f\"messages {messages} are not all feature indices (0..{n_features - 1})\")\n        if self.utterance is not None:\n            if self.messages is not None and self.utterance not in self.messages:\n                raise ValueError(\n                    f\"utterance {self.feature_names[self.utterance]!r} is not in the message set\"\n                )\n            if not 0 <= self.utterance < n_features:\n                raise ValueError(\n                    f\"utterance {self.utterance} is not a feature index (0..{n_features - 1})\"\n                )\n            if not any(row[self.utterance] for row in objects):\n                raise ValueError(\n                    f\"utterance {self.feature_names[self.utterance]!r} is true of no object\"","lineStart":1,"lineEnd":100,"totalLines":224,"truncated":true}},"title":"src/rsa/context.py","time":{"start":1791339922469,"end":1791339922484}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142e0416001BpapJfTJULkTXC","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142df494001i9Bf4tFANNOJ1u"}}
