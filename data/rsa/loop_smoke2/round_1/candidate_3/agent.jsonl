{"type":"tool_use","timestamp":1791339905536,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"KpKUMKbai5r7ggGJ","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Vanilla RSA pragmatic listener (depth 1), uniform prior over objects.\n2: \n3: The listener reasons about a speaker who chooses a true word with probability\n4: proportional to exp(alpha * log L0(object | word)), where L0 is the literal\n5: listener; the listener inverts that speaker with a uniform prior over objects\n6: (Frank & Goodman, 2012). With no informative word the choice is uniform. A\n7: lapse parameter mixes in uniform guessing.\n8: \"\"\"\n9: \n10: import jax.numpy as jnp\n11: import numpyro.distributions as dist\n12: from memo import memo\n13: \n14: from src.rsa.memo_kit import EPS, at, with_lapse\n15: \n16: PARAMS = {\n17:     \"alpha\": dist.LogNormal(0.0, 1.0),\n18:     \"lapse\": dist.Beta(1.0, 9.0),\n19: }\n20: \n21: \n22: @memo\n23: def L0[u: UTT, r: OBJ](lex: ...):\n24:     listener: knows(u)\n25:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n26:     return Pr[listener.r == r]\n27: \n28: \n29: @memo\n30: def L1[u: UTT, r: OBJ](alpha, lex: ...):\n31:     listener: thinks[\n32:         speaker: given(r in OBJ, wpp=1),\n33:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n34:     ]\n35:     listener: observes [speaker.u] is u\n36:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n37:     return Pr[listener.r == r]\n38: \n39: \n40: def choice_probs(params, ctx):\n41:     heard = L1(params[\"alpha\"], ctx.lex)[ctx.utterance]\n42:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n43:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 43 lines)\n</content>","metadata":{"preview":"\"\"\"Vanilla RSA pragmatic listener (depth 1), uniform prior over objects.\n\nThe listener reasons about a speaker who chooses a true word with probability\nproportional to exp(alpha * log L0(object | word)), where L0 is the literal\nlistener; the listener inverts that speaker with a uniform prior over objects\n(Frank & Goodman, 2012). With no informative word the choice is uniform. A\nlapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1.py","text":"\"\"\"Vanilla RSA pragmatic listener (depth 1), uniform prior over objects.\n\nThe listener reasons about a speaker who chooses a true word with probability\nproportional to exp(alpha * log L0(object | word)), where L0 is the literal\nlistener; the listener inverts that speaker with a uniform prior over objects\n(Frank & Goodman, 2012). With no informative word the choice is uniform. A\nlapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L1(params[\"alpha\"], ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":43,"totalLines":43,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l1.py","time":{"start":1791339905187,"end":1791339905505}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142dc084001ULhk7LZcy5SUcC","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142db503001xGQMQWH6HJ1aZY"}}
{"type":"tool_use","timestamp":1791339905537,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"fplGIbupyeglwcM8","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_salience.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_salience.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n2: \n3: As vanilla RSA, but the pragmatic listener's prior over objects is a softmax\n4: of salience weights: w_features per feature an object has (pragmods prior\n5: measurements favour objects with more features) plus w_familiar times the\n6: base rate at which the object was seen in a familiarization phase. The prior\n7: enters only the listener's own inference, not the literal listener the\n8: speaker simulates (Frank & Goodman, 2012). With no informative word the\n9: choice is that prior itself, so prior-elicitation trials inform the salience\n10: weights. A lapse parameter mixes in uniform guessing.\n11: \"\"\"\n12: \n13: import jax.numpy as jnp\n14: import numpyro.distributions as dist\n15: from memo import memo\n16: \n17: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n18: \n19: PARAMS = {\n20:     \"alpha\": dist.LogNormal(0.0, 1.0),\n21:     \"w_features\": dist.Normal(0.0, 1.0),\n22:     \"w_familiar\": dist.Normal(0.0, 2.0),\n23:     \"lapse\": dist.Beta(1.0, 9.0),\n24: }\n25: \n26: \n27: @memo\n28: def L0[u: UTT, r: OBJ](lex: ...):\n29:     listener: knows(u)\n30:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n31:     return Pr[listener.r == r]\n32: \n33: \n34: @memo\n35: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n36:     listener: thinks[\n37:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n38:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n39:     ]\n40:     listener: observes [speaker.u] is u\n41:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n42:     return Pr[listener.r == r]\n43: \n44: \n45: def choice_probs(params, ctx):\n46:     prior = softmax_prior(\n47:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n48:     )\n49:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n50:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 50 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n\nAs vanilla RSA, but the pragmatic listener's prior over objects is a softmax\nof salience weights: w_features per feature an object has (pragmods prior\nmeasurements favour objects with more features) plus w_familiar times the\nbase rate at which the object was seen in a familiarization phase. The prior\nenters only the listener's own inference, not the literal listener the\nspeaker simulates (Frank & Goodman, 2012). With no informative word the\nchoice is that prior itself, so prior-elicitation trials inform the salience\nweights. A lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_salience.py","text":"\"\"\"RSA pragmatic listener (depth 1) with a learned salience prior at the top.\n\nAs vanilla RSA, but the pragmatic listener's prior over objects is a softmax\nof salience weights: w_features per feature an object has (pragmods prior\nmeasurements favour objects with more features) plus w_familiar times the\nbase rate at which the object was seen in a familiarization phase. The prior\nenters only the listener's own inference, not the literal listener the\nspeaker simulates (Frank & Goodman, 2012). With no informative word the\nchoice is that prior itself, so prior-elicitation trials inform the salience\nweights. A lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":50,"totalLines":50,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l1_salience.py","time":{"start":1791339905289,"end":1791339905520}},"id":"prt_1142dc0fc00163zz0FSvCcWSqu","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142db503001xGQMQWH6HJ1aZY"}}
{"type":"tool_use","timestamp":1791339905901,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"F9JdKn2SrLp8yRSx","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n2: \n3: As the salience model, but the prior over objects is common knowledge: the\n4: literal listener the speaker simulates uses it too (the paper's \"mutual\n5: knowledge\" variant), so salience shapes which word a speaker would choose as\n6: well as the listener's inference. Salience is a softmax of w_features per\n7: feature an object has plus w_familiar times its familiarization base rate.\n8: With no informative word the choice is that prior. A lapse parameter mixes in\n9: uniform guessing.\n10: \"\"\"\n11: \n12: import jax.numpy as jnp\n13: import numpyro.distributions as dist\n14: from memo import memo\n15: \n16: from src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n17: \n18: PARAMS = {\n19:     \"alpha\": dist.LogNormal(0.0, 1.0),\n20:     \"w_features\": dist.Normal(0.0, 1.0),\n21:     \"w_familiar\": dist.Normal(0.0, 2.0),\n22:     \"lapse\": dist.Beta(1.0, 9.0),\n23: }\n24: \n25: \n26: @memo\n27: def L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n28:     listener: knows(u)\n29:     listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n30:     return Pr[listener.r == r]\n31: \n32: \n33: @memo\n34: def L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n35:     listener: thinks[\n36:         speaker: given(r in OBJ, wpp=vec(prior, r)),\n37:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n38:     ]\n39:     listener: observes [speaker.u] is u\n40:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n41:     return Pr[listener.r == r]\n42: \n43: \n44: def choice_probs(params, ctx):\n45:     prior = softmax_prior(\n46:         params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n47:     )\n48:     heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n49:     return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])\n\n(End of file - total 49 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py","text":"\"\"\"RSA pragmatic listener (depth 1) with a salience prior at every level.\n\nAs the salience model, but the prior over objects is common knowledge: the\nliteral listener the speaker simulates uses it too (the paper's \"mutual\nknowledge\" variant), so salience shapes which word a speaker would choose as\nwell as the listener's inference. Salience is a softmax of w_features per\nfeature an object has plus w_familiar times its familiarization base rate.\nWith no informative word the choice is that prior. A lapse parameter mixes in\nuniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, softmax_prior, vec, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"w_features\": dist.Normal(0.0, 1.0),\n    \"w_familiar\": dist.Normal(0.0, 2.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ..., prior: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=vec(prior, r) * at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ..., prior: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=vec(prior, r)),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex, prior) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    prior = softmax_prior(\n        params[\"w_features\"] * ctx.feature_count + params[\"w_familiar\"] * ctx.familiarization\n    )\n    heard = L1(params[\"alpha\"], ctx.lex, prior)[ctx.utterance]\n    return with_lapse(jnp.where(ctx.is_prior > 0, prior, heard), params[\"lapse\"])","lineStart":1,"lineEnd":49,"totalLines":49,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l1_shared_prior.py","time":{"start":1791339905675,"end":1791339905887}},"id":"prt_1142dc26d001cVWmDLDdPVTtzm","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142db503001xGQMQWH6HJ1aZY"}}
{"type":"tool_use","timestamp":1791339906155,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"EyRfcjtT4S6tVNo1","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n2: \n3: One more level of recursion than the vanilla model: a speaker S2 chooses words\n4: by how well the depth-1 pragmatic listener L1 would recover the object\n5: (exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\n6: what the pragmods \"complex\" game needs to single out the object described by\n7: the twice-implicated word. One rationality alpha at every level; uniform\n8: choice with no informative word; a lapse parameter mixes in uniform guessing.\n9: \"\"\"\n10: \n11: import jax.numpy as jnp\n12: import numpyro.distributions as dist\n13: from memo import memo\n14: \n15: from src.rsa.memo_kit import EPS, at, with_lapse\n16: \n17: PARAMS = {\n18:     \"alpha\": dist.LogNormal(0.0, 1.0),\n19:     \"lapse\": dist.Beta(1.0, 9.0),\n20: }\n21: \n22: \n23: @memo\n24: def L0[u: UTT, r: OBJ](lex: ...):\n25:     listener: knows(u)\n26:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n27:     return Pr[listener.r == r]\n28: \n29: \n30: @memo\n31: def L1[u: UTT, r: OBJ](alpha, lex: ...):\n32:     listener: thinks[\n33:         speaker: given(r in OBJ, wpp=1),\n34:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n35:     ]\n36:     listener: observes [speaker.u] is u\n37:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n38:     return Pr[listener.r == r]\n39: \n40: \n41: @memo\n42: def L2[u: UTT, r: OBJ](alpha, lex: ...):\n43:     listener: thinks[\n44:         speaker: given(r in OBJ, wpp=1),\n45:         speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n46:     ]\n47:     listener: observes [speaker.u] is u\n48:     listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n49:     return Pr[listener.r == r]\n50: \n51: \n52: def choice_probs(params, ctx):\n53:     heard = L2(params[\"alpha\"], ctx.lex)[ctx.utterance]\n54:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n55:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 55 lines)\n</content>","metadata":{"preview":"\"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n\nOne more level of recursion than the vanilla model: a speaker S2 chooses words\nby how well the depth-1 pragmatic listener L1 would recover the object\n(exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\nwhat the pragmods \"complex\" game needs to single out the object described by\nthe twice-implicated word. One rationality alpha at every level; uniform\nchoice with no informative word; a lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/rsa_l2.py","text":"\"\"\"RSA pragmatic listener at depth 2, uniform prior over objects.\n\nOne more level of recursion than the vanilla model: a speaker S2 chooses words\nby how well the depth-1 pragmatic listener L1 would recover the object\n(exp(alpha * log L1)), and the listener L2 inverts S2. Depth-2 reasoning is\nwhat the pragmods \"complex\" game needs to single out the object described by\nthe twice-implicated word. One rationality alpha at every level; uniform\nchoice with no informative word; a lapse parameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import EPS, at, with_lapse\n\nPARAMS = {\n    \"alpha\": dist.LogNormal(0.0, 1.0),\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\n@memo\ndef L1[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L0[u, r](lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\n@memo\ndef L2[u: UTT, r: OBJ](alpha, lex: ...):\n    listener: thinks[\n        speaker: given(r in OBJ, wpp=1),\n        speaker: chooses(u in UTT, wpp=at(lex, u, r) * exp(alpha * log(L1[u, r](alpha, lex) + {EPS}))),\n    ]\n    listener: observes [speaker.u] is u\n    listener: chooses(r in OBJ, wpp=Pr[speaker.r == r])\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L2(params[\"alpha\"], ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":55,"totalLines":55,"truncated":false}},"title":"data/rsa/loop_smoke2/models/rsa_l2.py","time":{"start":1791339905869,"end":1791339906029}},"id":"prt_1142dc2ee001rTFgEu2qniZvVS","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142db503001xGQMQWH6HJ1aZY"}}
