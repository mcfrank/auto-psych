{"type":"tool_use","timestamp":1791339908807,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"dVv6KY8F3SAuVTmO","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/data/rsa/loop_smoke2/models/literal_listener.py"},"output":"<path>/home/user/auto-psych/data/rsa/loop_smoke2/models/literal_listener.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Literal listener (depth 0).\n2: \n3: The listener picks uniformly among the objects the heard word is literally\n4: true of; with no informative word, uniformly among all objects. A lapse\n5: parameter mixes in uniform guessing.\n6: \"\"\"\n7: \n8: import jax.numpy as jnp\n9: import numpyro.distributions as dist\n10: from memo import memo\n11: \n12: from src.rsa.memo_kit import at, with_lapse\n13: \n14: PARAMS = {\n15:     \"lapse\": dist.Beta(1.0, 9.0),\n16: }\n17: \n18: \n19: @memo\n20: def L0[u: UTT, r: OBJ](lex: ...):\n21:     listener: knows(u)\n22:     listener: chooses(r in OBJ, wpp=at(lex, u, r))\n23:     return Pr[listener.r == r]\n24: \n25: \n26: def choice_probs(params, ctx):\n27:     heard = L0(ctx.lex)[ctx.utterance]\n28:     uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n29:     return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])\n\n(End of file - total 29 lines)\n</content>","metadata":{"preview":"\"\"\"Literal listener (depth 0).\n\nThe listener picks uniformly among the objects the heard word is literally\ntrue of; with no informative word, uniformly among all objects. A lapse\nparameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/data/rsa/loop_smoke2/models/literal_listener.py","text":"\"\"\"Literal listener (depth 0).\n\nThe listener picks uniformly among the objects the heard word is literally\ntrue of; with no informative word, uniformly among all objects. A lapse\nparameter mixes in uniform guessing.\n\"\"\"\n\nimport jax.numpy as jnp\nimport numpyro.distributions as dist\nfrom memo import memo\n\nfrom src.rsa.memo_kit import at, with_lapse\n\nPARAMS = {\n    \"lapse\": dist.Beta(1.0, 9.0),\n}\n\n\n@memo\ndef L0[u: UTT, r: OBJ](lex: ...):\n    listener: knows(u)\n    listener: chooses(r in OBJ, wpp=at(lex, u, r))\n    return Pr[listener.r == r]\n\n\ndef choice_probs(params, ctx):\n    heard = L0(ctx.lex)[ctx.utterance]\n    uniform = jnp.full_like(heard, 1.0 / heard.shape[0])\n    return with_lapse(jnp.where(ctx.is_prior > 0, uniform, heard), params[\"lapse\"])","lineStart":1,"lineEnd":29,"totalLines":29,"truncated":false}},"title":"data/rsa/loop_smoke2/models/literal_listener.py","time":{"start":1791339908713,"end":1791339908796}},"metadata":{"google":{"thoughtSignature":""}},"id":"prt_1142dce5f001beWigtbz6Zfxap","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142dc4270013mJRhLEUrcuDBz"}}
{"type":"tool_use","timestamp":1791339908944,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"qiudmgcAMtslpVdq","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/memo_kit.py"},"output":"<path>/home/user/auto-psych/src/rsa/memo_kit.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Helpers every memo model file may import.\n2: \n3: memo parses its own language: an array parameter (declared ``lex: ...``) can\n4: only be read through a function call, never subscripted (``lex[u, r]`` parses\n5: as a query about an agent). These JIT-compiled indexers are that call.\n6: \n7: ``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\n8: context shape being evaluated (`src.rsa.model_file`).\n9: \"\"\"\n10: \n11: from __future__ import annotations\n12: \n13: import jax\n14: import jax.numpy as jnp\n15: \n16: # Added inside log() so a zero probability gives a large finite penalty, not\n17: # -inf and a NaN gradient.\n18: EPS = 1e-10\n19: \n20: \n21: @jax.jit\n22: def at(matrix, i, j):\n23:     \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n24:     return matrix[i, j]\n25: \n26: \n27: @jax.jit\n28: def vec(vector, i):\n29:     \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n30:     return vector[i]\n31: \n32: \n33: def with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n34:     \"\"\"Mix a choice distribution with a uniform guess over the objects.\n35: \n36:     With probability ``lapse`` the participant picks an object at random.\n37:     Without some such noise a model that gives an object probability zero\n38:     (the literal semantics of RSA does, for any object the word is false of)\n39:     makes one participant's choice of it an impossible event.\n40:     \"\"\"\n41:     return (1.0 - lapse) * p + lapse / p.shape[-1]\n42: \n43: \n44: def softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n45:     \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n46:     return jax.nn.softmax(logits)\n\n(End of file - total 46 lines)\n</content>","metadata":{"preview":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/memo_kit.py","text":"\"\"\"Helpers every memo model file may import.\n\nmemo parses its own language: an array parameter (declared ``lex: ...``) can\nonly be read through a function call, never subscripted (``lex[u, r]`` parses\nas a query about an agent). These JIT-compiled indexers are that call.\n\n``OBJ`` and ``UTT`` are not here: the loader injects them, sized to the\ncontext shape being evaluated (`src.rsa.model_file`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport jax\nimport jax.numpy as jnp\n\n# Added inside log() so a zero probability gives a large finite penalty, not\n# -inf and a NaN gradient.\nEPS = 1e-10\n\n\n@jax.jit\ndef at(matrix, i, j):\n    \"\"\"matrix[i, j] for an array parameter (e.g. the lexicon at [u, r]).\"\"\"\n    return matrix[i, j]\n\n\n@jax.jit\ndef vec(vector, i):\n    \"\"\"vector[i] for an array parameter (e.g. a prior over objects at r).\"\"\"\n    return vector[i]\n\n\ndef with_lapse(p: jnp.ndarray, lapse) -> jnp.ndarray:\n    \"\"\"Mix a choice distribution with a uniform guess over the objects.\n\n    With probability ``lapse`` the participant picks an object at random.\n    Without some such noise a model that gives an object probability zero\n    (the literal semantics of RSA does, for any object the word is false of)\n    makes one participant's choice of it an impossible event.\n    \"\"\"\n    return (1.0 - lapse) * p + lapse / p.shape[-1]\n\n\ndef softmax_prior(logits: jnp.ndarray) -> jnp.ndarray:\n    \"\"\"A prior over objects from unnormalised log weights.\"\"\"\n    return jax.nn.softmax(logits)","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"src/rsa/memo_kit.py","time":{"start":1791339908866,"end":1791339908932}},"id":"prt_1142dcef6001UYKmfmtZvw1AnD","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142dc4270013mJRhLEUrcuDBz"}}
{"type":"tool_use","timestamp":1791339909299,"sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","part":{"type":"tool","tool":"read","callID":"vg5Ds3tAElwSIhCZ","state":{"status":"completed","input":{"filePath":"/home/user/auto-psych/src/rsa/loop/check_candidate.py"},"output":"<path>/home/user/auto-psych/src/rsa/loop/check_candidate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Self-check for an agent's memo candidate: the admission gates with a short fit.\n2: \n3:     <the harness python> -m src.rsa.loop.check_candidate <candidate_dir> --responses <responses.csv>\n4: \n5: Runs the code gate, loading, the contract on the training displays and on\n6: the novelty pool's shapes, a short NUTS fit (zero-probability choices, finite\n7: ELPD) and the pool predictions. It does not run the novelty comparison\n8: (that needs the loop's model set) and reports non-convergence of the short\n9: fit as a warning, since the loop's fit is longer. Exit code 0 when nothing\n10: fails.\n11: \"\"\"\n12: \n13: from __future__ import annotations\n14: \n15: import sys\n16: import tempfile\n17: from dataclasses import dataclass\n18: from pathlib import Path\n19: \n20: import tyro\n21: \n22: from src.rsa.dataset import DEFAULT_TRIALS_CSV, load_forced_choice\n23: from src.rsa.fit import FitSettings\n24: from src.rsa.loop.gates import GateConfig, admit\n25: from src.rsa.loop.novelty import novelty_pool\n26: \n27: CHECK_SETTINGS = FitSettings(num_warmup=300, num_samples=300, num_chains=2)\n28: CHECK_TIME_LIMIT_SEC = 10 * 60\n29: \n30: \n31: @dataclass\n32: class Args:\n33:     candidate_dir: tyro.conf.Positional[Path]\n34:     \"\"\"The candidate directory (positional: the command the agents are given passes it bare).\"\"\"\n35:     responses: Path = DEFAULT_TRIALS_CSV\n36: \n37: \n38: def check(candidate_dir: Path, responses: Path) -> tuple[bool, str]:\n39:     with tempfile.TemporaryDirectory() as cache:\n40:         cfg = GateConfig(\n41:             responses_path=responses, cache_dir=Path(cache), settings=CHECK_SETTINGS,\n42:             novelty_threshold=0.0, time_limit_sec=CHECK_TIME_LIMIT_SEC,\n43:         )\n44:         out = admit(\n45:             candidate_dir, \"candidate\", cfg=cfg,\n46:             training=load_forced_choice(responses).contexts, pool=novelty_pool(), admitted_preds={},\n47:         )\n48:     if out.admitted:\n49:         return True, (\n50:             f\"PASS: the candidate meets every gate the self-check runs \"\n51:             f\"(short-fit ELPD-LOO {out.elpd_loo:.1f}). The loop also checks novelty \"\n52:             f\"against the models in the set.\"\n53:         )\n54:     if out.reason.startswith(\"the fit did not converge\"):\n55:         return True, (\n56:             \"WARNING (not a failure of the self-check): the short fit did not converge \"\n57:             f\"({out.reason}). The loop fits longer; if your model has parameters the \"\n58:             \"data cannot pin down, reparameterise.\"\n59:         )\n60:     return False, f\"FAIL: {out.reason}\"\n61: \n62: \n63: def main(args: Args) -> int:\n64:     ok, message = check(args.candidate_dir, args.responses)\n65:     print(message)\n66:     return 0 if ok else 1\n67: \n68: \n69: if __name__ == \"__main__\":\n70:     sys.exit(main(tyro.cli(Args)))\n\n(End of file - total 70 lines)\n</content>","metadata":{"preview":"\"\"\"Self-check for an agent's memo candidate: the admission gates with a short fit.\n\n    <the harness python> -m src.rsa.loop.check_candidate <candidate_dir> --responses <responses.csv>\n\nRuns the code gate, loading, the contract on the training displays and on\nthe novelty pool's shapes, a short NUTS fit (zero-probability choices, finite\nELPD) and the pool predictions. It does not run the novelty comparison\n(that needs the loop's model set) and reports non-convergence of the short\nfit as a warning, since the loop's fit is longer. Exit code 0 when nothing\nfails.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nimport tempfile\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nimport tyro","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/auto-psych/src/rsa/loop/check_candidate.py","text":"\"\"\"Self-check for an agent's memo candidate: the admission gates with a short fit.\n\n    <the harness python> -m src.rsa.loop.check_candidate <candidate_dir> --responses <responses.csv>\n\nRuns the code gate, loading, the contract on the training displays and on\nthe novelty pool's shapes, a short NUTS fit (zero-probability choices, finite\nELPD) and the pool predictions. It does not run the novelty comparison\n(that needs the loop's model set) and reports non-convergence of the short\nfit as a warning, since the loop's fit is longer. Exit code 0 when nothing\nfails.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nimport tempfile\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nimport tyro\n\nfrom src.rsa.dataset import DEFAULT_TRIALS_CSV, load_forced_choice\nfrom src.rsa.fit import FitSettings\nfrom src.rsa.loop.gates import GateConfig, admit\nfrom src.rsa.loop.novelty import novelty_pool\n\nCHECK_SETTINGS = FitSettings(num_warmup=300, num_samples=300, num_chains=2)\nCHECK_TIME_LIMIT_SEC = 10 * 60\n\n\n@dataclass\nclass Args:\n    candidate_dir: tyro.conf.Positional[Path]\n    \"\"\"The candidate directory (positional: the command the agents are given passes it bare).\"\"\"\n    responses: Path = DEFAULT_TRIALS_CSV\n\n\ndef check(candidate_dir: Path, responses: Path) -> tuple[bool, str]:\n    with tempfile.TemporaryDirectory() as cache:\n        cfg = GateConfig(\n            responses_path=responses, cache_dir=Path(cache), settings=CHECK_SETTINGS,\n            novelty_threshold=0.0, time_limit_sec=CHECK_TIME_LIMIT_SEC,\n        )\n        out = admit(\n            candidate_dir, \"candidate\", cfg=cfg,\n            training=load_forced_choice(responses).contexts, pool=novelty_pool(), admitted_preds={},\n        )\n    if out.admitted:\n        return True, (\n            f\"PASS: the candidate meets every gate the self-check runs \"\n            f\"(short-fit ELPD-LOO {out.elpd_loo:.1f}). The loop also checks novelty \"\n            f\"against the models in the set.\"\n        )\n    if out.reason.startswith(\"the fit did not converge\"):\n        return True, (\n            \"WARNING (not a failure of the self-check): the short fit did not converge \"\n            f\"({out.reason}). The loop fits longer; if your model has parameters the \"\n            \"data cannot pin down, reparameterise.\"\n        )\n    return False, f\"FAIL: {out.reason}\"\n\n\ndef main(args: Args) -> int:\n    ok, message = check(args.candidate_dir, args.responses)\n    print(message)\n    return 0 if ok else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(tyro.cli(Args)))","lineStart":1,"lineEnd":70,"totalLines":70,"truncated":false}},"title":"src/rsa/loop/check_candidate.py","time":{"start":1791339909097,"end":1791339909265}},"id":"prt_1142dcfc5001PWJm40EngBN0W2","sessionID":"ses_eebd27f9bffeDsODafbAdCfMV5","messageID":"msg_1142dc4270013mJRhLEUrcuDBz"}}
