quence_a\": \"HHHHTTTT\",\n    \"sequence_b\": \"HTTTTTTT\",\n    \"eig\": 0.053699,\n    \"selection_rank\": 62,\n    \"joint_eig_bits\": 2.306587,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHHHHHT\",\n    \"sequence_b\": \"HHHTHHH\",\n    \"eig\": 0.040397,\n    \"selection_rank\": 63,\n    \"joint_eig_bits\": 2.311137,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHHHTHHH\",\n    \"sequence_b\": \"HHHTTTTH\",\n    \"eig\": 0.023564,\n    \"selection_rank\": 64,\n    \"joint_eig_bits\": 2.312921,\n    \"source\": \"eig\"\n  }\n];\n\n    const jsPsych = initJsPsych({\n      on_finish: function () { window.__experimentData = jsPsych.data.get().values(); }\n    });\n\n    const timeline = [];\n\n    // 1. Instructions\n    timeline.push({\n      type: jsPsychHtmlButtonResponse,\n      stimulus:\n        '<div class=\"auto-psych-prose\">' +\n          '<p>In this study, you will look at sequences of coin flips and judge how <strong>random</strong> they look.</p>' +\n          '<p>Imagine flipping a fair coin over and over. Each flip is equally likely to come up Heads (H) or Tails (T), and every flip is independent — the coin has no memory, so what came before does not change what comes next.</p>' +\n          '<p>On each trial you will see <strong>two</strong> sequences of coin flips, side by side. The two sequences will have the <strong>same length</strong>. Your task is to pick the <strong>one sequence that looks more random</strong> to you — the one that looks more like it was produced by ge\n          '<p>Different people have different impressions of what makes a sequence look random, and there are no right or wrong answers. We are interested in your own honest impression, so go with your gut. You will complete <strong>64 trials</strong>, which takes about 7 minutes. Your responses are\n        '</div>',\n      choices: ['Begin']\n    });\n\n    // 2. One trial per stimulus, side counterbalanced; sequence_a = LEFT.\n    STIMULI.forEach(function (s) {\n      var swap = Math.random() < 0.5;\n      var left = swap ? s.sequence_b : s.sequence_a;\n      var right = swap ? s.sequence_a : s.sequence_b;\n      timeline.push({\n        type: jsPsychHtmlButtonResponse,\n        stimulus:\n          '<p>Which sequence looks more random?</p>' +\n          '<div class=\"auto-psych-pair\">' +\n            '<div class=\"auto-psych-seq\">' + left + '</div>' +\n            '<div class=\"auto-psych-seq\">' + right + '</div>' +\n          '</div>',\n        choices: ['Left', 'Right'],\n        data: { sequence_a: left, sequence_b: right },\n        on_finish: function (data) { data.chose_left = data.response === 0 ? 1 : 0; }\n      });\n    });\n\n    // 3. Debrief\n    timeline.push({\n      type: jsPsychHtmlButtonResponse,\n      stimulus: '<div class=\"auto-psych-prose\"><p>Thank you for participating! Your responses help us understand how people perceive randomness in sequences of coin flips. When you click <strong>Finish</strong>, your responses will be submitted and you will be <strong>redirected back to Prolific</st\n      choices: ['Finish']\n    });\n\n    jsPsych.run(timeline);\n  </script>\n</html>\n\n608\n[\n  {\n    \"sequence_a\": \"HHHTTHTT\",\n    \"sequence_b\": \"TTHHTTHH\",\n    \"eig\": 0.061253,\n    \"selection_rank\": 1,\n    \"joint_eig_bits\": 0.763517,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHTH\",\n    \"sequence_b\": \"TTHTH\",\n    \"eig\": 0.023775,\n    \"selection_rank\": 2,\n    \"joint_eig_bits\": 1.054851,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHTTHHTH\",\n    \"sequence_b\": \"HTTHTTHH\",\n    \"eig\": 0.012231,\n    \"selection_rank\": 3,\n    \"joint_eig_bits\": 1.301778,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHHTTTHH\",\n    \"sequence_b\": \"HTTTHTTT\",\n    \"eig\": 0.012905,\n    \"selection_ran\nShell cwd was reset to /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo","is_error":false}]},"parent_tool_use_id":null,"session_id":"8c9a3677-ceb5-4a2d-8655-fdf596f1d014","uuid":"e4ec5f9b-1d2d-40d1-8957-96a1f74489fe","timestamp":"2026-10-01T15:54:17.156Z","tool_use_result":{"stdout":"28:## Experiment presentation (reproduce VERBATIM — identical across all experiments)\n29-\n30-The implemented jsPsych experiment must be identical in every experiment and every\n31-run; **only the stimuli change.** Use the wording below exactly (do not\n32-paraphrase), **button responses only**, and the data contract above (`chose_left`,\n33-`sequence_a`, `sequence_b`).\n34-\n35-> **Rendering note (the wording below is Markdown — convert it to HTML).** The\n36-> `**bold**` spans must render as `<strong>` in the experiment; participants must\n37-> never see literal asterisks. Put each paragraph in its own `<p>`, and wrap the\n38-> instructions and debrief in the skeleton's `<div class=\"auto-psych-prose\">`\n39-> (constrained-width, left-aligned) so the text does not span the full screen.\n40-\n41-- **Instructions** (first screen, button labelled `Begin`) — use this wording exactly:\n42-  > In this study, you will look at sequences of coin flips and judge how\n43-  > **random** they look.\n44-  >\n45-  > Imagine flipping a fair coin over and over. Each flip is equally likely to come\n46-  > up Heads (H) or Tails (T), and every flip is independent — the coin has no\n47-  > memory, so what came before does not change what comes next.\n48-  >\n49-  > On each trial you will see **two** sequences of coin flips, side by side. The\n50-  > two sequences will have the **same length**. Your task is to pick the **one\n51-  > sequence that looks more random** to you — the one that looks more like it was\n52-  > produced by genuinely random coin flipping.\n53-  >\n54-  > Different people have different impressions of what makes a sequence look\n55-  > random, and there are no right or wrong answers. We are interested in your own\n56-  > honest impression, so go with your gut. You will complete **64 trials**, which\n57-  > takes about 7 minutes. Your responses are anonymous.\n58-\n59-  > **Wording rationale (not shown to participants).** This instruction is grounded\n60-  > in the subjective-randomness literature, which warns that naming the structural\n61-  > cues under study (run length / \"streakiness\", alternation / \"switching\", H–T\n62-  > balance) coaches participants and confounds the measurement (Nickerson, 2002,\n63-  > *Psychol. Rev.*; Reimers, Donkin & Le Pelley, 2018, *Cognition*). The accepted\n64-  > practice is to define the generating process — a *fair coin*, 50/50,\n65-  > independent flips — but leave the meaning of \"random-looking\" for the\n66-  > participant to supply from their own intuition (Williams & Griffiths, 2013,\n67-  > *JEP:General*, Exp. 3 nested condition; Griffiths, Daniels, Austerweil &\n68-  > Tenenbaum, 2018, *Cognitive Psychology*). The question phrasing \"which … looks\n----\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Experiment</title>\n    <script src=\"https://unpkg.com/jspsych@7.3.4\"></script>\n    <link\n      href=\"https://unpkg.com/jspsych@7.3.4/css/jspsych.css\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://unpkg.com/@jspsych/plugin-html-button-response@1.1.3\"></script>\n    <style>\n      /* Readable prose block for instructions/debrief — constrained width, left\n       aligned, comfortable line height. Without this, text spans the full screen. */\n      .auto-psych-prose {\n        max-width: 620px;\n        margin: 0 auto;\n        text-align: left;\n        line-height: 1.6;\n        font-size: 18px;\n      }\n      .auto-psych-prose p {\n        margin: 0 0 1em;\n      }\n      .auto-psych-pair {\n        display: flex;\n        justify-content: center;\n        gap: 64px;\n        margin: 24px 0;\n      }\n      .auto-psych-seq {\n        font-family: monos