ng) rate.\n    mu_lapse = pm.Normal(\"mu_lapse\", mu=-2.0, sigma=1.0)\n    sigma_lapse = pm.HalfNormal(\"sigma_lapse\", sigma=1.0)\n    z_lapse = pm.Normal(\"z_lapse\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    lapse = pm.Deterministic(\"lapse\", pm.math.sigmoid(mu_lapse + sigma_lapse * z_lapse))\n\n    theta = ideal[participant_id]\n    g = gamma[participant_id]\n    d = delta[participant_id]\n    b = beta[participant_id]\n    def rate_penalty(rate):\n        dev = rate - theta\n        return pt.sqr(dev) * pt.switch(dev > 0, over_frac, 1.0)\n\n    score_a = -b * rate_penalty(alt_rate_a) - g * imbalance_a - d * maxrun_a - kappa * endrun_a - rho * palin_a + omega * variety_a - eta * lopsided_a\n    score_b = -b * rate_penalty(alt_rate_b) - g * imbalance_b - d * maxrun_b - kappa * endrun_b - rho * palin_b + omega * variety_b - eta * lopsided_b\n    p_engaged = pm.math.sigmoid(score_a - score_b)\n    lam = lapse[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\", pt.clip(0.5 * lam + (1.0 - lam) * p_engaged, 1e-6, 1 - 1e-6)\n    )\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nTHTHTHHH,HTTHHTTH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n7681 /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment3/model_loop/responses.csv","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
