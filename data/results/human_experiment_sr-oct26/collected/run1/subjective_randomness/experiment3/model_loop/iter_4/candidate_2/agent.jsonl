designed is\nrejected by a fixed extra amount on top of the graded comparison of how random\nthe two look (personal ideal switching rate and sensitivity with lenience toward\nover-alternation, personal weights on imbalance and the longest run, shared\nweights on structural cues, personal guessing rate). Each person has their own\ndetection threshold drawn from a population.\n\"\"\"\n'''\nhead=doc+head[head.index('\\nimport numpy'):]\nbody=body.replace('''    # Personal pattern-detection gain scaling all structural cues (median 1).\n    sigma_gain = pm.HalfNormal(\"sigma_gain\", sigma=0.7)\n    z_gain = pm.Normal(\"z_gain\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    gain = pm.math.exp(sigma_gain * z_gain)\n''','''    # Personal threshold for the categorical \"designed\" verdict (logit scale).\n    mu_thr = pm.Normal(\"mu_thr\", mu=-1.5, sigma=1.0)\n    sigma_thr = pm.HalfNormal(\"sigma_thr\", sigma=1.0)\n    z_thr = pm.Normal(\"z_thr\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    thr = mu_thr + sigma_thr * z_thr\n    # Shared scale of structure salience on the detection logit.\n    det_scale = pm.LogNormal(\"det_scale\", mu=0.0, sigma=0.5)\n    # Shared extra rejection of a sequence caught as designed.\n    reject = pm.HalfNormal(\"reject\", sigma=2.0)\n''')\nbody=body.replace('''    s = gain[participant_id]\n''','''    t = thr[participant_id]\n''')\nold=body[body.index('    score_a ='):body.index('    lam = lapse')]\nnew='''    st_a = structure(endrun_a, palin_a, variety_a, lopsided_a, antisym_a)\n    st_b = structure(endrun_b, palin_b, variety_b, lopsided_b, antisym_b)\n    score_a = -b * rate_penalty(alt_rate_a) - g * imbalance_a - d * maxrun_a + st_a\n    score_b = -b * rate_penalty(alt_rate_b) - g * imbalance_b - d * maxrun_b + st_b\n    diff = score_a - score_b\n    # Probability each sequence is caught as designed (less structure term = more design).\n    q_a = pm.math.sigmoid(t - det_scale * st_a)\n    q_b = pm.math.sigmoid(t - det_scale * st_b)\n  