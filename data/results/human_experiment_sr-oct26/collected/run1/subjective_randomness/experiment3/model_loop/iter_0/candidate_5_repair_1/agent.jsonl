.\n        tally, lo, hi = 0, 0, 0\n        for x in seq:\n            tally += 1 if x == \"H\" else -1\n            lo = min(lo, tally)\n            hi = max(hi, tally)\n        return (hi - lo - 1) / (len(seq) - 1)\n''','''    def longest_alternation_share(seq):\n        # Longest stretch in which every adjacent pair of flips differs.\n        best = cur = 1\n        for x, y in zip(seq, seq[1:]):\n            cur = cur + 1 if x != y else 1\n            best = max(best, cur)\n        return (best - 1) / (len(seq) - 1)\n''')\ns=s.replace('\"lopsided_a\": lopsided_stretch(a)','\"altrun_a\": longest_alternation_share(a)')\ns=s.replace('\"lopsided_b\": lopsided_stretch(b)','\"altrun_b\": longest_alternation_share(b)')\ns=s.replace('lopsided_a = pm.Data(\"lopsided_a\"','altrun_a = pm.Data(\"altrun_a\"')\ns=s.replace('lopsided_b = pm.Data(\"lopsided_b\"','altrun_b = pm.Data(\"altrun_b\"')\ns=s.replace('''    # Shared penalty on the most lopsided stretch (positive: local excess looks designed).''','''    # Shared weight on the longest strictly alternating stretch\n    # (positive: a long rigid alternation looks designed; negative: it looks random).''')\ns=s.replace('eta * lopsided_a','eta * altrun_a').replace('eta * lopsided_b','eta * altrun_b')\nassert \"lopsided\" not in s\nopen(p,\"w\").write(s)\nEOF\ncat > $C/hypothesis.md <<'EOF'\nRefinement of `run_variety_asymmetric_ideal_rate` (rank 1, statistically tied with the best): people still compare a sequence's switching rate with their own ideal (with their own sensitivity, judging switching too often more leniently than too rarely by a shared fraction), still prefer varied run lengths, penalise heads/tails imbalance and the longest streak by personal weights, weigh the final streak and mirror symmetry by shared weights, and guess at a personal lapse rate. The one change is that people also notice the longest unbroken stretch of strict heads/tails alternation (HTHTH…) as a pattern in its own right — the alternation counterpart of the longest streak — and it shifts how random the sequence looks by a shared weight, so two sequences with the same number of switches differ when one gathers its switches into a long rigid alternating stretch (HHTHTHTT) and the other spreads them out (HTHHTTHT).\nEOF\necho longest_alternation_asymmetric_ideal > $C/model_name.txt\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $C --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment3/model_loop/responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"6087f5dc-7592-4fcd-b03f-6526b3292a2f","session_id":"f7a04e1b-574d-4df7-abcd-48a95e289137"}
