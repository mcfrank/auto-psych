 shape=MAX_PARTICIPANTS)\n    lapse = pm.Deterministic(\"lapse\", pm.math.sigmoid(mu_lapse + sigma_lapse * z_lapse))\n\n    theta = ideal[participant_id]\n    g = gamma[participant_id]\n    d = delta[participant_id]\n    b = beta[participant_id]\n    def rate_penalty(rate):\n        dev = rate - theta\n        return pt.sqr(dev) * pt.switch(dev > 0, over_frac, 1.0)\n\n    score_a = -b * rate_penalty(alt_rate_a) - g * imbalance_a - d * maxrun_a - kappa * endrun_a - rho * palin_a + omega * variety_a - eta * lopsided_a\n    score_b = -b * rate_penalty(alt_rate_b) - g * imbalance_b - d * maxrun_b - kappa * endrun_b - rho * palin_b + omega * variety_b - eta * lopsided_b\n    p_engaged = pm.math.sigmoid(score_a - score_b)\n    lam = lapse[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\", pt.clip(0.5 * lam + (1.0 - lam) * p_engaged, 1e-6, 1 - 1e-6)\n    )\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n1c1\n< \"\"\"Asymmetric ideal switching rate plus the most lopsided stretch.\n---\n> \"\"\"Most lopsided stretch with an asymmetric tolerance around the ideal switching rate.\n3,9c3,9\n< Refinement of `run_variety_asymmetric_ideal_rate`: people compare alternation\n< with a personal ideal (over-alternation judged leniently by a shared fraction),\n< prefer varied run lengths, penalise imbalance and the longest run by personal\n< weights, weigh the final run and mirror symmetry by shared weights, and lapse at\n< a personal rate. The one change: the single most lopsided contiguous stretch\n< (largest local heads/tails excess) makes a sequence look less random by a shared\n< weight.\n---\n> Refinement of `most_lopsided_stretch_aversion`: one striking local heads/tails\n> excess still makes a sequence look designed, on top of the personal ideal\n> switching rate and sensitivity, personal weights on imbalance and the longest\n> run, shared weights on the final run, mirror symmetry and run-length variety,\n> and a personal lapse rate. The one change (grafted from\n> `run_variety_asymmetric_ideal_rate`): switching more often than one's ideal costs\n> only a shared fraction of what the same shortfall in switching costs.\n145,146c145\n<     # Shared fraction of the ideal-rate penalty applied to over-alternation\n<     # (below 1: switching too often is judged more leniently than too rarely).\n---\n>     # Shared fraction of the ideal-rate penalty applied to over-alternation."}
