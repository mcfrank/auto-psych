_aversion. Each sequence is judged by\nits switching rate against a personal ideal (personal sensitivity, asymmetric\ntolerance), personal weights on imbalance and the longest run, and structural\ncues of design (final run, mirror symmetry, complement symmetry, run-length\nvariety, most lopsided stretch), with a personal lapse rate. The one change:\nnoticing structure is one personal trait - a person's own pattern-detection\ngain (population-distributed, median 1) scales all structural cues together,\nwhose relative weights are shared - instead of a personal weight on\nantisymmetry alone.\n\"\"\"'''\ns=newdoc+s[doc_end:]\nold=s[s.index(\"    # Personal penalty on complement symmetry\"):s.index(\"    # Shared fraction\")]\nnew='''    # Shared penalty on complement symmetry (positive: antisymmetric sequences look designed).\n    chi = pm.Normal(\"chi\", mu=0.0, sigma=1.5)\n\n    # Personal pattern-detection gain scaling all structural cues (median 1).\n    sigma_gain = pm.HalfNormal(\"sigma_gain\", sigma=0.7)\n    z_gain = pm.Normal(\"z_gain\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    gain = pm.math.exp(sigma_gain * z_gain)\n\n'''\ns=s.replace(old,new)\ns=s.replace(\"    c = chi[participant_id]\\n\",\"    s = gain[participant_id]\\n\")\ns=s.replace(\"    def rate_penalty\",\"\\n    def structure(endrun, palin, variety, lopsided, antisym):\\n        return -kappa * endrun - rho * palin + omega * variety - eta * lopsided - chi * antisym\\n\\n    def rate_penalty\")\ns=s.replace(\"- kappa * endrun_a - rho * palin_a + omega * variety_a - eta * lopsided_a - c * antisym_a\",\"+ s * structure(endrun_a, palin_a, variety_a, lopsided_a, antisym_a)\")\ns=s.replace(\"- kappa * endrun_b - rho * palin_b + omega * variety_b - eta * lopsided_b - c * antisym_b\",\"+ s * structure(endrun_b, palin_b, variety_b, lopsided_b, antisym_b)\")\nopen(sys.argv[2],'w').write(s)\nPY\nsed -n '/Shared penalty on mirror/,$p' $D/candidate.py\n/scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment3/model_loop/responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"f889b1cd-3e4a-4a92-9f63-8f69cfafe47a","session_id":"a834530f-1272-4787-bb27-bd1611478e08"}
