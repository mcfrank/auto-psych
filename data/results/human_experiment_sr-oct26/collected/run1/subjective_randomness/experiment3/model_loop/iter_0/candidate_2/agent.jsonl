:, None, :]  # (n, ND, NK)\n\n    def evidence(r, d):\n        s_rand = pt.sum(r * kern, axis=(1, 2))\n        s_des = pt.sum(d * sim_d, axis=1)\n        return pt.log(s_rand + 1e-300) - pt.log(s_des + 1e-300)\n\n    diff = evidence(r_a, d_a) - evidence(r_b, d_b)\n    p_engaged = pm.math.sigmoid(tau_all[participant_id] * diff)\n    lam = lapse_all[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\", pt.clip(0.5 * lam + (1.0 - lam) * p_engaged, 1e-6, 1 - 1e-6)\n    )\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && time /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment3/model_loop/responses.csv 2>&1 | tail -15","is_backgrounded":false,"task_type":"local_bash","uuid":"714ce364-2676-48ed-a32e-6d19fb232ee4","session_id":"176efcc1-d349-4191-a569-68ee22a6da2f"}
