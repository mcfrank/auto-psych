ll (relative to an ideal-looking sequence, score 0), not only\non the difference, so the same sequence is judged differently beside a\ndifferent partner. Each sequence's impression is the incumbent's\n(personal_complement_symmetry_aversion) judgement.\n\"\"\"'''\nsrc = doc + src[doc_end:]\nold = \"    p_engaged = pm.math.sigmoid(score_a - score_b)\\n\"\nnew = '''    # Personal anchoring on the first-read (left) sequence's impression.\n    mu_alpha = pm.Normal(\"mu_alpha\", mu=0.0, sigma=0.3)\n    sigma_alpha = pm.HalfNormal(\"sigma_alpha\", sigma=0.3)\n    z_alpha = pm.Normal(\"z_alpha\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    alpha = mu_alpha + sigma_alpha * z_alpha\n    a_i = alpha[participant_id]\n    p_engaged = pm.math.sigmoid((1.0 + a_i) * score_a - (1.0 - a_i) * score_b)\n'''\nassert old in src\nsrc = src.replace(old, new)\nopen('candidate.py','w').write(src)\nEOF\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate \\\n    --candidate-dir /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment3/model_loop/iter_3/candidate_0 \\\n    --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment3/model_loop/responses.csv 2>&1 | tail -5"}],"uuid":"857a7efd-50ea-4ba8-adae-b3977ae4e088","session_id":"cee3da27-9fd3-4906-ab1b-8f04833e24b5"}
