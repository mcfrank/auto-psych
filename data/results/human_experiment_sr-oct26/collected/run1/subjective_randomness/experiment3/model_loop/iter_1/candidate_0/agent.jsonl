 = pm.Normal(\"mu_crit\", mu=2.0, sigma=1.5)\n    sigma_crit = pm.HalfNormal(\"sigma_crit\", sigma=1.0)\n    z_crit = pm.Normal(\"z_crit\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    crit = mu_crit + sigma_crit * z_crit\n\n    # Personal probability of inspecting the left sequence first.\n    mu_first = pm.Normal(\"mu_first\", mu=0.0, sigma=1.0)\n    sigma_first = pm.HalfNormal(\"sigma_first\", sigma=1.0)\n    z_first = pm.Normal(\"z_first\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    first_left = pm.math.sigmoid(mu_first + sigma_first * z_first)\n\n    theta = ideal[participant_id]\n    g = gamma[participant_id]\n    d = delta[participant_id]\n    b = beta[participant_id]\n    c = crit[participant_id]\n    q = first_left[participant_id]\n\n    def rate_penalty(rate):\n        dev = rate - theta\n        return pt.sqr(dev) * pt.switch(dev > 0, over_frac, 1.0)\n\n    score_a = -b * rate_penalty(alt_rate_a) - g * imbalance_a - d * maxrun_a - kappa * endrun_a - rho * palin_a + omega * variety_a - eta * lopsided_a\n    score_b = -b * rate_penalty(alt_rate_b) - g * imbalance_b - d * maxrun_b - kappa * endrun_b - rho * palin_b + omega * variety_b - eta * lopsided_b\n    p_compare = pm.math.sigmoid(score_a - score_b)\n    accept_a = pm.math.sigmoid(score_a - c)\n    accept_b = pm.math.sigmoid(score_b - c)\n    p_left_first = accept_a + (1.0 - accept_a) * p_compare\n    p_right_first = (1.0 - accept_b) * p_compare\n    p_engaged = q * p_left_first + (1.0 - q) * p_right_first\n    lam = lapse[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\", pt.clip(0.5 * lam + (1.0 - lam) * p_engaged, 1e-6, 1 - 1e-6)\n    )\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\n} > $D/candidate.py\ngrep -n \"lapse\\|^with\\|theta =\" $D/candidate.py | head -20\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && timeout 1500 /scratch/users/kushinm/auto-psyc