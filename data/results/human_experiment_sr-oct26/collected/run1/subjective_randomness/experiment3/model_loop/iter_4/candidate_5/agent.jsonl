   mu_cap = pm.Normal(\"mu_cap\", mu=np.log(6.0), sigma=0.7)\n    sigma_cap = pm.HalfNormal(\"sigma_cap\", sigma=0.7)\n    z_cap = pm.Normal(\"z_cap\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    capacity = pm.Deterministic(\"capacity\", pm.math.exp(mu_cap + sigma_cap * z_cap))\n\n    theta = ideal[participant_id]\n    g = gamma[participant_id]\n    d = delta[participant_id]\n    b = beta[participant_id]\n    c = chi[participant_id]\n    def rate_penalty(rate):\n        dev = rate - theta\n        return pt.sqr(dev) * pt.switch(dev > 0, over_frac, 1.0)\n\n    score_a = -b * rate_penalty(alt_rate_a) - g * imbalance_a - d * maxrun_a - kappa * endrun_a - rho * palin_a + omega * variety_a - eta * lopsided_a - c * antisym_a\n    score_b = -b * rate_penalty(alt_rate_b) - g * imbalance_b - d * maxrun_b - kappa * endrun_b - rho * palin_b + omega * variety_b - eta * lopsided_b - c * antisym_b\n    blur = pt.sqrt(1.0 + pt.sqr(seq_len / capacity[participant_id]))\n    p_engaged = pm.math.sigmoid((score_a - score_b) / blur)\n    lam = lapse[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\", pt.clip(0.5 * lam + (1.0 - lam) * p_engaged, 1e-6, 1 - 1e-6)\n    )\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n======\n\"\"\"Personal pattern-detection gain.\n\nRefinement of personal_complement_symmetry_aversion. Each sequence is judged by\nits switching rate against a personal ideal (personal sensitivity, asymmetric\ntolerance), personal weights on imbalance and the longest run, and structural\ncues of design (final run, mirror symmetry, complement symmetry, run-length\nvariety, most lopsided stretch), with a personal lapse rate. The one change:\nnoticing structure is one personal trait - a person's own pattern-detection\ngain (population-distributed, median 1) scales all structural cues together,\nwhose relative weights are shared - instead of a personal weight on\nantisymm