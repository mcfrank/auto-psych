"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":813,"cache_read_input_tokens":49390,"cache_creation":{"ephemeral_5m_input_tokens":813,"ephemeral_1h_input_tokens":0},"output_tokens":98,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a936729a-b50b-4fca-bacc-00d77cfc3a99","uuid":"00506b13-e41d-4392-a5fe-8b25c2fcfe74","timestamp":"2026-09-30T19:47:03.943Z","request_id":"req_011CfaCapgMwQ1hA4dwBMVW6"}
