{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SnfKZXzXUFnbnn39kJqytC","type":"tool_result","content":"falk_konold_dp.py\nfinite_experience_occurrence.py\nideal_alternation_streak_penalty.hypothesis.md\nideal_alternation_streak_penalty.py\nideal_alternation_with_balance.hypothesis.md\nideal_alternation_with_balance.py\nindividual_alternation_prototype.hypothesis.md\nindividual_alternation_prototype.py\nindividual_irregularity_weight.hypothesis.md\nindividual_irregularity_weight.py\niter1_candidate1.hypothesis.md\niter1_candidate1.py\nlocal_representativeness.py\nmodels_manifest.yaml\nmotif_stack_alternation_individual.hypothesis.md\nmotif_stack_alternation_individual.py\nmotif_stack.py\nonline_transition_surprise.hypothesis.md\nonline_transition_surprise.py\npersonal_ideal_alternation.hypothesis.md\npersonal_ideal_alternation.py\npersonal_ideal_longest_run.hypothesis.md\npersonal_ideal_longest_run.py\npersonal_switch_belief.hypothesis.md\npersonal_switch_belief.py\nrun_hazard_switch_belief.hypothesis.md\nrun_hazard_switch_belief.py\nwindowed_glimpse_expectation.hypothesis.md\nwindowed_glimpse_expectation.py\n\"\"\"Personal ideal alternation rate.\n\nEach person carries their own ideal switching rate for a random coin (how often\nconsecutive flips should differ) and judges a sequence as more random the closer\nits proportion of alternations lies to that personal ideal. Ideals differ\nbetween people (a hierarchical, non-centred logit-normal population), so the\nmodel predicts individual differences in alternation preference: some people\nfavour near-perfect alternation, others streakier sequences.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\n# Upper bound on participant ids (ids are unique across a run's experiments);\n# an id at or beyond it fails loudly at indexing.\nMAX_PARTICIPANTS = 400\n\n\ndef compute_features(sequence_a, sequence_b):\n    def alternation_rate(seq):\n        seq = seq.strip().upper()\n        if len(seq) < 2:\n            raise ValueError(f\"sequence too short: {seq!r}\")\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    return {\"alt_rate_a\": alternation_rate(sequence_a), \"alt_rate_b\": alternation_rate(sequence_b)}\n\n\nwith pm.Model() as model:\n    alt_rate_a = pm.Data(\"alt_rate_a\", np.zeros(1, dtype=\"float64\"))\n    alt_rate_b = pm.Data(\"alt_rate_b\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Population ideal alternation rate (logit scale) and its spread.\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.4, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    ideal = pm.Deterministic(\n        \"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal)\n    )\n    # Sensitivity to squared distance from the ideal.\n    beta = pm.LogNormal(\"beta\", mu=2.0, sigma=1.0)\n\n    theta = ideal[participant_id]\n    score_a = -pt.sqr(alt_rate_a - theta)\n    score_b = -pt.sqr(alt_rate_b - theta)\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(beta * (score_a - score_b)))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nTHTHTHHH,HTTHHTTH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n2561 ../responses.csv","is_error":false}]},"parent_tool_use_id":null,"session_id":"f9d0e554-1705-4b12-b79d-9619c0be2ac1","uuid":"9d22dad1-dda9-4817-a376-780ae57fc44c","timestamp":"2026-09-30T12:53:05.576Z","tool_use_result":{"stdout":"falk_konold_dp.py\nfinite_experience_occurrence.py\nideal_alternation_streak_penalty.hypothesis.md\nideal_alternation_streak_penalty.py\nideal_alternation_with_balance.hypothesis.md\nideal_alternation_with_balance.py\nindividual_alternation_prototype.hypothesis.md\nin