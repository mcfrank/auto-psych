{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013mUgzUsguDmb2mdyGiYBMK","type":"tool_result","content":"Each person carries their own prototype of how often a genuinely random coin switches between heads and tails, and judges a sequence as random to the extent its switch rate is close to that personal prototype. People differ substantially in this prototype (some expect heavy alternation, others expect near-independent switching), so the same pair can be judged in opposite directions by different participants.\npersonal_switch_rate_prototype\n\"\"\"Personal switch-rate prototype.\n\nEach person carries their own prototype of how often a genuinely random coin\nswitches between heads and tails, and judges a sequence as random to the extent\nits switch rate is close to that personal prototype. People differ in this\nprototype, so the same pair can be judged in opposite directions by different\nparticipants.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\n# Upper bound on participant ids (ids are unique across experiments); unused\n# slots are sampled from the population prior and do not touch the likelihood.\nMAX_PARTICIPANTS = 512\n\n\ndef compute_features(sequence_a, sequence_b):\n    \"\"\"Each sequence's switch rate: share of adjacent flips that differ.\"\"\"\n\n    def switch_rate(seq):\n        seq = seq.strip().upper()\n        if len(seq) < 2:\n            return 0.5\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    return {\"switch_a\": switch_rate(sequence_a), \"switch_b\": switch_rate(sequence_b)}\n\n\nwith pm.Model() as model:\n    switch_a = pm.Data(\"switch_a\", np.zeros(1, dtype=\"float64\"))\n    switch_b = pm.Data(\"switch_b\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Population prototype switch rate (logit scale) and its spread across people.\n    mu_proto = pm.Normal(\"mu_proto\", mu=0.4, sigma=1.0)\n    sigma_proto = pm.HalfNormal(\"sigma_proto\", sigma=1.0)\n    z_proto = pm.Normal(\"z_proto\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    proto = pm.math.sigmoid(mu_proto + sigma_proto * z_proto)[participant_id]\n\n    # Sensitivity to squared distance from the personal prototype.\n    beta = pm.HalfNormal(\"beta\", sigma=10.0)\n\n    dist_a = pt.sqr(switch_a - proto)\n    dist_b = pt.sqr(switch_b - proto)\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(beta * (dist_b - dist_a)))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nfalk_konold_dp.py\nfinite_experience_occurrence.py\nindividual_alternation_prototype.hypothesis.md\nindividual_alternation_prototype.py\nlocal_representativeness.py\nmodels_manifest.yaml\nmotif_stack.py\npersonal_ideal_alternation.hypothesis.md\npersonal_ideal_alternation.py\npersonal_switch_belief.hypothesis.md\npersonal_switch_belief.py\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nTHTHTHHH,HTTHHTTH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n2561 /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment1/model_loop/responses.csv","is_error":false}]},"parent_tool_use_id":null,"session_id":"0b479a07-c81d-4332-8ca2-6a176f246c18","uuid":"b82280cd-c752-4afd-b930-2ec2aa9c8d7c","timestamp":"2026-09-30T10:12:45.462Z","tool_use_result":{"stdout":"Each person carries their own prototype of how often a genuinely random coin switches between heads and tails, and judges a sequence as random to the extent its switch rate is close to that personal prototype. People differ substantially in this prototype (some expect heavy alternation, others expect near-independent switching), so the same pair can be judged in opposite directions by different participants.\npersonal_switch_rate_prototype\n\"\"\"Personal switch-rate prototype.\n\nEach person carries their own prototype of how often a genuinely random coin\nswitches between heads and tails, and judges a sequence as random to the extent\nits switch rate is close to that personal prototype. People differ in this\nprototype, so the same pair can be judged in opposite directions by different\nparticipants.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\n# Upper bound on participant ids (ids are unique across experiments); unused\n# slots are sampled from the population prior and do not touch the likelihood.\nMAX_PARTICIPANTS = 512\n\n\ndef compute_features(sequence_a, sequence_b):\n    \"\"\"Each sequence's switch rate: share of adjacent flips that differ.\"\"\"\n\n    def switch_rate(seq):\n        seq = seq.strip().upper()\n        if len(seq) < 2:\n            return 0.5\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    return {\"switch_a\": switch_rate(sequence_a), \"switch_b\": switch_rate(sequence_b)}\n\n\nwith pm.Model() as model:\n    switch_a = pm.Data(\"switch_a\", np.zeros(1, dtype=\"float64\"))\n    switch_b = pm.Data(\"switch_b\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Population prototype switch rate (logit scale) and its spread across people.\n    mu_proto = pm.Normal(\"mu_proto\", mu=0.4, sigma=1.0)\n    sigma_proto = pm.HalfNormal(\"sigma_proto\", sigma=1.0)\n    z_proto = pm.Normal(\"z_proto\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    proto = pm.math.sigmoid(mu_proto + sigma_proto * z_proto)[participant_id]\n\n    # Sensitivity to squared distance from the personal prototype.\n    beta = pm.HalfNormal(\"beta\", sigma=10.0)\n\n    dist_a = pt.sqr(switch_a - proto)\n    dist_b = pt.sqr(switch_b - proto)\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(beta * (dist_b - dist_a)))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nfalk_konold_dp.py\nfinite_experience_occurrence.py\nindividual_alternation_prototype.hypothesis.md\nindividual_alternation_prototype.py\nlocal_representativeness.py\nmodels_manifest.yaml\nmotif_stack.py\npersonal_ideal_alternation.hypothesis.md\npersonal_ideal_alternation.py\npersonal_switch_belief.hypothesis.md\npersonal_switch_belief.py\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nTHTHTHHH,HTTHHTTH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n2561 /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment1/model_loop/responses.csv","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
