{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K9gzpzvcsn2UjowGmk2JEb","type":"tool_result","content":"falk_konold_dp.py\nfinite_experience_occurrence.py\nideal_alternation_streak_penalty.hypothesis.md\nideal_alternation_streak_penalty.py\nideal_alternation_with_balance.hypothesis.md\nideal_alternation_with_balance.py\nindividual_alternation_prototype.hypothesis.md\nindividual_alternation_prototype.py\nindividual_irregularity_weight.hypothesis.md\nindividual_irregularity_weight.py\niter1_candidate1.hypothesis.md\niter1_candidate1.py\nlocal_representativeness.py\nmodels_manifest.yaml\nmotif_stack_alternation_individual.hypothesis.md\nmotif_stack_alternation_individual.py\nmotif_stack.py\nonline_transition_surprise.hypothesis.md\nonline_transition_surprise.py\npersonal_ideal_alternation.hypothesis.md\npersonal_ideal_alternation.py\npersonal_ideal_longest_run.hypothesis.md\npersonal_ideal_longest_run.py\npersonal_switch_belief.hypothesis.md\npersonal_switch_belief.py\nrun_hazard_switch_belief.hypothesis.md\nrun_hazard_switch_belief.py\nwindowed_glimpse_expectation.hypothesis.md\nwindowed_glimpse_expectation.py\n\"\"\"Personal ideal alternation rate.\n\nEach person carries their own ideal switching rate for a random coin (how often\nconsecutive flips should differ) and judges a sequence as more random the closer\nits proportion of alternations lies to that personal ideal. Ideals differ\nbetween people (a hierarchical, non-centred logit-normal population), so the\nmodel predicts individual differences in alternation preference: some people\nfavour near-perfect alternation, others streakier sequences.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\n# Upper bound on participant ids (ids are unique across a run's experiments);\n# an id at or beyond it fails loudly at indexing.\nMAX_PARTICIPANTS = 400\n\n\ndef compute_features(sequence_a, sequence_b):\n    def alternation_rate(seq):\n        seq = seq.strip().upper()\n        if len(seq) < 2:\n            raise ValueError(f\"sequence too short: {seq!r}\")\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    return {\"alt_rate_a\": alternation_rate(sequence_a), \"alt_rate_b\": alternation_rate(sequence_b)}\n\n\nwith pm.Model() as model:\n    alt_rate_a = pm.Data(\"alt_rate_a\", np.zeros(1, dtype=\"float64\"))\n    alt_rate_b = pm.Data(\"alt_rate_b\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Population ideal alternation rate (logit scale) and its spread.\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.4, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    ideal = pm.Deterministic(\n        \"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal)\n    )\n    # Sensitivity to squared distance from the ideal.\n    beta = pm.LogNormal(\"beta\", mu=2.0, sigma=1.0)\n\n    theta = ideal[participant_id]\n    score_a = -pt.sqr(alt_rate_a - theta)\n    score_b = -pt.sqr(alt_rate_b - theta)\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(beta * (score_a - score_b)))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)","is_error":false}]},"parent_tool_use_id":null,"session_id":"9c6fb0bd-9c76-4001-abcf-1e6971137056","uuid":"025c2e7a-a8e3-4874-b07b-1a5239460c35","timestamp":"2026-09-30T12:53:11.125Z","tool_use_result":{"stdout":"falk_konold_dp.py\nfinite_experience_occurrence.py\nideal_alternation_streak_penalty.hypothesis.md\nideal_alternation_streak_penalty.py\nideal_alternation_with_balance.hypothesis.md\nideal_alternation_with_balance.py\nindividual_alternation_prototype.hypothesis.md\nindividual_alternation_prototype.py\nindividual_irregularity_weight.hypothesis.md\nindividual_irregularity_weight.py\niter1_candidate1.hypothe