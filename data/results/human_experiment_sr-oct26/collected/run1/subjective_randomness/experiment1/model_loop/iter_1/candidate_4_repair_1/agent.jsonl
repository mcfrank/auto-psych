{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bjr1bxcrf","task_type":"local_bash","description":"cd /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment1/model_loop/iter_1/candidate_4_repair_1\ncat << 'EOF' > hypothesis.md\nRefinement of the incumbent `personal_ideal_alternation`: each person still judges a sequence as more random the closer its proportion of alternations lies to their own personal ideal switching rate, but people also notice the single longest streak of identical flips and treat a long streak as a sign of non-randomness, beyond what the overall alternation rate shows. The one change is a shared penalty on the length of the longest run (in flips), added because the critique shows that among irregular sequences people penalise long runs beyond what alternation rate captures, which the alternation-only model under-predicts.\nEOF\necho ideal_alternation_streak_penalty > model_name.txt\ncat << 'EOF' > candidate.py\n\"\"\"Personal ideal alternation rate plus a longest-streak penalty.\n\nRefinement of `personal_ideal_alternation`: each person judges a sequence as\nmore random the closer its proportion of alternations lies to their own ideal\nswitching rate (hierarchical, non-centred logit-normal population), and, as the\nsingle change, everyone additionally penalises the length of a sequence's\nlongest run of identical flips, beyond what the alternation rate shows.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\n# Upper bound on participant ids (ids are unique across a run's experiments);\n# an id at or beyond it fails loudly at indexing.\nMAX_PARTICIPANTS = 400\n\n\ndef compute_features(sequence_a, sequence_b):\n    def alternation_rate(seq):\n        seq = seq.strip().upper()\n        if len(seq) < 2:\n            raise ValueError(f\"sequence too short: {seq!r}\")\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    def longest_run(seq):\n        seq = seq.strip().upper()\n        best = run = 1\n        for x, y in zip(seq, seq[1:]):\n            run = run + 1 if x == y else 1\n            best = max(best, run)\n        return float(best)\n\n    return {\n        \"alt_rate_a\": alternation_rate(sequence_a),\n        \"alt_rate_b\": alternation_rate(sequence_b),\n        \"max_run_a\": longest_run(sequence_a),\n        \"max_run_b\": longest_run(sequence_b),\n    }\n\n\nwith pm.Model() as model:\n    alt_rate_a = pm.Data(\"alt_rate_a\", np.zeros(1, dtype=\"float64\"))\n    alt_rate_b = pm.Data(\"alt_rate_b\", np.zeros(1, dtype=\"float64\"))\n    max_run_a = pm.Data(\"max_run_a\", np.zeros(1, dtype=\"float64\"))\n    max_run_b = pm.Data(\"max_run_b\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Population ideal alternation rate (logit scale) and its spread.\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.4, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    ideal = pm.Deterministic(\n        \"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal)\n    )\n    # Sensitivity to squared distance from the ideal.\n    beta = pm.LogNormal(\"beta\", mu=2.0, sigma=1.0)\n    # Shared penalty per flip of the longest streak (positive: long runs look less random).\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=1.0)\n\n    theta = ideal[participant_id]\n    score_a = -beta * pt.sqr(alt_rate_a - theta) - gamma * max_run_a\n    score_b = -beta * pt.sqr(alt_rate_b - theta) - gamma * max_run_b\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(score_a - score_b))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment1/model_loop/iter_1/candidate_4_repair_1 --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment1/model_loop/responses.csv 2>&1 | tail -5"}],"uuid":"82466789-bdd8-4632-bb15-c127a933ddb3","session_id":"ee258ff8-33e0-41f3-ba95-465174ee71ee"}
