)\n\n    theta = ideal[participant_id]\n    score_a = -beta * pt.sqr(alt_rate_a - theta) - gamma * run_frac_a\n    score_b = -beta * pt.sqr(alt_rate_b - theta) - gamma * run_frac_b\n    p_engaged = pm.math.sigmoid(score_a - score_b)\n    lam = lapse[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\", pt.clip(0.5 * lam + (1.0 - lam) * p_engaged, 1e-6, 1 - 1e-6)\n    )\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\n/scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment1/model_loop/responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"cd80356d-2168-45e8-a16e-e1c1536360f1","session_id":"d844174f-62bc-4264-9ced-43d05adf264e"}
