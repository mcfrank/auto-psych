_live/runs/run1/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment2/model_loop/responses.csv 2>&1 | tail -5","is_backgrounded":false,"task_type":"local_bash","uuid":"157b1e1d-0198-4158-8e48-8e960d10afd3","session_id":"47e1dd46-ae42-435d-8f12-039bc4a77baa"}
