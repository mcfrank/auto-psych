\noverall decisiveness (a population with median 1) that scales every comparison,\nso people differ in how consistently they follow their impression.\n\"\"\"'''\ni=src.index('\\n\\nimport numpy')\nsrc=doc+src[i:]\nsrc=src.replace('''    # Personal lapse (guessing) rate.''','''    # Personal decisiveness: scales the whole comparison (log-normal, median 1).\n    sigma_decisive = pm.HalfNormal(\"sigma_decisive\", sigma=0.5)\n    z_decisive = pm.Normal(\"z_decisive\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    decisive = pm.Deterministic(\"decisive\", pt.exp(sigma_decisive * z_decisive))\n\n    # Personal lapse (guessing) rate.''')\nsrc=src.replace('p_engaged = pm.math.sigmoid(score_a - score_b)','p_engaged = pm.math.sigmoid(decisive[participant_id] * (score_a - score_b))')\nassert 'decisive[participant_id]' in src\nopen(\"/scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment2/model_loop/iter_2/candidate_3/candidate.py\",\"w\").write(src)\nPY\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment2/model_loop/responses.csv 2>&1 | tail -5","is_backgrounded":false,"task_type":"local_bash","uuid":"61de40ca-dfb0-4ecb-9526-37c047682f49","session_id":"c59e7e96-0aa2-46b1-9eed-fd21aa789405"}
