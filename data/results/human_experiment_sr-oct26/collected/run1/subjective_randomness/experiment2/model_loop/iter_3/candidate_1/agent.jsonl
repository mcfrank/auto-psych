{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ATCSMsRxwhVVRqLajuGLrQ","type":"tool_result","content":"edge_streak_balance_alternation_lapse.py\nedge_weighted_alternation_memory.py\nexemplar_random_vs_designed_gcm.hypothesis.md\nexemplar_random_vs_designed_gcm.py\nindividual_alternation_sensitivity_mirror.hypothesis.md\nindividual_alternation_sensitivity_mirror.py\nindividual_streak_aversion_lapse.py\nlapse_individual_balance_alternation.py\nlapse_individual_streak_aversion.py\nleaky_memory_bayesian_randomness.hypothesis.md\nleaky_memory_bayesian_randomness.py\nlempel_ziv_incompressibility.hypothesis.md\nlempel_ziv_incompressibility.py\nmirror_symmetry_streak_aversion_lapse.hypothesis.md\nmirror_symmetry_streak_aversion_lapse.py\nmirror_symmetry_terminal_streak_lapse.hypothesis.md\nmirror_symmetry_terminal_streak_lapse.py\nmodels_manifest.yaml\nopening_run_streak_aversion_lapse.hypothesis.md\nopening_run_streak_aversion_lapse.py\nperiodic_chunk_repetition_aversion.hypothesis.md\nperiodic_chunk_repetition_aversion.py\npersonal_decisiveness_mirror_streak_lapse.hypothesis.md\npersonal_decisiveness_mirror_streak_lapse.py\npersonal_lapse_ideal_alternation.py\npersonal_sensitivity_opening_run_lapse.hypothesis.md\npersonal_sensitivity_opening_run_lapse.py\nprimacy_recency_streak_balance_lapse.hypothesis.md\nprimacy_recency_streak_balance_lapse.py\nrunning_lead_surprise_path.hypothesis.md\nrunning_lead_surprise_path.py\nshared_stretch_cancellation.hypothesis.md\nshared_stretch_cancellation.py\nshort_pattern_evenness_lapse.hypothesis.md\nshort_pattern_evenness_lapse.py\nside_bias_streak_aversion_lapse.hypothesis.md\nside_bias_streak_aversion_lapse.py\nterminal_discounted_streak_lapse.hypothesis.md\nterminal_discounted_streak_lapse.py\nterminal_run_streak_aversion_lapse.hypothesis.md\nterminal_run_streak_aversion_lapse.py\nworst_stretch_switch_deficit.hypothesis.md\nworst_stretch_switch_deficit.py\n\"\"\"Incumbent mirror_symmetry_streak_aversion_lapse with person-level alternation sensitivity.\n\nRefinement of `mirror_symmetry_streak_aversion_lapse`: each person judges a sequence\nas more random the closer its alternation rate lies to their own ideal switching\nrate, penalises heads/tails imbalance and the longest run by weights of their\nown, weighs the final run by a shared weight and guesses on some trials at a\npersonal lapse rate, and palindromes look designed by a shared weight. The one\nchange: how sharply departures from the ideal switching rate count (the\nalternation sensitivity) is each person's own, drawn from a population.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\nMAX_PARTICIPANTS = 400\n\n\ndef compute_features(sequence_a, sequence_b):\n    def alternation_rate(seq):\n        if len(seq) < 2:\n            raise ValueError(f\"sequence too short: {seq!r}\")\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    def imbalance(seq):\n        return abs(seq.count(\"H\") - seq.count(\"T\")) / len(seq)\n\n    def longest_run_share(seq):\n        best = cur = 1\n        for x, y in zip(seq, seq[1:]):\n            cur = cur + 1 if x == y else 1\n            best = max(best, cur)\n        return (best - 1) / (len(seq) - 1)\n\n    def final_run_share(seq):\n        cur = 1\n        for x, y in zip(seq[-2::-1], seq[:0:-1]):\n            if x != y:\n                break\n            cur += 1\n        return (cur - 1) / (len(seq) - 1)\n\n    def palindrome(seq):\n        return 1.0 if seq == seq[::-1] else 0.0\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"alt_rate_a\": alternation_rate(a),\n        \"alt_rate_b\": alternation_rate(b),\n        \"imbalance_a\": imbalance(a),\n        \"imbalance_b\": imbalance(b),\n        \"maxrun_a\": longest_run_share(a),\n        \"maxrun_b\": longest_run_share(b),\n        \"endrun_a\": final_run_share(a),\n        \"endrun_b\": final_run_share(b),\n        \"palin_a\": palindrome(a),\n        \"palin_b\": palindrome(b),\n    }\n\n\nwith pm.Model() as model:\n    alt_rate_a = pm.Data(\"alt_rate_a\", np.zeros(1, dtype=\"float64\"))\n    alt_rate_b = pm.Data(\"alt_rate_b\", np.zeros(1, dtype=\"float64\"))\n    imbalance_a = pm.Data(\"imbalance_a\", np.zeros(1, dtype=\"float64\"))\n    imbalance_b = pm.Data(\"imbalance_b\", np.zeros(1, dtype=\"float64\"))\n    maxrun_a = pm.Data(\"maxrun_a\", np.zeros(1, dtype=\"float64\"))\n    maxrun_b = pm.Data(\"maxrun_b\", np.zeros(1, dtype=\"float64\"))\n    endrun_a = pm.Data(\"endrun_a\", np.zeros(1, dtype=\"float64\"))\n    endrun_b = pm.Data(\"endrun_b\", np.zeros(1, dtype=\"float64\"))\n    palin_a = pm.Data(\"palin_a\", np.zeros(1, dtype=\"float64\"))\n    palin_b = pm.Data(\"palin_b\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Personal ideal alternation rate (non-centred logit-normal population).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.4, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n    # Personal alternation sensitivity (non-centred log-normal population).\n    mu_beta = pm.Normal(\"mu_beta\", mu=2.5, sigma=0.5)\n    sigma_beta = pm.HalfNormal(\"sigma_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    beta = pm.math.exp(mu_beta + sigma_beta * z_beta)\n\n    # Personal weight on H/T imbalance.\n    mu_gamma = pm.Normal(\"mu_gamma\", mu=0.0, sigma=2.0)\n    sigma_gamma = pm.HalfNormal(\"sigma_gamma\", sigma=1.5)\n    z_gamma = pm.Normal(\"z_gamma\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    gamma = mu_gamma + sigma_gamma * z_gamma\n\n    # Personal streak aversion (weight on the longest run's share of the sequence).\n    mu_delta = pm.Normal(\"mu_delta\", mu=0.0, sigma=2.0)\n    sigma_delta = pm.HalfNormal(\"sigma_delta\", sigma=1.5)\n    z_delta = pm.Normal(\"z_delta\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    delta = mu_delta + sigma_delta * z_delta\n\n    # Shared extra weight on the final run (positive: end streaks penalised more).\n    kappa = pm.Normal(\"kappa\", mu=0.0, sigma=1.5)\n\n    # Shared penalty on mirror symmetry (positive: palindromes look designed).\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=1.5)\n\n    # Personal lapse (guessing) rate.\n    mu_lapse = pm.Normal(\"mu_lapse\", mu=-2.0, sigma=1.0)\n    sigma_lapse = pm.HalfNormal(\"sigma_lapse\", sigma=1.0)\n    z_lapse = pm.Normal(\"z_lapse\", mu=0.0, sigma=1.0, shape=MAX_PARTICIPANTS)\n    lapse = pm.Deterministic(\"lapse\", pm.math.sigmoid(mu_lapse + sigma_lapse * z_lapse))\n\n    theta = ideal[participant_id]\n    g = gamma[participant_id]\n    d = delta[participant_id]\n    b = beta[participant_id]\n    score_a = -b * pt.sqr(alt_rate_a - theta) - g * imbalance_a - d * maxrun_a - kappa * endrun_a - rho * palin_a\n    score_b = -b * pt.sqr(alt_rate_b - theta) - g * imbalance_b - d * maxrun_b - kappa * endrun_b - rho * palin_b\n    p_engaged = pm.math.sigmoid(score_a - score_b)\n    lam = lapse[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\", pt.clip(0.5 * lam + (1.0 - lam) * p_engaged, 1e-6, 1 - 1e-6)\n    )\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)","is_error":false}]},"parent_tool_use_id":null,"session_id":"689da2fe-b76a-4d39-b741-acf6d52555b2","uuid":"118ddfaa-61de-4137-a745-24fd48ccc0c0","timestamp":"2026-10-01T11:33:49.041Z","tool_use_result":{"stdout":"edge_streak_balance_alternation_lapse.py\nedge_weighted_alternation_memory.py\nexemplar_random_vs_designed_gcm.hypothesis.md\nexemplar_random_vs_designed_gcm.py\nindividual_alternation_sensitivity_mirror.hypothesis.md\nindividual_alternation_sensi