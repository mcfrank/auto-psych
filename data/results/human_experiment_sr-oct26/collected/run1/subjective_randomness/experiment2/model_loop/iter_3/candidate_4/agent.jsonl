red weights, and guesses at a personal lapse rate. The one change: switching\nmore often than the ideal is penalised by a shared fitted factor relative to\nswitching less often (an asymmetric ideal-rate penalty).\n\"\"\"\n\n'''\nbody = src[start:]\nbody = body.replace('''    # Personal lapse (guessing) rate.''', '''    # Shared asymmetry: over-alternation costs omega times as much as under-alternation.\n    log_omega = pm.Normal(\"log_omega\", mu=0.0, sigma=1.0)\n    omega = pm.Deterministic(\"omega\", pm.math.exp(log_omega))\n\n    # Personal lapse (guessing) rate.''')\nbody = body.replace('''    score_a = -b * pt.sqr(alt_rate_a - theta)''', '''    dev_a = alt_rate_a - theta\n    dev_b = alt_rate_b - theta\n    pen_a = pt.sqr(dev_a) * pt.switch(dev_a > 0, omega, 1.0)\n    pen_b = pt.sqr(dev_b) * pt.switch(dev_b > 0, omega, 1.0)\n    score_a = -b * pen_a''')\nbody = body.replace('''    score_b = -b * pt.sqr(alt_rate_b - theta)''', '''    score_b = -b * pen_b''')\nassert body.count(\"pen_a\") == 2 and body.count(\"pen_b\") == 2\nopen(\"/scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment2/model_loop/iter_3/candidate_4/candidate.py\",\"w\").write(doc+body)\nPY\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment2/model_loop/responses.csv 2>&1 | tail -5","is_backgrounded":false,"task_type":"local_bash","uuid":"fd1165a2-a8b7-4b0a-a90f-774e73f07317","session_id":"ab61eac6-de43-4f51-8cd4-a7c5a7b91050"}
