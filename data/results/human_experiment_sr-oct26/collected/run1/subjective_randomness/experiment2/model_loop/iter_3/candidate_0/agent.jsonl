 weights on\nimbalance and the longest run, shared weights on the final run and mirror\nsymmetry, personal lapse rate).\n\"\"\"\n'''\ni=src.index('import numpy')\nsrc=doc+\"\\n\"+src[i:]\nsrc=src.replace('''    a = sequence_a.strip().upper()''','''    def run_variety(seq):\n        runs = []\n        cur = 1\n        for x, y in zip(seq, seq[1:]):\n            if x == y:\n                cur += 1\n            else:\n                runs.append(cur)\n                cur = 1\n        runs.append(cur)\n        n = len(seq)\n        kmax = 1\n        while (kmax + 1) * (kmax + 2) // 2 <= n:\n            kmax += 1\n        if kmax <= 1:\n            return 0.0\n        return (len(set(runs)) - 1) / (kmax - 1)\n\n    a = sequence_a.strip().upper()''')\nsrc=src.replace('''        \"palin_b\": palindrome(b),\n''','''        \"palin_b\": palindrome(b),\n        \"variety_a\": run_variety(a),\n        \"variety_b\": run_variety(b),\n''')\nsrc=src.replace('''    participant_id = pm.Data(''','''    variety_a = pm.Data(\"variety_a\", np.zeros(1, dtype=\"float64\"))\n    variety_b = pm.Data(\"variety_b\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(''')\nsrc=src.replace('''    # Personal lapse''','''    # Shared weight on run-length variety (positive: varied runs look random).\n    omega = pm.Normal(\"omega\", mu=0.0, sigma=1.5)\n\n    # Personal lapse''')\nsrc=src.replace(\"- rho * palin_a\",\"- rho * palin_a + omega * variety_a\").replace(\"- rho * palin_b\",\"- rho * palin_b + omega * variety_b\")\nopen(\"/scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment2/model_loop/iter_3/candidate_0/candidate.py\",\"w\").write(src)\nPY\ngrep -n \"variety\\|omega\" $D/candidate.py\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run1/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loo