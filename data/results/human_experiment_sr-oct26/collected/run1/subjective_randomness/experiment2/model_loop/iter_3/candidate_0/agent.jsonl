er_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run1/data/subjective_randomness/experiment2/model_loop/responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"c6699ce6-f163-4173-a233-7b0f76370362","session_id":"680922c2-4fd9-4851-89ca-4b1a47653ad7"}
