{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WM4V9ThFKUL3Pn3fR26Q9C","type":"tool_result","content":"balance_aware_heads_alternation_ideal.hypothesis.md\nbalance_aware_heads_alternation_ideal.py\nbalanced_heads_default_alternation_ideal.hypothesis.md\nbalanced_heads_default_alternation_ideal.py\nbalanced_heads_lapse_ideal_streak.hypothesis.md\nbalanced_heads_lapse_ideal_streak.py\nbayes_rigged_coin_with_two_flip_memory.hypothesis.md\nbayes_rigged_coin_with_two_flip_memory.py\ngist_typicality_count_runs.hypothesis.md\ngist_typicality_count_runs.py\ngraded_periodicity_personal_ideal.py\nheads_default_alternation_ideal.py\nheads_favoring_lapse_ideal_streak.py\niter0_candidate0.hypothesis.md\niter0_candidate0.py\niter1_candidate4.hypothesis.md\niter1_candidate4.py\nlength_scaled_alternation_ideal.py\nmax_lopsided_window_surprise.hypothesis.md\nmax_lopsided_window_surprise.py\nmodels_manifest.yaml\nperiodic_penalized_alternation_ideal.py\npersonal_ideal_with_personal_lapse.py\npersonal_lapse_ideal_streak_excess.py\npersonal_side_bias_alternation_ideal.hypothesis.md\npersonal_side_bias_alternation_ideal.py\nperson_sensitivity_length_scaled_ideal.py\nstreak_aware_balanced_alternation_ideal.hypothesis.md\nstreak_aware_balanced_alternation_ideal.py\nswitching_then_balance_semiorder.hypothesis.md\nswitching_then_balance_semiorder.py\ntally_span_personal_ideal.hypothesis.md\ntally_span_personal_ideal.py\n\"\"\"Triplet-variety balanced heads-default alternation ideal.\n\nRefinement of `balance_aware_heads_alternation_ideal`: people judge a sequence\nby how close its switching rate is to their own ideal (person-specific,\nlength-scaled sensitivity; shared periodicity penalty), favour heads-leaning\nsequences and dislike lopsided H/T counts, and they also register the variety\nof short local patterns: a sequence whose overlapping three-flip chunks are\nmostly distinct looks more random than one that reuses the same few chunks,\nat the same switching rate. The one change is the shared triplet-variety\nweight `rho`.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def alternation_rate(seq):\n        switches = sum(1 for x, y in zip(seq, seq[1:]) if x != y)\n        return switches / (len(seq) - 1)\n\n    def periodic(seq):\n        n = len(seq)\n        for p in range(1, n // 2 + 1):\n            if all(seq[i] == seq[i + p] for i in range(n - p)):\n                return 1.0\n        return 0.0\n\n    def heads_excess(seq):\n        return seq.count(\"H\") / len(seq) - 0.5\n\n    def triplet_variety(seq):\n        # Share of the possible distinct three-flip chunks the sequence shows.\n        n_windows = len(seq) - 2\n        if n_windows <= 0:\n            return 0.0\n        distinct = len({seq[i:i + 3] for i in range(n_windows)})\n        return distinct / min(8, n_windows)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"alt_rate_a\": alternation_rate(a),\n        \"alt_rate_b\": alternation_rate(b),\n        \"periodic_a\": periodic(a),\n        \"periodic_b\": periodic(b),\n        \"heads_excess_diff\": heads_excess(a) - heads_excess(b),\n        # Symmetric imbalance |#H-#T|/n: b minus a (positive favours a).\n        \"imbalance_diff_ba\": 2.0 * (abs(heads_excess(b)) - abs(heads_excess(a))),\n        # Triplet variety, a minus b (positive favours a).\n        \"triplet_variety_diff\": triplet_variety(a) - triplet_variety(b),\n        \"log_trans\": float(np.log((len(a) - 1) / 5.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    alt_a = pm.Data(\"alt_rate_a\", np.zeros(1, dtype=\"float64\"))\n    alt_b = pm.Data(\"alt_rate_b\", np.zeros(1, dtype=\"float64\"))\n    per_a = pm.Data(\"periodic_a\", np.zeros(1, dtype=\"float64\"))\n    per_b = pm.Data(\"periodic_b\", np.zeros(1, dtype=\"float64\"))\n    heads_diff = pm.Data(\"heads_excess_diff\", np.zeros(1, dtype=\"float64\"))\n    imb_diff = pm.Data(\"imbalance_diff_ba\", np.zeros(1, dtype=\"float64\"))\n    trip_diff = pm.Data(\"triplet_variety_diff\", np.zeros(1, dtype=\"float64\"))\n    log_trans = pm.Data(\"log_trans\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=1.5, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n    delta = pm.Normal(\"delta\", mu=0.0, sigma=2.0)\n    # Symmetric balance weight (positive: lopsided H/T counts look less random).\n    eta = pm.Normal(\"eta\", mu=0.0, sigma=2.0)\n\n    # Reward for local pattern variety (positive: more distinct triplets look\n    # more random).\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=2.0)\n\n    theta = ideal[participant_id]\n    dist_a = (alt_a - theta) ** 2\n    dist_b = (alt_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_trans)\n    score = (\n        sens * (dist_b - dist_a)\n        + gamma * (per_b - per_a)\n        + delta * heads_diff\n        + eta * imb_diff\n        + rho * trip_diff\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(score))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n\"\"\"Tally span personal ideal.\n\nPeople read a sequence flip by flip while keeping a running tally of how far\nheads lead tails, and judge randomness by how widely that tally swings over the\nreading: the span between its highest and lowest point (start included). Each\nperson expects a fair coin's tally to cover some typical share of the sequence's\nlength; a long streak (even one later evened out) stretches the span and strict\nalternation pins it at one step, and people choose the sequence whose tally span\nis closer to their own expectation. Each person also has a small left/right\nresponse bias.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(sens * (dist_b - dist_a) + side[participant_id]))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)","is_error":false}]},"parent_tool_use_id":null,"session_id":"16429e1f-063a-4f19-a8f0-dad100262bc9","uuid":"454e49e6-012a-4180-b883-826d21ab61e6","timestamp":"2026-10-03T12:22:24.712Z","tool_use_result":{"stdout":"balance_aware_heads_alternation_ideal.hypothesis.md\nbalance_aware_heads_alternation_ideal.py\nbalanced_heads_default_alternation_ideal.hypothesis.md\nbalanced_heads_default_alternation_ideal.py\nbalanced_heads_lapse_ideal_streak.hypothesis.md\nbalanced_heads_lapse_ideal_streak.py\nbayes_rigged_coin_with_two_flip_memory.hypothesis.md\nbayes_rigged_coin_with_two_flip_memory.py\ngist_typicality_count_runs.hypothesis.md\ngist_typicality_count_runs.py\ngraded_periodicity_personal_ideal.py\nheads_default_alternation_ideal.py\nheads_favoring_lapse_ideal_streak.py\niter0_candidate0.hypothesis.md\niter0_candidate0.py\niter1_candidate4.hypothesis.md\niter1_candidate4.py\nlength_scaled_alternation_ideal.py\nmax_lopsided_window_surprise.hypothesis.md\nmax_lopsided_window_surprise.py\nmodels_manifest.yaml\nperiodic_penalized_alternation_ideal.py\npersonal_ideal_with_personal_lapse.py\npersonal_lapse_ideal_streak_excess.py\npersonal_side_bias_alternation_ideal.hypothesis.md\npersonal_side_bias_al