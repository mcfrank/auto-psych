y\ntie_return_rate_personal_ideal.hypothesis.md\ntie_return_rate_personal_ideal.py\n\"\"\"Tally span personal ideal with a personal switching preference.\n\nRefinement of `tally_span_personal_ideal`: people keep a running heads-minus-\ntails tally and judge a sequence random by how close the tally's span (as a\nshare of the length) is to their own expected span, with a personal left/right\nlean. The one change: they also reward H/T switching in its own right, with a\nperson-specific weight, so of two sequences with equally wide tally swings\nthey pick the one that alternates more.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"switch_diff\": switch_rate(a) - switch_rate(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    switch_diff = pm.Data(\"switch_diff\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # The change: person-specific reward on the switch-rate difference.\n    mu_alt = pm.Normal(\"mu_alt\", mu=0.0, sigma=1.5)\n    sigma_alt = pm.HalfNormal(\"sigma_alt\", sigma=1.0)\n    z_alt = pm.Normal(\"z_alt\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    alt = mu_alt + sigma_alt * z_alt\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    logit = sens * (dist_b - dist_a) + alt[participant_id] * switch_diff + side[participant_id]\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)","is_error":false}]},"parent_tool_use_id":null,"session_id":"62104931-367f-460b-bf92-86f3ebe38ae3","uuid":"7fe1ee2f-d14a-4856-99a2-684e6ed93b9c","timestamp":"2026-10-03T13:48:08.539Z","tool_use_result":{"stdout":"sequence_a,sequence_b,participant_id,trial_index,chose_left\r\nHTTHHTTH,THTHTHHH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n5121 responses.csv\nbalance_aware_heads_alternation_ideal.hypothesis.md\nbalance_aware_heads_alternation_ideal.py\nbalanced_heads_default_alternation_ideal.hypothesis.md\nbalanced_h