dtype=\"float64\"))\n    heads_diff = pm.Data(\"heads_excess_diff\", np.zeros(1, dtype=\"float64\"))\n    imb_diff = pm.Data(\"imbalance_diff_ba\", np.zeros(1, dtype=\"float64\"))\n    log_trans = pm.Data(\"log_trans\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=1.5, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n    delta = pm.Normal(\"delta\", mu=0.0, sigma=2.0)\n    # Symmetric balance weight (positive: lopsided H/T counts look less random).\n    eta = pm.Normal(\"eta\", mu=0.0, sigma=2.0)\n\n    theta = ideal[participant_id]\n    dist_a = (alt_a - theta) ** 2\n    dist_b = (alt_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_trans)\n    score = (\n        sens * (dist_b - dist_a)\n        + gamma * (per_b - per_a)\n        + delta * heads_diff\n        + eta * imb_diff\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(score))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nRefinement of the incumbent `balance_aware_heads_alternation_ideal`: people still judge a sequence by how close its switching rate is to their own ideal (person-specific, length-scaled sensitivity, shared penalty for periodic sequences), still favour heads-leaning sequences and still find lopsided H/T counts less random — but they also notice a streak of identical flips as soon as it is long in absolute terms, so every flip of the longest run beyond two (HHH, HHHH, ...) makes a sequence look less random, over and above what its switch count implies. The one change is this shared penalty on the absolute excess length of the longest streak, addressing the critique's strongest FDR-surviving discrepancy: among pairs with equal switch counts, people choose the sequence with the shorter longest run far more often than the incumbent predicts.\n1c1\n< \"\"\"Streak-averse balanced heads-default alternation ideal.\n---\n> \"\"\"Balance-aware heads-default alternation ideal.\n3,9c3,8\n< Refinement of `balance_aware_heads_alternation_ideal`: people judge a sequence\n< by how close its switching rate is to their own ideal (person-specific,\n< length-scaled sensitivity; shared periodicity penalty), favour heads-leaning\n< sequences and dislike lopsided H/T counts, and they also notice a long streak\n< in absolute terms: every flip of the longest run beyond two makes a sequence\n< look less random beyond what its switch count implies. The one change is the\n< shared streak-excess weight `kappa`.\n---\n> Refinement of `heads_default_alternation_ideal`: people judge a sequence by how\n> close its switching rate is to their own ideal (person-specific, length-scaled\n> sensitivity; shared periodicity penalty) and favour heads-leaning sequences,\n> but they also expect a random coin to give roughly equal heads and tails, so a\n> lopsided H/T count in either direction looks less random. The one change is the\n> shared symmetric imbalance weight `eta`.\n30,36d28\n<     def streak_excess(seq):\n<         longest, cur = 1, 1\n<         for x, y in zip(seq, seq[1:]):\n<             cur = cur + 1 if x == y else 1\n<             longest = max(longest, cur)\n<         return float(max(0, longest - 2))\n< \n44a37\n>         # Symmetric imbalance |#H-#T|/n: b minus 