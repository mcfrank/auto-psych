{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UXKw7TspKs4LxpCnLfDmjY","type":"tool_result","content":"\"\"\"Tally span personal ideal with a personal switching preference.\n\nRefinement of `tally_span_personal_ideal`: people keep a running heads-minus-\ntails tally and judge a sequence random by how close the tally's span (as a\nshare of the length) is to their own expected span, with a personal left/right\nlean. The one change: they also reward H/T switching in its own right, with a\nperson-specific weight, so of two sequences with equally wide tally swings\nthey pick the one that alternates more.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"switch_diff\": switch_rate(a) - switch_rate(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    switch_diff = pm.Data(\"switch_diff\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # The change: person-specific reward on the switch-rate difference.\n    mu_alt = pm.Normal(\"mu_alt\", mu=0.0, sigma=1.5)\n    sigma_alt = pm.HalfNormal(\"sigma_alt\", sigma=1.0)\n    z_alt = pm.Normal(\"z_alt\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    alt = mu_alt + sigma_alt * z_alt\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    logit = sens * (dist_b - dist_a) + alt[participant_id] * switch_diff + side[participant_id]\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n----\n\"\"\"Tally-excursion triplet-variety alternation ideal.\n\nRefinement of `iter1_candidate4`: people judge a sequence by how close its\nswitching rate is to their own ideal (person-specific, length-scaled\nsensitivity; shared periodicity penalty), favour heads-leaning sequences,\ndislike lopsided H/T counts and reward distinct three-flip chunks; and while\nreading they follow a running heads-minus-tails tally, so a sequence whose\ntally swings widely (a streak, even one later evened out) looks less random.\nThe one change is the shared tally-span penalty `kappa`.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def alternation_rate(seq):\n        switches = sum(1 for x, y in zip(seq, seq[1:]) if x != y)\n        return switches / (len(seq) - 1)\n\n    def periodic(seq):\n        n = len(seq)\n        for p in range(1, n // 2 + 1):\n            if all(seq[i] == seq[i + p] for i in range(n - p)):\n                return 1.0\n        return 0.0\n\n    def heads_excess(seq):\n        return seq.count(\"H\") / len(seq) - 0.5\n\n    def triplet_variety(seq):\n        n_windows = len(seq) - 2\n        if n_windows <= 0:\n            return 0.0\n        distinct = len({seq[i:i + 3] for i in range(n_windows)})\n        return distinct / min(8, n_windows)\n\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"alt_rate_a\": alternation_rate(a),\n        \"alt_rate_b\": alternation_rate(b),\n        \"periodic_a\": periodic(a),\n        \"periodic_b\": periodic(b),\n        \"heads_excess_diff\": heads_excess(a) - heads_excess(b),\n        \"imbalance_diff_ba\": 2.0 * (abs(heads_excess(b)) - abs(heads_excess(a))),\n        \"triplet_variety_diff\": triplet_variety(a) - triplet_variety(b),\n        # Tally span share, b minus a (positive favours a).\n        \"span_diff_ba\": span_share(b) - span_share(a),\n        \"log_trans\": float(np.log((len(a) - 1) / 5.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    alt_a = pm.Data(\"alt_rate_a\", np.zeros(1, dtype=\"float64\"))\n    alt_b = pm.Data(\"alt_rate_b\", np.zeros(1, dtype=\"float64\"))\n    per_a = pm.Data(\"periodic_a\", np.zeros(1, dtype=\"float64\"))\n    per_b = pm.Data(\"periodic_b\", np.zeros(1, dtype=\"float64\"))\n    heads_diff = pm.Data(\"heads_excess_diff\", np.zeros(1, dtype=\"float64\"))\n    imb_diff = pm.Data(\"imbalance_diff_ba\", np.zeros(1, dtype=\"float64\"))\n    trip_diff = pm.Data(\"triplet_variety_diff\", np.zeros(1, dtype=\"float64\"))\n    span_diff = pm.Data(\"span_diff_ba\", np.zeros(1, dtype=\"float64\"))\n    log_trans = pm.Data(\"log_trans\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=1.5, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n    delta = pm.Normal(\"delta\", mu=0.0, sigma=2.0)\n    eta = pm.Normal(\"eta\", mu=0.0, sigma=2.0)\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=2.0)\n    # Tally-span penalty (positive: a wider-swinging tally looks less random).\n    kappa = pm.Normal(\"kappa\", mu=0.0, sigma=2.0)\n\n    theta = ideal[participant_id]\n    dist_a = (alt_a - theta) ** 2\n    dist_b = (alt_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_trans)\n    score = (\n        sens * (dist_b - dist_a)\n        + gamma * (per_b - per_a)\n        + delta * heads_diff\n        + eta * imb_diff\n        + rho * trip_diff\n        + kappa * span_diff\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(score))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nHTTHHTTH,THTHTHHH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n5121 ../responses.csv","is_error":false}]},"parent_tool_use_id":null,"session_id":"bde64ab7-d974-4071-b165-ca1505051caa","uuid":"66801c32-4b65-4f08-a140-b5f16fb96f47","timestamp":"2026-10-03T13:47:46.220Z","tool_use_result":{"stdout":"\"\"\"Tally span personal ideal with a personal switching preference.\n\nRefinement of `tally_span_personal_ideal`: people keep a running heads-minus-\ntails tally and judge a sequence random by how close the tally's span (as a\nshare of the length) is to their own expected span, with a personal left/right\nlean. The one change: they also reward H/T switching in its own right, with a\nperson-specific weight, so of two sequences with equally wide tally swings\nthey pick the one that alternates more.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"switch_diff\": switch_rate(a) - switch_rate(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    switch_diff = pm.Data(\"switch_diff\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\")