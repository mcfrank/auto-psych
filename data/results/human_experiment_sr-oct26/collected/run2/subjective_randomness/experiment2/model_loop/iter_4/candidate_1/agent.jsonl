span_personal_ideal.py\ntally_span_switch_rate_ideal_2.hypothesis.md\ntally_span_switch_rate_ideal_2.py\ntally_span_switch_rate_ideal.hypothesis.md\ntally_span_switch_rate_ideal.py\ntally_span_switch_triplet_variety.hypothesis.md\ntally_span_switch_triplet_variety.py\ntie_return_rate_personal_ideal.hypothesis.md\ntie_return_rate_personal_ideal.py\n\"\"\"Tally span personal ideal with an ideal (inverted-U) switching rate.\n\nRefinement of `iter2_candidate3`: people keep a running heads-minus-tails\ntally and judge a sequence random by how close the tally's span (as a share of\nthe length) is to their own expected span, with a personal left/right lean.\nThe one change: switching is judged by closeness to an ideal switching rate\n(shared ideal, person-specific weight) rather than rewarded linearly, so\nstrict alternation looks too regular and streaky sequences too sticky.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"sw_a\": switch_rate(a),\n        \"sw_b\": switch_rate(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    sw_a = pm.Data(\"sw_a\", np.zeros(1, dtype=\"float64\"))\n    sw_b = pm.Data(\"sw_b\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # The change: switching judged by closeness to a shared ideal switch rate,\n    # with a person-specific weight (replacing the linear switching reward).\n    sw_ideal = pm.Beta(\"sw_ideal\", alpha=6.0, beta=4.0)\n    mu_kappa = pm.Normal(\"mu_kappa\", mu=0.0, sigma=1.5)\n    sigma_kappa = pm.HalfNormal(\"sigma_kappa\", sigma=1.0)\n    z_kappa = pm.Normal(\"z_kappa\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    kappa = mu_kappa + sigma_kappa * z_kappa\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    sw_dist = (sw_b - sw_ideal) ** 2 - (sw_a - sw_ideal) ** 2\n    logit = sens * (dist_b - dist_a) + 4.0 * kappa[participant_id] * sw_dist + side[participant_id]\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)","is_error":false}]},"parent_tool_use_id":null,"session_id":"bc5f2bbb-6019-4fe1-85f9-f6d4280d480b","uuid":"34419624-e689-442b-b8cb-def55e0a7591","timestamp":"2026-10-03T16:27:20.505Z","tool_use_result":{"stdout":"balance_aware_heads_alternation_ideal.hypothesis.md\nbalance_aware_heads_alternation_ideal.py\nbalanced_heads_default_alternation_ideal.hypothesis.md\nbalanced_heads_default_alternation_ideal.py\nbalanced_heads_lapse_ideal_streak.hypothesis.md\nbalanced_heads_lapse_ideal_streak.py\nbayes_rigged_coin_with_two_flip_memory.hypothesis.md\nbayes_rigged_coin_with_two_flip_memory.py\nbayes_triplet_chunk_rig_detector.hypothesis.md\nbayes_triplet_chunk_rig_detector.py\ngist_typicality_count_runs.hypothesis.md\ngist_typicality_count_runs.py\ngraded_periodicity_personal_ideal.py\nheads_default_alternation_ideal.py\nheads_favoring_lapse_ideal_streak.py\niter0_candidate0.hypothesis.md\niter0_candidate0.py\niter1_candidate4.hypothesis.md\niter1_candidate4.py\niter2_candidate3.hypothesis.md\niter2_candidate3.py\nlempel_ziv_copy_complexity.hypothesis.md\nlempel_ziv_copy_complexity.py\nlength_scaled_alternation_ideal.py\nmax_lopsided_window_surprise.hypothesis.md\nmax_lopsided_window_surprise.py\nmodels_manifest.yaml\nperiodic_penalized_alternation_ideal.py\npersonal_ideal_with_personal_lapse.py\npersonal_lapse_ideal_streak_excess.py\npersonal_side_bias_alternation_ideal.hypothesis.md\npersonal_side_bias_alternation_ideal.py\nperson_sensitivity_length_scaled_ideal.py\nrandom_vs_designed_exemplar_contrast.hypothesis.md\nrandom_vs_designed_exemplar_contrast.py\nrun_length_profile_typicality.hypothesis.md\nrun_length_profile_typicality.py\nstreak_aware_balanced_alternation_ideal.hypothesis.md\nstreak_aware_balanced_alternation_ideal.py\nswitching_then_balance_semiorder.hypothesis.md\nswitching_then_balance_semiorder.py\ntally_excursion_triplet_alternation_ideal.hypothesis.md\ntally_excursion_triplet_alter