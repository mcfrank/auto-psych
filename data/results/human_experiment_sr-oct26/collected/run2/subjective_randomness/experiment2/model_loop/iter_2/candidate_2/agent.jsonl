. Each person also has a small left/right\nresponse bias.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(sens * (dist_b - dist_a) + side[participant_id]))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nHTTHHTTH,THTHTHHH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n5121 responses.csv","is_error":false}]},"parent_tool_use_id":null,"session_id":"d7859ced-a4a6-4aeb-8fc4-3881ae0a88ca","uuid":"7bb76482-8916-481c-8cf6-999c7507e434","timestamp":"2026-10-03T12:22:26.187Z","tool_use_result":{"stdout":"balance_aware_heads_alternation_ideal.hypothesis.md\nbalance_aware_heads_alternation_ideal.py\nbalanced_heads_default_alternation_ideal.hypothesis.md\nbalanced_heads_default_alternation_ideal.py\nbalanced_heads_lapse_ideal_streak.hypothesis.md\nbalanced_heads_lapse_ideal_streak.py\nbayes_rigged_coin_with_two_flip_memory.hypothesis.md\nbayes_rigged_coin_with_two_flip_memory.py\ngist_typicality_count_runs.hypothesis.md\ngist_typicality_count_runs.py\ngraded_periodicity_personal_ideal.py\nheads_default_alternation_ideal.py\nheads_favoring_lapse_ideal_streak.py\niter0_candidate0.hypothesis.md\niter0_candidate0.py\niter1_candidate4.hypothesis.md\niter1_candidate4.py\nlength_scaled_alternation_ideal.py\nmax_lopsided_window_surprise.hypothesis.md\nmax_lopsided_window_surprise.py\nmodels_manifest.yaml\nperiodic_penalized_alternation_ideal.py\npersonal_ideal_with_personal_lapse.py\npersonal_lapse_ideal_streak_excess.py\npersonal_side_bias_alternation_ideal.hypothesis.md\npersonal_side_bias_alternation_ideal.py\nperson_sensitivity_length_scaled_ideal.py\nstreak_aware_balanced_alternation_ideal.hypothesis.md\nstreak_aware_balanced_alternation_ideal.py\nswitching_then_balance_semiorder.hypothesis.md\nswitching_then_balance_semiorder.py\ntally_span_personal_ideal.hypothesis.m