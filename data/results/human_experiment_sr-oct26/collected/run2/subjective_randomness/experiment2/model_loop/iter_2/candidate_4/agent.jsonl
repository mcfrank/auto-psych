s * (dist_b - dist_a) + side[participant_id]))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
