_mu = pm.Normal(\"lean_mu\", 0.0, 0.5)\n    lean_sigma = pm.HalfNormal(\"lean_sigma\", 0.3)\n    lean_z = pm.Normal(\"lean_z\", 0.0, 1.0, shape=400)\n    lean = lean_mu + lean_sigma * lean_z\n\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(lp_diff + lean[participant_id]))\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\ncat > /tmp/fit_test.py << 'EOF'\nimport sys, csv, importlib.util, numpy as np, pymc as pm, arviz as az\nD=sys.argv[1]; R=sys.argv[2]\nspec=importlib.util.spec_from_file_location(\"c\", D+\"/candidate.py\"); m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\nrows=list(csv.DictReader(open(R)))\nfeats=[m.compute_features(r[\"sequence_a\"],r[\"sequence_b\"]) for r in rows]\ndata={k:np.array([f[k] for f in feats]) for k in feats[0]}\ndata[\"participant_id\"]=np.array([int(r[\"participant_id\"]) for r in rows])\ndata[\"chose_left\"]=np.array([int(r[\"chose_left\"]) for r in rows])\nwith m.model:\n    pm.set_data(data)\n    idata=pm.sample(1000,tune=1000,chains=4,cores=1,progressbar=False,random_seed=1)\nprint(\"div\",int(idata.sample_stats.diverging.sum()))\ns=az.summary(idata,var_names=[\"logit_c\",\"logit_a\",\"logit_b\",\"lean_mu\",\"lean_sigma\"]); print(s)\nprint(\"min ess\", float(az.ess(idata,var_names=[\"~p_left\"]).to_array().min()))\nEOF\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run2/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses $D/../../responses.csv 2>&1 | tail -3\n/scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python /tmp/fit_test.py $D $D/../../responses.csv 2>&1 | grep -v -i warn | tail -12","uuid":"b41ad797-e34c-4a7c-9a20-0703a4325e90","session_id":"93416006-ffb5-44a2-b617-99b1e4e5ed44"}
