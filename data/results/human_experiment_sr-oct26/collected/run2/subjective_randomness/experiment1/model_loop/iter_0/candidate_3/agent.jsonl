balance_b + alt_weight * irregularity_b)\n\n    p_left = pm.Deterministic(\n        \"p_left\",\n        pm.math.sigmoid(beta * (score_a - score_b) + side_bias),\n    )\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n\n\n'''\ni=src.index(\"LOCAL_WINDOW = 4\")\nopen(D+\"/candidate.py\",\"w\").write(head+src[i:])\nPY\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run2/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses $D/../../responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"e276cf0b-804d-4d03-ba6b-8759f08ce309","session_id":"185e5969-de5c-4817-825c-0e02d4a1425a"}
