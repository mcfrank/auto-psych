{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y3hzpjXqo8LfU9z2QU2rrt","type":"tool_result","content":"\"\"\"Length-scaled personal alternation ideal with person-specific sensitivity.\n\nRefinement of `length_scaled_alternation_ideal`: each person judges a sequence\nas random by how close its proportion of H/T switches is to their own ideal\nswitching rate (sensitivity scaled as a fitted power of the number of\ntransitions), with a shared penalty for visibly periodic sequences. The single\nchange: the sensitivity to the distance from the ideal is person-specific,\ndrawn from a log-normal population distribution, so people differ in how\ndecisively they act on their impression as well as in their ideal.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def alternation_rate(seq):\n        switches = sum(1 for x, y in zip(seq, seq[1:]) if x != y)\n        return switches / (len(seq) - 1)\n\n    def periodic(seq):\n        n = len(seq)\n        for p in range(1, n // 2 + 1):\n            if all(seq[i] == seq[i + p] for i in range(n - p)):\n                return 1.0\n        return 0.0\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"alt_rate_a\": alternation_rate(a),\n        \"alt_rate_b\": alternation_rate(b),\n        \"periodic_a\": periodic(a),\n        \"periodic_b\": periodic(b),\n        \"log_trans\": float(np.log((len(a) - 1) / 5.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    alt_a = pm.Data(\"alt_rate_a\", np.zeros(1, dtype=\"float64\"))\n    alt_b = pm.Data(\"alt_rate_b\", np.zeros(1, dtype=\"float64\"))\n    per_a = pm.Data(\"periodic_a\", np.zeros(1, dtype=\"float64\"))\n    per_b = pm.Data(\"periodic_b\", np.zeros(1, dtype=\"float64\"))\n    log_trans = pm.Data(\"log_trans\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Population distribution of personal ideal switching rates (logit scale).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Population distribution of personal sensitivities (log scale, at 5 transitions).\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=1.5, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n\n    # Power-law exponent: how sensitivity scales with number of transitions.\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n    # Shared penalty for a visibly periodic sequence (positive: less random).\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n\n    theta = ideal[participant_id]\n    dist_a = (alt_a - theta) ** 2\n    dist_b = (alt_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_trans)\n    score = sens * (dist_b - dist_a) + gamma * (per_b - per_a)\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(score))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nHTTHHTTH,THTHTHHH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\nHTTTTTTT,HTHTHTHT,0,3,0\r\nHTHHTHHT,HHHHTTTT,0,4,1\r\n2561 responses.csv\nbayes_pattern_vs_alternating_coin.hypothesis.md\nbayes_pattern_vs_alternating_coin.py\nbest_lag_copy_rule_detector.hypothesis.md\nbest_lag_copy_rule_detector.py\ncontext_learner_surprise.hypothesis.md\ncontext_learner_surprise.py\nexemplar_designed_pattern_similarity.hypothesis.md\nexemplar_designed_pattern_similarity.py\nfalk_konold_dp.py\nfinite_experience_occurrence.py\ngamblers_fallacy_fading_memory.hypothesis.md\ngamblers_fallacy_fading_memory.py\nlength_scaled_alternation_ideal.hypothesis.md\nlength_scaled_alternation_ideal.py\nlength_scaled_alternation_ideal_streak.hypothesis.md\nlength_scaled_alternation_ideal_streak.py\nlocal_representativeness.py\nlocal_window_alternation_ideal.hypothesis.md\nlocal_window_alternation_ideal.py\nmodels_manifest.yaml\nmost_salient_regular_stretch.hypothesis.md\nmost_salient_regular_stretch.py\nmotif_stack_person_alternation.hypothesis.md\nmotif_stack_person_alternation.py\nmotif_stack.py\npair_normalized_alternation_contrast.hypothesis.md\npair_normalized_alternation_contrast.py\nperiodic_ideal_absolute_streak_penalty.hypothesis.md\nperiodic_ideal_absolute_streak_penalty.py\nperiodic_penalized_alternation_ideal.hypothesis.md\nperiodic_penalized_alternation_ideal.py\npersonal_alternation_ideal.hypothesis.md\npersonal_alternation_ideal.py\npersonal_alternation_ideal_streak_penalty.hypothesis.md\npersonal_alternation_ideal_streak_penalty.py\npersonal_ideal_with_personal_lapse.hypothesis.md\npersonal_ideal_with_personal_lapse.py\npersonal_lapse_ideal_streak_excess.hypothesis.md\npersonal_lapse_ideal_streak_excess.py\npersonal_markov_coin_belief.hypothesis.md\npersonal_markov_coin_belief.py\nperson_alternation_prototype.hypothesis.md\nperson_alternation_prototype.py\nperson_sensitivity_length_scaled_ideal.hypothesis.md\nperson_sensitivity_length_scaled_ideal.py\nperson_specific_alternation_prototype.hypothesis.md\nperson_specific_alternation_prototype.py\nposition_weighted_switch_impression.hypothesis.md\nposition_weighted_switch_impression.py\nrunning_tally_drift_ideal.hypothesis.md\nrunning_tally_drift_ideal.py\nstreak_penalized_personal_prototype.hypothesis.md\nstreak_penalized_personal_prototype.py\niter_0/critique:\nagent.jsonl\nCRITIQUE_CONTEXT.md\ncritiques.md\nppc_results.json\nscratch\ntest_stats\n\niter_1/critique:\nagent.jsonl\nCRITIQUE_CONTEXT.md\ncritiques.md\nppc_results.json\nscratch\ntest