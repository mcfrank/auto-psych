, mu=0.0, sigma=1.0, shape=(N_SLOTS, 6))\n    zp = z[participant_id]\n\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n    # Shared reward on chunk variety and penalty on rule-built sequences.\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=1.0)\n    # The change: shared reward on the variety of run lengths.\n    eta = pm.Normal(\"eta\", mu=0.0, sigma=1.0)\n\n    theta = pm.math.sigmoid(mu_ideal + sigma_ideal * zp[:, 0])\n    sens = pm.math.exp(mu_log_beta + sigma_log_beta * zp[:, 1] + lam * log_len)\n    sw_p = pm.math.sigmoid(mu_sw + sigma_sw * zp[:, 2])\n    kappa = mu_kappa + sigma_kappa * zp[:, 3]\n    pat = pm.math.exp(sigma_pat * zp[:, 4])\n    side = sigma_side * zp[:, 5]\n\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sw_dist = (sw_b - sw_p) ** 2 - (sw_a - sw_p) ** 2\n    logit = (\n        sens * (dist_b - dist_a)\n        + 4.0 * kappa * sw_dist\n        + pat * (gamma * trip_diff - rho * rule_diff)\n        + eta * runvar_diff\n        + side\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run2/repo\n/scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -c \"\nimport sys;sys.path.insert(0,'$C');import candidate as c\nD='/scratch/users/kushinm/auto-psych/outer_loop_live/run2/data/subjective_randomness/experiment3/model_loop/responses.csv'\nimport csv,numpy as np;r=list(csv.DictReader(open(D)))\nd=np.array([c.compute_features(x['sequence_a'],x['sequence_b'])['runvar_diff'] for x in r]);print((d!=0).mean(),np.unique(d))\nfor s in ['HHTTHHTT','HTHHHTTH','HTHTHTHT','HHHHTHHT']: print(s,c.compute_features(s,s)['runvar_diff'])\n\" 2>&1 | tail -6","uuid":"273de03f-14b0-44a9-9ed4-9677fc1612e5","session_id":"ba583503-b00e-4610-bef9-99cc91309314"}
