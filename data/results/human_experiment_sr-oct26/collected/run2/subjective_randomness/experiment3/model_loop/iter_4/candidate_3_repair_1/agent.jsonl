articipant_id]\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n======\n\"\"\"Terminal-streak recency penalty on the person-specific switch-ideal rule-built judgement.\n\nRefinement of `person_switch_ideal_pattern_rule_built`: tally span judged against\na personal expected span, switching by closeness to a personal ideal switching\nrate, chunk variety and a rule-built penalty scaled by a personal pattern\nsensitivity, and a personal left/right lean. The one change: people weigh the\nflips they read last, so a sequence that ends on a streak looks less random —\nevery flip of the final run beyond the first counts against it (a shared\nterminal-streak penalty). Among equal-switch pairs people pick the sequence\nthat ends with a switch.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    def triplet_variety(seq):\n        n_windows = len(seq) - 2\n        if n_windows < 1:\n            return 0.0\n        distinct = len({seq[i:i + 3] for i in range(n_windows)})\n        return distinct / min(8, n_windows)\n\n    def rule_built(seq):\n        # A unit of two or more flips repeated at least twice, or a sequence\n        # equal to its own reversed complement.\n        n = len(seq)\n        if len(set(seq)) < 2:\n            return 0.0\n        for p in range(2, n // 2 + 1):\n            if all(seq[i] == seq[i + p] for i in range(n - p)):\n                return 1.0\n        swapped = seq.translate(str.maketrans(\"HT\", \"TH\")