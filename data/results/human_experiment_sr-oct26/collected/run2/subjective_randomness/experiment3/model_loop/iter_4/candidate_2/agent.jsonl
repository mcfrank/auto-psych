{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LjeK2wbDyzJKNnqdYGbfU9","type":"tool_result","content":"feature_space_random_designed_exemplars.hypothesis.md\nfeature_space_random_designed_exemplars.py\nfirst_read_anchored_departure.hypothesis.md\nfirst_read_anchored_departure.py\ngist_typicality_subjective_switch_coin.hypothesis.md\ngist_typicality_subjective_switch_coin.py\ngraded_near_periodicity_tally_switch.hypothesis.md\ngraded_near_periodicity_tally_switch.py\nheavy_tailed_choice_noise_tally_switch.hypothesis.md\nheavy_tailed_choice_noise_tally_switch.py\niter0_candidate4.hypothesis.md\niter0_candidate4.py\nmemory_span_limited_comparison.hypothesis.md\nmemory_span_limited_comparison.py\nmodels_manifest.yaml\npair_normalized_tally_switch_contrast.py\npersonal_engagement_lapse_tally_switch.hypothesis.md\npersonal_engagement_lapse_tally_switch.py\npersonal_switch_ideal_rule_built_tally.hypothesis.md\npersonal_switch_ideal_rule_built_tally.py\nperson_decisiveness_rule_built_tally.hypothesis.md\nperson_decisiveness_rule_built_tally.py\nperson_decisiveness_tally_switch_triplet.hypothesis.md\nperson_decisiveness_tally_switch_triplet.py\nperson_pattern_sensitivity_rule_built.hypothesis.md\nperson_pattern_sensitivity_rule_built.py\nperson_switch_ideal_pattern_rule_built.hypothesis.md\nperson_switch_ideal_pattern_rule_built.py\nrule_built_tally_switch_triplet.hypothesis.md\nrule_built_tally_switch_triplet.py\nshared_impression_personal_decisiveness.hypothesis.md\nshared_impression_personal_decisiveness.py\nshared_indifference_band_tally_switch.hypothesis.md\nshared_indifference_band_tally_switch.py\nshared_judgement_personal_engagement.hypothesis.md\nshared_judgement_personal_engagement.py\nstreak_excess_pattern_rule_built.hypothesis.md\nstreak_excess_pattern_rule_built.py\ntally_restoring_force_coin.hypothesis.md\ntally_restoring_force_coin.py\ntally_span_switch_ideal_periodic_unit_2.py\ntally_span_switch_ideal_periodic_unit.py\ntally_span_switch_ideal_triplet_variety.py\ntally_span_switch_rate_ideal_2.py\nterminal_run_pattern_rule_built.hypothesis.md\nterminal_run_pattern_rule_built.py\nterminal_streak_recency_pattern_rule.hypothesis.md\nterminal_streak_recency_pattern_rule.py\nworst_window_switch_deviation.hypothesis.md\nworst_window_switch_deviation.py\n7681 responses.csv\n\"\"\"Terminal-streak recency penalty on the person-specific switch-ideal rule-built judgement.\n\nRefinement of `person_switch_ideal_pattern_rule_built`: tally span judged against\na personal expected span, switching by closeness to a personal ideal switching\nrate, chunk variety and a rule-built penalty scaled by a personal pattern\nsensitivity, and a personal left/right lean. The one change: people weigh the\nflips they read last, so a sequence that ends on a streak looks less random —\nevery flip of the final run beyond the first counts against it (a shared\nterminal-streak penalty). Among equal-switch pairs people pick the sequence\nthat ends with a switch.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    def triplet_variety(seq):\n        n_windows = len(seq) - 2\n        if n_windows < 1:\n            return 0.0\n        distinct = len({seq[i:i + 3] for i in range(n_windows)})\n        return distinct / min(8, n_windows)\n\n    def rule_built(seq):\n        # A unit of two or more flips repeated at least twice, or a sequence\n        # equal to its own reversed complement.\n        n = len(seq)\n        if len(set(seq)) < 2:\n            return 0.0\n        for p in range(2, n // 2 + 1):\n            if all(seq[i] == seq[i + p] for i in range(n - p)):\n                return 1.0\n        swapped = seq.translate(str.maketrans(\"HT\", \"TH\"))\n        return 1.0 if seq == swapped[::-1] else 0.0\n\n    def terminal_excess(seq):\n        # Flips of the final run beyond the first (0 when it ends on a switch).\n        k = 1\n        while k < len(seq) and seq[-1 - k] == seq[-1]:\n            k += 1\n        return float(k - 1)\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"sw_a\": switch_rate(a),\n        \"sw_b\": switch_rate(b),\n        \"trip_diff\": triplet_variety(a) - triplet_variety(b),\n        \"rule_diff\": rule_built(a) - rule_built(b),\n        \"term_diff\": terminal_excess(a) - terminal_excess(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    sw_a = pm.Data(\"sw_a\", np.zeros(1, dtype=\"float64\"))\n    sw_b = pm.Data(\"sw_b\", np.zeros(1, dtype=\"float64\"))\n    trip_diff = pm.Data(\"trip_diff\", np.zeros(1, dtype=\"float64\"))\n    rule_diff = pm.Data(\"rule_diff\", np.zeros(1, dtype=\"float64\"))\n    term_diff = pm.Data(\"term_diff\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # Switching judged by closeness to a shared ideal rate, person-specific weight.\n    # The change: person-specific ideal switching rate (logit scale, non-centred).\n    mu_sw = pm.Normal(\"mu_sw\", mu=0.4, sigma=0.7)\n    sigma_sw = pm.HalfNormal(\"sigma_sw\", sigma=0.7)\n    z_sw = pm.Normal(\"z_sw\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    sw_ideal = pm.math.sigmoid(mu_sw + sigma_sw * z_sw)\n    mu_kappa = pm.Normal(\"mu_kappa\", mu=0.0, sigma=1.5)\n    sigma_kappa = pm.HalfNormal(\"sigma_kappa\", sigma=1.0)\n    z_kappa = pm.Normal(\"z_kappa\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    kappa = mu_kappa + sigma_kappa * z_kappa\n\n    # Shared reward on the share of distinct three-flip chunks.\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n\n    # Shared penalty on a rule-built (copied or anti-symmetric) sequence.\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=1.0)\n\n    # Person-specific pattern sensitivity scaling both structural cues\n    # (median 1, so gamma and rho remain the typical person's weights).\n    sigma_pat = pm.HalfNormal(\"sigma_pat\", sigma=0.7)\n    z_pat = pm.Normal(\"z_pat\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    pat = pm.math.exp(sigma_pat * z_pat)\n\n    # The change: shared penalty per flip of the final run beyond the first.\n    tau = pm.Normal(\"tau\", mu=0.0, sigma=1.0)\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    sw_p = sw_ideal[participant_id]\n    sw_dist = (sw_b - sw_p) ** 2 - (sw_a - sw_p) ** 2\n    logit = (\n        sens * (dist_b - dist_a)\n        + 4.0 * kappa[participant_id] * sw_dist\n        + pat[participant_id] * (gamma * trip_diff - rho * rule_diff)\n        - tau * term_diff\n        + side[participant_id]\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)","is_error":false}]},"parent_tool_use_id":null,"session_id":"7ffcf238-91d1-4f12-ba72-3238a3e8c8e2","uuid":"a98c093c-cd9e-4e27-9344-ee7ecc0b41d2","timestamp":"2026-10-04T09:42:50.485Z","tool_use_result":{"stdout":"feature_space_random_designed_exemplars.hypothesis.md\nfeature_space_random_designed_exemplars.py\nfirst_read_anchored_departure.hypothesis.md\nfirst_read_anchored_departure.py\ngist_typicality_subjective_switch_coin.hypothesis.md\ngist_typicality_subjective_switch_coin.py\ngraded_near_periodicity_tally_switch.hypothesis.md\ngraded_near_periodicity_tally_switch.py\nheavy_tailed_choice_noise_tally_switch.hypothesis.md\nheavy_tailed_choice_noise_tally_switch.py\niter0_candidate4.hypothesis.md\niter0_candidate4.py\nmemory_span_limited_comparison.hypothesis.md\nmemory_span_limited_comparison.py\nmodels_manifest.yaml\npair_normalized_tally_switch_contrast.py\npersonal_engagement_lapse_tally_switch.hypothesis.md\npersonal_engagement_lapse_tally_switch.py\npersonal_switch_ideal_rule_built_tally.hypothesis.md\npersonal_switch_ideal_rule_built_tally.py\nperson_decisiveness_rule_built_tally.hypothesis.md\nperson_decisiveness_rule_built_tally.py\nperson_decisiveness_tally_switch_triplet.hypothesis.md\nperson_decisiveness_tally_switch_triplet.py\nperson_pattern_sensitivity_rule_built.hypothesis.md\nperson_pattern_sensitivity_rule_built.py\nperson_switch_ideal_pattern_rule_built.hypothesis.md\npe