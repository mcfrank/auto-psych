{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016wcRD6CdRLJq3moPsN8ons","type":"tool_result","content":"feature_space_random_designed_exemplars.hypothesis.md\nfeature_space_random_designed_exemplars.py\ngraded_near_periodicity_tally_switch.hypothesis.md\ngraded_near_periodicity_tally_switch.py\niter0_candidate4.hypothesis.md\niter0_candidate4.py\nmodels_manifest.yaml\npair_normalized_tally_switch_contrast.py\npersonal_engagement_lapse_tally_switch.hypothesis.md\npersonal_engagement_lapse_tally_switch.py\nperson_decisiveness_rule_built_tally.hypothesis.md\nperson_decisiveness_rule_built_tally.py\nperson_decisiveness_tally_switch_triplet.hypothesis.md\nperson_decisiveness_tally_switch_triplet.py\nperson_pattern_sensitivity_rule_built.hypothesis.md\nperson_pattern_sensitivity_rule_built.py\nrule_built_tally_switch_triplet.hypothesis.md\nrule_built_tally_switch_triplet.py\nshared_impression_personal_decisiveness.hypothesis.md\nshared_impression_personal_decisiveness.py\nshared_indifference_band_tally_switch.hypothesis.md\nshared_indifference_band_tally_switch.py\nshared_judgement_personal_engagement.hypothesis.md\nshared_judgement_personal_engagement.py\ntally_restoring_force_coin.hypothesis.md\ntally_restoring_force_coin.py\ntally_span_switch_ideal_periodic_unit_2.py\ntally_span_switch_ideal_periodic_unit.py\ntally_span_switch_ideal_triplet_variety.py\ntally_span_switch_rate_ideal_2.py\n\"\"\"Rule-built tally/switch/triplet judgement with person-specific pattern sensitivity.\n\nRefinement of `rule_built_tally_switch_triplet`: people keep a running\nheads-minus-tails tally and judge a sequence random by how close its span is\nto their own expected span (person-specific, length-scaled sensitivity,\npersonal left/right lean), judge switching by closeness to an ideal switching\nrate (person-specific weight), reward variety of three-flip chunks and\npenalise sequences built by a copying or mirror rule. The one change: people\ndiffer in how much they attend to pattern structure -- a single person-specific\ngain scales both structural cues (chunk variety and the rule-built penalty).\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    def triplet_variety(seq):\n        n_windows = len(seq) - 2\n        if n_windows < 1:\n            return 0.0\n        distinct = len({seq[i:i + 3] for i in range(n_windows)})\n        return distinct / min(8, n_windows)\n\n    def rule_built(seq):\n        # A unit of two or more flips repeated at least twice, or a sequence\n        # equal to its own reversed complement.\n        n = len(seq)\n        if len(set(seq)) < 2:\n            return 0.0\n        for p in range(2, n // 2 + 1):\n            if all(seq[i] == seq[i + p] for i in range(n - p)):\n                return 1.0\n        swapped = seq.translate(str.maketrans(\"HT\", \"TH\"))\n        return 1.0 if seq == swapped[::-1] else 0.0\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"sw_a\": switch_rate(a),\n        \"sw_b\": switch_rate(b),\n        \"trip_diff\": triplet_variety(a) - triplet_variety(b),\n        \"rule_diff\": rule_built(a) - rule_built(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    sw_a = pm.Data(\"sw_a\", np.zeros(1, dtype=\"float64\"))\n    sw_b = pm.Data(\"sw_b\", np.zeros(1, dtype=\"float64\"))\n    trip_diff = pm.Data(\"trip_diff\", np.zeros(1, dtype=\"float64\"))\n    rule_diff = pm.Data(\"rule_diff\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # Switching judged by closeness to a shared ideal rate, person-specific weight.\n    sw_ideal = pm.Beta(\"sw_ideal\", alpha=6.0, beta=4.0)\n    mu_kappa = pm.Normal(\"mu_kappa\", mu=0.0, sigma=1.5)\n    sigma_kappa = pm.HalfNormal(\"sigma_kappa\", sigma=1.0)\n    z_kappa = pm.Normal(\"z_kappa\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    kappa = mu_kappa + sigma_kappa * z_kappa\n\n    # Shared reward on the share of distinct three-flip chunks.\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n\n    # The change: shared penalty on a rule-built (copied or anti-symmetric) sequence.\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=1.0)\n\n    # The change: person-specific pattern sensitivity scaling both structural cues\n    # (median 1, so gamma and rho remain the typical person's weights).\n    sigma_pat = pm.HalfNormal(\"sigma_pat\", sigma=0.7)\n    z_pat = pm.Normal(\"z_pat\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    pat = pm.math.exp(sigma_pat * z_pat)\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    sw_dist = (sw_b - sw_ideal) ** 2 - (sw_a - sw_ideal) ** 2\n    logit = (\n        sens * (dist_b - dist_a)\n        + 4.0 * kappa[participant_id] * sw_dist\n        + pat[participant_id] * (gamma * trip_diff - rho * rule_diff)\n        + side[participant_id]\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nsequence_a,sequence_b,participant_id,trial_index,chose_left\r\nHTTHHTTH,THTHTHHH,0,1,1\r\nHTHTTHTH,HTHHHHHT,0,2,1\r\n7681 responses.csv","is_error":false}]},"parent_tool_use_id":null,"session_id":"14a33179-a212-40a6-9de1-2c7ea5b431d0","uuid":"8c651e62-3e9a-403b-a3d5-bfbd94bb58f5","timestamp":"2026-10-04T02:42:52.594Z","tool_use_result":{"stdout":"feature_space_random_designed_exemplars.hypothesis.md\nfeature_space_random_designed_exemplars.py\ngraded_near_periodicity_tally_switch.hypothesis.md\ngraded_near_periodicity_tally_switch.py\niter0_candidate4.hypothesis.md\niter0_candidate4.py\nmodels_manifest.yaml\npair_normalized_tally_switch_contrast.py\npersonal_engagement_lapse_tally_switch.hypothesis.md\npersonal_engagement_lapse_tally_switch.py\nperson_decisiveness_rule_built_tally.hypothesis.md\nperson_decisiveness_rule_built_tally.py\nperson_decisiveness_tally_switch_triplet.hypothesis.md\nperson_decisiveness_tally_switch_triplet.py\nperson_pattern_sensitivity_rule_built.hypothesis.md\nperson_pattern_sensitivity_rule_built.py\nrule_built_tally_switch_triplet.hy