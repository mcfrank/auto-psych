{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017mNB9rZZ1gcCZ3ycBMD4t7","type":"tool_result","content":"1\t\"\"\"Person-specific ideal switching rate in the rule-built tally/switch/triplet judgement.\n2\t\n3\tRefinement of `person_pattern_sensitivity_rule_built`: people keep a running\n4\theads-minus-tails tally and judge a sequence random by how close its span is\n5\tto their own expected span (person-specific, length-scaled sensitivity,\n6\tpersonal left/right lean), judge switching by closeness to an ideal switching\n7\trate (person-specific weight), and weigh chunk variety and a rule-built\n8\tpenalty by a personal pattern sensitivity. The one change: each person holds\n9\ttheir own ideal switching rate, drawn from a population distribution, rather\n10\tthan one rate shared by everyone, so people split in opposite directions on\n11\tpairs that differ mainly in switching.\n12\t\"\"\"\n13\timport numpy as np\n14\timport pymc as pm\n15\t\n16\t\n17\tdef compute_features(sequence_a, sequence_b):\n18\t    def span_share(seq):\n19\t        tally, hi, lo = 0, 0, 0\n20\t        for c in seq:\n21\t            tally += 1 if c == \"H\" else -1\n22\t            hi = max(hi, tally)\n23\t            lo = min(lo, tally)\n24\t        return (hi - lo) / len(seq)\n25\t\n26\t    def switch_rate(seq):\n27\t        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n28\t\n29\t    def triplet_variety(seq):\n30\t        n_windows = len(seq) - 2\n31\t        if n_windows < 1:\n32\t            return 0.0\n33\t        distinct = len({seq[i:i + 3] for i in range(n_windows)})\n34\t        return distinct / min(8, n_windows)\n35\t\n36\t    def rule_built(seq):\n37\t        # A unit of two or more flips repeated at least twice, or a sequence\n38\t        # equal to its own reversed complement.\n39\t        n = len(seq)\n40\t        if len(set(seq)) < 2:\n41\t            return 0.0\n42\t        for p in range(2, n // 2 + 1):\n43\t            if all(seq[i] == seq[i + p] for i in range(n - p)):\n44\t                return 1.0\n45\t        swapped = seq.translate(str.maketrans(\"HT\", \"TH\"))\n46\t        return 1.0 if seq == swapped[::-1] else 0.0\n47\t\n48\t    a = sequence_a.strip().upper()\n49\t    b = sequence_b.strip().upper()\n50\t    return {\n51\t        \"span_a\": span_share(a),\n52\t        \"span_b\": span_share(b),\n53\t        \"sw_a\": switch_rate(a),\n54\t        \"sw_b\": switch_rate(b),\n55\t        \"trip_diff\": triplet_variety(a) - triplet_variety(b),\n56\t        \"rule_diff\": rule_built(a) - rule_built(b),\n57\t        \"log_len\": float(np.log(len(a) / 6.0)),\n58\t    }\n59\t\n60\t\n61\tN_SLOTS = 400\n62\t\n63\twith pm.Model() as model:\n64\t    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n65\t    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n66\t    sw_a = pm.Data(\"sw_a\", np.zeros(1, dtype=\"float64\"))\n67\t    sw_b = pm.Data(\"sw_b\", np.zeros(1, dtype=\"float64\"))\n68\t    trip_diff = pm.Data(\"trip_diff\", np.zeros(1, dtype=\"float64\"))\n69\t    rule_diff = pm.Data(\"rule_diff\", np.zeros(1, dtype=\"float64\"))\n70\t    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n71\t    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n72\t\n73\t    # Person-specific expected tally span (share of the length), in (0, 1).\n74\t    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n75\t    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n76\t    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n77\t    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n78\t\n79\t    # Person-specific sensitivity, scaled by a power of the length.\n80\t    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n81\t    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n82\t    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n83\t    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n84\t    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n85\t\n86\t    # Switching judged by closeness to a shared ideal rate, person-specific weight.\n87\t    # The change: person-specific ideal switching rate (logit scale, non-centred).\n88\t    mu_sw = pm.Normal(\"mu_sw\", mu=0.4, sigma=0.7)\n89\t    sigma_sw = pm.HalfNormal(\"sigma_sw\", sigma=0.7)\n90\t    z_sw = pm.Normal(\"z_sw\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n91\t    sw_ideal = pm.math.sigmoid(mu_sw + sigma_sw * z_sw)\n92\t    mu_kappa = pm.Normal(\"mu_kappa\", mu=0.0, sigma=1.5)\n93\t    sigma_kappa = pm.HalfNormal(\"sigma_kappa\", sigma=1.0)\n94\t    z_kappa = pm.Normal(\"z_kappa\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n95\t    kappa = mu_kappa + sigma_kappa * z_kappa\n96\t\n97\t    # Shared reward on the share of distinct three-flip chunks.\n98\t    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n99\t\n100\t    # Shared penalty on a rule-built (copied or anti-symmetric) sequence.\n101\t    rho = pm.Normal(\"rho\", mu=0.0, sigma=1.0)\n102\t\n103\t    # Person-specific pattern sensitivity scaling both structural cues\n104\t    # (median 1, so gamma and rho remain the typical person's weights).\n105\t    sigma_pat = pm.HalfNormal(\"sigma_pat\", sigma=0.7)\n106\t    z_pat = pm.Normal(\"z_pat\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n107\t    pat = pm.math.exp(sigma_pat * z_pat)\n108\t\n109\t    # Person-specific left/right response bias (decision stage, not a cue).\n110\t    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n111\t    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n112\t    side = sigma_side * z_side\n113\t\n114\t    theta = ideal[participant_id]\n115\t    dist_a = (span_a - theta) ** 2\n116\t    dist_b = (span_b - theta) ** 2\n117\t    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n118\t    sw_p = sw_ideal[participant_id]\n119\t    sw_dist = (sw_b - sw_p) ** 2 - (sw_a - sw_p) ** 2\n120\t    logit = (\n121\t        sens * (dist_b - dist_a)\n122\t        + 4.0 * kappa[participant_id] * sw_dist\n123\t        + pat[participant_id] * (gamma * trip_diff - rho * rule_diff)\n124\t        + side[participant_id]\n125\t    )\n126\t    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n127\t\n128\t    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n129\t    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n130\t"}]},"parent_tool_use_id":null,"session_id":"0c9adce5-c991-4d77-bece-3c4de9080420","uuid":"c8f92a2a-6c3d-47e9-8338-abd05b2e556d","timestamp":"2026-10-04T06:01:10.990Z","tool_use_result":{"type":"text","file":{"filePath":"/scratch/users/kushinm/auto-psych/outer_loop_live/run2/data/subjective_randomness/experiment3/model_loop/models/person_switch_ideal_pattern_rule_built.py","content":"\"\"\"Person-specific ideal switching rate in the rule-built tally/switch/triplet judgement.\n\nRefinement of `person_pattern_sensitivity_rule_built`: people keep a running\nheads-minus-tails tally and judge a sequence random by how close its span is\nto their own expected span (person-specific, length-scaled sensitivity,\npersonal left/right lean), judge switching by closeness to an ideal switching\nrate (person-specific weight), and weigh chunk variety and a rule-built\npenalty by a personal pattern sensitivity. The one change: each person holds\ntheir own ideal switching rate, drawn from a population distribution, rather\nthan one rate shared by everyone, so people split in opposite directions on\npairs that differ mainly in switching.\n\"\"\"\nimport numpy as np\nimport pymc as pm\n\n\ndef compute_features(sequence_a, sequence_b):\n    def span_share(seq):\n        tally, hi, lo = 0, 0, 0\n        for c in seq:\n            tally += 1 if c == \"H\" else -1\n            hi = max(hi, tally)\n            lo = min(lo, tally)\n        return (hi - lo) / len(seq)\n\n    def switch_rate(seq):\n        return sum(1 for x, y in zip(seq, seq[1:]) if x != y) / (len(seq) - 1)\n\n    def triplet_variety(seq):\n        n_windows = len(seq) - 2\n        if n_windows < 1:\n            return 0.0\n        distinct = len({seq[i:i + 3] for i in range(n_windows)})\n        return distinct / min(8, n_windows)\n\n    def rule_built(seq):\n        # A unit of two or more flips repeated at least twice, or a sequence\n        # equal to its own reversed complement.\n        n = len(seq)\n        if len(set(seq)) < 2:\n            return 0.0\n        for p in range(2, n // 2 + 1):\n            if all(seq[i] == seq[i + p] for i in range(n - p)):\n                return 1.0\n        swapped = seq.translate(str.maketrans(\"HT\", \"TH\"))\n        return 1.0 if seq == swapped[::-1] else 0.0\n\n    a = sequence_a.strip().upper()\n    b = sequence_b.strip().upper()\n    return {\n        \"span_a\": span_share(a),\n        \"span_b\": span_share(b),\n        \"sw_a\": switch_rate(a),\n        \"sw_b\": switch_rate(b),\n        \"trip_diff\": triplet_variety(a) - triplet_variety(b),\n        \"rule_diff\": rule_built(a) - rule_built(b),\n        \"log_len\": float(np.log(len(a) / 6.0)),\n    }\n\n\nN_SLOTS = 400\n\nwith pm.Model() as model:\n    span_a = pm.Data(\"span_a\", np.zeros(1, dtype=\"float64\"))\n    span_b = pm.Data(\"span_b\", np.zeros(1, dtype=\"float64\"))\n    sw_a = pm.Data(\"sw_a\", np.zeros(1, dtype=\"float64\"))\n    sw_b = pm.Data(\"sw_b\", np.zeros(1, dtype=\"float64\"))\n    trip_diff = pm.Data(\"trip_diff\", np.zeros(1, dtype=\"float64\"))\n    rule_diff = pm.Data(\"rule_diff\", np.zeros(1, dtype=\"float64\"))\n    log_len = pm.Data(\"log_len\", np.zeros(1, dtype=\"float64\"))\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    # Person-specific expected tally span (share of the length), in (0, 1).\n    mu_ideal = pm.Normal(\"mu_ideal\", mu=-0.5, sigma=1.0)\n    sigma_ideal = pm.HalfNormal(\"sigma_ideal\", sigma=1.0)\n    z_ideal = pm.Normal(\"z_ideal\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    ideal = pm.Deterministic(\"ideal\", pm.math.sigmoid(mu_ideal + sigma_ideal * z_ideal))\n\n    # Person-specific sensitivity, scaled by a power of the length.\n    mu_log_beta = pm.Normal(\"mu_log_beta\", mu=2.0, sigma=1.5)\n    sigma_log_beta = pm.HalfNormal(\"sigma_log_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    beta = pm.Deterministic(\"beta\", pm.math.exp(mu_log_beta + sigma_log_beta * z_beta))\n    lam = pm.Normal(\"lam\", mu=0.0, sigma=1.0)\n\n    # Switching judged by closeness to a shared ideal rate, person-specific weight.\n    # The change: person-specific ideal switching rate (logit scale, non-centred).\n    mu_sw = pm.Normal(\"mu_sw\", mu=0.4, sigma=0.7)\n    sigma_sw = pm.HalfNormal(\"sigma_sw\", sigma=0.7)\n    z_sw = pm.Normal(\"z_sw\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    sw_ideal = pm.math.sigmoid(mu_sw + sigma_sw * z_sw)\n    mu_kappa = pm.Normal(\"mu_kappa\", mu=0.0, sigma=1.5)\n    sigma_kappa = pm.HalfNormal(\"sigma_kappa\", sigma=1.0)\n    z_kappa = pm.Normal(\"z_kappa\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    kappa = mu_kappa + sigma_kappa * z_kappa\n\n    # Shared reward on the share of distinct three-flip chunks.\n    gamma = pm.Normal(\"gamma\", mu=0.0, sigma=2.0)\n\n    # Shared penalty on a rule-built (copied or anti-symmetric) sequence.\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=1.0)\n\n    # Person-specific pattern sensitivity scaling both structural cues\n    # (median 1, so gamma and rho remain the typical person's weights).\n    sigma_pat = pm.HalfNormal(\"sigma_pat\", sigma=0.7)\n    z_pat = pm.Normal(\"z_pat\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    pat = pm.math.exp(sigma_pat * z_pat)\n\n    # Person-specific left/right response bias (decision stage, not a cue).\n    sigma_side = pm.HalfNormal(\"sigma_side\", sigma=0.3)\n    z_side = pm.Normal(\"z_side\", mu=0.0, sigma=1.0, shape=N_SLOTS)\n    side = sigma_side * z_side\n\n    theta = ideal[participant_id]\n    dist_a = (span_a - theta) ** 2\n    dist_b = (span_b - theta) ** 2\n    sens = beta[participant_id] * pm.math.exp(lam * log_len)\n    sw_p = sw_ideal[participant_id]\n    sw_dist = (sw_b - sw_p) ** 2 - (sw_a - sw_p) ** 2\n    logit = (\n        sens * (dist_b - dist_a)\n        + 4.0 * kappa[participant_id] * sw_dist\n        + pat[participant_id] * (gamma * trip_diff - rho * rule_diff)\n        + side[participant_id]\n    )\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(logit))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n","numLines":130,"startLine":1,"totalLines":130}}}
