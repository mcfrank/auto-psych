'); return r.fun,r.x\nbase=['span','span2','sw','sw2','per']\nb,_=fit(base); print('base',b)\nfor extra in ['lrun','trip','heads','imb','fl','perfrac','startH']:\n    f,w=fit(base+[extra]); print(extra,round(b-f,1),np.round(w,2))\nEOF\n/scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python ana.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2454,"cache_read_input_tokens":68556,"cache_creation":{"ephemeral_5m_input_tokens":2454,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"790f7cac-5b05-40da-97e7-5daf51bbaba8","uuid":"cf3994a9-8a24-48a4-9829-5867e83417b0","timestamp":"2026-10-03T20:37:31.493Z","request_id":"req_011CffwrHdHvst1QoUsZSKKB"}
