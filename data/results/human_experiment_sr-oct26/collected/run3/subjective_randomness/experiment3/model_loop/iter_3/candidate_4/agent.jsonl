iff, gam_diff, pid, y = [], [], [], [], [], [], []'''),\n('''        alt2_diff.append(table[ia_ib[0]][\"alt2\"] - table[ia_ib[1]][\"alt2\"])\n''', '''        alt2_diff.append(table[ia_ib[0]][\"alt2\"] - table[ia_ib[1]][\"alt2\"])\n        gam_diff.append(table[ia_ib[0]][\"gam\"] - table[ia_ib[1]][\"gam\"])\n'''),\n('''        \"alt2_diff\": np.asarray(alt2_diff, dtype=\"float64\"),\n''', '''        \"alt2_diff\": np.asarray(alt2_diff, dtype=\"float64\"),\n        \"gam_diff\": np.asarray(gam_diff, dtype=\"float64\"),\n'''),\n('''    alt2_diff = pm.Data(\"alt2_diff\", np.zeros(1, dtype=\"float64\"))\n''', '''    alt2_diff = pm.Data(\"alt2_diff\", np.zeros(1, dtype=\"float64\"))\n    gam_diff = pm.Data(\"gam_diff\", np.zeros(1, dtype=\"float64\"))\n'''),\n('''    log_chance2_diff = 0.5 * d_switch2 * alt2_diff\n''', '''    # Gambler's run-length belief: shared rise g in the believed log-odds of\n    # switching per flip the current run lasts beyond two (g > 0: long streaks\n    # are improbable under chance beyond their switch count).\n    g_run = pm.Normal(\"g_run\", mu=0.0, sigma=1.0)\n    log_chance2_diff = 0.5 * d_switch2 * alt2_diff + 0.5 * g_run * gam_diff\n'''),\n]\nfor a, b in reps:\n    assert s.count(a) == 1, a\n    s = s.replace(a, b)\nopen(sys.argv[2], \"w\").write(s)\nPY\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run3/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment3/model_loop/responses.csv 2>&1 | tail -5"}],"uuid":"8ee6b405-8d89-42fa-b8af-8ba5eec0b987","session_id":"0268d052-585e-42a5-b281-fc81db63f174"}
