 \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTTHTTHT\",\n    \"sequence_b\": \"HTTHTTTT\",\n    \"eig\": 0.005142,\n    \"selection_rank\": 51,\n    \"joint_eig_bits\": 2.692599,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHTHHHT\",\n    \"sequence_b\": \"TTTHTTTH\",\n    \"eig\": 0.020689,\n    \"selection_rank\": 52,\n    \"joint_eig_bits\": 2.694999,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"TTH\",\n    \"sequence_b\": \"TTT\",\n    \"eig\": 0.04154,\n    \"selection_rank\": 53,\n    \"joint_eig_bits\": 2.698067,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHTHTHT\",\n    \"sequence_b\": \"TTTHHHHH\",\n    \"eig\": 0.027332,\n    \"selection_rank\": 54,\n    \"joint_eig_bits\": 2.701449,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHHTHHT\",\n    \"sequence_b\": \"HTHTTHHT\",\n    \"eig\": 0.010055,\n    \"selection_rank\": 55,\n    \"joint_eig_bits\": 2.703451,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"THHTHHTH\",\n    \"sequence_b\": \"THHTTHTH\",\n    \"eig\": 0.010055,\n    \"selection_rank\": 56,\n    \"joint_eig_bits\": 2.708142,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"THTTHTTH\",\n    \"sequence_b\": \"TTTTHTTH\",\n    \"eig\": 0.005142,\n    \"selection_rank\": 57,\n    \"joint_eig_bits\": 2.708297,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"THTHTHHH\",\n    \"sequence_b\": \"THTHTHTH\",\n    \"eig\": 0.072038,\n    \"selection_rank\": 58,\n    \"joint_eig_bits\": 2.712235,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"THHHHHH\",\n    \"sequence_b\": \"TTTTTTT\",\n    \"eig\": 0.036081,\n    \"selection_rank\": 59,\n    \"joint_eig_bits\": 2.713906,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"THTHTHTH\",\n    \"sequence_b\": \"TTTHHTTT\",\n    \"eig\": 0.125952,\n    \"selection_rank\": 60,\n    \"joint_eig_bits\": 2.716892,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHTHTHT\",\n    \"sequence_b\": \"HTHTHTTT\",\n    \"eig\": 0.072038,\n    \"selection_rank\": 61,\n    \"joint_eig_bits\": 2.719752,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTTHHTHT\",\n    \"sequence_b\": \"HTTHTTHT\",\n    \"eig\": 0.010055,\n    \"selection_rank\": 62,\n    \"joint_eig_bits\": 2.720066,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHTHHTHH\",\n    \"sequence_b\": \"HTHTTHTH\",\n    \"eig\": 0.038377,\n    \"selection_rank\": 63,\n    \"joint_eig_bits\": 2.721704,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHTHHTHT\",\n    \"sequence_b\": \"TTHTTHTT\",\n    \"eig\": 0.034309,\n    \"selection_rank\": 64,\n    \"joint_eig_bits\": 2.723046,\n    \"source\": \"eig\"\n  }\n];\n\n    const jsPsych = initJsPsych({\n      on_finish: function () { window.__experimentData = jsPsych.data.get().values(); }\n    });\n\n    const timeline = [];\n\n    // 1. Instructions\n    timeline.push({\n      type: jsPsychHtmlButtonResponse,\n      stimulus:\n        '<div class=\"auto-psych-prose\">' +\n          '<p>In this study, you will look at sequences of coin flips and judge how <strong>random</strong> they look.</p>' +\n          '<p>Imagine flipping a fair coin over and over. Each flip is equally likely to come up Heads (H) or Tails (T), and every flip is independent — the coin has no memory, so what came before does not change what comes next.</p>' +\n          '<p>On each trial you will see <strong>two</strong> sequences of coin flips, side by side. The two sequences will have the <strong>same length</strong>. Your task is to pick the <strong>one sequence that looks more random</strong> to you — the one that looks more like it was produced by genuinely random coin flipping.</p>' +\n          '<p>Different people have different impressions of what makes a sequence look random, and there are no right or wrong answers. We are interested in your own honest impression, so go with your gut. You will complete <strong>64 trials</strong