\": 19,\n    \"joint_eig_bits\": 2.518152,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHHTHHHT\",\n    \"sequence_b\": \"TTTHTHTH\",\n    \"eig\": 0.01701,\n    \"selection_rank\": 20,\n    \"joint_eig_bits\": 2.533024,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHTHHHT\",\n    \"sequence_b\": \"HTHTHTHT\",\n    \"eig\": 0.086365,\n    \"selection_rank\": 21,\n    \"joint_eig_bits\": 2.54086,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHHHHTHT\",\n    \"sequence_b\": \"TTTTTHHH\",\n    \"eig\": 0.013286,\n    \"selection_rank\": 22,\n    \"joint_eig_bits\": 2.549707,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"THHHHHTH\",\n    \"sequence_b\": \"THHTHHTH\",\n    \"eig\": 0.004578,\n    \"selection_rank\": 23,\n    \"joint_eig_bits\": 2.5563,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHHTHTHT\",\n    \"sequence_b\": \"HTHTHTHT\",\n    \"eig\": 0.072038,\n    \"selection_rank\": 24,\n    \"joint_eig_bits\": 2.563137,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHTHTTT\",\n    \"sequence_b\": \"THTHTHTH\",\n    \"eig\": 0.064642,\n    \"selection_rank\": 25,\n    \"joint_eig_bits\": 2.571194,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTHTTTTT\",\n    \"sequence_b\": \"TTTHHHHH\",\n    \"eig\": 0.013286,\n    \"selection_rank\": 26,\n    \"joint_eig_bits\": 2.578641,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HHTHHTHH\",\n    \"sequence_b\": \"THHTTHTT\",\n    \"eig\": 0.040608,\n    \"selection_rank\": 27,\n    \"joint_eig_bits\": 2.588098,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"HTTHTTHT\",\n    \"sequence_b\": \"HTTTTTHT\",\n    \"eig\": 0.004578,\n    \"selection_rank\": 28,\n    \"joint_eig_bits\": 2.594824,\n    \"source\": \"eig\"\n  },\n  {\n    \"sequence_a\": \"TH\",\n    \"sequence_b\": \"TT\",\n    \"eig\": 0.06002,\n    \"selection_rank\": 29,\n    \"joint_eig_bits\": 2.601023,\n    \"source\": \"eig\"\n  },\n  