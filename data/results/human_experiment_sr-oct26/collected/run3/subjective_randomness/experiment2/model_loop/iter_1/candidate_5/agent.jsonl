 habitual side\n(Left with person-specific probability pi_i), so\np_left = (1 - lambda_i) * p_judge + lambda_i * pi_i.\n\"\"\"\n'''\nbody=src[src.index('import math'):]\nold='''    p_left = pm.Deterministic(\n        \"p_left\", pm.math.sigmoid(beta[participant_id] * score_diff)\n    )\n'''\nnew='''    p_judge = pm.math.sigmoid(beta[participant_id] * score_diff)\n\n    # Person-specific habitual-side lapses: rate lambda_i of skipping the\n    # judgment, and the side pi_i (probability of Left) clicked when they do.\n    mu_logit_lam = pm.Normal(\"mu_logit_lam\", mu=-2.5, sigma=1.0)\n    sigma_logit_lam = pm.HalfNormal(\"sigma_logit_lam\", sigma=0.75)\n    z_lam = pm.Normal(\"z_lam\", mu=0.0, sigma=1.0, shape=400)\n    lam = pm.math.sigmoid(mu_logit_lam + sigma_logit_lam * z_lam)\n    mu_logit_pi = pm.Normal(\"mu_logit_pi\", mu=0.0, sigma=1.0)\n    sigma_logit_pi = pm.HalfNormal(\"sigma_logit_pi\", sigma=1.0)\n    z_pi = pm.Normal(\"z_pi\", mu=0.0, sigma=1.0, shape=400)\n    pi_side = pm.math.sigmoid(mu_logit_pi + sigma_logit_pi * z_pi)\n\n    lam_i = lam[participant_id]\n    p_left = pm.Deterministic(\n        \"p_left\",\n        pt.clip((1.0 - lam_i) * p_judge + lam_i * pi_side[participant_id], 1e-6, 1 - 1e-6),\n    )\n'''\nassert old in body\nopen('$D/candidate.py'.replace('$D','/scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment2/model_loop/iter_1/candidate_5'),'w').write(head+'\\n'+body.replace(old,new))\nPY\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run3/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment2/model_loop/responses.csv 2>&1 | tail -5"}],"uuid":"2afea08e-9e59-47b9-be73-281efac4e51c","session_id":"fbe46fa4-102a-48d3-81a6-ec3c33bd929b"}
