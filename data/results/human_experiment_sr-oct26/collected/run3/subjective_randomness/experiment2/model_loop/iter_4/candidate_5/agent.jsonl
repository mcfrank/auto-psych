titions. The coin is\nbelieved to repeat tails and heads with different probabilities: the chance log-\nlikelihood difference of a pair gains rho * ((TT_a - HH_a) - (TT_b - HH_b)),\nwhere HH/TT count adjacent heads-heads / tails-tails repeats and 2*rho is the log\nratio of the believed probability of repeating tails to that of repeating heads\n(shared, fitted; rho > 0: heads streaks look less like chance than tails\nstreaks). Weighed by the person's sensitivity like the rest of the evidence.\n\"\"\"\n\n'''\nbody=body.replace('''    out = {\"h\": float(h), \"k\": float(k), \"lm\": log_markov, \"lb\": log_biased, \"alt2\": float(ss - sr)}''',\n'''    hh = sum(1 for x, y in zip(seq, seq[1:]) if x == y == \"H\")\n    tt = sum(1 for x, y in zip(seq, seq[1:]) if x == y == \"T\")\n    out = {\"h\": float(h), \"k\": float(k), \"lm\": log_markov, \"lb\": log_biased, \"alt2\": float(ss - sr),\n           \"rep_asym\": float(tt - hh)}''')\nbody=body.replace('heads_diff.append(table[ia_ib[0]][\"h\"] - table[ia_ib[1]][\"h\"])','rep_asym_diff.append(table[ia_ib[0]][\"rep_asym\"] - table[ia_ib[1]][\"rep_asym\"])')\nbody=body.replace('idx_a, idx_b, switch_diff, alt2_diff, heads_diff, pid, y','idx_a, idx_b, switch_diff, alt2_diff, rep_asym_diff, pid, y')\nbody=body.replace('\"heads_diff\": np.asarray(heads_diff,','\"rep_asym_diff\": np.asarray(rep_asym_diff,')\nbody=body.replace('heads_diff = pm.Data(\"heads_diff\"','rep_asym_diff = pm.Data(\"rep_asym_diff\"')\nbody=body.replace('''    # Believed heads probability of a fair coin, as its logit (0: symmetric).\n    logit_theta = pm.Normal(\"logit_theta\", mu=0.0, sigma=0.5)''','''    # Face-specific repetition belief: half the log ratio of the believed\n    # probability of repeating tails to that of repeating heads (0: symmetric).\n    rho = pm.Normal(\"rho\", mu=0.0, sigma=0.5)''')\nbody=body.replace('logit_theta * heads_diff','rho * rep_asym_diff')\nassert 'heads' not in body.replace('heads-heads','') or True\nopen('iter_4/candidat