ma=3.0)\n    z = pm.Normal(\"z\", mu=0.0, sigma=1.0, shape=400)\n    beta = pm.Deterministic(\"beta\", mu + sigma * z)\n\n    p_left = pm.Deterministic(\n        \"p_left\", pm.math.sigmoid(beta[participant_id] * switch_diff)\n    )\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run3/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $C --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment2/model_loop/responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"ef3f6f5b-4d08-4183-8d67-60db1a544cc8","session_id":"dc44f0df-6886-4691-8206-0862392f4b85"}
