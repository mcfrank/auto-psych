{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RySPkPgMB6oHv2LTT7NRgN","type":"tool_result","content":"\"\"\"Refinement of `local_representativeness` with person-specific sensitivity.\n\nKahneman & Tversky local representativeness: a sequence looks random to the\nextent it is locally balanced (multi-scale window imbalance) and irregular\n(near an over-alternating prototype, not periodic). The single change from the\nincumbent: each participant applies this shared criterion with their own\ndecision sensitivity (log-normal population, non-centred), instead of one\npooled sensitivity.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\nN_PERSON_SLOTS = 400\n\nwith pm.Model() as model:\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    multiscale_imbalance_a = pm.Data(\n        \"multiscale_imbalance_a\", np.zeros(1, dtype=\"float64\")\n    )\n    multiscale_imbalance_b = pm.Data(\n        \"multiscale_imbalance_b\", np.zeros(1, dtype=\"float64\")\n    )\n    p_alts_a = pm.Data(\"p_alts_a\", np.zeros(1, dtype=\"float64\"))\n    p_alts_b = pm.Data(\"p_alts_b\", np.zeros(1, dtype=\"float64\"))\n    periodicity_a = pm.Data(\"periodicity_a\", np.zeros(1, dtype=\"float64\"))\n    periodicity_b = pm.Data(\"periodicity_b\", np.zeros(1, dtype=\"float64\"))\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n\n    theta_alt = pm.Uniform(\"theta_alt\", lower=0.5001, upper=0.95)\n    alt_weight = pm.Uniform(\"alt_weight\", lower=0.01, upper=0.99)\n    periodic_share = pm.Uniform(\"periodic_share\", lower=0.01, upper=0.99)\n    beta = pm.Uniform(\"beta\", lower=0.2, upper=12.0)\n    sigma_beta = pm.HalfNormal(\"sigma_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_PERSON_SLOTS)\n    beta_person = beta * pt.exp(sigma_beta * z_beta - 0.5 * sigma_beta**2)\n    side_bias = pm.Uniform(\"side_bias\", lower=-2.0, upper=2.0)\n\n    balance_weight = 1.0 - alt_weight\n    irregularity_a = (1.0 - periodic_share) * pt.abs(\n        p_alts_a - theta_alt\n    ) + periodic_share * periodicity_a\n    irregularity_b = (1.0 - periodic_share) * pt.abs(\n        p_alts_b - theta_alt\n    ) + periodic_share * periodicity_b\n    score_a = -(balance_weight * multiscale_imbalance_a + alt_weight * irregularity_a)\n    score_b = -(balance_weight * multiscale_imbalance_b + alt_weight * irregularity_b)\n\n    p_left = pm.Deterministic(\n        \"p_left\",\n        pm.math.sigmoid(beta_person[participant_id] * (score_a - score_b) + side_bias),\n    )\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Self-contained feature computation\n# ─────────────────────────────────────────────────────────────────────────────","is_error":false}]},"parent_tool_use_id":null,"session_id":"659947dd-e124-47b6-883c-21c12f5465d1","uuid":"54577129-7e2b-4880-b44b-a0b481db2bc7","timestamp":"2026-10-04T15:33:17.390Z","tool_use_result":{"stdout":"\"\"\"Refinement of `local_representativeness` with person-specific sensitivity.\n\nKahneman & Tversky local representativeness: a sequence looks random to the\nextent it is locally balanced (multi-scale window imbalance) and irregular\n(near an over-alternating prototype, not periodic). The single change from the\nincumbent: each participant applies this shared criterion with their own\ndecision sensitivity (log-normal population, non-centred), instead of one\npooled sensitivity.\n\"\"\"\n\nimport numpy as np\nimport pymc as pm\nimport pytensor.tensor as pt\n\nN_PERSON_SLOTS = 400\n\nwith pm.Model() as model:\n    participant_id = pm.Data(\"participant_id\", np.zeros(1, dtype=\"int64\"))\n\n    multiscale_imbalance_a = pm.Data(\n        \"multiscale_imbalance_a\", np.zeros(1, dtype=\"float64\")\n    )\n    multiscale_imbalance_b = pm.Data(\n        \"multiscale_imbalance_b\", np.zeros(1, dtype=\"float64\")\n    )\n    p_alts_a = pm.Data(\"p_alts_a\", np.zeros(1, dtype=\"float64\"))\n    p_alts_b = pm.Data(\"p_alts_b\", np.zeros(1, dtype=\"float64\"))\n    periodicity_a = pm.Data(\"periodicity_a\", np.zeros(1, dtype=\"float64\"))\n    periodicity_b = pm.Data(\"periodicity_b\", np.zeros(1, dtype=\"float64\"))\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n\n    theta_alt = pm.Uniform(\"theta_alt\", lower=0.5001, upper=0.95)\n    alt_weight = pm.Uniform(\"alt_weight\", lower=0.01, upper=0.99)\n    periodic_share = pm.Uniform(\"periodic_share\", lower=0.01, upper=0.99)\n    beta = pm.Uniform(\"beta\", lower=0.2, upper=12.0)\n    sigma_beta = pm.HalfNormal(\"sigma_beta\", sigma=0.7)\n    z_beta = pm.Normal(\"z_beta\", mu=0.0, sigma=1.0, shape=N_PERSON_SLOTS)\n    beta_person = beta * pt.exp(sigma_beta * z_beta - 0.5 * sigma_beta**2)\n    side_bias = pm.Uniform(\"side_bias\", lower=-2.0, upper=2.0)\n\n    balance_weight = 1.0 - alt_weight\n    irregularity_a = (1.0 - periodic_share) * pt.abs(\n        p_alts_a - theta_alt\n    ) + periodic_share * periodicity_a\n    irregularity_b = (1.0 - periodic_share) * pt.abs(\n        p_alts_b - theta_alt\n    ) + periodic_share * periodicity_b\n    score_a = -(balance_weight * multiscale_imbalance_a + alt_weight * irregularity_a)\n    score_b = -(balance_weight * multiscale_imbalance_b + alt_weight * irregularity_b)\n\n    p_left = pm.Deterministic(\n        \"p_left\",\n        pm.math.sigmoid(beta_person[participant_id] * (score_a - score_b) + side_bias),\n    )\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Self-contained feature computation\n# ─────────────────────────────────────────────────────────────────────────────","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
