{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FajtNnRZBg8BU2BrmMfaxc","type":"tool_result","content":"142\t# prepare_observed hook\n143\t# ---------------------------------------------------------------------------\n144\t\n145\t\n146\tdef _model_prepare_observed(model: Any) -> Any:\n147\t    \"\"\"The model's optional ``prepare_observed`` callable, or ``None``.\"\"\"\n148\t    return getattr(model, _PREPARE_OBSERVED_ATTR, None)\n149\t\n150\t\n151\tdef _observed_via_hook(model: Any, rows: List[Dict[str, Any]]) -> Dict[str, np.ndarray]:\n152\t    \"\"\"Build every ``pm.Data`` array through the model's ``prepare_observed`` hook.\n153\t\n154\t    The hook owns the layout, so the harness cannot check it column by column.\n155\t    It checks the contract instead, and fails loudly on any breach — a hook that\n156\t    returned the wrong keys or a mis-shaped array would otherwise surface much\n157\t    later as an inscrutable pytensor shape error, or worse, as a silently\n158\t    mis-aligned likelihood:\n159\t\n160\t    - the returned keys must be exactly the model's ``pm.Data`` names;\n161\t    - every value must be a numpy array whose rank matches the container's\n162\t      placeholder, and whose dtype has the same *kind* (a float array for an\n163\t      integer container would be truncated on binding);\n164\t    - the observed-response container must have one entry per input row, which\n165\t      is what makes ``p_left`` per-trial and keeps ELPD-LOO pointwise.\n166\t\n167\t    Exact dtype *width* is normalized here rather than demanded of the hook,\n168\t    because the width is PyMC's choice, not the model's: ``pm.Data`` converts an\n169\t    ``int64`` array to ``intX`` (int32 under PyMC 5.28), so a hook that hard-coded\n170\t    a width would break on a different build. This mirrors what the\n171\t    column-mapping path does with ``placeholder.dtype``.\n172\t    \"\"\"\n173\t    prepare = _model_prepare_observed(model)\n174\t    if prepare is None:\n175\t        raise ValueError(\"Model declares no prepare_observed hook.\")\n176\t    rows = list(rows)\n177\t    try:\n178\t        out = prepare(rows)\n179\t    except KeyError as e:\n180\t        # A hook that reads row[\"participant_id\"] off a bare stimulus row needs\n181\t        # a column those rows lack — report it the way the column-mapping path\n182\t        # does, so callers can reject or screen the model instead of crashing.\n183\t        missing = _bookkeeping_column_missing_from(e, rows)\n184\t        if missing is None:\n185\t            raise  # the hook's own bug, not a column the rows lack\n186\t        available = sorted(rows[0]) if rows else []\n187\t        raise MissingStimulusColumns([missing], available) from e\n188\t    if not isinstance(out, dict):\n189\t        raise TypeError(\n190\t            \"prepare_observed must return a dict of pm.Data name -> numpy array, \"\n191\t            f\"got {type(out).__name__}.\"\n192\t        )\n193\t    expected = set(pm_data_inputs(model))\n194\t    got = set(out)\n195\t    if got != expected:\n196\t        missing = sorted(expected - got)\n197\t        unexpected = sorted(got - expected)\n198\t        raise ValueError(\n199\t            \"prepare_observed must return exactly the model's pm.Data containers. \"\n200\t            f\"Missing: {missing}. Unexpected: {unexpected}.\"\n201\t        )\n202\t    bound: Dict[str, np.ndarray] = {}\n203\t    for name in sorted(out):\n204\t        arr = out[name]\n205\t        if not isinstance(arr, np.ndarray):\n206\t            raise TypeError(\n207\t                f\"prepare_observed returned {type(arr).__name__} for {name!r}; \"\n208\t                \"every value must be a numpy array.\"\n209\t            )\n210\t        placeholder = model.named_vars[name].get_value()\n211\t        if arr.ndim != placeholder.ndim:\n212\t            raise ValueError(\n213\t                f\"prepare_observed returned a {arr.ndim}-D array for {name!r} but \"\n214\t                f\"its pm.Data placeholder is {placeholder.ndim}-D.\"\n215\t            )\n216\t        if arr.dtype.kind != placeholder.dtype.kind:\n217\t            raise ValueError(\n218\t                f\"prepare_observed returned dtype {arr.dtype} for {name!r} but its \"\n219\t                f\"pm.Data placeholder is {placeholder.dtype} — the kinds differ, so \"\n220\t                \"binding would silently reinterpret the values.\"\n221\t            )\n222\t        cast = arr.astype(placeholder.dtype, copy=False)\n223\t        if not np.array_equal(cast, arr):\n224\t            raise ValueError(\n225\t                f\"prepare_observed's {name!r} array does not survive the cast to the \"\n226\t                f\"container's dtype {placeholder.dtype} (values out of range).\"\n227\t            )\n228\t        bound[name] = cast\n229\t    out = bound\n230\t    response_name = observed_response_data(model)\n231\t    n_response = len(out[response_name])\n232\t    if n_response != len(rows):\n233\t        raise ValueError(\n234\t            f\"prepare_observed returned {n_response} entries for the observed-response \"\n235\t            f\"container {response_name!r} but was given {len(rows)} rows; the observed \"\n236\t            \"response must stay one-per-trial.\"\n237\t        )\n238\t    return out\n239\t\n240\t\n241\t# ---------------------------------------------------------------------------\n242\t# Non-stimulus columns & MissingStimulusColumns\n243\t# ---------------------------------------------------------------------------\n244\t\n245\t# Columns a *response* row carries but a bare stimulus row never does. A model\n246\t# that binds only these beyond the features is legitimately unevaluable on a\n247\t# bare stimulus: one with a participant-level random effect is predicted as\n248\t# participants and averaged where it can be (new participants in a design after\n249\t# data, eig._new_participant_draws; the training participants in the novelty\n250\t# gate), and screened out of a design before any data; anything else missing\n251\t# means the rows were built wrong.\n252\tNON_STIMULUS_COLUMNS = frozenset({\"participant_id\", \"trial_index\"})\n253\t\n254\t\n255\tdef participant_ids_in(responses_path: Path) -> Optional[List[int]]:\n256\t    \"\"\"Distinct participant ids in a responses CSV, sorted; ``None`` without\n257\t    the column (or without rows).\"\"\"\n258\t    with Path(responses_path).open(encoding=\"utf-8\", newline=\"\") as f:\n259\t        reader = csv.DictReader(f)\n260\t        if \"participant_id\" not in (reader.fieldnames or []):\n261\t            return None"}]},"parent_tool_use_id":null,"session_id":"73813b53-8bc9-451b-a34c-64df5c8dba30","uuid":"2ce7bc63-64b4-47fc-a6ed-dc7b10534c33","timestamp":"2026-10-04T15:43:49.781Z","tool_use_result":{"type":"text","file":{"filePath":"/scratch/users/kushinm/auto-psych/outer_loop_live/runs/run3/repo/src/models/data_binding.py","content":"# prepare_observed hook\n# ---------------------------------------------------------------------------\n\n\ndef _model_prepare_observed(model: Any) -> Any:\n    \"\"\"The model's optional ``prepare_observed`` callable, or ``None``.\"\"\"\n    return getattr(model, _PREPARE_OBSERVED_ATTR, None)\n\n\ndef _observed_via_hook(model: Any, rows: List[Dict[str, Any]]) -> Dict[str, np.ndarray]:\n    \"\"\"Build every ``pm.Data`` array through the model's ``prepare_observed`` hook.\n\n    The hook owns the layout, so the harness cannot check it column by column.\n    It checks the contract instead, and fails loudly on any breach — a hook that\n    returned the wrong keys or a mis-shaped array would otherwise surface much\n    later as an inscrutable pytensor shape error, or worse, as a silently\n    mis-aligned likelihood:\n\n    - the returned keys must be exactly the model's ``pm.Data`` names;\n    - every value must be a numpy array whose rank matches the container's\n      placeholder, and whose dtype has the same *kind* (a float array for an\n      integer container would be truncated on binding);\n    - the observed-response container must have one entry per input row, which\n      is what makes ``p_left`` per-trial and keeps ELPD-LOO pointwise.\n\n    Exact dtype *width* is normalized here rather than demanded of the hook,\n    because the width is PyMC's choice, not the model's: ``pm.Data`` converts an\n    ``int64`` array to ``intX`` (int32 under PyMC 5.28), so a hook that hard-coded\n    a width would break on a different build. This mirrors what the\n    column-mapping path does with ``placeholder.dtype``.\n    \"\"\"\n    prepare = _model_prepare_observed(model)\n    if prepare is None:\n        raise ValueError(\"Model declares no prepare_observed hook.\")\n    rows = list(rows)\n    try:\n        out = prepare(rows)\n    except KeyError as e:\n        # A hook that reads row[\"participant_id\"] off a bare stimulus row needs\n        # a column those rows lack — report it the way the column-mapping path\n        # does, so callers can reject or screen the model instead of crashing.\n        missing = _bookkeeping_column_missing_from(e, rows)\n        if missing is None:\n            raise  # the hook's own bug, not a column the rows lack\n        available = sorted(rows[0]) if rows else []\n        raise MissingStimulusColumns([missing], available) from e\n    if not isinstance(out, dict):\n        raise TypeError(\n            \"prepare_observed must return a dict of pm.Data name -> numpy array, \"\n            f\"got {type(out).__name__}.\"\n        )\n    expected = set(pm_data_inputs(model))\n    got = set(out)\n    if got != expected:\n        missing = sorted(expected - got)\n        unexpected = sorted(got - expected)\n        raise ValueError(\n            \"prepare_observed must return exactly the model's pm.Data containers. \"\n            f\"Missing: {missing}. Unexpected: {unexpected}.\"\n        )\n    bound: Dict[str, np.ndarray] = {}\n    for name in sorted(out):\n        arr = out[name]\n        if not isinstance(arr, np.ndarray):\n            raise TypeError(\n                f\"prepare_observed returned {type(arr).__name__} for {name!r}; \"\n                \"every value must be a numpy array.\"\n            )\n        placeholder = model.named_vars[name].get_value()\n        if arr.ndim != placeholder.ndim:\n            raise ValueError(\n                f\"prepare_observed returned a {arr.ndim}-D array for {name!r} but \"\n                f\"its pm.Data placeholder is {placeholder.ndim}-D.\"\n            )\n        if arr.dtype.kind != placeholder.dtype.kind:\n            raise ValueError(\n                f\"prepare_observed returned dtype {arr.dtype} for {name!r} but its \"\n                f\"pm.Data placeholder is {placeholder.dtype} — the kinds differ, so \"\n                \"binding would silently reinterpret the values.\"\n            )\n        cast = arr.astype(placeholder.dtype, copy=False)\n        if not np.array_equal(cast, arr):\n            raise ValueError(\n                f\"prepare_observed's {name!r} array does not survive the cast to the \"\n                f\"container's dtype {placeholder.dtype} (values out of range).\"\n            )\n        bound[name] = cast\n    out = bound\n    response_name = observed_response_data(model)\n    n_response = len(out[response_name])\n    if n_response != len(rows):\n        raise ValueError(\n            f\"prepare_observed returned {n_response} entries for the observed-response \"\n            f\"container {response_name!r} but was given {len(rows)} rows; the observed \"\n            \"response must stay one-per-trial.\"\n        )\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Non-stimulus columns & MissingStimulusColumns\n# ---------------------------------------------------------------------------\n\n# Columns a *response* row carries but a bare stimulus row never does. A model\n# that binds only these beyond the features is legitimately unevaluable on a\n# bare stimulus: one with a participant-level random effect is predicted as\n# participants and averaged where it can be (new participants in a design after\n# data, eig._new_participant_draws; the training participants in the novelty\n# gate), and screened out of a design before any data; anything else missing\n# means the rows were built wrong.\nNON_STIMULUS_COLUMNS = frozenset({\"participant_id\", \"trial_index\"})\n\n\ndef participant_ids_in(responses_path: Path) -> Optional[List[int]]:\n    \"\"\"Distinct participant ids in a responses CSV, sorted; ``None`` without\n    the column (or without rows).\"\"\"\n    with Path(responses_path).open(encoding=\"utf-8\", newline=\"\") as f:\n        reader = csv.DictReader(f)\n        if \"participant_id\" not in (reader.fieldnames or []):\n            return None","numLines":120,"startLine":142,"totalLines":392}}}
