witch_diff * logit_q - log_regular_diff\n''','''    # Length normalisation of the evidence (gamma = 0: total evidence, 1: per flip).\n    gamma = pm.Normal(\"gamma\", mu=0.5, sigma=0.5)\n    trial_len = seq_len[idx_a]\n    length_scale = pt.exp(-gamma * pt.log(trial_len / 5.0))\n\n    score_diff = (switch_diff * logit_q - log_regular_diff) * length_scale\n''')\nopen('/scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment1/model_loop/iter_3/candidate_3/candidate.py','w').write(src)\nPY\ngrep -n gamma $D/candidate.py\n/scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment1/model_loop/responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"802e083b-10a4-410c-9eff-d09d6f8ee06f","session_id":"d7902f2c-097e-4a5d-b341-8c6f75c0471d"}
