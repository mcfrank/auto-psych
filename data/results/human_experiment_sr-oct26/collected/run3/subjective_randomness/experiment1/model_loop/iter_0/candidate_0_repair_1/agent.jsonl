{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bvjapvepp","task_type":"local_bash","description":"cd /tmp && cat << 'EOF' > /tmp/conv_test.py\nimport importlib.util, csv, numpy as np, pymc as pm, arviz as az\nspec = importlib.util.spec_from_file_location(\"c\", \"/scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment1/model_loop/iter_0/candidate_0_repair_1/candidate.py\")\nm = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\nrows = list(csv.DictReader(open(\"/scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment1/model_loop/responses.csv\")))\nfeats = [m.compute_features(r[\"sequence_a\"], r[\"sequence_b\"]) for r in rows]\nd = {k: np.array([f[k] for f in feats]) for k in feats[0]}\nd[\"participant_id\"] = np.array([int(r[\"participant_id\"]) for r in rows])\nd[\"chose_left\"] = np.array([int(r[\"chose_left\"]) for r in rows])\nprint(d[\"participant_id\"].max())\nwith m.model:\n    pm.set_data(d)\n    idata = pm.sample(1000, tune=1000, chains=4, cores=4, random_seed=1, progressbar=False)\nprint(\"div\", int(idata.sample_stats.diverging.sum()))\nprint(az.summary(idata, var_names=[\"mu_k\",\"sigma_k\",\"beta\"]))\nEOF\ntimeout 1500 /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python /tmp/conv_test.py 2>&1 | grep -v Warn | tail -8"}],"uuid":"0829510c-6a2a-4f44-a170-0746e3e6370b","session_id":"ecd8a8e1-efdf-4049-b3e3-5eb5c3e80ce6"}
