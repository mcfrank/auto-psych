str.count(\"H\").values; hb = b.str.count(\"H\").values\n    seqs = pd.unique(np.concatenate([a.values, b.values]))\n    runs = {s: 1 + sum(1 for i in range(1, len(s)) if s[i] != s[i - 1]) for s in seqs}\n    ra = a.map(runs).values; rb = b.map(runs).values\n    mask = (ha == hb) & (ra != rb)\n    if mask.sum() == 0:\n        return 0.5\n    y = df[\"chose_left\"].values[mask]\n    return float(np.where(ra[mask] > rb[mask], y, 1 - y).mean())\nEOF\ncat << 'EOF' > participant_consistency_across_mirror_presentations.py\n# name: participant_consistency_across_mirror_presentations\n# description: Per-participant, the SD (across people) of agreement with the data-majority on the 25% of pairs with the weakest consensus; observed above null_mean means individual differences in WHICH sequence looks random (different criteria, not just different decisiveness) exceed what a single shared score with person-specific beta produces.\ndef test_statistic(df):\n    a = df[\"sequence_a\"].values; b = df[\"sequence_b\"].values\n    first_is_a = a < b\n    key = np.where(first_is_a, a, b) + \"|\" + np.where(first_is_a, b, a)\n    y = df[\"chose_left\"].values\n    cf = np.where(first_is_a, y, 1 - y)\n    pm_ = pd.Series(cf).groupby(key).transform(\"mean\").values\n    ext = np.abs(pm_ - 0.5)\n    pair_ext = pd.Series(ext).groupby(key).first()\n    thr = np.quantile(pair_ext.values, 0.25)\n    mask = ext <= thr\n    agree = (cf == (pm_ >= 0.5)).astype(float)\n    g = pd.Series(agree[mask]).groupby(df[\"participant_id\"].values[mask]).mean()\n    return float(g.std(ddof=0)) if len(g) > 1 else 0.0\nEOF\nls; cd /scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment1/model_loop && python3 -c \"\nimport numpy as np, pandas as pd, math, glob, time\nd=pd.read_csv('responses.csv')\nfor f in sorted(glob.glob('iter_1/critique/test_stats/*.py')):\n    g={'np':np,'pd':pd,'math':math}; exec(open(f).read(),g); t=time.time(); v=g['test_statistic'](d); print(f.split