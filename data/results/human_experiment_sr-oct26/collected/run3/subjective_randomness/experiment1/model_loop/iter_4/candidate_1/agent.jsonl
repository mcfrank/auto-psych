    return np.array([ (rep*lrep)[1:].sum()+(sw*lsw)[1:].sum() for rep,sw in R])\nfit(lambda th: th[2]*(renew_ll(RA,th[0],th[1])-renew_ll(RB,th[0],th[1])),3,'renewal_lin')\nfit(lambda th: th[3]*(renew_ll(RA,th[0],th[1],th[2])-renew_ll(RB,th[0],th[1],th[2])),4,'renewal_quad')\nLA=np.array([lz(s) for s in A]);LB=np.array([lz(s) for s in B])\nfit(lambda th: th[0]*(LA-LB),1,'lz')\nsat=-(K*np.log(np.clip(K/N,1e-9,1))+(N-K)*np.log(np.clip(1-K/N,1e-9,1))).sum(); print('saturated',sat)\nEOF\n/scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python /tmp/explore_c1.py\" completed (exit code 0)","uuid":"ba7c6b03-ba9c-44e3-a4f2-e9edc1c89e63","session_id":"83634236-4150-4dfd-8743-512dcaf57fa3"}
