, sigma=1.0, shape=400)\n    beta = pt.exp(mu_log_beta + sigma_log_beta * z_beta)\n\n    score_diff = log_tail[idx_a] - log_tail[idx_b]\n    p_left = pm.Deterministic(\"p_left\", pm.math.sigmoid(beta[participant_id] * score_diff))\n\n    chose_left = pm.Data(\"chose_left\", np.zeros(1, dtype=\"int64\"))\n    pm.Bernoulli(\"response\", p=p_left, observed=chose_left)\nEOF\ncd /scratch/users/kushinm/auto-psych/outer_loop_live/runs/run3/repo && /scratch/users/kushinm/auto-psych/outer_loop_live/venv/bin/python -m src.pipelines.inner_loop.check_candidate --candidate-dir $D --responses /scratch/users/kushinm/auto-psych/outer_loop_live/run3/data/subjective_randomness/experiment1/model_loop/responses.csv 2>&1 | tail -5\" completed (exit code 0)","uuid":"3380937d-5abc-45ba-8512-b93ebaed4d66","session_id":"d7397ec1-6d74-4718-9fdc-e920e05cd431"}
