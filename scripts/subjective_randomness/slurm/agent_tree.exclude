# Paths excluded from the agent's copy of the repository.
# Used by holdout_recovery_array.sbatch and tests/test_agent_tree_isolation.py.
#
# VCS, build artefacts, caches
.git
.venv
data
__pycache__
*.nc
node_modules
.uv_cache
.pip_cache
.cache
.hf

# GT-recipe and evaluation code (holdout leak channels, already excluded pre-P10)
ground_truth_models.py
evaluate_recovery.py
test_literature_faithful_pymc.py
test_literature_model_families.py
gt.txt
REFACTOR_NOTES.md
# Agent CLIs load these into every session (claude: CLAUDE.md; codex and
# opencode: AGENTS.md). The project CLAUDE.md names the held-out model, and
# a candidate agent needs none of it: its brief is self-contained.
CLAUDE.md
AGENTS.md

# Research library: agents must not read feature-computation or stimulus-design code
/src/subjective_randomness/features.py
/src/subjective_randomness/sequence_stats.py
/src/subjective_randomness/stimulus_design.py
/src/subjective_randomness/model_families/
# The PyMC registry holds alternative implementations of the ground truths: for
# a motif_stack holdout, motif_stack_softmax.py and motif_stack_tempered.py
# describe the held-out mechanism in full and motif_hmm.py is a close sibling.
# The array sbatch deletes only <gt>.py, so until now those were covered ONLY by
# opencode's read/glob/grep deny-list — which the claude and codex backends
# ignore entirely. Exclude the directory outright, symmetric with
# model_families/ above. The pipeline reads this registry from the harness
# checkout (--gt-models-dir / the config's seed_models_dir), never from the
# agent tree.
/src/subjective_randomness/pymc_model_families/

# Holdout configs name the GT models
/scripts/subjective_randomness/configs/holdout_recovery*.yaml

# Preprocess (superseded by P9, but exclude by name in case any remain)
preprocess.py

# Everything but src/ and the agents' own run tree. Docs, tests, scripts and
# analyses name and describe the ground truths (40 files named motif_stack),
# the rest of the research library is harness-only and names them too, and a
# loader comment naming motif_stack reached three agents. The harness runs
# from its own full copy; the agents' self-test needs only src/.
/docs/
/tests/
/scripts/
/analysis/
/diagrams/
/README.md
/SUMMARY.md
/HERO_RUN_DESIDERATA.md
/src/subjective_randomness/
.pytest_cache
# Every agent could read the Prolific, Firebase, Google and Claude tokens.
.secrets
.secrets.example

# Project literature: the source papers of the ground truths (Falk & Konold
# 1997, Hahn & Warren 2009, Kahneman & Tversky 1972, Griffiths et al.) and notes
# citing them. PDFs are binary, so the GT-name scan cannot see into them.
# Inner-loop agents are told the task from task_description.md instead of
# problem_definition.md, which hints at mechanisms ("motif parses",
# "occurrence probabilities").
/src/pipelines/outer_loop/projects/*/references/
/src/pipelines/outer_loop/projects/*/instruction_literature.md
/src/pipelines/outer_loop/projects/*/problem_definition.md

# Archived seed pools: the 2026-07 hero-run seeds include a motif/DP-style
# likelihood with the motif_stack ground truth's parameter names (the jank
# audit, C2). Nothing the agents run reads them.
/src/pipelines/outer_loop/projects/*/seed_models/archive_*/
