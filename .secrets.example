# Copy to .secrets (gitignored) or export these locally. Never commit real values.
# The Slurm harness (scripts/outer_loop_live/_env.sh) sources this file.

# Prolific REST API token — create/publish studies and poll submissions.
# Account settings -> API tokens. Needed for --prolific-mode test/live.
PROLIFIC_API_TOKEN=replace-me

# Google Gemini API key: the usual login of the default coding agents (opencode +
# Gemini), live runs included, and of the simulated paths (LLM browser steering,
# the closed/Gemini participant backend).
GOOGLE_API_KEY=replace-me

# Shared secret guarding the /results and /register_session Cloud Functions;
# deploy and live collection fail without it. Make one with
# `openssl rand -hex 32` and keep it the same for every deploy and collection.
AUTO_PSYCH_RESULTS_TOKEN=replace-me

# Firebase CI token for non-interactive `firebase deploy` from compute nodes.
# Generate once on a machine with a browser:  firebase login:ci
# (or: npx -y firebase-tools login:ci) and paste the token here.
# Needed for --deploy-target firebase.
FIREBASE_TOKEN=replace-me

# Claude agents (backend `claude`) are billed one of two ways, chosen per run
# with agent.claude_auth / --claude-auth / CLAUDE_AUTH (there is no default):
# - subscription: the long-lived token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=replace-me
# - api: an Anthropic API key (per-token billing).
ANTHROPIC_API_KEY=replace-me
# The agent gets only the credential of the run's mode, never both.
