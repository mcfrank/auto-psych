# Git worktrees
.worktrees/

# Secrets (never commit)
.secrets
*.env
.env.*
.firebaserc
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.eggs/
dist/
build/

# R
.Rhistory
.RData
.Rproj.user

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Project run artifacts (optional: uncomment to ignore generated runs)
projects/*/run*/

# Node (for jsPsych Builder when used)
node_modules/
npm-debug.log

# Firebase: local CLI state/cache (do not commit)
.firebase/

# Firebase Hosting deploy target (copy of implementer output)
public/
firebase.generated.json

# Static results-viewer snapshot built by src/viewer/freeze.py (regenerated, never committed)
viewer_dist/

# remote_jobs (SLURM cluster deployment): per-submission JSON, fetched logs, local env
remote_jobs/.runs/
remote_jobs/logs/
remote_jobs/.env.local
# Allow the .env.example template to be tracked (overrides the top-level .env.* rule).
!remote_jobs/.env.example

# Local scratch / working notes (never commit)
*.local.txt
*_cache/
scratch/

# Large generated text dumps (~21 MB of PDF-extraction output). Untracked in
# 2026-08; the file itself is kept on disk.
gt.txt

# Regenerable ArviZ MCMC caches (648 MB under holdout_recovery alone). These were
# tracked until 2026-08 and untracked with `git rm -r --cached`; the caches stay on
# disk and are refilled by the next fit. Already matched by the `*_cache/` rule
# above — spelled out here so the intent is not an accident of that pattern.
data/**/mcmc_cache/

# PID files written by the nohup drivers for long-running runs (data/**/run.pid)
*.pid

# Large regenerable mega-analysis predictions (fit via analysis/behavioral/fit_mega_models.py)
analysis/behavioral/data/mega_model_predictions.csv

# Quarto render artifacts (regenerate with quarto render)
analysis/behavioral/*.html
analysis/behavioral/*_files/
functions/.env
